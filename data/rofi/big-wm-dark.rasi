/* SPDX-License-Identifier: GPL-2.0-or-later
 *
 * Modo escuro do "Buscar aplicativos" e do "Executar" (big-wm-launcher com
 * big-wm-theme dark): o mesmo desenho do big-wm.rasi, com as cores do
 * estilo BigWindowMaker-Dark do Window Maker. Barra de título preta com
 * texto branco, corpo com o gradiente cinza-escuro dos menus, texto claro,
 * relevo cinza/preto e o item selecionado em cinza-claro com texto preto,
 * como o realce dos menus escuros.
 */

@import "big-wm.rasi"

/* O rofi não aceita variáveis dentro de linear-gradient(): os gradientes
 * repetem as cores literais (título #2e2e2e -> #000000, menu #4a4a4a ->
 * #2e2e2e, botões #5a5a5a -> #3a3a3a). */
* {
    wm-menu-top:     #4a4a4a;
    wm-menu-bottom:  #2e2e2e;
    wm-light:        #7a7a7a;
    wm-shadow:       #000000;
    wm-dim:          #1a1a1a;
    wm-pressed:      #2a2a2a;
    wm-select:       #a8a8a8;

    text-color:       #e6e6e6;
}

window {
    background-color: @wm-menu-top;
}

titlebar {
    background-image: linear-gradient(to right, #2e2e2e, #000000);
}

button-close {
    text-color:       #e6e6e6;
    background-image: linear-gradient(to bottom, #5a5a5a, #3a3a3a);
}

inputbar {
    background-color: #2b2b2b;
}

entry {
    placeholder-color: #8a8a8a;
}

button-lista, button-grade, button-categorias, button-voltar {
    background-image: linear-gradient(to bottom, #5a5a5a, #3a3a3a);
}

textbox-hint {
    text-color:       #9a9a9a;
}

listview {
    background-image: linear-gradient(to right, #4a4a4a, #2e2e2e);
}

element {
    border-color:     rgba(255, 255, 255, 10%);
}

/* Texto preto no item selecionado (cinza-claro). O "inherit" do
 * element-text não pega a cor do element selecionado: a regra vai no
 * próprio element-text, no estado selecionado. */
element selected.normal {
    background-color: @wm-select;
    text-color:       black;
}

element-text selected.normal {
    text-color:       black;
}
