# Big WindowMaker: aplicativos padrão só desta sessão (o XDG lê este
# arquivo antes do /etc/xdg/mimeapps.list e depois do ~/.config/mimeapps.list).
#
# O mimeapps.list da BigLinux (biglinux-mime) aponta pastas para o Dolphin.
# Sem o Dolphin, o XDG escolhia o primeiro aplicativo que se registra para
# inode/directory, e o Kate (editor de texto) virava o gerenciador de
# arquivos. Aqui o Thunar é o padrão; a escolha do usuário (Abrir com >
# Definir como padrão, xdg-mime default) fica no ~/.config/mimeapps.list e
# vale mais que este arquivo.
#
# Vídeos: o Big Video Player (biglinux), nos tipos que ele declara. O
# mimeapps.list da BigLinux aponta vídeos para o SMPlayer e o VLC, que o
# Big WindowMaker não traz, e o mpv (dependência do Big Video Player) virava
# o padrão sem ninguém escolher. O mpv continua em "Abrir com".
#
# Programas e pacotes baixados (.exe, .msi, .deb, .rpm, AppImage, scripts,
# .jar, .flatpakref): o Big Trust Alt primeiro. Ele identifica o arquivo sem
# executá-lo e oferece o pacote nativo, o Flatpak, o big-pkg-installer ou o
# Wine. Sem ele instalado, o XDG pula para o próximo da lista (o que o
# mimeapps.list da BigLinux já usava), então nada fica sem programa.
[Default Applications]
inode/directory=thunar.desktop;
application/mxf=br.com.biglinux.VideoPlayer.desktop;
application/vnd.apple.mpegurl=br.com.biglinux.VideoPlayer.desktop;
application/vnd.ms-asf=br.com.biglinux.VideoPlayer.desktop;
application/vnd.rn-realmedia=br.com.biglinux.VideoPlayer.desktop;
application/x-matroska=br.com.biglinux.VideoPlayer.desktop;
