// Configuração do wlmaker para a sessão Big WindowMaker (Wayland, experimental).
// Gerado por big-wm-firstrun a partir de /usr/share/big-wm/wlmaker/Config.plist.in.
// Edite à vontade: este arquivo não é sobrescrito em atualizações.
{
    Keyboard = {
        // Preenchido com o layout do sistema (localectl) no primeiro login.
        XkbRMLVO = {
            Rules = "evdev";
            Model = "@XKB_MODEL@";
            Layout = "@XKB_LAYOUT@";
            Variant = "@XKB_VARIANT@";
            Options = "@XKB_OPTIONS@";
        };
        Repeat = {
            Delay = 300;
            Rate = 25;
        };
    };

    Touchpad = {
        Enabled = True;
        DisableWhileTyping = True;
        ClickMethod = ClickFinger;
        TapToClick = Enabled;
        ScrollMethod = TwoFingers;
        NaturalScrolling = Disabled;
    };

    Cursor = {
        EmulateRightButtonModifier = Logo;
        MoveWindowModifier = Alt;
    };

    ThemeFile = "/usr/share/big-wm/wlmaker/Theme.plist";

    // "Configurações..." no menu dos lançadores do Dock e do Clip: o painel
    // "Configurações de Aplicação na posição Dock" do Window Maker.
    DockSettingsCommand = "/usr/bin/big-wm-dock-settings";

    Decoration = {
        Mode = SuggestServer;
    };

    // Mesmos atalhos da sessão X11 sempre que o wlmaker oferece a ação.
    KeyBindings = {
        "Ctrl+Alt+Backspace" = Quit;

        "Ctrl+Alt+L" = LockScreen;
        "Logo+L" = LockScreen;

        "Ctrl+Alt+T" = (ShellExecute, "big-wm-open terminal");
        "Logo+Return" = (ShellExecute, "big-wm-open terminal");
        // Buscar aplicativos: Alt+Espaço, como no X11; Super+Espaço também.
        "Alt+space" = (ShellExecute, "big-wm-open apps");
        "Logo+space" = (ShellExecute, "big-wm-open apps");
        // Executar...
        "Logo+R" = (ShellExecute, "big-wm-open run");
        "Logo+E" = (ShellExecute, "big-wm-open files");
        // Histórico da área de transferência (wmcliphist), como no X11.
        "Logo+V" = (ShellExecute, "big-wm-open clipboard");
        // Captura de tela: o Spectacle, quando instalado (big-wm-screenshot).
        "Print" = (ShellExecute, "big-wm-screenshot full");
        "Alt+Print" = (ShellExecute, "big-wm-screenshot window");
        "Shift+Print" = (ShellExecute, "big-wm-screenshot area");
        // Forçar o fechamento de um aplicativo travado: o ponteiro vira a
        // caveira vermelha; clique na janela (Esc ou o botão direito
        // cancelam). No X11, o big-wm-xkill.
        "Ctrl+Alt+Escape" = ForceCloseSelect;
        "Ctrl+Shift+Escape" = (ShellExecute, "big-wm-open taskmanager");
        // Organização de janelas (wmake-zones dentro do wlmaker), com os
        // mesmos atalhos do X11.
        "Logo+Z" = (Zones, "picker");
        "Logo+Shift+Z" = (Zones, "autotile toggle");
        "Logo+Ctrl+Z" = (Zones, "layout next");
        "Logo+Alt+Z" = (Zones, "editor");
        "Logo+Ctrl+Left" = (Zones, "move left");
        "Logo+Ctrl+Right" = (Zones, "move right");
        "Logo+Ctrl+Up" = (Zones, "move up");
        "Logo+Ctrl+Down" = (Zones, "move down");
        "Logo+Ctrl+0" = (Zones, "restore");
        "Logo+Ctrl+F" = (Zones, "float");
        "Logo+Ctrl+Return" = (Zones, "promote");
        "Logo+Ctrl+equal" = (Zones, "grow");
        "Logo+Ctrl+minus" = (Zones, "shrink");
        "Logo+Alt+Left" = (Zones, "focus left");
        "Logo+Alt+Right" = (Zones, "focus right");
        "Logo+Alt+Up" = (Zones, "focus up");
        "Logo+Alt+Down" = (Zones, "focus down");
        "Logo+Shift+Left" = (Zones, "swap left");
        "Logo+Shift+Right" = (Zones, "swap right");
        "Logo+Shift+Up" = (Zones, "swap up");
        "Logo+Shift+Down" = (Zones, "swap down");
        "Logo+Ctrl+BackSpace" = (Zones, "undo");
        "Logo+Ctrl+Shift+BackSpace" = (Zones, "redo");

        "Alt+Tab" = TaskNext;
        "Shift+Alt+ISO_Left_Tab" = TaskPrevious;

        "Ctrl+Alt+Left" = WorkspacePrevious;
        "Ctrl+Alt+Right" = WorkspaceNext;

        "Alt+Up" = WindowRaise;
        "Alt+Down" = WindowLower;
        "Alt+F10" = WindowToggleMaximized;
        "Alt+F11" = WindowToggleFullscreen;
        "Alt+F4" = WindowClose;
        "Ctrl+Alt+Shift+Right" = WindowToNextWorkspace;
        "Ctrl+Alt+Shift+Left" = WindowToPreviousWorkspace;

        "F12" = RootMenu;
        "Ctrl+Escape" = RootMenu;

        // Dock com abas (big-wm-tabbed-dock): as mesmas teclas que ele captura no X11.
        "Logo+Alt+1" = (ShellExecute, "big-wm-tabbed-dock --tab 1");
        "Logo+Alt+2" = (ShellExecute, "big-wm-tabbed-dock --tab 2");
        "Logo+Alt+3" = (ShellExecute, "big-wm-tabbed-dock --tab 3");
        "Logo+Alt+4" = (ShellExecute, "big-wm-tabbed-dock --tab 4");
        "Logo+Alt+5" = (ShellExecute, "big-wm-tabbed-dock --tab 5");
        "Logo+Alt+6" = (ShellExecute, "big-wm-tabbed-dock --tab 6");
        "Logo+Alt+7" = (ShellExecute, "big-wm-tabbed-dock --tab 7");
        "Logo+Alt+8" = (ShellExecute, "big-wm-tabbed-dock --tab 8");
        "Logo+Alt+9" = (ShellExecute, "big-wm-tabbed-dock --tab 9");
        "Logo+Alt+Page_Up" = (ShellExecute, "big-wm-tabbed-dock --tab prev");
        "Logo+Alt+Page_Down" = (ShellExecute, "big-wm-tabbed-dock --tab next");

        "Ctrl+Shift+Page_Up" = OutputMagnify;
        "Ctrl+Shift+Page_Down" = OutputReduce;

        // Ampliação da tela (acessibilidade): Ctrl+Alt+rolagem amplia ou
        // reduz sobre qualquer janela; Ctrl+Alt+0 volta ao normal. Sem os
        // modificadores, a rolagem continua indo para os programas.
        "Ctrl+Alt+WheelUp" = ZoomIn;
        "Ctrl+Alt+WheelDown" = ZoomOut;
        "Ctrl+Alt+0" = ZoomReset;

        "XF86MonBrightnessDown" = (ShellExecute, "brightnessctl set 5%-");
        "XF86MonBrightnessUp" = (ShellExecute, "brightnessctl set +5%");
        "XF86AudioRaiseVolume" = (ShellExecute, "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+");
        "XF86AudioLowerVolume" = (ShellExecute, "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-");
        "XF86AudioMute" = (ShellExecute, "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle");
        "XF86AudioPlay" = (ShellExecute, "playerctl play-pause");
        "XF86AudioNext" = (ShellExecute, "playerctl next");
        "XF86AudioPrev" = (ShellExecute, "playerctl previous");
    };

    // Ampliação da tela (ações ZoomIn, ZoomOut e ZoomReset; os atalhos estão
    // em KeyBindings). Tudo opcional; estes são os padrões.
    Zoom = {
        // Ampliação máxima.
        MaxLevel = 8.0;
        // Fator por entalhe da roda (ou por ZoomIn): 1.25 dobra em ~3.
        Step = 1.25;
        // Milissegundos para deslizar até o novo nível; 0 desliga a animação.
        AnimationTime = 120;
        // Como a área ampliada segue o ponteiro: Proportional (a posição do
        // ponteiro na tela corresponde à mesma posição na área ampliada, e o
        // que está sob ele não muda de lugar), Push (só anda quando o
        // ponteiro encosta na borda) ou Centered (centrada no ponteiro).
        Tracking = Proportional;
        // Pixels ampliados suavizados (True) ou em blocos nítidos (False).
        Smooth = True;
    };
    HotCorner = {
        TriggerDelay = 500;
        TopLeftEnter = None;
        TopLeftLeave = None;
        TopRightEnter = None;
        TopRightLeave = None;
        BottomLeftEnter = LockScreen;
        BottomLeftLeave = None;
        BottomRightEnter = InhibitLockBegin;
        BottomRightLeave = InhibitLockEnd;
    };

    // Cliques e roda na área de trabalho, como no Window Maker (WPrefs >
    // Mouse; o big-wm-wprefs-sync traz o que for mudado lá). Botões:
    // ApplicationsMenu, WindowListMenu, SelectWindows ou None. Roda:
    // SwitchWorkspaces, SwitchWindows ou None.
    // Atributos de janela por aplicativo, como o WMWindowAttributes do
    // Window Maker (chave: app ID no Wayland; "instância.classe", instância
    // ou classe no X11; "*" para todos): NoMiniaturizeButton,
    // NoCloseButton, NoResizebar. Janelas de tamanho fixo não têm a barra
    // de redimensionar. O painel Informações não tem o botão de miniaturizar.
    // ServerDecoration = Yes: a moldura do Window Maker (barra de título e
    // de redimensionar) mesmo em programas que desenham a própria e pedem
    // "sem moldura" (xdg-decoration, nenhum protocolo no GTK 4,
    // _MOTIF_WM_HINTS no X11); No: nunca. Em todos ("*"), como no X11
    // (IgnoreDecorationChanges no WMWindowAttributes): menus, avisos, telas
    // de abertura, docks e painéis (layer-shell) continuam sem moldura. Os
    // botões próprios dos programas GTK, Telegram, Chrome e AshyTerm somem
    // (button-layout vazio, big-wm-theme); a barra da Steam fica dentro.
    WindowAttributes = {
        "*" = { ServerDecoration = Yes; };
        "big-wm-about" = { NoMiniaturizeButton = Yes; };
    };

    // h j k l como as setas nos menus (ViKeyMenus do Window Maker).
    ViKeyMenus = No;

    RootMouse = {
        DisableActions = No;
        LeftButton = SelectWindows;
        MiddleButton = WindowListMenu;
        RightButton = ApplicationsMenu;
        BackwardButton = None;
        ForwardButton = None;
        Wheel = None;
        WheelTilt = None;
    };

    ScreenLock = {
        IdleSeconds = 600;
        Command = "/usr/bin/big-wm-lock";
    };

    // Sacudir o mouse aumenta o próprio ponteiro por um instante. As
    // preferências (ligar/desligar, sensibilidade, tamanho, tempos) ficam no
    // mesmo arquivo da sessão X11, lido de novo quando muda (menu
    // Configurações > Localizar o ponteiro ao sacudir).
    LocatePointer = {
        SettingsFile = "~/.config/big-wm/locate-pointer.conf";
    };

    // Forçar o fechamento (Ctrl+Alt+Esc, ação ForceCloseSelect): a imagem
    // "pirate" do tema de cursor big-wm-skull (a caveira vermelha).
    ForceClose = {
        CursorTheme = "big-wm-skull";
        Cursor = "pirate";
    };

    // Executados quando o wlmaker já está pronto (WAYLAND_DISPLAY definido).
    // Sem shell: a linha é dividida em espaços. Use caminhos absolutos;
    // se um comando não puder ser iniciado, o wlmaker encerra a sessão.
    Autostart = (
        "/usr/bin/big-wm-session-ctl start",
        "/usr/bin/big-wm-wallpaper --restore"
    );

    Outputs = (
        {
            Name = "*";
            Transformation = Normal;
            Scale = 1.0;
        },
    );
}
