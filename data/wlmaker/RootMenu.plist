// Root menu of the Big WindowMaker Wayland session (wlmaker): same layout as
// the X11 session menu. Applications, Wallpapers and Dockapps are generated
// by big-wm-appmenu when the session starts; Themes and Styles (Window Maker
// styles, applied with setstyle) by big-wm-wprefs-sync, which also takes what
// is set in Window Maker's preferences (WPrefs) to wlmaker.
("Big WindowMaker",
 ("Applications", GeneratePlistMenu, "big-wm-appmenu --wlmaker"),
 ("Search applications", ShellExecute, "big-wm-open apps"),
 ("Terminal", ShellExecute, "big-wm-open terminal"),
 ("Files", ShellExecute, "big-wm-open files"),
 ("Web browser", ShellExecute, "big-wm-open browser"),
 ("Run...", ShellExecute, "big-wm-open run"),
 ("Workspaces",
  ("New", WorkspaceAdd),
  ("Remove last", WorkspaceDestroyLast),
  ("Previous", WorkspacePrevious),
  ("Next", WorkspaceNext),
  ("Window organization",
    ("Zones on/off", Zones, "zones toggle"),
    ("Auto Tiling on/off", Zones, "autotile toggle"),
    ("Next layout", Zones, "layout next"),
    ("Restore the window", Zones, "restore"),
    ("Edit zones...", ShellExecute, "wmake-zones-prefs --editor"),
    ("Preferences...", ShellExecute, "wmake-zones-prefs"))),
 ("Appearance",
  ("Light theme", ShellExecute, "big-wm-theme light"),
  ("Dark theme", ShellExecute, "big-wm-theme dark"),
  ("Themes", GeneratePlistMenu, "big-wm-wprefs-sync --open-menu '-noext /usr/share/WindowMaker/Themes ~/GNUstep/Library/WindowMaker/Themes WITH setstyle'"),
  ("Styles", GeneratePlistMenu, "big-wm-wprefs-sync --open-menu '-noext /usr/share/WindowMaker/Styles ~/GNUstep/Library/WindowMaker/Styles WITH setstyle'"),
  ("Wallpapers", GeneratePlistMenu, "big-wm-appmenu --wlmaker --wallpapers"),
  ("Icon sets", GeneratePlistMenu, "big-wm-appmenu --wlmaker --icon-themes"),
  ("Dockapps", GeneratePlistMenu, "big-wm-appmenu --wlmaker --dockapps"),
  ("Lock Screen...", ShellExecute, "big-wm-lock-settings"),
  ("Window organization",
    ("Zones on/off", Zones, "zones toggle"),
    ("Auto Tiling on/off", Zones, "autotile toggle"),
    ("Next layout", Zones, "layout next"),
    ("Restore the window", Zones, "restore"),
    ("Edit zones...", ShellExecute, "wmake-zones-prefs --editor"),
    ("Preferences...", ShellExecute, "wmake-zones-prefs"))),
 ("Settings",
  ("Window Maker", ShellExecute, "WPrefs"),
  ("Tabbed Dock preferences", ShellExecute, "big-wm-tabbed-dock --preferences"),
  ("BigLinux Settings", ShellExecute, "biglinux-settings"),
  ("Displays", ShellExecute, "wdisplays"),
  ("Magnify", OutputMagnify),
  ("Reduce", OutputReduce),
  ("Save display state", OutputSaveState),
  ("Volume", ShellExecute, "pavucontrol"),
  ("Software", ShellExecute, "pamac-manager")),
 ("Screenshot",
  ("Full screen", ShellExecute, "big-wm-screenshot full"),
  ("Window", ShellExecute, "big-wm-screenshot window"),
  ("Area", ShellExecute, "big-wm-screenshot area")),
 ("Session",
  ("Lock screen", LockScreen),
  ("Force quit", ShellExecute, "big-wm-kill"),
  ("Reload configuration", ShellExecute, "big-wm-wprefs-sync"),
  ("Welcome", ShellExecute, "big-wm-welcome"),
  ("Info panel", ShellExecute, "big-wm-about"),
  ("Log out", Quit),
  ("Suspend", ShellExecute, "systemctl suspend"),
  ("Restart", ShellExecute, "systemctl reboot"),
  ("Shut down", ShellExecute, "systemctl poweroff")))
