// Root menu of the Big WindowMaker Wayland session (wlmaker).
("Big WindowMaker",
 ("Applications", ShellExecute, "rofi -show drun"),
 ("Terminal", ShellExecute, "xdg-terminal-exec"),
 ("Files", ShellExecute, "xdg-open \"$HOME\""),
 ("Run...", ShellExecute, "rofi -show run"),
 ("Workspaces",
  ("New", WorkspaceAdd),
  ("Remove last", WorkspaceDestroyLast),
  ("Previous", WorkspacePrevious),
  ("Next", WorkspaceNext)),
 ("Displays",
  ("Configure...", ShellExecute, "wdisplays"),
  ("Magnify", OutputMagnify),
  ("Reduce", OutputReduce),
  ("Save state", OutputSaveState)),
 ("System",
  ("BigLinux Settings", ShellExecute, "biglinux-settings"),
  ("Software", ShellExecute, "pamac-manager"),
  ("Volume", ShellExecute, "pavucontrol")),
 ("Screenshot",
  ("Full screen", ShellExecute, "big-wm-screenshot full"),
  ("Area", ShellExecute, "big-wm-screenshot area")),
 ("Lock screen", LockScreen),
 ("Session",
  ("Log out", Quit),
  ("Suspend", ShellExecute, "systemctl suspend"),
  ("Restart", ShellExecute, "systemctl reboot"),
  ("Shut down", ShellExecute, "systemctl poweroff")))
