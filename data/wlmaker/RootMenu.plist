// Root menu of the Big WindowMaker Wayland session (wlmaker): same layout as
// the X11 session menu. Applications, Wallpapers and Dockapps are generated
// by big-wm-appmenu when the session starts.
("Big WindowMaker",
 ("Applications", GeneratePlistMenu, "big-wm-appmenu --wlmaker"),
 ("Search applications", ShellExecute, "big-wm-open apps"),
 ("Terminal", ShellExecute, "big-wm-open terminal"),
 ("Files", ShellExecute, "big-wm-open files"),
 ("Web browser", ShellExecute, "big-wm-open browser"),
 ("Run...", ShellExecute, "big-wm-open run"),
 ("Workspaces",
  ("New", WorkspaceAdd),
  ("Remove last", WorkspaceDestroyLast),
  ("Previous", WorkspacePrevious),
  ("Next", WorkspaceNext)),
 ("Appearance",
  ("Wallpapers", GeneratePlistMenu, "big-wm-appmenu --wlmaker --wallpapers"),
  ("Dockapps", GeneratePlistMenu, "big-wm-appmenu --wlmaker --dockapps")),
 ("Settings",
  ("BigLinux Settings", ShellExecute, "biglinux-settings"),
  ("Displays", ShellExecute, "wdisplays"),
  ("Magnify", OutputMagnify),
  ("Reduce", OutputReduce),
  ("Save display state", OutputSaveState),
  ("Volume", ShellExecute, "pavucontrol"),
  ("Software", ShellExecute, "pamac-manager")),
 ("Screenshot",
  ("Full screen", ShellExecute, "big-wm-screenshot full"),
  ("Window", ShellExecute, "big-wm-screenshot window"),
  ("Area", ShellExecute, "big-wm-screenshot area")),
 ("Session",
  ("Lock screen", LockScreen),
  ("Force quit", ShellExecute, "big-wm-kill"),
  ("Log out", Quit),
  ("Suspend", ShellExecute, "systemctl suspend"),
  ("Restart", ShellExecute, "systemctl reboot"),
  ("Shut down", ShellExecute, "systemctl poweroff")))
