// Dock, Clip e áreas de trabalho da sessão Big WindowMaker (Wayland).
{
  Dock = {
    Output = {
      Name = "*";
    };
    Edge = RIGHT;
    Anchor = TOP;
    Launchers = (
      {
        AppID = "org.communitybig.ashyterm";
        CommandLine = "/usr/bin/big-wm-open terminal";
        Icon = "big-wm-terminal-56x56.png";
      },
      {
        AppID = "rofi";
        CommandLine = "/usr/bin/big-wm-open apps";
        Icon = "big-wm-apps-56x56.png";
      }
    );
  };
  Clip = {
    Output = {
      Name = "*";
    };
    Edge = LEFT;
    Anchor = TOP;
    // Ícone do Clip (o arame do clipe, como no X11).
    Icon = "big-wm-clip-56x56.png";
    // Abaixo do Clip, como na sessão X11 (wlmdock --clip): navegador e
    // gerenciador de arquivos padrão.
    Launchers = (
      {
        AppID = "firefox";
        CommandLine = "/usr/bin/big-wm-open browser";
        Icon = "big-wm-netscape-56x56.png";
      },
      {
        AppID = "thunar";
        CommandLine = "/usr/bin/big-wm-open files";
        Icon = "big-wm-folder-56x56.png";
      }
    );
    // Ordem dos dockapps a partir do Clip; Alt+arrastar reorganiza e grava
    // em ~/.config/wlmaker/Dockapps.plist.
    Dockapps = (
      wlmcalclock,
      wlmclock,
      wlmmixer,
      wlmcpugraph,
      wlmmemgraph,
      wlmnetgraph,
      wlmbattery
    );
  };
  Workspaces = (
    {
      Name = "1";
    },
    {
      Name = "2";
    },
    {
      Name = "3";
    },
    {
      Name = "4";
    }
  );
}
