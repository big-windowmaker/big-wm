// Dock, Clip e áreas de trabalho da sessão Big WindowMaker (Wayland).
{
  Dock = {
    Output = {
      Name = "*";
    };
    Edge = RIGHT;
    Anchor = TOP;
    // Ícone das gavetas ("Add a drawer" no menu do Dock), como o Drawer do
    // X11.
    DrawerIcon = "big-wm-drawer-56x56.png";
    // Duplo clique no ladrilho principal: o painel de informações, como o
    // Info Panel do Window Maker no X11.
    InfoCommand = "/usr/bin/big-wm-about";
    // Dockapps que vão para o Dock (logo depois dos lançadores), nesta
    // ordem, enquanto não foram postos em outro lugar: os do Dock da sessão
    // X11, os mesmos programas pelo XWayland (o nome é o WM_CLASS), com a
    // bandeja (big-wm-tray) no lugar do wmsystemtray, o ladrilho da
    // organização de janelas (wmake-zones-wl) no do wmake-zones e os olhos
    // nativos (wlmeyes --dockapp) no do wmeyes.
    // Logo abaixo da bandeja, o volume (wmpulsemixer: saída e microfone
    // pelo PulseAudio/PipeWire) e o controle de música (wmusic, MPRIS).
    Dockapps = (
      wmclock,
      "big-wm-tray",
      wmpulsemixer,
      wmusic,
      wmcpuload,
      wmmemload,
      wmnet,
      "wmake-zones-wl",
      wmcliphist,
      wmshutdown,
      wlmeyes
    );
    Launchers = (
      {
        AppID = "org.communitybig.ashyterm";
        CommandLine = "/usr/bin/big-wm-open terminal";
        Icon = "big-wm-terminal-56x56.png";
      },
      {
        AppID = "rofi";
        CommandLine = "/usr/bin/big-wm-open apps";
        Icon = "big-wm-apps-56x56.png";
      }
    );
  };
  Clip = {
    Output = {
      Name = "*";
    };
    Edge = LEFT;
    Anchor = TOP;
    // Ícone do Clip (o arame do clipe, como no X11).
    Icon = "big-wm-clip-56x56.png";
    // Abaixo do Clip, como na sessão X11 (wlmdock --clip): navegador e
    // gerenciador de arquivos padrão.
    Launchers = (
      {
        AppID = "firefox";
        CommandLine = "/usr/bin/big-wm-open browser";
        Icon = "big-wm-netscape-56x56.png";
      },
      {
        AppID = "thunar";
        CommandLine = "/usr/bin/big-wm-open files";
        Icon = "big-wm-folder-56x56.png";
      }
    );
    // Ordem dos dockapps a partir do Clip; Alt+arrastar reorganiza e grava
    // em ~/.config/wlmaker/Dockapps.plist.
    Dockapps = (
      wlmcalclock,
      wlmclock,
      wlmmixer,
      wlmcpugraph,
      wlmmemgraph,
      wlmnetgraph,
      wlmbattery
    );
  };
  Workspaces = (
    {
      Name = "1";
    },
    {
      Name = "2";
    },
    {
      Name = "3";
    },
    {
      Name = "4";
    }
  );
}
