// Menu raiz da sessão Big WindowMaker Wayland (wlmaker): mesma estrutura do
// menu da sessão X11. Aplicativos, Papéis de parede e Dockapps são gerados
// pelo big-wm-appmenu quando a sessão começa; Temas e Estilos (estilos do
// Window Maker, aplicados com o setstyle) pelo big-wm-wprefs-sync, que também
// leva para o wlmaker o que é configurado nas preferências (WPrefs).
("Big WindowMaker",
 ("Aplicativos", GeneratePlistMenu, "big-wm-appmenu --wlmaker"),
 ("Buscar aplicativos", ShellExecute, "big-wm-open apps"),
 ("Terminal", ShellExecute, "big-wm-open terminal"),
 ("Arquivos", ShellExecute, "big-wm-open files"),
 ("Navegador", ShellExecute, "big-wm-open browser"),
 ("Executar...", ShellExecute, "big-wm-open run"),
 ("Áreas de trabalho",
  ("Nova", WorkspaceAdd),
  ("Remover a última", WorkspaceDestroyLast),
  ("Anterior", WorkspacePrevious),
  ("Próxima", WorkspaceNext),
  ("Organização de janelas",
    ("Zonas: ligar/desligar", Zones, "zones toggle"),
    ("Mosaico automático: ligar/desligar", Zones, "autotile toggle"),
    ("Próximo layout", Zones, "layout next"),
    ("Restaurar a janela", Zones, "restore"),
    ("Editar zonas...", ShellExecute, "wmake-zones-prefs --editor"),
    ("Preferências...", ShellExecute, "wmake-zones-prefs"))),
 ("Aparência",
  ("Tema claro", ShellExecute, "big-wm-theme light"),
  ("Tema escuro", ShellExecute, "big-wm-theme dark"),
  ("Temas", GeneratePlistMenu, "big-wm-wprefs-sync --open-menu '-noext /usr/share/WindowMaker/Themes ~/GNUstep/Library/WindowMaker/Themes WITH setstyle'"),
  ("Estilos", GeneratePlistMenu, "big-wm-wprefs-sync --open-menu '-noext /usr/share/WindowMaker/Styles ~/GNUstep/Library/WindowMaker/Styles WITH setstyle'"),
  ("Papéis de parede", GeneratePlistMenu, "big-wm-appmenu --wlmaker --wallpapers"),
  ("Conjuntos de ícones", GeneratePlistMenu, "big-wm-appmenu --wlmaker --icon-themes"),
  ("Aumentar Escala", ZoomIn),
  ("Diminuir Escala", ZoomOut)),
 ("Configurações",
  ("Organização de janelas",
    ("Zonas: ligar/desligar", Zones, "zones toggle"),
    ("Mosaico automático: ligar/desligar", Zones, "autotile toggle"),
    ("Próximo layout", Zones, "layout next"),
    ("Restaurar a janela", Zones, "restore"),
    ("Editar zonas...", ShellExecute, "wmake-zones-prefs --editor"),
    ("Preferências...", ShellExecute, "wmake-zones-prefs")),
  ("Tela de bloqueio...", ShellExecute, "big-wm-lock-settings"),
  ("Dockapps", GeneratePlistMenu, "big-wm-appmenu --wlmaker --dockapps"),
  ("Preferências do Dock com Abas", ShellExecute, "big-wm-tabbed-dock --preferences"),
  ("Monitores", ShellExecute, "big-wm-display-resolution"),
  ("Configurações avançadas de rede", ShellExecute, "nm-connection-editor"),
  ("Configurações da impressão", ShellExecute, "system-config-printer"),
  ("Gerenciador de impressão", ShellExecute, "xdg-open http://localhost:631/"),
  ("Controle de Volume", ShellExecute, "pavucontrol"),
  ("Gerenciador de Bluetooth", ShellExecute, "blueman-manager"),
  ("Gerenciamento de Hardware", ShellExecute, "big-driver-manager"),
  ("WindowMaker (WPrefs)", ShellExecute, "WPrefs"),
  ("Adicionar/remover programas", ShellExecute, "pamac-manager"),
  ("Configurações do BigLinux", ShellExecute, "biglinux-settings"),
  ("Lupa", ZoomIn)),
 ("Captura de tela",
  ("Tela inteira", ShellExecute, "big-wm-screenshot full"),
  ("Janela", ShellExecute, "big-wm-screenshot window"),
  ("Área", ShellExecute, "big-wm-screenshot area")),
 ("Sessão",
  ("Bloquear tela", LockScreen),
  ("Forçar o fechamento", ShellExecute, "big-wm-kill"),
  ("Recarregar a configuração", ShellExecute, "big-wm-wprefs-sync"),
  ("Boas-vindas", ShellExecute, "big-wm-welcome"),
  ("Sobre", ShellExecute, "big-wm-about"),
  ("Sair", Quit),
  ("Suspender", ShellExecute, "systemctl suspend"),
  ("Reiniciar", ShellExecute, "systemctl reboot"),
  ("Desligar", ShellExecute, "systemctl poweroff")))
