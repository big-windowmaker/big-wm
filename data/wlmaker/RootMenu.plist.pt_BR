// Menu raiz da sessão Big WindowMaker Wayland (wlmaker).
("Big WindowMaker",
 ("Aplicativos", ShellExecute, "rofi -show drun"),
 ("Terminal", ShellExecute, "xdg-terminal-exec"),
 ("Arquivos", ShellExecute, "xdg-open \"$HOME\""),
 ("Executar...", ShellExecute, "rofi -show run"),
 ("Áreas de trabalho",
  ("Nova", WorkspaceAdd),
  ("Remover a última", WorkspaceDestroyLast),
  ("Anterior", WorkspacePrevious),
  ("Próxima", WorkspaceNext)),
 ("Monitores",
  ("Configurar...", ShellExecute, "wdisplays"),
  ("Ampliar", OutputMagnify),
  ("Reduzir", OutputReduce),
  ("Salvar estado", OutputSaveState)),
 ("Sistema",
  ("Configurações do BigLinux", ShellExecute, "biglinux-settings"),
  ("Programas", ShellExecute, "pamac-manager"),
  ("Volume", ShellExecute, "pavucontrol")),
 ("Captura de tela",
  ("Tela inteira", ShellExecute, "big-wm-screenshot full"),
  ("Área", ShellExecute, "big-wm-screenshot area")),
 ("Bloquear tela", LockScreen),
 ("Sessão",
  ("Sair", Quit),
  ("Suspender", ShellExecute, "systemctl suspend"),
  ("Reiniciar", ShellExecute, "systemctl reboot"),
  ("Desligar", ShellExecute, "systemctl poweroff")))
