[Desktop Entry]
# Terminal preferido do Big WindowMaker para o Thunar e o exo ("Abrir
# terminal aqui"): o big-wm-terminal abre o terminal escolhido pelo usuário
# (AshyTerm por padrão) na pasta. Usado pelo xfce4-mime-helper, quando o
# xfce4-settings está instalado, e pelo exo-open sem ele (helpers.rc).
Version=1.0
Type=X-XFCE-Helper
Icon=utilities-terminal
Name=Big WindowMaker (preferred terminal)
Name[pt_BR]=Big WindowMaker (terminal preferido)
X-XFCE-Category=TerminalEmulator
X-XFCE-Commands=big-wm-terminal
X-XFCE-CommandsWithParameter=big-wm-terminal -e "%s"
NoDisplay=true
