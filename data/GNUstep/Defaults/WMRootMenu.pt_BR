(
  "Big WindowMaker",
  (Aplicativos, OPEN_PLMENU, "|| big-wm-appmenu"),
  ("Buscar aplicativos", SHORTCUT, "Mod1+space", EXEC, "big-wm-open apps"),
  (Terminal, SHORTCUT, "Control+Mod1+t", EXEC, "big-wm-open terminal"),
  (Arquivos, SHORTCUT, "Mod4+e", EXEC, "big-wm-open files"),
  (Navegador, EXEC, "big-wm-open browser"),
  ("Executar...", SHORTCUT, "Mod4+r", EXEC, "big-wm-open run"),
  ("Área de transferência", SHORTCUT, "Mod4+v", EXEC, "big-wm-open clipboard"),
  (
    "Áreas de trabalho",
    ("Áreas de trabalho", WORKSPACE_MENU),
    (
      "Organização de janelas",
      ("Zonas: ligar/desligar", EXEC, "wmake-zones zones toggle"),
      ("Mosaico automático: ligar/desligar", EXEC, "wmake-zones autotile toggle"),
      ("Escolher a zona (Super+Z)", EXEC, "wmake-zones picker"),
      ("Próximo layout", EXEC, "wmake-zones layout next"),
      ("Organizar as janelas agora", EXEC, "wmake-zones arrange"),
      ("Restaurar as janelas", EXEC, "wmake-zones restore-all"),
      ("Editar zonas...", EXEC, "wmake-zones-prefs --editor"),
      ("Preferências...", EXEC, "wmake-zones-prefs")
    ),
    ("Ocultar as outras", HIDE_OTHERS),
    ("Mostrar todas", SHOW_ALL),
    ("Organizar ícones", ARRANGE_ICONS),
    ("Restaurar posição do Dock", RESET_DOCK),
    (Atualizar, REFRESH),
    ("Salvar sessão", SAVE_SESSION),
    ("Limpar sessão", CLEAR_SESSION)
  ),
  (
    "Aparência",
    ("Tema claro", EXEC, "big-wm-theme light"),
    ("Tema escuro", EXEC, "big-wm-theme dark"),
    (Temas, OPEN_MENU, "-noext /usr/share/WindowMaker/Themes ~/GNUstep/Library/WindowMaker/Themes WITH setstyle"),
    (Estilos, OPEN_MENU, "-noext /usr/share/WindowMaker/Styles ~/GNUstep/Library/WindowMaker/Styles WITH setstyle"),
    ("Conjuntos de ícones", OPEN_PLMENU, "|| big-wm-appmenu --icon-themes"),
    ("Papéis de parede", OPEN_MENU, "-noext /usr/share/backgrounds/big-wm ~/GNUstep/Library/WindowMaker/Backgrounds WITH big-wm-wallpaper"),
    (
      "Ajuste do papel de parede",
      (Preencher, EXEC, "big-wm-wallpaper --mode fill"),
      (Ajustar, EXEC, "big-wm-wallpaper --mode fit"),
      ("Tamanho original", EXEC, "big-wm-wallpaper --mode center"),
      (Esticar, EXEC, "big-wm-wallpaper --mode stretch"),
      ("Lado a lado", EXEC, "big-wm-wallpaper --mode tile"),
      ("Estender pelos monitores", EXEC, "big-wm-wallpaper --mode span")
    ),
    ("Aumentar Escala", EXEC, "big-wm-zoom in"),
    ("Diminuir Escala", EXEC, "big-wm-zoom out"),
    ("Salvar tema...", SHEXEC, "getstyle -p ~/GNUstep/Library/WindowMaker/Themes/\"%a(Nome do tema)\""),
    ("Salvar conjunto de ícones...", SHEXEC, "geticonset ~/GNUstep/Library/WindowMaker/IconSets/\"%a(Nome do conjunto de ícones)\"")
  ),
  (
    "Configurações",
    (
      "Organização de janelas",
      ("Zonas: ligar/desligar", EXEC, "wmake-zones zones toggle"),
      ("Mosaico automático: ligar/desligar", EXEC, "wmake-zones autotile toggle"),
      ("Escolher a zona (Super+Z)", EXEC, "wmake-zones picker"),
      ("Próximo layout", EXEC, "wmake-zones layout next"),
      ("Organizar as janelas agora", EXEC, "wmake-zones arrange"),
      ("Restaurar as janelas", EXEC, "wmake-zones restore-all"),
      ("Editar zonas...", EXEC, "wmake-zones-prefs --editor"),
      ("Preferências...", EXEC, "wmake-zones-prefs")
    ),
    ("Tela de bloqueio...", EXEC, "big-wm-lock-settings"),
    ("Dockapps", OPEN_PLMENU, "|| big-wm-appmenu --dockapps"),
    ("Preferências do Dock com Abas", EXEC, "big-wm-tabbed-dock --preferences"),
    (Monitores, EXEC, "big-wm-display-resolution"),
    ("Configurações avançadas de rede", EXEC, "nm-connection-editor"),
    ("Configurações da impressão", EXEC, "system-config-printer"),
    ("Gerenciador de impressão", EXEC, "xdg-open http://localhost:631/"),
    ("Controle de Volume", EXEC, pavucontrol),
    ("Gerenciador de Bluetooth", EXEC, "blueman-manager"),
    ("Gerenciamento de Hardware", EXEC, "big-driver-manager"),
    ("WindowMaker (WPrefs)", EXEC, WPrefs),
    ("Adicionar/remover programas", EXEC, "pamac-manager"),
    ("Configurações do BigLinux", EXEC, "biglinux-settings"),
    (Lupa, EXEC, wmagnify),
    ("Localizar o ponteiro ao sacudir", EXEC, "big-wm-locate-pointer --toggle")
  ),
  (
    "Captura de tela",
    ("Tela inteira", SHORTCUT, Print, EXEC, "big-wm-screenshot full"),
    (Janela, SHORTCUT, "Mod1+Print", EXEC, "big-wm-screenshot window"),
    ("Área", SHORTCUT, "Shift+Print", EXEC, "big-wm-screenshot area")
  ),
  (
    "Sessão",
    ("Bloquear tela", SHORTCUT, "Mod4+l", EXEC, "big-wm-lock"),
    ("Forçar o fechamento", SHORTCUT, "Control+Mod1+Escape", EXEC, "big-wm-kill"),
    ("Gerenciador de tarefas", SHORTCUT, "Control+Shift+Escape", EXEC, "big-wm-open taskmanager"),
    ("Reiniciar o Window Maker", RESTART),
    ("Boas-vindas", EXEC, "big-wm-welcome"),
    ("Sobre", INFO_PANEL),
    (Sair, EXIT),
    (Suspender, EXEC, "systemctl suspend"),
    (Reiniciar, EXEC, "systemctl reboot"),
    (Desligar, EXEC, "systemctl poweroff")
  )
)
