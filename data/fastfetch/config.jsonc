// fastfetch do Big WindowMaker: o logo em ASCII (ascii-art, gerado de
// themes/logo/big-wm.svg por data/fastfetch/gerar-ascii.py) e os textos com
// as cores do logo: azul #2d85c6 (Sistema), ciano #04bacc (Área de
// trabalho, título) e branco (Hardware). Mesmos módulos e rótulos do
// /etc/fastfetch/config.jsonc da BigCommunity, para o wrapper traduzir.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "~/.config/fastfetch/ascii-art",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "separator": "38;2;4;186;204",
      "title": "38;2;4;186;204",
      "output": "97"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name-colored}@{host-name-colored}"
    },
    "separator",
    {
      "type": "os",
      "key": "{icon} System",
      "keyColor": "38;2;45;133;198",
      "format": "{pretty-name} {arch}"
    },
    {
      "type": "kernel",
      "key": "│ ├ Kernel",
      "keyColor": "38;2;45;133;198",
      "format": "{release}"
    },
    {
      "type": "uptime",
      "key": "│ ├󰅐 Uptime",
      "keyColor": "38;2;45;133;198"
    },
    {
      "type": "packages",
      "key": "│ ├󰏖 Packages",
      "keyColor": "38;2;45;133;198"
    },
    {
      "type": "shell",
      "key": "│ └ Shell",
      "keyColor": "38;2;45;133;198"
    },
    {
      "type": "de",
      "key": "󰇄 Desktop",
      "keyColor": "38;2;4;186;204"
    },
    {
      "type": "wm",
      "key": "│ ├ WM",
      "keyColor": "38;2;4;186;204"
    },
    {
      "type": "theme",
      "key": "│ ├󰉼 Theme",
      "keyColor": "38;2;4;186;204"
    },
    {
      "type": "icons",
      "key": "│ ├󰀻 Icons",
      "keyColor": "38;2;4;186;204"
    },
    {
      "type": "terminal",
      "key": "│ └ Terminal",
      "keyColor": "38;2;4;186;204",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "host",
      "key": "󰌢 Hardware",
      "keyColor": "97",
      "format": "{name}"
    },
    {
      "type": "cpu",
      "key": "│ ├󰻠 CPU",
      "keyColor": "97",
      "format": "{name} ({cores-logical}) @ {freq-base}"
    },
    {
      "type": "gpu",
      "key": "│ ├󰍛 GPU",
      "keyColor": "97"
    },
    {
      "type": "memory",
      "key": "│ ├ RAM",
      "keyColor": "97"
    },
    {
      "type": "disk",
      "key": "│ ├ Disk",
      "keyColor": "97",
      "folders": "/"
    },
    {
      "type": "display",
      "key": "│ └󰍹 Display",
      "keyColor": "97"
    },
    "break",
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}
