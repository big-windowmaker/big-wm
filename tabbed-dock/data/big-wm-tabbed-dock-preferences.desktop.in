[Desktop Entry]
Type=Application
Name=Tabbed Dock Preferences
Comment=Position, appearance, behaviour and startup of the Big Tabbed Dock
Exec=big-wm-tabbed-dock --preferences
TryExec=big-wm-tabbed-dock
Icon=big-wm-tabbed-dock
Categories=Settings;DesktopSettings;GTK;
Keywords=dock;tabs;shelf;launcher;
OnlyShowIn=WindowMaker;wlmaker;
StartupNotify=false
# Já está em Menu Principal > Configurações: o menu Aplicativos (big-wm-appmenu)
# não o repete.
X-BigWM-RootMenu=true
