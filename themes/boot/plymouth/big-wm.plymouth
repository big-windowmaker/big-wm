[Plymouth Theme]
Name=Big WindowMaker
Description=Tela de boot do Big WindowMaker no estilo do Window Maker
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/big-wm
ScriptFile=/usr/share/plymouth/themes/big-wm/big-wm.script
# Fonte dos textos do script. O hook plymouth do mkinitcpio a procura com o
# fc-match e a copia para o initramfs (pacote gsfonts).
Font=Nimbus Sans Bold 14
