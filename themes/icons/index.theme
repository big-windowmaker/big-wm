[Icon Theme]
Name=Big WindowMaker
Comment=Classic Window Maker icons redrawn in SVG
Comment[pt_BR]=Ícones clássicos do Window Maker redesenhados em SVG
Inherits=bigicons-papient,breeze,Adwaita,hicolor
Example=folder
Directories=scalable/apps,scalable/places,scalable/mimetypes

[scalable/apps]
Context=Applications
Size=64
MinSize=16
MaxSize=512
Type=Scalable

[scalable/places]
Context=Places
Size=64
MinSize=16
MaxSize=512
Type=Scalable

[scalable/mimetypes]
Context=MimeTypes
Size=64
MinSize=16
MaxSize=512
Type=Scalable
