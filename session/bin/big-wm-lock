#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-or-later
#
# Bloqueia a tela com a janela OPENSTEP do Big WindowMaker:
#
#   X11       xsecurelock com os módulos auth_big_wm e saver_big_wm
#             (big-wm-lockscreen); o PAM fica com o authproto_pam do
#             xsecurelock. Sem eles, i3lock.
#   Wayland   gtklock (ext-session-lock) com o layout e o estilo do Big
#             WindowMaker; sem ele, swaylock.
#
#   big-wm-lock           bloqueia agora (menu, Super+L, canto ativo e, no
#                         Wayland, o ScreenLock do wlmaker por inatividade)
#   big-wm-lock --watch   bloqueio pelo logind (suspensão, loginctl
#                         lock-session) e, no X11, por inatividade (xss-lock);
#                         iniciado pelo autostart
#
# Chamado direto pelo menu, funciona mesmo sem o xss-lock (na sessão live o
# bloqueio automático fica desligado, mas o manual continua). Chamado pelo
# xss-lock --transfer-sleep-lock, só libera a suspensão depois que a tela
# está bloqueada (o xsecurelock fecha o XSS_SLEEP_LOCK_FD sozinho; com o
# i3lock, o protocolo do exemplo do xss-lock).
#
# Fundo (Aparência > Tela de bloqueio, ~/.config/big-wm/lock.conf): a área
# de trabalho desfocada e escurecida, preto clássico, cinza OPENSTEP, o
# papel de parede escurecido ou uma imagem. A captura é desfocada na memória
# pelo big-wm-lockscreen (a do Wayland vem do grim por um pipe); só a imagem
# desfocada, pequena, vai para um arquivo 0600 em $XDG_RUNTIME_DIR (memória,
# só do usuário), apagado ao desbloquear. Sem $XDG_RUNTIME_DIR, sem imagem:
# o fundo fica preto.

# O autostart roda como serviço do systemd --user, fora da sessão do logind:
# o xss-lock só acha a sessão (e o sinal Lock do "loginctl lock-session") se
# ela for informada.
wayland=0
[ "${XDG_SESSION_TYPE:-}" = wayland ] && wayland=1

if [ "${1:-}" = --watch ]; then
	if [ "$wayland" = 0 ]; then
		exec xss-lock ${XDG_SESSION_ID:+--session="$XDG_SESSION_ID"} --transfer-sleep-lock -- "$0"
	fi
	# Wayland: a inatividade é do próprio wlmaker (ScreenLock); aqui só o
	# logind. O swayidle acha a sessão pelo XDG_SESSION_ID e, com -w, só
	# libera a suspensão depois que a tela está bloqueada.
	swayidle -w before-sleep "$0" lock "$0"
	# Sem o protocolo de inatividade (ext-idle-notify) no compositor o
	# swayidle não sobe: atende só o "loginctl lock-session".
	exec gdbus monitor --system --dest org.freedesktop.login1 \
		--object-path "/org/freedesktop/login1/session/_3${XDG_SESSION_ID:-auto}" |
		while read -r line; do
			case $line in *".Session.Lock ()"*) "$0" ;; esac
		done
fi

# Já bloqueada: nada a fazer (menu, xss-lock e wlmaker podem chamar ao mesmo
# tempo). Vale a tela desta sessão: um bloqueio de outra sessão do mesmo
# usuário (X11 num terminal, Wayland noutro) não conta.
already_locked() {
	local p var
	if [ "$wayland" = 1 ]; then var=WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-}; else var=DISPLAY=${DISPLAY:-}; fi
	for p in $(pgrep -u "$EUID" -x 'xsecurelock|gtklock|i3lock|swaylock'); do
		tr '\0' '\n' <"/proc/$p/environ" 2>/dev/null | grep -qxF -- "$var" && return 0
	done
	return 1
}
already_locked && exit 0

color=000000
lockdir=
image=
if [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -d "$XDG_RUNTIME_DIR" ] && [ -O "$XDG_RUNTIME_DIR" ]; then
	lockdir=$XDG_RUNTIME_DIR/big-wm-lock
	(umask 077 && mkdir -p "$lockdir") && chmod 700 "$lockdir" && image=$lockdir/background.png
fi
cleanup() {
	[ -n "$lockdir" ] && rm -f -- "$lockdir/background.png" "$lockdir/layout.ui" "$lockdir/locked"
}

lockscreen=$(command -v big-wm-lockscreen)
helpers=/usr/lib/xsecurelock
datadir=${BIG_WM_DATADIR:-/usr/share/big-wm}

# Fundo, antes de bloquear (a captura tem de ser da área de trabalho, não da
# tela de bloqueio). Leva algumas dezenas de milissegundos; se falhar, o
# fundo é preto e o bloqueio continua.
make_background() {
	[ -n "$image" ] && [ -n "$lockscreen" ] || return 1
	rm -f -- "$image"
	if [ "$wayland" = 1 ]; then
		if grep -qs '^Background=\(black\|gray\|wallpaper\|image\)$' \
			"${XDG_CONFIG_HOME:-$HOME/.config}/big-wm/lock.conf"; then
			"$lockscreen" background "$image"
		else
			grim -t ppm - 2>/dev/null | "$lockscreen" background --ppm - "$image"
		fi
	else
		"$lockscreen" background --x11 "$image"
	fi
	[ -s "$image" ]
}

case ${LANG%%_*} in
pt) t_session=Sessão t_locked="Sessão bloqueada" t_user=Usuário: t_password=Senha:
	t_hint="Digite a senha para desbloquear" t_unlock=Desbloquear ;;
es) t_session=Sesión t_locked="Sesión bloqueada" t_user=Usuario: t_password=Contraseña:
	t_hint="Escriba la contraseña para desbloquear" t_unlock=Desbloquear ;;
*) t_session=Session t_locked="Session locked" t_user=User: t_password=Password:
	t_hint="Type your password to unlock" t_unlock=Unlock ;;
esac

# Valor de uma chave booleana do lock.conf (padrão: ligado).
lock_opt() {
	! grep -qs "^$1=false\$" "${XDG_CONFIG_HOME:-$HOME/.config}/big-wm/lock.conf"
}

# Layout do gtklock com os textos do idioma e o usuário (só os caracteres
# de nomes de usuário: nada que o XML ou a marcação do GTK interpretem).
gtklock_layout() {
	local user
	user=$(id -un | tr -cd 'A-Za-z0-9._-')
	sed -e "s|@SESSION@|$t_session|" -e "s|@LOCKED@|$t_locked|" \
		-e "s|@USER_MARKUP@|$t_user  \&lt;b\&gt;$user\&lt;/b\&gt;|" \
		-e "s|@PASSWORD@|$t_password|" -e "s|@HINT@|$t_hint|" -e "s|@UNLOCK@|$t_unlock|" \
		-e "s|@SHOW_LOGO@|$(lock_opt ShowLogo && echo 1 || echo 0)|" \
		-e "s|@SHOW_USER@|$(lock_opt ShowUser && echo 1 || echo 0)|" \
		"$datadir/lock/gtklock-layout.ui.in" >"$lockdir/layout.ui"
}

if [ "$wayland" = 1 ]; then
	if command -v gtklock >/dev/null && [ -n "$lockdir" ] && [ -r "$datadir/lock/gtklock-layout.ui.in" ]; then
		args=(-s "$datadir/lock/gtklock.css" -g Adwaita -L "touch $lockdir/locked")
		make_background && args+=(-b "$image")
		gtklock_layout && args+=(-x "$lockdir/layout.ui")
		lock_opt ShowClock && args+=(--time-format "%H:%M") || args+=(--time-format "")
		lock_opt ShowDate && args+=(--date-format "%A, %x") || args+=(--date-format "")
		rm -f -- "$lockdir/locked"
		gtklock "${args[@]}" &
		pid=$!
		# Volta só com a tela bloqueada (o swayidle -w espera por isso
		# antes de deixar suspender).
		for _ in $(seq 1 100); do
			[ -e "$lockdir/locked" ] && break
			kill -0 "$pid" 2>/dev/null || break
			sleep 0.05
		done
		if [ -e "$lockdir/locked" ]; then
			# Limpa quando o gtklock sair (desbloqueio).
			(while kill -0 "$pid" 2>/dev/null; do sleep 1; done; cleanup) &
			disown -a
			exit 0
		fi
		kill "$pid" 2>/dev/null
	fi
	# Sem o gtklock (ou ele não conseguiu bloquear): swaylock, com o fundo.
	args=(-f -c "$color" --ignore-empty-password --show-failed-attempts)
	if [ -s "$image" ] || make_background; then
		args+=(-i "$image" -s fill)
	fi
	# -f: volta assim que a tela está bloqueada (o swayidle -w espera por isso).
	swaylock "${args[@]}"
	status=$?
	(sleep 2; while pgrep -u "$EUID" -x swaylock >/dev/null; do sleep 1; done; cleanup) &
	disown -a
	exit "$status"
fi

if command -v xsecurelock >/dev/null && [ -x "$helpers/auth_big_wm" ] && [ -x "$helpers/saver_big_wm" ]; then
	make_background
	# A primeira tecla já vai para a senha; o diálogo some depois de um
	# minuto sem teclas (volta a janela de sessão bloqueada); a tela apaga
	# em dez minutos. O xsecurelock fecha o XSS_SLEEP_LOCK_FD do xss-lock
	# assim que bloqueia. O módulo de autenticação vai com o caminho
	# completo: só o nome não passa na conferência do xsecurelock, que
	# então usaria o auth_x11 dele.
	BIG_WM_LOCK_BACKGROUND=$image \
		XSECURELOCK_AUTH=$helpers/auth_big_wm XSECURELOCK_SAVER=saver_big_wm \
		XSECURELOCK_DISCARD_FIRST_KEYPRESS=0 XSECURELOCK_AUTH_TIMEOUT=60 \
		XSECURELOCK_BLANK_TIMEOUT=600 XSECURELOCK_SHOW_DATETIME=0 \
		XSECURELOCK_BACKGROUND_COLOR=black \
		xsecurelock
	status=$?
	cleanup
	exit "$status"
fi

# Sem o xsecurelock: i3lock, com o mesmo fundo.
args=(-c "$color" -e -f)
if make_background; then
	args+=(-i "$image")
fi

if [[ -e /dev/fd/${XSS_SLEEP_LOCK_FD:--1} ]]; then
	# O i3lock não pode herdar a trava de suspensão: ao fechar a nossa
	# (a única cópia), o logind sabe que já pode suspender.
	i3lock "${args[@]}" {XSS_SLEEP_LOCK_FD}<&-
	exec {XSS_SLEEP_LOCK_FD}<&-
	while pgrep -u "$EUID" -x i3lock >/dev/null; do
		sleep 0.5
	done
else
	trap 'kill %% 2>/dev/null' TERM INT
	i3lock -n "${args[@]}" &
	wait
fi
cleanup
