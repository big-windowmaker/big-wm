    "green": (0, 255, 0), "blue": (0, 0, 255), "yellow": (255, 255, 0),
    "cyan": (0, 255, 255), "magenta": (255, 0, 255), "gray": (190, 190, 190),
    "grey": (190, 190, 190), "darkgray": (169, 169, 169),
