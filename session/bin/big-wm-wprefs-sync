#!/usr/bin/python3 -I
# SPDX-License-Identifier: GPL-2.0-or-later
#
# Leva para a sessão Wayland (wlmaker) o que foi configurado no WPrefs e nos
# outros programas do Window Maker (setstyle, wmsetbg, editor de menu).
#
#   big-wm-wprefs-sync            sincroniza uma vez e pede ao wlmaker para
#                                 recarregar (quando ele está rodando)
#   big-wm-wprefs-sync --watch    sincroniza e liga o vigia: a unidade
#                                 big-wm-wprefs-sync.path do systemd --user
#                                 (sem processo residente), que roda
#                                 --triggered a cada gravação; sem o systemd
#                                 --user (ou com WMAKER_USER_ROOT), fica
#                                 vigiando ~/GNUstep/Defaults (inotify). Cada
#                                 gravação do WPrefs chega ao wlmaker em menos
#                                 de um segundo (--watch --inotify: sempre o
#                                 vigia por inotify, residente)
#   big-wm-wprefs-sync --triggered
#                                 uma rodada do vigia (big-wm-wprefs-sync.service):
#                                 espera as gravações em sequência terminarem,
#                                 sincroniza e só recarrega o wlmaker se algo
#                                 mudou; repete se houve gravação durante a
#                                 rodada
#   big-wm-wprefs-sync --dry-run  mostra o que mudaria, sem gravar
#   big-wm-wprefs-sync --full     aplica todos os valores convertidos, não só
#                                 os que mudaram desde a última vez
#   big-wm-wprefs-sync --no-reload
#                                 grava sem avisar o wlmaker (início da sessão)
#   big-wm-wprefs-sync --reload   só pede ao wlmaker para recarregar
#   big-wm-wprefs-sync --open-menu SPEC | --open-plmenu SPEC
#                                 submenu gerado (GeneratePlistMenu) para um
#                                 OPEN_MENU / OPEN_PLMENU do menu do Window
#                                 Maker (diretórios WITH comando, arquivos de
#                                 menu, "| comando" e "|| comando")
#
# Lê (domínios WINGs, global /etc/WindowMaker + usuário ~/GNUstep/Defaults):
#   WindowMaker, WMGLOBAL, WMRootMenu, WMState e as linhas "xset" que o
#   WPrefs grava em ~/GNUstep/Library/WindowMaker/autostart.
# Grava em ~/.config/wlmaker: Config.plist (atalhos, teclado, mouse, foco,
#   posicionamento, cantos ativos), Theme.plist (cores, texturas, fontes,
#   alinhamento do título), RootMenu.plist (menu raiz) e State.plist (nomes
#   das áreas de trabalho); e o papel de parede (big-wm-wallpaper).
#
# Mesclagem: cada valor convertido é um "item" (arquivo + caminho no plist).
# O estado da última sincronização fica em ~/.config/wlmaker/.wprefs-sync.json.
# Um item só é gravado quando o valor vindo do Window Maker MUDOU desde a
# última sincronização; as outras chaves do wlmaker (e edições feitas à mão
# em itens que o Window Maker não mudou) ficam como estão, com os
# comentários. Na primeira vez, a referência é a configuração padrão do Big
# WindowMaker: só o que o usuário mudou na sessão X11 é levado (os atalhos de
# teclado vão todos). Um item que volta ao padrão recebe o valor do arquivo
# padrão do wlmaker (/usr/share/big-wm/wlmaker), não a conversão.
# Detalhes e a tabela de equivalências: docs/wayland-parity.md.

import ctypes
import ctypes.util
import datetime
import fcntl
import hashlib
import json
import math
import os
import re
import select
import shlex
import shutil
import signal
import struct
import subprocess
import sys
import tempfile
import time

PROG = "big-wm-wprefs-sync"
STATE_VERSION = 1


def log(msg):
    print(f"{PROG}: {msg}", file=sys.stderr)


# == Property lists ==========================================================
#
# Um único analisador para os dois dialetos do formato OpenStep:
#  - WINGs (Window Maker): comentários /* */ e //, escapes \n \t \ooo etc.,
#    <data> em hexadecimal;
#  - libbase (wlmaker): comentários //, "\x" vale o próprio x, vírgula final
#    em arrays, ";" opcional após o último par de um dicionário.
# Os nós guardam a posição no texto, para editar um arquivo do wlmaker sem
# perder comentários nem a formatação do resto.


class PlistError(Exception):
    pass


class Node:
    __slots__ = ("kind", "value", "start", "end", "entries", "items")

    def __init__(self, kind, start, end=None, value=None):
        self.kind = kind          # "str", "data", "array", "dict"
        self.value = value        # str ou bytes
        self.start = start
        self.end = end
        self.entries = []         # dict: lista de Entry
        self.items = []           # array: lista de Node


class Entry:
    __slots__ = ("key", "value", "start", "end")

    def __init__(self, key, value, start, end):
        self.key, self.value, self.start, self.end = key, value, start, end


_WINGS_ESC = {"a": "\a", "b": "\b", "t": "\t", "n": "\n", "v": "\v",
              "f": "\f", "r": "\r", "e": "\x1b"}


class _Parser:
    def __init__(self, text, dialect):
        self.t, self.i, self.dialect = text, 0, dialect

    def error(self, msg):
        line = self.t.count("\n", 0, self.i) + 1
        raise PlistError(f"linha {line}: {msg}")

    def skip(self):
        t = self.t
        while self.i < len(t):
            c = t[self.i]
            if c.isspace():
                self.i += 1
            elif t.startswith("//", self.i):
                j = t.find("\n", self.i)
                self.i = len(t) if j < 0 else j + 1
            elif t.startswith("/*", self.i):
                j = t.find("*/", self.i + 2)
                if j < 0:
                    self.error("comentário /* sem fim")
                self.i = j + 2
            else:
                break

    def peek(self):
        self.skip()
        return self.t[self.i] if self.i < len(self.t) else ""

    def expect(self, c):
        if self.peek() != c:
            self.error(f"esperado {c!r}, encontrado {self.peek() or 'fim'!r}")
        self.i += 1

    def value(self):
        c = self.peek()
        start = self.i
        if c == "{":
            return self.dict()
        if c == "(":
            return self.array()
        if c == '"':
            return Node("str", start, *self.quoted())
        if c == "<":
            j = self.t.find(">", self.i)
            if j < 0:
                self.error("<data> sem fim")
            hexa = re.sub(r"\s", "", self.t[self.i + 1:j])
            try:
                data = bytes.fromhex(hexa)
            except ValueError:
                self.error("<data> inválido")
            self.i = j + 1
            return Node("data", start, self.i, data)
        m = re.compile(r'[^\s{}()=;,"<>]+').match(self.t, self.i)
        if not m:
            self.error(f"valor inválido {c or 'fim'!r}")
        self.i = m.end()
        return Node("str", start, self.i, m.group())

    def quoted(self):
        t, i, out = self.t, self.i + 1, []
        while True:
            if i >= len(t):
                self.error("string sem aspas de fechamento")
            c = t[i]
            if c == '"':
                self.i = i + 1
                return self.i, "".join(out)
            if c == "\\" and i + 1 < len(t):
                n = t[i + 1]
                if self.dialect == "wings":
                    if n in "01234567":
                        m = re.compile(r"[0-7]{1,3}").match(t, i + 1)
                        out.append(chr(int(m.group(), 8)))
                        i = m.end()
                        continue
                    out.append(_WINGS_ESC.get(n, n))
                else:
                    out.append(n)
                i += 2
                continue
            out.append(c)
            i += 1

    def dict(self):
        node = Node("dict", self.i)
        self.i += 1
        while self.peek() != "}":
            if not self.peek():
                self.error("dicionário sem }")
            key = self.value()
            if key.kind != "str":
                self.error("chave de dicionário inválida")
            self.expect("=")
            val = self.value()
            end = val.end
            if self.peek() == ";":
                self.i += 1
                end = self.i
            elif self.peek() != "}":
                self.error(f"esperado ';' após {key.value!r}")
            node.entries.append(Entry(key, val, key.start, end))
        self.i += 1
        node.end = self.i
        return node

    def array(self):
        node = Node("array", self.i)
        self.i += 1
        while self.peek() != ")":
            if not self.peek():
                self.error("array sem )")
            node.items.append(self.value())
            if self.peek() == ",":
                self.i += 1
            elif self.peek() != ")":
                self.error("esperado ',' ou ')'")
        self.i += 1
        node.end = self.i
        return node

    def document(self):
        if not self.peek():
            return None
        node = self.value()
        if self.peek():
            self.error("conteúdo depois do fim do documento")
        return node


def parse_node(text, dialect="wings"):
    return _Parser(text, dialect).document()


def to_py(node):
    """Nó -> str, bytes, list ou dict (a última chave repetida vence)."""
    if node is None:
        return None
    if node.kind in ("str", "data"):
        return node.value
    if node.kind == "array":
        return [to_py(n) for n in node.items]
    return {e.key.value: to_py(e.value) for e in node.entries}


def loads(text, dialect="wings"):
    return to_py(parse_node(text, dialect))


def load_file(path, dialect="wings"):
    try:
        with open(path, encoding="utf-8", errors="surrogateescape") as f:
            return loads(f.read(), dialect)
    except FileNotFoundError:
        return None
    except (OSError, PlistError) as e:
        log(f"{path}: {e}")
        return None


_BARE = re.compile(r"[A-Za-z0-9_.$]+")


def quote(s):
    """String no dialeto do wlmaker (libbase): sem aspas só [A-Za-z0-9_.$]."""
    if _BARE.fullmatch(s):
        return s
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


def dumps(v, indent=0, step=2):
    """Valor Python -> texto do wlmaker. Dicionários uma chave por linha."""
    pad, inner = " " * indent, " " * (indent + step)
    if isinstance(v, str):
        return quote(v)
    if isinstance(v, (bytes, bytearray)):
        raise PlistError("o wlmaker não aceita <data>")
    if isinstance(v, dict):
        if not v:
            return "{}"
        body = "".join(f"{inner}{quote(k)} = {dumps(x, indent + step, step)};\n"
                       for k, x in v.items())
        return "{\n" + body + pad + "}"
    if isinstance(v, (list, tuple)):
        if all(isinstance(x, str) for x in v):
            one = "(" + ", ".join(quote(x) for x in v) + ")"
            if len(one) + indent < 100:
                return one
        body = ",\n".join(inner + dumps(x, indent + step, step) for x in v)
        return "(\n" + body + "\n" + pad + ")"
    raise PlistError(f"tipo sem representação: {type(v).__name__}")


def check_wlmaker(text):
    """Confere o texto com as regras do analisador do wlmaker (libbase)."""
    if re.search(r"/\*", _strip_strings(text)):
        raise PlistError("o wlmaker não aceita comentários /* */")
    root = parse_node(text, "wlmaker")

    def walk(n):
        if n.kind == "data":
            raise PlistError("o wlmaker não aceita <data>")
        if n.kind == "str" and text[n.start] != '"' and not _BARE.fullmatch(n.value):
            raise PlistError(f"{n.value!r} precisa de aspas no wlmaker")
        for e in n.entries:
            walk(e.key)
            walk(e.value)
        for x in n.items:
            walk(x)
    if root is not None:
        walk(root)
    return root


def _strip_strings(text):
    out = re.sub(r'"(?:[^"\\]|\\.)*"', '""', text, flags=re.S)
    return re.sub(r"//[^\n]*", "", out)


class PlistDoc:
    """Arquivo do wlmaker editado no lugar: só o trecho do valor muda."""

    def __init__(self, text):
        self.text = text
        self.root = parse_node(text, "wlmaker") if text.strip() else None

    def _reparse(self):
        self.root = parse_node(self.text, "wlmaker")

    def node(self, path):
        n = self.root
        for k in path:
            if n is None or n.kind != "dict":
                return None
            n = next((e.value for e in reversed(n.entries) if e.key.value == k), None)
        return n

    def get(self, path):
        return to_py(self.node(path))

    def _entry(self, parent, key):
        return next((e for e in reversed(parent.entries) if e.key.value == key), None)

    def _line_indent(self, pos):
        line_start = self.text.rfind("\n", 0, pos) + 1
        m = re.match(r"[ \t]*", self.text[line_start:])
        return m.group()

    def set(self, path, value):
        if self.root is None:
            self.text = dumps({}) + "\n"
            self._reparse()
        parent = self.root
        for i, k in enumerate(path[:-1]):
            n = self.node(path[:i + 1])
            if n is None or n.kind != "dict":
                rest = value
                for kk in reversed(path[i + 1:]):
                    rest = {kk: rest}
                return self.set(path[:i + 1], rest)
            parent = n
        if parent.kind != "dict":
            raise PlistError("a raiz do arquivo não é um dicionário")
        key = path[-1]
        entry = self._entry(parent, key)
        if entry is not None:
            indent = len(self._line_indent(entry.start))
            new = dumps(value, indent)
            self.text = self.text[:entry.value.start] + new + self.text[entry.value.end:]
        else:
            if parent.entries:
                last = parent.entries[-1]
                ind = self._line_indent(last.start)
                semi = "" if self.text[last.end - 1] == ";" else ";"
                at = last.end
                new = f"{semi}\n{ind}{quote(key)} = {dumps(value, len(ind))};"
            else:
                ind = self._line_indent(parent.start) + "  "
                at = parent.start + 1
                closing = self._line_indent(parent.end - 1)
                new = f"\n{ind}{quote(key)} = {dumps(value, len(ind))};\n{closing}"
                if self.text[at:parent.end - 1].strip() == "":
                    self.text = self.text[:at] + self.text[parent.end - 1:]
            self.text = self.text[:at] + new + self.text[at:]
        self._reparse()

    def delete(self, path):
        parent = self.node(path[:-1]) if len(path) > 1 else self.root
        if parent is None or parent.kind != "dict":
            return False
        entry = self._entry(parent, path[-1])
        if entry is None:
            return False
        start, end = entry.start, entry.end
        line_start = self.text.rfind("\n", 0, start) + 1
        if self.text[line_start:start].strip() == "":
            start = line_start
            # O comentário no fim da linha é da entrada.
            m = re.compile(r"[ \t]*(//[^\n]*)?\n").match(self.text, end)
            if m:
                end = m.end()
        self.text = self.text[:start] + self.text[end:]
        self._reparse()
        return True


# == Cores, texturas e fontes do Window Maker ================================

_COLOR_NAMES = {
