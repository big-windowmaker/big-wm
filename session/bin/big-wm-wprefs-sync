# Ações do wlmaker 0.8/0.9 (src/action.c). As outras só existem no wlmaker
# do Big WindowMaker (patches em big-windowmaker/packages): uma ação
# desconhecida no KeyBindings impede o wlmaker de iniciar, por isso só são
# usadas quando aparecem no binário instalado.
STOCK_ACTIONS = {
    "None", "Quit", "LockScreen", "InhibitLockBegin", "InhibitLockEnd",
    "LaunchTerminal", "ShellExecute", "Execute", "WorkspacePrevious",
    "WorkspaceNext", "WorkspaceAdd", "WorkspaceDestroyLast", "TaskPrevious",
    "TaskNext", "WindowRaise", "WindowLower", "WindowToggleFullscreen",
    "WindowToggleMaximized", "WindowMaximize", "WindowUnmaximize",
    "WindowFullscreen", "WindowShade", "WindowUnshade", "WindowMinimize",
    "WindowClose", "WindowToNextWorkspace", "WindowToPreviousWorkspace",
    "RootMenu", "ThemeLoadFromFile", "OutputMagnify", "OutputReduce",
    "OutputSaveState",
}
# Recursos procurados no binário do wlmaker: nome -> texto que só existe
# com o patch correspondente.
CAPABILITIES = {
    "WorkspaceSwitchTo": b"WorkspaceSwitchTo",
    "WindowToWorkspace": b"WindowToWorkspace",
    "WindowToggleShaded": b"WindowToggleShaded",
    "ReloadConfiguration": b"ReloadConfiguration",
    "corner-commands": b"Hot corner action with argument",
}


class Wlmaker:
    _caps = None

    @classmethod
    def caps(cls):
        if cls._caps is None:
            exe = os.environ.get("BIGWM_WLMAKER") or shutil.which("wlmaker") or "/usr/bin/wlmaker"
            try:
                with open(exe, "rb") as f:
                    data = f.read()
            except OSError:
                data = b""
            cls._caps = {k for k, v in CAPABILITIES.items() if v in data}
        return cls._caps

    @classmethod
    def has_action(cls, action):
        name = action[0] if isinstance(action, list) else action
        return name in STOCK_ACTIONS or name in cls.caps()


# == Comandos e menus =======================================================

def wayland_command(cmd):
    """Comando de um item do Window Maker -> (ação, argumento) do wlmaker.

    Programas que só fazem sentido no X11 viram o equivalente Wayland.
    None quando o comando não pode rodar no Wayland (pede dados com %a/%A,
    usa o id de janela com %w/%W).
    """
    c = cmd.strip()
    if re.search(r"%[aAwW]", c):
        return None
    word = shlex.split(c)[0] if c else ""
    base = os.path.basename(word)
    if c == "big-wm-lock" or base in ("xlock", "xscreensaver-command") and "-lock" in c:
        return ("LockScreen", None)
    if base == "arandr":
        return ("ShellExecute", "wdisplays")
    if base == "xkill":
        return ("ShellExecute", "big-wm-kill")
    if base == "wmagnify":
        return ("OutputMagnify", None)
    return ("ShellExecute", c)


_ACTION_LABELS = {
    "pt": {"new": "Nova", "destroy": "Remover a última", "prev": "Anterior",
           "next": "Próxima", "reload": "Recarregar a configuração"},
    "es": {"new": "Nueva", "destroy": "Eliminar la última", "prev": "Anterior",
           "next": "Siguiente", "reload": "Recargar la configuración"},
    "en": {"new": "New", "destroy": "Destroy last", "prev": "Previous",
           "next": "Next", "reload": "Reload configuration"},
}


def _labels():
    lang = (os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES")
            or os.environ.get("LANG") or "en")[:2]
    return _ACTION_LABELS.get(lang, _ACTION_LABELS["en"])


_SKIP_COMMANDS = {"HIDE_OTHERS", "SHOW_ALL", "ARRANGE_ICONS", "REFRESH",
                  "SAVE_SESSION", "CLEAR_SESSION", "INFO_PANEL", "LEGAL_PANEL",
                  "WINDOWS_MENU"}


class MenuConverter:
    """WMRootMenu (array do Window Maker) -> RootMenu.plist do wlmaker."""

    def __init__(self):
        self.shortcuts = {}      # combo canônico -> valor do KeyBindings
        self.dropped = []

    def item(self, entry):
        if not isinstance(entry, list) or not entry or not isinstance(entry[0], str):
            return None
        label, rest = entry[0], list(entry[1:])
        if rest and all(isinstance(x, list) for x in rest):
            sub = [label]
            for x in rest:
                y = self.item(x)
                if y is not None:
                    sub.append(y)
            return sub if len(sub) > 1 else None
        shortcut = None
        if len(rest) >= 2 and rest[0] == "SHORTCUT":
            shortcut, rest = rest[1], rest[2:]
        if not rest or not isinstance(rest[0], str):
            self.dropped.append(label)
            return None
        cmd, arg = rest[0], (rest[1] if len(rest) > 1 else None)
        out = self.command(label, cmd, arg)
        if out is None:
            self.dropped.append(label)
            return None
        if shortcut and len(out) >= 2 and isinstance(out[1], str) and out[1] not in (
                "GeneratePlistMenu",) and not isinstance(out[1], list):
            k = parse_wm_key(shortcut)
            if k:
                action = out[1] if len(out) == 2 else [out[1], out[2]]
                self.shortcuts[combo_string(*k)] = action
        return out

    def command(self, label, cmd, arg):
        if cmd in ("EXEC", "SHEXEC"):
            if not isinstance(arg, str) or not arg.strip():
                return None
            w = wayland_command(arg)
            if w is None:
                return None
            return [label, w[0]] + ([w[1]] if w[1] is not None else [])
        if cmd == "EXIT" or cmd == "SHUTDOWN":
            return [label, "Quit"]
        if cmd == "RESTART":
            if arg:
                return None
            return [label, "ShellExecute", PROG]
        if cmd == "WORKSPACE_MENU":
            lab = _labels()
            return [label, [lab["new"], "WorkspaceAdd"],
                    [lab["destroy"], "WorkspaceDestroyLast"],
                    [lab["prev"], "WorkspacePrevious"],
                    [lab["next"], "WorkspaceNext"]]
        if cmd == "OPEN_MENU" and isinstance(arg, str):
            return [label, "GeneratePlistMenu", f"{PROG} --open-menu {shlex.quote(arg)}"]
        if cmd == "OPEN_PLMENU" and isinstance(arg, str):
            m = re.fullmatch(r"\s*\|\|\s*big-wm-appmenu(\s.*)?", arg)
            if m:
                return [label, "GeneratePlistMenu",
                        ("big-wm-appmenu --wlmaker" + (m.group(1) or "")).rstrip()]
            return [label, "GeneratePlistMenu", f"{PROG} --open-plmenu {shlex.quote(arg)}"]
        if cmd in _SKIP_COMMANDS:
            return None
        return None

    def menu(self, wm_menu):
        if not isinstance(wm_menu, list) or not wm_menu or not isinstance(wm_menu[0], str):
            return None
        out = [wm_menu[0]]
        for x in wm_menu[1:]:
            y = self.item(x)
            if y is not None:
                out.append(y)
        return out if len(out) > 1 else None


# Menus no formato antigo (texto, com cpp): o suficiente para os arquivos
# comuns ("Título" MENU ... "Título" END, EXEC, SHEXEC, OPEN_MENU, ...).
def parse_old_menu(text, base_dir="."):
    def expand(t, depth=0):
        out = []
        for line in t.splitlines():
            m = re.match(r'\s*#\s*include\s*[<"]([^>"]+)[>"]', line)
            if m and depth < 5:
                for d in (base_dir, "/usr/share/WindowMaker", "/etc/WindowMaker"):
                    p = os.path.join(os.path.expanduser(d), m.group(1))
                    if os.path.isfile(p):
                        with open(p, encoding="utf-8", errors="replace") as f:
                            out.extend(expand(f.read(), depth + 1))
                        break
                continue
            if line.lstrip().startswith("#"):
                continue
            out.append(line)
        return out
    stack = [[None]]
    for line in expand(text):
        line = re.sub(r"\s*//.*$", "", line).strip()
        while line.endswith("\\"):
            line = line[:-1]
        if not line:
            continue
        try:
            toks = shlex.split(line)
        except ValueError:
            continue
        if len(toks) < 2:
            continue
        label, cmd, rest = toks[0], toks[1], toks[2:]
        shortcut = []
        if cmd == "SHORTCUT" and len(rest) >= 2:
            shortcut, cmd, rest = ["SHORTCUT", rest[0]], rest[1], rest[2:]
        if cmd == "MENU":
            stack.append([label])
        elif cmd == "END":
            if len(stack) > 1:
                done = stack.pop()
                if stack[-1][0] is None and len(stack) == 1:
                    stack[-1] = done
                else:
                    stack[-1].append(done)
        else:
            stack[-1].append([label] + shortcut + [cmd] + ([" ".join(rest)] if rest else []))
    root = stack[0]
    return root if root and root[0] is not None else None


def _menu_from_path(path):
    path = os.path.expanduser(path)
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            text = f.read()
    except OSError:
        return None
    try:
        v = loads(text)
        if isinstance(v, list):
            return v
    except PlistError:
        pass
    return parse_old_menu(text, os.path.dirname(path))


def open_menu(spec):
    """Submenu para OPEN_MENU: diretórios (-noext, WITH), arquivo ou '| cmd'."""
    s = spec.strip()
    conv = MenuConverter()
    if s.startswith("|"):
        cmd = s.lstrip("|").strip()
        out = _run_capture(cmd)
        menu = None
        if out is not None:
            try:
                menu = loads(out)
            except PlistError:
                menu = parse_old_menu(out)
        return conv.menu(menu) if isinstance(menu, list) else None
    noext = False
    with_cmd = None
    m = re.search(r"\s+WITH\s+(.*)$", s)
    if m:
        with_cmd, s = m.group(1).strip(), s[:m.start()]
    words = shlex.split(s)
    if words and words[0] == "-noext":
        noext, words = True, words[1:]
    paths = [os.path.expanduser(w) for w in words]
    if len(paths) == 1 and os.path.isfile(paths[0]) and with_cmd is None:
        menu = _menu_from_path(paths[0])
        return conv.menu(menu) if isinstance(menu, list) else None
    return directory_menu(paths, with_cmd, noext)


def directory_menu(dirs, with_cmd, noext):
    """Lista de diretórios como submenu: cada arquivo chama 'with_cmd arquivo'.

    Os comandos que mudam a configuração do Window Maker (setstyle,
    wmsetbg) passam a mudar a do wlmaker: setstyle grava o estilo e o
    big-wm-wprefs-sync (que vigia ~/GNUstep/Defaults) o converte; wmsetbg
    vira big-wm-wallpaper.
    """
    entries = {}
    for d in dirs:
        try:
            names = sorted(os.listdir(d), key=str.lower)
        except OSError:
            continue
        for n in names:
            if n.startswith("."):
                continue
            p = os.path.join(d, n)
            label = os.path.splitext(n)[0] if noext else n
            label = re.sub(r"\.(themed|style)$", "", label)
            entries.setdefault(label, p)
    items = []
    for label, p in entries.items():
        if with_cmd:
            base = with_cmd.split()[0]
            if os.path.basename(base) == "wmsetbg":
                cmd = f"big-wm-wallpaper {shlex.quote(p)}"
            elif os.path.basename(base) == "setstyle":
                cmd = f"{with_cmd} {shlex.quote(p)} && {PROG}"
            else:
                cmd = f"{with_cmd} {shlex.quote(p)}"
            items.append([label, "ShellExecute", cmd])
        elif os.path.isdir(p):
            items.append([label, "GeneratePlistMenu",
                          f"{PROG} --open-menu {shlex.quote(shlex.quote(p))}"])
        elif os.access(p, os.X_OK):
            items.append([label, "ShellExecute", shlex.quote(p)])
    return items


def _run_capture(cmd):
    try:
        r = subprocess.run(["/bin/sh", "-c", cmd], capture_output=True,
                           text=True, timeout=30, errors="replace")
        return r.stdout
    except (OSError, subprocess.SubprocessError):
        return None


def print_submenu(title, items):
    """Saída de um GeneratePlistMenu: sempre um array válido."""
    if not items:
        items = [["—"]]
    print(dumps([title] + items))


# == Leitura da configuração do Window Maker ================================

class Paths:
    def __init__(self, env=os.environ):
        home = env.get("HOME", os.path.expanduser("~"))
        self.home = home
        self.gnustep = env.get("WMAKER_USER_ROOT") or os.path.join(home, "GNUstep")
        self.defaults = os.path.join(self.gnustep, "Defaults")
        self.library = os.path.join(self.gnustep, "Library", "WindowMaker")
        self.global_dir = env.get("BIGWM_WM_GLOBAL", "/etc/WindowMaker")
        self.datadir = env.get("BIGWM_DATADIR", "/usr/share/big-wm")
        cfg = env.get("XDG_CONFIG_HOME") or os.path.join(home, ".config")
        self.config_home = cfg
        self.wlmaker = os.path.join(cfg, "wlmaker")
        self.state = os.path.join(self.wlmaker, ".wprefs-sync.json")
        self.wallpaper_state = os.path.join(cfg, "big-wm", "wallpaper")
        self.autostart = os.path.join(cfg, "autostart")
        self.wmstyles = env.get("BIGWM_WMSTYLES", "/usr/share/WindowMaker/Styles")
        self.theme_mode_file = os.path.join(cfg, "big-wm", "theme")
        self.lang = (env.get("LC_ALL") or env.get("LC_MESSAGES") or env.get("LANG") or "C").split(".")[0]

    def localized(self, base):
        lang = self.lang
        for cand in (f"{base}.{lang}", f"{base}.{lang.split('_')[0]}", base):
            if os.path.exists(cand):
                return cand
        return base

    def shipped_defaults(self, name):
        p = os.path.join(self.datadir, "GNUstep", "Defaults", name)
        return self.localized(p) if name == "WMRootMenu" else p

    def mode(self):
        """Modo claro ou escuro do big-wm-theme (~/.config/big-wm/theme)."""
        try:
            with open(self.theme_mode_file, encoding="utf-8") as f:
                return "dark" if f.read().strip() == "dark" else "light"
        except OSError:
            return "light"

    def mode_style(self):
        """Estilo do Window Maker do modo (o par do big-wm-theme)."""
        name = "BigWindowMaker-Dark.style" if self.mode() == "dark" else "BigWindowMaker.style"
        return os.path.join(self.wmstyles, name)

    def shipped_theme(self):
        """Tema padrão do wlmaker para o modo: Theme.plist ou Theme-Dark.plist."""
        light = os.path.join(self.datadir, "wlmaker", "Theme.plist")
        dark = os.path.join(self.datadir, "wlmaker", "Theme-Dark.plist")
        return dark if self.mode() == "dark" and os.path.exists(dark) else light

    def shipped_themes(self):
        names = ("Theme.plist", "Theme-Dark.plist")
        return {os.path.join(d, "wlmaker", n) for d in (self.datadir, "/usr/share/big-wm") for n in names}

    def shipped_wlmaker(self, name):
        if name == "Theme.plist":
            return self.shipped_theme()
        p = os.path.join(self.datadir, "wlmaker", name)
        return self.localized(p) if name == "RootMenu.plist" else p


def _dict(v):
    return v if isinstance(v, dict) else {}


class WMConfig:
    """Configuração efetiva do Window Maker: global + domínio do usuário."""

    def __init__(self, paths, user_dir=None, autostart=None):
        self.paths = paths
        user_dir = user_dir or paths.defaults
        g = paths.global_dir
        self.wm = {**_dict(load_file(os.path.join(g, "WindowMaker"))),
                   **_dict(load_file(os.path.join(user_dir, "WindowMaker")))}
        self.glob = {**_dict(load_file(os.path.join(g, "WMGLOBAL"))),
                     **_dict(load_file(os.path.join(user_dir, "WMGLOBAL")))}
        self.state = _dict(load_file(os.path.join(user_dir, "WMState")))
        menu = load_file(os.path.join(user_dir, "WMRootMenu"))
        if menu is None:
            menu = load_file(os.path.join(g, "WMRootMenu"))
        if isinstance(menu, str):
            menu = _menu_from_path(menu.replace("%s", paths.gnustep))
        self.menu = menu if isinstance(menu, list) else None
        self.autostart = autostart
        if autostart is None:
            try:
                with open(os.path.join(paths.library, "autostart"), encoding="utf-8",
                          errors="replace") as f:
                    self.autostart = f.read()
            except OSError:
                self.autostart = ""

    @classmethod
    def shipped(cls, paths):
        """Padrão do Big WindowMaker (o que o big-wm-firstrun copia)."""
        c = cls.__new__(cls)
        c.paths = paths
        g = paths.global_dir
        # No modo escuro (big-wm-theme dark) o padrão é o estilo escuro: a
        # troca de modo não conta como mudança feita no WPrefs.
        c.wm = {**_dict(load_file(os.path.join(g, "WindowMaker"))),
                **_dict(load_file(paths.shipped_defaults("WindowMaker"))),
                **_dict(load_file(paths.mode_style()))}
        c.glob = {**_dict(load_file(os.path.join(g, "WMGLOBAL"))),
                  **_dict(load_file(paths.shipped_defaults("WMGLOBAL")))}
        c.state = _dict(load_file(paths.shipped_defaults("WMState")))
        menu = load_file(paths.shipped_defaults("WMRootMenu"))
        c.menu = menu if isinstance(menu, list) else None
        c.autostart = ""
        return c

    def get(self, key, default=None):
        return self.wm.get(key, default)

    def bool(self, key, default=False):
        v = self.wm.get(key)
        if not isinstance(v, str):
            return default
        return v.strip().lower() in ("yes", "y", "true", "1")

    def resolve_pixmap(self, name):
        if not isinstance(name, str) or not name:
            return None
        p = os.path.expanduser(name)
        if os.path.isabs(p):
            return p
        for d in self.wm.get("PixmapPath") or []:
            if isinstance(d, str):
                cand = os.path.join(os.path.expanduser(d), p)
                if os.path.isfile(cand):
                    return cand
        return None


# == Conversão ==============================================================
#
# convert() devolve {item: valor}. Um item é uma tupla:
#   ("Theme", caminho...)          Theme.plist
#   ("Config", caminho...)         Config.plist
#   ("KeyBindings", combo)         Config.plist, KeyBindings (combo canônico)
#   ("RootMenu",)                  RootMenu.plist inteiro
#   ("State", "Workspaces")        State.plist, nomes das áreas de trabalho
#   ("Wallpaper",)                 [arquivo, modo] ou ["color", cor]
#   ("Autostart", nome)            "hidden" ou "shown"

THEME_FILLS = {
    ("Window", "TitleBar", "FocussedFill"): "FTitleBack",
    ("Window", "TitleBar", "BlurredFill"): "UTitleBack",
    ("Window", "ResizeBar", "Fill"): "ResizebarBack",
    ("Menu", "Item", "Fill"): "MenuTextBack",
    ("Tile", "Fill"): "IconBack",
}
THEME_COLORS = {
    ("Window", "TitleBar", "FocussedTextColor"): "FTitleColor",
    ("Window", "TitleBar", "BlurredTextColor"): "UTitleColor",
    ("Window", "Border", "Color"): "FrameBorderColor",
    ("Menu", "Item", "EnabledTextColor"): "MenuTextColor",
    ("Menu", "Item", "DisabledTextColor"): "MenuDisabledColor",
    ("Menu", "Item", "HighlightedTextColor"): "HighlightTextColor",
    ("Clip", "TextColor"): "ClipTitleColor",
}
THEME_FONTS = {
    ("Window", "TitleBar", "Font"): ("WindowTitleFont", 12),
    ("Menu", "Item", "Font"): ("MenuTextFont", 12),
    ("Clip", "Font"): ("ClipTitleFont", 10),
    ("TaskList", "Font"): ("LargeDisplayFont", 16),
}

_PIXMAP_MODES = {"spixmap": "fill", "fpixmap": "fill", "mpixmap": "fit",
                 "cpixmap": "center", "tpixmap": "tile"}


def _xset(autostart):
    """Últimas linhas 'xset r rate D R' e 'xset m N/D T' do autostart."""
    rate = accel = None
    for line in (autostart or "").splitlines():
        line = line.split("#", 1)[0]
        m = re.search(r"\bxset\s+r\s+rate\s+(\d+)\s+(\d+)", line)
        if m:
            rate = (int(m.group(1)), int(m.group(2)))
        m = re.search(r"\bxset\s+m\s+(\d+)(?:/(\d+))?", line)
        if m:
            d = int(m.group(2) or 1) or 1
            accel = int(m.group(1)) / d
    return rate, accel


def accel_to_speed(a):
    """Aceleração do X (xset m; o WPrefs grava de ~0,5 a 10, 2 é o padrão)
    -> velocidade do libinput (-1 a 1, 0 é o padrão), em escala logarítmica:
    2 -> 0, 10 -> 1, 0,4 -> -1."""
    if a <= 0:
        return -1.0
    s = math.log(a / 2) / math.log(5)
    return max(-1.0, min(1.0, s))


def convert(cfg):
    items = {}
    wm = cfg.wm

    # Aparência (texturas, cores e fontes do estilo).
    for path, key in THEME_FILLS.items():
        f = texture_fill(wm.get(key))
        if f:
            items[("Theme",) + path] = f
    for path, key in THEME_COLORS.items():
        c = color_value(wm.get(key))
        if c:
            items[("Theme",) + path] = c
    hl = color_value(wm.get("HighlightColor"))
    if hl:
        items[("Theme", "Menu", "Item", "HighlightedFill")] = {"Color": hl, "Type": "SOLID"}
    for path, (key, size) in THEME_FONTS.items():
        f = parse_font(wm.get(key), size)
        if f:
            items[("Theme",) + path] = f
    bw = wm.get("FrameBorderWidth")
    if isinstance(bw, str) and bw.isdigit():
        items[("Theme", "Window", "Border", "Width")] = bw
    just = str(wm.get("TitleJustify", "")).lower()
    if just in ("left", "center", "right"):
        items[("Theme", "Window", "TitleBar", "Justify")] = just.capitalize()
    style = str(wm.get("MenuStyle", "")).lower()
    if style in ("normal", "singletexture", "flat"):
        items[("Theme", "Menu", "Item", "BezelWidth")] = "0" if style == "flat" else "1"
    back = wm.get("WorkspaceBack")
    bg = texture_color(back)
    if bg:
        items[("Theme", "BackgroundColor")] = bg

    # Papel de parede (swaybg, pelo big-wm-wallpaper).
    if isinstance(back, list) and back and isinstance(back[0], str):
        kind = back[0].lower()
        if kind in _PIXMAP_MODES and len(back) >= 2:
            f = cfg.resolve_pixmap(back[1]) or os.path.expanduser(str(back[1]))
            items[("Wallpaper",)] = [f, _PIXMAP_MODES[kind]]
        elif bg:
            items[("Wallpaper",)] = ["color", "#" + bg[-6:]]
    elif isinstance(back, str) and bg:
        items[("Wallpaper",)] = ["color", "#" + bg[-6:]]

    # Atalhos de teclado: ações do Window Maker e SHORTCUT do menu raiz.
    keys = {}
    menu_conv = MenuConverter()
    root_menu = menu_conv.menu(cfg.menu) if cfg.menu else None
    for combo, action in menu_conv.shortcuts.items():
        keys.setdefault(combo.lower(), (combo, action))
    for wm_key in sorted(WM_KEY_ACTIONS):
        k = parse_wm_key(wm.get(wm_key))
        if k:
            combo = combo_string(*k)
            keys.setdefault(combo.lower(), (combo, WM_KEY_ACTIONS[wm_key]))
    for canon, (combo, action) in keys.items():
        if Wlmaker.has_action(action):
            items[("KeyBindings", canon)] = [combo, action]

    if root_menu:
        items[("RootMenu",)] = root_menu

    # Mouse: tecla para mover janelas e velocidade (xset m do WPrefs).
    mod = _MODS.get(str(wm.get("ModifierKey", "")).lower())
    if mod:
        items[("Config", "Cursor", "MoveWindowModifier")] = mod
    rate, accel = _xset(cfg.autostart)
    if rate:
        items[("Config", "Keyboard", "Repeat", "Delay")] = str(rate[0])
        items[("Config", "Keyboard", "Repeat", "Rate")] = str(rate[1])
    if accel is not None:
        items[("Config", "Mouse", "AccelSpeed")] = "%.2f" % accel_to_speed(accel)
        items[("Config", "Mouse", "AccelProfile")] = "Flat" if accel <= 1 else "Adaptive"
    dct = wm.get("DoubleClickTime") or cfg.glob.get("DoubleClickTime")
    if isinstance(dct, str) and dct.isdigit():
        items[("Config", "Mouse", "DoubleClickTime")] = dct

    # Foco e posicionamento das janelas.
    focus = str(wm.get("FocusMode", "")).lower()
    if focus:
        items[("Config", "FocusMode")] = "Click" if focus in (
            "manual", "clicktofocus", "click") else "Sloppy"
    place = str(wm.get("WindowPlacement", "")).lower()
    if place:
        items[("Config", "WindowPlacement")] = "Center" if place == "center" else "Smart"

    # Cantos ativos: comandos do Window Maker (topo esq., topo dir., base
    # esq., base dir.) nos "Enter" do wlmaker.
    # O grupo vai inteiro: o canto vazio no WPrefs fica sem ação também no
    # wlmaker (e sem as ações "Leave", que o Window Maker não tem).
    corners = ("TopLeft", "TopRight", "BottomLeft", "BottomRight")
    acts = wm.get("HotCornerActions")
    enabled = cfg.bool("HotCorners")
    delay = wm.get("HotCornerDelay")
    hot = {"TriggerDelay": delay if isinstance(delay, str) and delay.isdigit() else "250"}
    for i, name in enumerate(corners):
        cmd = acts[i] if isinstance(acts, list) and i < len(acts) and isinstance(acts[i], str) else "None"
        value = "None"
        if enabled and cmd.strip() and cmd.strip().lower() != "none":
            w = wayland_command(cmd)
            if w and w[1] is None:
                value = w[0]
            elif w and "corner-commands" in Wlmaker.caps():
                value = [w[0], w[1]]
        hot[name + "Enter"] = value
        hot[name + "Leave"] = "None"
    items[("Config", "HotCorner")] = hot

    # Dock e Clip (painel Dock/Clip do WPrefs): o Dock é o wlmdock, os
    # lançadores do Clip o wlmdock --clip, iniciados pelo XDG autostart.
    items[("Autostart", "big-wm-wayland-dock")] = "hidden" if cfg.bool("DisableDock") else "shown"
    items[("Autostart", "big-wm-wayland-clip")] = "hidden" if cfg.bool("DisableClip") else "shown"

    # Nomes das áreas de trabalho (WMState, gravado pelo Window Maker).
    ws = cfg.state.get("Workspaces")
    if isinstance(ws, list):
        names = [w.get("Name") for w in ws if isinstance(w, dict) and isinstance(w.get("Name"), str)]
        if names:
            items[("State", "Workspaces")] = [n[:31] for n in names]
    return items


# == Aplicação ==============================================================

def item_id(k):
    return json.dumps(list(k), ensure_ascii=False)


def item_key(s):
    return tuple(json.loads(s))


def _canon(v):
    return json.loads(json.dumps(v))


def _atomic_write(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".wprefs-sync-", dir=os.path.dirname(path))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        try:
            os.chmod(tmp, os.stat(path).st_mode & 0o7777)
        except OSError:
            os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


THEME_MARKER = "Gerado pelo big-wm-wprefs-sync"
THEME_HEADER = ("// Tema do wlmaker. Gerado pelo big-wm-wprefs-sync a partir do tema padrão\n"
                "// do modo (claro/escuro) e da aparência escolhida no Window Maker (WPrefs,\n"
                "// estilos). É refeito quando a aparência muda; uma versão editada à mão\n"
                "// vai antes para Theme.plist.bak-<data>. Para um tema só seu, use outro\n"
                "// arquivo no ThemeFile do Config.plist.\n")


def _sha(text):
    return hashlib.sha256(text.encode("utf-8", "surrogateescape")).hexdigest()


def _read(path):
    try:
        with open(path, encoding="utf-8", errors="surrogateescape") as f:
            return f.read()
    except OSError:
        return None


class Syncer:
    def __init__(self, paths, dry_run=False, full=False, out=sys.stderr):
        self.p = paths
        self.dry_run = dry_run
        self.full = full
        self.out = out
        self.docs = {}
        self.changed = set()
        self.messages = []
        self.pending_files = {}

    # -- arquivos do wlmaker ------------------------------------------------
    def _file(self, name):
        return os.path.join(self.p.wlmaker, name)

    def doc(self, name):
        if name not in self.docs:
            text = _read(self._file(name))
            if text is None:
                text = "{\n}\n"
            self.docs[name] = PlistDoc(text)
        return self.docs[name]

    def shipped_value(self, k):
        """Valor do item no arquivo padrão do wlmaker (para restaurar)."""
        if k[0] == "Theme":
            v = load_file(self.p.shipped_wlmaker("Theme.plist"), "wlmaker")
            path = k[1:]
        elif k[0] == "Config":
            v = load_file(self.p.shipped_wlmaker("Config.plist.in"), "wlmaker")
            path = k[1:]
        elif k[0] == "KeyBindings":
            v = _dict(load_file(self.p.shipped_wlmaker("Config.plist.in"), "wlmaker")).get("KeyBindings")
            kb = _dict(v)
            for key, val in kb.items():
                if canonical_combo(key) == k[1]:
                    return [key, val]
            return None
        else:
            return None
        for part in path:
            v = _dict(v).get(part) if isinstance(v, dict) else None
        return v

    def _keybinding_entry(self, canon):
        kb = self.doc("Config.plist").get(("KeyBindings",))
        for key in _dict(kb):
            if canonical_combo(key) == canon:
                return key, kb[key]
        return None, None

    def apply(self, k, value, last, shipped, restore=False):
        kind = k[0]
        if kind in ("Theme", "Config"):
            name = "Theme.plist" if kind == "Theme" else "Config.plist"
            doc = self.doc(name)
            path = k[1:]
            if value is None:
                cur = doc.get(path)
                if cur is not None and _canon(cur) in (_canon(last), _canon(shipped)):
                    doc.delete(path)
                    self.changed.add(name)
                return
            if doc.get(path) != value:
                doc.set(path, value)
                self.changed.add(name)
        elif kind == "KeyBindings":
            doc = self.doc("Config.plist")
            key, cur = self._keybinding_entry(k[1])
            if value is None:
                if key is not None and last is not None and _canon(cur) in (
                        _canon(last[1]), _canon((shipped or [None, None])[1])):
                    doc.delete(("KeyBindings", key))
                    self.changed.add("Config.plist")
                return
            combo, action = value
            if key is not None and _canon(cur) == _canon(action):
                return
            if key is not None and cur is not None and _canon(cur) != _canon((last or [None, None])[1]):
                self.messages.append(f"atalho {key}: {cur!r} trocado por {action!r} (WPrefs)")
            doc.set(("KeyBindings", key or combo), action)
            self.changed.add("Config.plist")
        elif kind == "RootMenu":
            self.write_menu(value, restore)
        elif kind == "State":
            doc = self.doc("State.plist")
            if value is None:
                return
            new = [{"Name": n} for n in value]
            if _canon(doc.get(("Workspaces",))) != _canon(new):
                doc.set(("Workspaces",), new)
                self.changed.add("State.plist")
        elif kind == "Wallpaper":
            self.set_wallpaper(value, restore)
        elif kind == "Autostart":
            self.set_autostart(k[1], value)

    def write_menu(self, menu, restore):
        path = self._file("RootMenu.plist")
        cur = _read(path)
        shipped = _read(self.p.shipped_wlmaker("RootMenu.plist"))
        if restore and shipped is not None:
            text = shipped
        elif menu is None:
            return
        else:
            text = ("// Menu raiz convertido do menu do Window Maker (WMRootMenu) pelo\n"
                    "// big-wm-wprefs-sync. Mudanças feitas no editor de menu do WPrefs\n"
                    "// substituem este arquivo; a versão anterior fica em *.bak-<data>.\n"
                    + dumps(menu) + "\n")
        if cur == text:
            return
        self.pending_files[path] = text
        self.changed.add("RootMenu.plist")

    def set_wallpaper(self, value, restore):
        state = self.p.wallpaper_state
        if restore or value is None:
            text = None
        elif value[0] == "color":
            text = f"color:{value[1]}\n"
        else:
            text = value[0] + ("\n" if value[1] == "fill" else f"\n{value[1]}\n")
        cur = _read(state)
        if cur == text:
            return
        self.pending_files[state] = text
        self.changed.add("wallpaper")

    def set_autostart(self, name, value):
        path = os.path.join(self.p.autostart, f"{name}.desktop")
        cur = _read(path)
        ours = cur is not None and "X-Big-WM-WPrefs-Sync=true" in cur
        if cur is not None and not ours:
            return  # arquivo do usuário ou do Big Tabbed Dock: não mexe
        if value == "hidden":
            text = ("[Desktop Entry]\nType=Application\n"
                    f"Name={name}\nHidden=true\nX-Big-WM-WPrefs-Sync=true\n")
            if cur == text:
                return
        else:
            if cur is None:
                return
            text = None
        self.pending_files[path] = text
        self.changed.add(f"autostart:{name}:{value}")

    # -- sincronização ------------------------------------------------------
    def load_state(self):
        try:
            with open(self.p.state, encoding="utf-8") as f:
                s = json.load(f)
            if s.get("version") == STATE_VERSION:
                return s
        except (OSError, ValueError):
            pass
        return None

    def run(self):
        if not os.path.exists(self._file("Config.plist")):
            # A sessão Wayland ainda não foi usada: o big-wm-firstrun cria a
            # configuração no primeiro login e a sincronização vem logo depois.
            return set()
        # Uma sincronização por vez (o vigia e um setstyle && sync do menu).
        with open(self.p.state + ".lock", "w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            return self._run()

    def _run(self):
        desired = convert(WMConfig(self.p))
        base = convert(WMConfig.shipped(self.p))
        state = self.load_state()
        if state is None or self.full:
            # Primeira vez: a referência é o padrão do Big WindowMaker. Os
            # atalhos de teclado vão todos (no Wayland faltavam vários).
            last = {k: v for k, v in base.items() if k[0] != "KeyBindings"}
            if self.full:
                last = {}
        else:
            last = {item_key(k): v for k, v in state.get("items", {}).items()}
        desired_c = {k: _canon(v) for k, v in desired.items()}
        base_c = {k: _canon(v) for k, v in base.items()}
        # O tema é tratado à parte (sync_theme): gerado do tema padrão do
        # modo (claro/escuro) com o que difere do estilo padrão.
        theme_desired = {k: v for k, v in desired_c.items() if k[0] == "Theme"}
        theme_base = {k: v for k, v in base_c.items() if k[0] == "Theme"}
        last = {k: v for k, v in last.items() if k[0] != "Theme"}

        todo = []
        for k in (set(desired_c) | set(last)) - set(theme_desired):
            d, l = desired_c.get(k), last.get(k)
            if d == l and not self.full:
                continue
            restore = d is not None and d == base_c.get(k)
            todo.append((k, d, l, restore))
        # Remoções primeiro (um atalho que mudou de tecla não pode apagar
        # a tecla nova de outra ação).
        todo.sort(key=lambda t: (t[1] is not None, t[0]))
        for k, d, l, restore in todo:
            target = d
            shipped = self.shipped_value(k) if restore or d is None else None
            if shipped is not None and k[0] in ("Theme", "Config", "KeyBindings"):
                # De volta ao padrão: o valor do arquivo padrão do wlmaker.
                # Um valor que deixou de existir no Window Maker também volta
                # ao padrão (as chaves do Theme.plist são obrigatórias), menos
                # um atalho apagado, que sai do KeyBindings.
                if restore or k[0] != "KeyBindings":
                    target = shipped
            if self.dry_run:
                print(f"{item_id(k)}: {json.dumps(l, ensure_ascii=False)} -> "
                      f"{json.dumps(target, ensure_ascii=False)}", file=self.out)
                continue
            self.apply(k, target, l, shipped, restore)
        self.theme_state = self.sync_theme(theme_desired, theme_base, (state or {}).get("theme") or {})
        if self.dry_run:
            return set()
        self.commit(desired_c)
        for m in self.messages:
            log(m)
        return self.changed

    def sync_theme(self, desired, base, prev):
        """Tema do wlmaker a partir do estilo do Window Maker.

        Sem diferença para o estilo padrão do modo (claro ou escuro, do
        big-wm-theme), vale o tema padrão do modo pelo ThemeFile
        (/usr/share/big-wm/wlmaker/Theme.plist ou Theme-Dark.plist). Com
        diferenças, ~/.config/wlmaker/Theme.plist é gerado do tema padrão do
        modo com elas por cima, e o ThemeFile aponta para ele. Um
        Theme.plist ou um ThemeFile do próprio usuário não é tocado.
        """
        user = self._file("Theme.plist")
        cfg = self.doc("Config.plist")
        tf = cfg.get(("ThemeFile",))
        shipped = self.p.shipped_themes()
        mode_theme = self.p.shipped_theme()
        cur = _read(user)
        ours = cur is not None and THEME_MARKER in cur[:300]
        if (cur is not None and not ours) or (tf is not None and tf not in shipped and tf != user):
            if desired != base:
                self.messages.append("tema próprio do wlmaker (ThemeFile ou ~/.config/wlmaker/Theme.plist): "
                                     "a aparência do Window Maker não é levada")
            return prev
        overlay = {k: v for k, v in sorted(desired.items()) if v != base.get(k)}
        new = {"base": mode_theme, "overlay": {item_id(k): v for k, v in overlay.items()}, "sha256": None}

        def set_theme_file(path):
            # O mesmo tema padrão por outro caminho (BIGWM_DATADIR) já serve.
            if tf in shipped and path in shipped and os.path.basename(tf) == os.path.basename(path):
                return
            if tf != path:
                if self.dry_run:
                    print(f'["Config", "ThemeFile"]: {json.dumps(tf)} -> {json.dumps(path)}', file=self.out)
                    return
                cfg.set(("ThemeFile",), path)
                self.changed.add("Config.plist")

        if not overlay:
            if ours:
                if self.dry_run:
                    print(f"{user}: removido (tema padrão do modo)", file=self.out)
                else:
                    self.pending_files[user] = None
                    self.changed.add("Theme.plist")
            set_theme_file(mode_theme)
            return new
        if ours and prev.get("base") == mode_theme and prev.get("overlay") == new["overlay"] \
                and not self.full:
            new["sha256"] = prev.get("sha256")
        else:
            base_text = _read(mode_theme)
            if base_text is None:
                self.messages.append(f"{mode_theme} não existe: tema não gerado")
                return prev
            doc = PlistDoc(THEME_HEADER + re.sub(r"\A(\s*//[^\n]*\n)*", "", base_text))
            for k, v in overlay.items():
                doc.set(k[1:], v)
            if self.dry_run:
                for k, v in overlay.items():
                    print(f"{item_id(k)}: {json.dumps(base.get(k))} -> {json.dumps(v)}", file=self.out)
            else:
                if ours and _sha(cur) != prev.get("sha256"):
                    stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
                    shutil.copy2(user, f"{user}.bak-{stamp}")
                    log(f"tema do wlmaker editado à mão guardado em {user}.bak-{stamp}")
                self.pending_files[user] = doc.text
                self.changed.add("Theme.plist")
            new["sha256"] = _sha(doc.text)
        set_theme_file(user)
        return new

    def commit(self, desired_c):
        for name, doc in self.docs.items():
            if name not in self.changed:
                continue
            try:
                check_wlmaker(doc.text)
            except PlistError as e:
                log(f"{name}: resultado inválido, nada gravado ({e})")
                self.changed.discard(name)
                continue
            _atomic_write(self._file(name), doc.text)
        for path, text in self.pending_files.items():
            if text is None:
                try:
                    os.unlink(path)
                except FileNotFoundError:
                    pass
                continue
            if path.endswith(".plist"):
                try:
                    check_wlmaker(text)
                except PlistError as e:
                    log(f"{os.path.basename(path)}: resultado inválido, nada gravado ({e})")
                    self.changed.discard(os.path.basename(path))
                    continue
            if path.endswith("RootMenu.plist"):
                try:
                    check_wlmaker(text)
                except PlistError as e:
                    log(f"RootMenu.plist: resultado inválido, nada gravado ({e})")
                    continue
                cur = _read(path)
                st = self.load_state() or {}
                if cur is not None and hashlib.sha256(cur.encode("utf-8", "surrogateescape")).hexdigest() \
                        != st.get("menu_sha256"):
                    stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
                    shutil.copy2(path, f"{path}.bak-{stamp}")
                    log(f"menu do wlmaker editado à mão guardado em {path}.bak-{stamp}")
            _atomic_write(path, text)
        menu = _read(self._file("RootMenu.plist"))
        state = {
            "version": STATE_VERSION,
            "items": {item_id(k): v for k, v in sorted(desired_c.items())},
            "menu_sha256": _sha(menu) if menu else None,
            "theme": self.theme_state,
        }
        os.makedirs(self.p.wlmaker, exist_ok=True)
        _atomic_write(self.p.state, json.dumps(state, ensure_ascii=False, indent=1) + "\n")


# == Sessão: recarregar o wlmaker, papel de parede, Dock =====================

def wlmaker_pids():
    uid = os.getuid()
    pids = []
    for d in os.listdir("/proc"):
        if not d.isdigit():
            continue
        try:
            if os.stat(f"/proc/{d}").st_uid != uid:
                continue
            with open(f"/proc/{d}/comm") as f:
                if f.read().strip() == "wlmaker":
                    pids.append(int(d))
        except OSError:
            continue
    return pids


def wlmaker_can_reload(pid):
    """O wlmaker do Big WindowMaker recarrega com SIGHUP (ação
    ReloadConfiguration); o de outras versões terminaria com o sinal. Lê o
    binário que está rodando (/proc/PID/exe), não o instalado: depois de uma
    atualização do pacote, o da sessão aberta ainda é o antigo."""
    try:
        with open(f"/proc/{pid}/exe", "rb") as f:
            return b"ReloadConfiguration" in f.read()
    except OSError:
        return False


def session_compositor():
    """PID do compositor desta sessão: quem segura o
    $XDG_RUNTIME_DIR/$WAYLAND_DISPLAY.lock (flock, em /proc/locks). Outro
    wlmaker do mesmo usuário (aninhado, de teste) não é tocado."""
    display = os.environ.get("WAYLAND_DISPLAY")
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if not display or not runtime:
        return None
    lock = display if os.path.isabs(display) else os.path.join(runtime, display)
    try:
        st = os.stat(lock + ".lock")
        with open("/proc/locks") as f:
            locks = f.read().splitlines()
    except OSError:
        return None
    for line in locks:
        p = line.split()
        if len(p) >= 6 and p[1] == "FLOCK" and p[4].isdigit():
            dev_inode = p[5].split(":")
            if len(dev_inode) == 3 and dev_inode[2].isdigit() and int(dev_inode[2]) == st.st_ino:
                return int(p[4])
    return None


def reload_wlmaker():
    """Pede ao wlmaker da sessão atual que recarregue (SIGHUP)."""
    pid = session_compositor()
    if pid is None or pid not in wlmaker_pids():
        return False
    if not wlmaker_can_reload(pid):
        log("este wlmaker não recarrega a configuração: vale no próximo login")
        return False
    os.kill(pid, signal.SIGHUP)
    return True


def apply_session(changed, always_reload=False):
    """Aplica na sessão aberta. Chamado à mão (ou pelo big-wm-theme, que
    acabou de trocar o ThemeFile, ou pelo menu "Recarregar a configuração"),
    o wlmaker recarrega mesmo sem mudança feita aqui; o vigia só recarrega
    quando algo mudou."""
    if always_reload or changed & {"Config.plist", "Theme.plist", "RootMenu.plist"}:
        reload_wlmaker()
    if not changed:
        return
    if session_compositor() not in wlmaker_pids():
        return
    if "wallpaper" in changed and shutil.which("big-wm-wallpaper"):
        subprocess.run(["big-wm-wallpaper", "--restore"], check=False)
    for c in changed:
        if c.startswith("autostart:"):
            _, name, value = c.split(":")
            unit = "app-" + name.replace("-", "\\x2d") + "@autostart.service"
            verb = "stop" if value == "hidden" else "start"
            subprocess.run(["systemctl", "--user", verb, unit], check=False,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# == Vigia (inotify) ========================================================

IN_MODIFY, IN_CLOSE_WRITE, IN_MOVED_TO, IN_CREATE, IN_DELETE = 0x2, 0x8, 0x80, 0x100, 0x200


class Inotify:
    def __init__(self):
        libc = ctypes.CDLL(ctypes.util.find_library("c") or "libc.so.6", use_errno=True)
        self.libc = libc
        self.fd = libc.inotify_init1(os.O_CLOEXEC | os.O_NONBLOCK)
        if self.fd < 0:
            raise OSError(ctypes.get_errno(), "inotify_init1")

    def add(self, path, mask=IN_CLOSE_WRITE | IN_MOVED_TO | IN_CREATE | IN_DELETE):
        return self.libc.inotify_add_watch(self.fd, os.fsencode(path), mask)

    def read(self, timeout):
        r, _, _ = select.select([self.fd], [], [], timeout)
        if not r:
            return []
        try:
            data = os.read(self.fd, 65536)
        except BlockingIOError:
            return []
        names, i = [], 0
        while i + 16 <= len(data):
            _wd, _mask, _cookie, size = struct.unpack_from("iIII", data, i)
            names.append(data[i + 16:i + 16 + size].rstrip(b"\0").decode(errors="replace"))
            i += 16 + size
        return names


WATCHED = {"WindowMaker", "WMGLOBAL", "WMRootMenu", "WMState", "autostart"}


def watch(paths, reload):
    os.makedirs(paths.defaults, exist_ok=True)
    os.makedirs(paths.library, exist_ok=True)
    ino = Inotify()
    ino.add(paths.defaults)
    ino.add(paths.library)
    log(f"vigiando {paths.defaults}")
    while True:
        names = ino.read(None)
        if not any(n in WATCHED for n in names):
            continue
        # Junta as gravações em sequência do WPrefs (vários arquivos).
        while ino.read(0.4):
            pass
        try:
            changed = Syncer(paths).run()
            if reload:
                apply_session(changed)
            if changed:
                log("aplicado: " + ", ".join(sorted(changed)))
        except Exception as e:  # nunca derrubar o vigia
            log(f"erro na sincronização: {e}")


# == Vigia do systemd (big-wm-wprefs-sync.path) =============================
#
# O vigia residente em Python custava ~16 MiB de PSS a sessão inteira só para
# esperar um evento. A unidade .path do systemd --user vigia os mesmos
# diretórios (PathChanged) e inicia big-wm-wprefs-sync.service, que roda
# --triggered e sai. Enquanto o serviço roda, o systemd não vigia: por isso
# a rodada confere os arquivos de novo no fim e repete se algo mudou.

WATCH_UNIT = "big-wm-wprefs-sync.path"
QUIET = 0.4          # o mesmo intervalo do vigia por inotify
QUIET_MAX = 3.0      # nunca esperar mais que isto por silêncio


def watched_stamp(paths):
    """Marca (mtime_ns, tamanho, inode) dos arquivos que a sincronização lê."""
    out = []
    for d in (paths.defaults, paths.library):
        for name in sorted(WATCHED):
            try:
                st = os.stat(os.path.join(d, name))
                out.append((d, name, st.st_mtime_ns, st.st_size, st.st_ino))
            except OSError:
                out.append((d, name, None, None, None))
    return out


def wait_quiet(paths, quiet=QUIET, limit=QUIET_MAX):
    """Junta as gravações em sequência do WPrefs (vários arquivos): espera
    até nenhum arquivo vigiado mudar por `quiet` segundos."""
    start = time.monotonic()
    last = watched_stamp(paths)
    since = time.monotonic()
    while time.monotonic() - start < limit:
        time.sleep(0.05)
        cur = watched_stamp(paths)
        if cur != last:
            last, since = cur, time.monotonic()
        elif time.monotonic() - since >= quiet:
            break
    return last


def triggered(paths, reload=True):
    """Uma rodada do vigia: chamada pelo big-wm-wprefs-sync.service."""
    for _ in range(5):
        before = wait_quiet(paths)
        try:
            changed = Syncer(paths).run()
            if reload:
                apply_session(changed)
            if changed:
                log("aplicado: " + ", ".join(sorted(changed)))
        except Exception as e:  # a próxima gravação tenta de novo
            log(f"erro na sincronização: {e}")
        if watched_stamp(paths) == before:
            return 0
    return 0


def start_watch_unit(paths):
    """Liga o vigia do systemd --user. Falso quando não dá (sem systemd
    --user, sem a unidade, ou um WMAKER_USER_ROOT que a unidade, presa a
    ~/GNUstep, não vigia): aí vale o vigia por inotify."""
    if os.environ.get("WMAKER_USER_ROOT"):
        return False
    if paths.gnustep != os.path.join(paths.home, "GNUstep"):
        return False
    if not shutil.which("systemctl"):
        return False
    try:
        r = subprocess.run(["systemctl", "--user", "start", WATCH_UNIT],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30)
    except (OSError, subprocess.SubprocessError):
        return False
    return r.returncode == 0


# == Linha de comando =======================================================

def main(argv):
    args = list(argv)
    if "-h" in args or "--help" in args:
        print(__doc__ or open(__file__, encoding="utf-8").read().split("\n\n")[0])
        return 0
    if args and args[0] in ("--open-menu", "--open-plmenu"):
        spec = args[1] if len(args) > 1 else ""
        if args[0] == "--open-plmenu":
            s = spec.strip()
            if s.startswith("||"):
                out = _run_capture(s[2:])
                try:
                    menu = loads(out or "")
                except PlistError:
                    menu = None
            else:
                menu = _menu_from_path(s)
            conv = MenuConverter().menu(menu) if isinstance(menu, list) else None
            title, items = (conv[0], conv[1:]) if conv else ("Menu", [])
        else:
            items = open_menu(spec)
            title = "Menu"
            if isinstance(items, list) and items and isinstance(items[0], str):
                title, items = items[0], items[1:]
        print_submenu(title, items or [])
        return 0
    paths = Paths()
    if "--reload" in args:
        return 0 if reload_wlmaker() else 1
    if "--triggered" in args:
        return triggered(paths, "--no-reload" not in args)
    syncer = Syncer(paths, dry_run="--dry-run" in args, full="--full" in args, out=sys.stdout)
    changed = syncer.run()
    if "--no-reload" not in args and not syncer.dry_run:
        apply_session(changed, always_reload="--watch" not in args)
    if changed and not syncer.dry_run:
        log("aplicado: " + ", ".join(sorted(changed)))
    if "--watch" in args:
        if "--no-reload" not in args and "--inotify" not in args and start_watch_unit(paths):
            log(f"vigia: {WATCH_UNIT}")
            return 0
        watch(paths, "--no-reload" not in args)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
