    "teal": (0, 128, 128), "silver": (192, 192, 192),
}
_rgb_txt = None


def _x11_color_table():
    global _rgb_txt
    if _rgb_txt is None:
        _rgb_txt = {}
        for path in ("/usr/share/X11/rgb.txt", "/etc/X11/rgb.txt"):
            try:
                with open(path, encoding="latin-1") as f:
                    for line in f:
                        p = line.split(None, 3)
                        if len(p) == 4 and p[0].isdigit():
                            _rgb_txt[p[3].strip().replace(" ", "").lower()] = tuple(map(int, p[:3]))
                break
            except OSError:
                continue
    return _rgb_txt


def parse_color(spec):
    """Cor do Window Maker (#rgb, #rrggbb, rgb:r/g/b, nome X11) -> (r, g, b)."""
    if not isinstance(spec, str):
        return None
    s = spec.strip()
    m = re.fullmatch(r"#([0-9a-fA-F]+)", s)
    if m and len(m.group(1)) in (3, 6, 9, 12):
        h = m.group(1)
        n = len(h) // 3
        return tuple(round(int(h[i * n:(i + 1) * n], 16) * 255 / (16 ** n - 1)) for i in range(3))
    m = re.fullmatch(r"rgb:([0-9a-fA-F]{1,4})/([0-9a-fA-F]{1,4})/([0-9a-fA-F]{1,4})", s)
    if m:
        return tuple(round(int(x, 16) * 255 / (16 ** len(x) - 1)) for x in m.groups())
    name = s.replace(" ", "").lower()
    m = re.fullmatch(r"gr[ae]y(\d{1,3})", name)
    if m and int(m.group(1)) <= 100:
        v = round(int(m.group(1)) * 255 / 100)
        return (v, v, v)
    return _COLOR_NAMES.get(name) or _x11_color_table().get(name)


def argb(rgb):
    return "argb32:ff%02x%02x%02x" % rgb


def color_value(spec):
    rgb = parse_color(spec)
    return argb(rgb) if rgb else None


def _mix(colors):
    return tuple(round(sum(c[i] for c in colors) / len(colors)) for i in range(3))


_GRADIENT = {"h": "HGRADIENT", "v": "VGRADIENT", "d": "DGRADIENT"}


def texture_fill(tex):
    """Textura do Window Maker -> Fill do wlmaker (SOLID ou H/V/DGRADIENT).

    O wlmaker só tem cor sólida e degradês de duas cores: degradês de várias
    cores ficam com a primeira e a última, o entrelaçado (igradient) com a
    média, e as imagens (*pixmap) com a cor de fundo que a textura informa.
    """
    if isinstance(tex, str):
        rgb = parse_color(tex)
        return {"Color": argb(rgb), "Type": "SOLID"} if rgb else None
    if not isinstance(tex, list) or not tex or not isinstance(tex[0], str):
        return None
    kind, args = tex[0].lower(), tex[1:]
    cols = [parse_color(a) for a in args if isinstance(a, str)]
    if kind == "solid" and cols and cols[0]:
        return {"Color": argb(cols[0]), "Type": "SOLID"}
    m = re.fullmatch(r"(m?)([hvd])gradient", kind)
    if m:
        cs = [c for c in cols if c]
        if len(cs) >= 2:
            return {"From": argb(cs[0]), "To": argb(cs[-1]), "Type": _GRADIENT[m.group(2)]}
        if cs:
            return {"Color": argb(cs[0]), "Type": "SOLID"}
        return None
    if kind == "igradient":
        cs = [parse_color(a) for i, a in enumerate(args) if i in (0, 1, 3, 4)]
        cs = [c for c in cs if c]
        return {"Color": argb(_mix(cs)), "Type": "SOLID"} if cs else None
    m = re.fullmatch(r"t([hvd])gradient", kind)
    if m and len(args) >= 4:
        a, b = parse_color(args[2]), parse_color(args[3])
        if a and b:
            return {"From": argb(a), "To": argb(b), "Type": _GRADIENT[m.group(1)]}
    if kind in ("tpixmap", "spixmap", "cpixmap", "mpixmap", "fpixmap") and len(args) >= 2:
        c = parse_color(args[1])
        return {"Color": argb(c), "Type": "SOLID"} if c else None
    return None


def texture_color(tex):
    """Cor predominante de uma textura (para BackgroundColor)."""
    f = texture_fill(tex)
    if not f:
        return None
    if f["Type"] == "SOLID":
        return f["Color"]
    a, b = (tuple(int(f[k][-6:][i:i + 2], 16) for i in (0, 2, 4)) for k in ("From", "To"))
    return argb(_mix([a, b]))


_BOLD_WEIGHTS = {"demibold", "semibold", "bold", "extrabold", "ultrabold",
                 "black", "heavy"}


def parse_font(spec, default_size=12):
    """Fonte do Window Maker (fontconfig ou XLFD) -> Font do wlmaker."""
    if not isinstance(spec, str) or not spec.strip():
        return None
    s = spec.strip()
    if s.startswith("-"):
        f = s.split("-")
        if len(f) >= 9:
            face = f[2] if f[2] not in ("", "*") else "Sans"
            bold = f[3].lower() in _BOLD_WEIGHTS
            size = int(f[7]) if f[7].isdigit() and int(f[7]) > 0 else default_size
            return {"Face": face.title(), "Weight": "Bold" if bold else "Normal", "Size": str(size)}
        return None
    parts = re.split(r"(?<!\\):", s)
    families = [x.replace("\\", "").strip() for x in re.split(r"(?<!\\),", parts[0])]
    face = next((x for x in families if x), "Sans")
    bold, size = False, None
    for p in parts[1:]:
        key, _, val = p.partition("=")
        key, val = key.strip().lower(), val.strip().lower()
        if not _:
            if key in _BOLD_WEIGHTS:
                bold = True
            continue
        if key == "weight":
            bold = val in _BOLD_WEIGHTS or (val.isdigit() and int(val) >= 180)
        elif key == "pixelsize":
            try:
                size = round(float(val))
            except ValueError:
                pass
        elif key == "size" and size is None:
            try:
                size = round(float(val) * 96 / 72)
            except ValueError:
                pass
    m = re.fullmatch(r"(.*?)[\s-]+(\d+(?:\.\d+)?)", face)
    if m and size is None:
        face, size = m.group(1), round(float(m.group(2)) * 96 / 72)
    return {"Face": face[:127], "Weight": "Bold" if bold else "Normal",
            "Size": str(size or default_size)}


# == Teclas =================================================================

_MODS = {
    "shift": "Shift", "control": "Ctrl", "ctrl": "Ctrl", "mod1": "Alt",
    "alt": "Alt", "meta": "Alt", "mod2": "Mod2", "mod3": "Mod3",
    "mod4": "Logo", "super": "Logo", "hyper": "Logo", "logo": "Logo",
    "mod5": "Mod5",
}
_MOD_ORDER = ("Ctrl", "Shift", "Alt", "Mod2", "Mod3", "Logo", "Mod5")


class _Xkb:
    lib = None
    tried = False

    @classmethod
    def valid(cls, name):
        if not cls.tried:
            cls.tried = True
            path = ctypes.util.find_library("xkbcommon")
            try:
                cls.lib = ctypes.CDLL(path or "libxkbcommon.so.0")
                cls.lib.xkb_keysym_from_name.restype = ctypes.c_uint32
                cls.lib.xkb_keysym_from_name.argtypes = (ctypes.c_char_p, ctypes.c_int)
            except OSError:
                cls.lib = None
        if cls.lib is None:
            return bool(re.fullmatch(r"[A-Za-z0-9_]+", name))
        # 1 = XKB_KEYSYM_CASE_INSENSITIVE, como no wlmaker.
        return cls.lib.xkb_keysym_from_name(name.encode(), 1) != 0


def parse_wm_key(spec):
    """'Control+Mod1+Left' -> (frozenset({'Ctrl','Alt'}), 'Left') ou None."""
    if not isinstance(spec, str):
        return None
    s = spec.strip()
    if not s or s.lower() == "none":
        return None
    parts = [p for p in s.split("+")]
    if "" in parts:
        return None
    mods, key = set(), None
    for p in parts:
        m = _MODS.get(p.lower())
        if m:
            mods.add(m)
        elif p.lower() == "lock":
            return None
        elif key is None:
            key = p
        else:
            return None
    if key is None or not _Xkb.valid(key):
        return None
    # Shift+Tab chega ao wlmaker como ISO_Left_Tab.
    if key.lower() == "tab" and "Shift" in mods:
        key = "ISO_Left_Tab"
    return frozenset(mods), key


def combo_string(mods, key):
    return "+".join([m for m in _MOD_ORDER if m in mods] + [key])


def parse_wl_key(spec):
    """Chave de KeyBindings do wlmaker -> forma canônica (para comparar)."""
    mods, key = set(), None
    for p in spec.split("+"):
        if p in _MOD_ORDER:
            mods.add(p)
        elif key is None and p:
            key = p
        else:
            return None
    if key is None:
        return None
    return frozenset(mods), key.lower()


def canonical_combo(spec):
    c = parse_wl_key(spec)
    return combo_string(c[0], c[1]).lower() if c else spec.lower()


