# Menu "Aplicativos" do Window Maker: todos os aplicativos instalados,
# separados por categoria, no formato property list (OPEN_PLMENU).
#
#   big-wm-appmenu            imprime o menu (usa o cache quando nada mudou)
#   big-wm-appmenu --no-cache gera de novo, sem ler nem gravar o cache
#   big-wm-appmenu --dockapps menu "Dockapps": os dockapps instalados, para
#                             abrir e arrastar para o Dock
#   big-wm-appmenu --icons    ícones de reserva (WMWindowAttributes) para os
#                             aplicativos que não informam o próprio ícone
#   big-wm-appmenu --wallpapers
#                             menu "Papéis de parede" da sessão Wayland
#   big-wm-appmenu --x11-dockapps-note
#                             notificação: dockapps X11 só na sessão X11
#
# Com --wlmaker, os menus saem no formato do wlmaker (GeneratePlistMenu em
# data/wlmaker/RootMenu.plist): a estrutura é a mesma, só a ação muda
# (ShellExecute em vez de EXEC). O wlmaker rejeita o menu inteiro se um
# gerador falhar, por isso a saída é sempre um plist válido.
#
# Segue a especificação de entradas .desktop da freedesktop.org: lê
# $XDG_DATA_HOME e $XDG_DATA_DIRS (inclusive flatpak), o primeiro arquivo de
# cada ID vence, respeita NoDisplay, Hidden, OnlyShowIn/NotShowIn e TryExec
# (com os ajustes do Big WindowMaker por ID, ver desktop_overrides), e
# usa o nome traduzido para o idioma da sessão. Os aplicativos abrem com
# gtk-launch, que trata Exec, Terminal e DBusActivatable como o resto do
# sistema. Substitui o "wmmenugen -parser:xdg", que abortava o menu inteiro
# quando um dos diretórios não existia e não traduzia as categorias.

import hashlib
import locale
import os
import re
import shlex
import shutil
import subprocess
import sys
from configparser import ConfigParser, Error as ConfigError

CACHE_VERSION = "4"

