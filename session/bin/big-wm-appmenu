# Submenus do menu Dockapps quando há muitos (o menu inteiro não cabe numa
# tela de 768 linhas).
DOCKAPP_GROUPS = (
    ("clock", "Relógios e calendário", "Clocks and calendar"),
    ("system", "Sistema", "System"),
    ("net", "Rede e energia", "Network and power"),
    ("sound", "Som e música", "Sound and music"),
    ("sky", "Tempo e céu", "Weather and sky"),
    ("tools", "Ferramentas", "Tools"),
    ("fun", "Diversão", "Fun"),
)
DOCKAPP_FLAT_MAX = 12


def dockapp_command(command, program, wayland=False):
    if program == "wmweather" and os.path.exists(os.path.expanduser("~/.wmweatherrc")):
        return "wmweather"
    if wayland and program in GTK_DOCKAPPS:
        # GTK (wmcliphist, wmshutdown...) só desenha a janela de ícone no X11.
        return "env GDK_BACKEND=x11 BIG_WM_DOCKAPP_X11=1 " + command
    return command


def dockapp_available(program, has_battery):
    """Instalado e útil aqui (bateria, driver cpufreq, sensores)."""
    if shutil.which(program) is None:
        return False
    if program in BATTERY_DOCKAPPS:
        return has_battery
    if program == "wmcpufreq":
        # Sem driver cpufreq (a maioria das VMs) ele sai na hora.
        return os.path.isdir("/sys/devices/system/cpu/cpu0/cpufreq")
    if program == "wmgtemp":
        return any(n.startswith("temp") and n.endswith("_input")
                   for d in _listdir("/sys/class/hwmon") for n in _listdir(f"/sys/class/hwmon/{d}"))
    return True


# Dockapps do wlmaker: clientes Wayland do protocolo de ícones do wlmaker,
# que aparecem como ladrilhos ao lado do Clip.
WAYLAND_DOCKAPPS = (
    ("wlmclock", "wlmclock", "Relógio", "Clock", "clock"),
    ("wlmcpugraph", "wlmcpugraph", "Uso da CPU", "CPU usage", "system"),
    ("wlmmemgraph", "wlmmemgraph", "Memória", "Memory", "system"),
    ("wlmnetgraph", "wlmnetgraph", "Tráfego de rede", "Network traffic", "net"),
    ("wlmbattery", "wlmbattery", "Bateria", "Battery", "net"),
    # A bandeja (SNI) é um dockapp adotado pelo wlmaker: tirada do Dock,
    # volta por aqui.
    ("big-wm-tray", "big-wm-tray", "Bandeja do sistema", "System tray", "system"),
    ("wmake-zones-wl", "wmake-zones-wl", "Organização de janelas", "Window organization", "tools"),
    # O wmeyes do X11 não vê o ponteiro fora das janelas X11 (o XWayland só
    # sabe dele sobre elas); este, igual a ele, segue o ponteiro pela tela
    # (protocolo de observação do wlmaker).
    ("wlmeyes --dockapp", "wlmeyes", "Olhos que seguem o ponteiro", "Eyes that follow the pointer", "fun"),
)

# Dockapps do X11 que o wlmaker põe no Dock e no Clip pelo XWayland, iguais
# aos do X11 (o ladrilho é a janela de ícone do programa): todos os do
# catálogo do X11, conferidos um a um no laboratório (docs/wayland-dockapps.md,
# tabela de auditoria), menos os que têm um equivalente do Wayland (a bandeja,
# a organização de janelas e os olhos, acima) e o wmpager (as áreas de
# trabalho do wlmaker não chegam ao X11: ele não teria o que mostrar). O
# wmnet precisa do -w (sem ele mapeia uma janela comum).
_XWAYLAND_EQUIVALENT = {"wmsystemtray": "big-wm-tray", "wmake-zones": "wmake-zones-wl",
                        "wmeyes": "wlmeyes"}
_XWAYLAND_OUT = {"wmpager"}
XWAYLAND_DOCKAPPS = tuple(
    (("wmnet -w",) + d[1:]) if d[1] == "wmnet" else d
    for d in DOCKAPPS if d[1] not in _XWAYLAND_EQUIVALENT and d[1] not in _XWAYLAND_OUT)
# Os de GTK só desenham a janela de ícone com o backend X11; o
# BIG_WM_DOCKAPP_X11 diz ao big-wm-open que os aplicativos abertos por eles
# voltam ao backend da sessão (Wayland), sem herdar o GDK_BACKEND=x11.
GTK_DOCKAPPS = frozenset({"wmcliphist", "wmshutdown", "minidock", "minicontrol", "wmudmount"})
XWAYLAND_DOCKAPP_PROGRAMS = frozenset(d[1] for d in XWAYLAND_DOCKAPPS)


# Sem bateria (desktops, VMs) esses só mostram "?".
BATTERY_DOCKAPPS = {"wlmbattery", "wmbattery", "wmapmload"}


def _listdir(path):
    try:
        return os.listdir(path)
    except OSError:
        return []


# Programas dos dockapps X11: nunca no menu de aplicativos da sessão Wayland
# (são ladrilhos, não aplicativos; os que funcionam lá ficam no menu
# Dockapps). Os pacotes do big-dockapps já trazem NotShowIn=wlmaker nos
# .desktop; isto cobre pacotes antigos e de terceiros.
X11_DOCKAPP_PROGRAMS = frozenset(d[1] for d in DOCKAPPS) | {
    "wmsmixer", "wmweather+", "wmhdplop", "wmload", "wmnd"}


def is_x11_dockapp(entry):
    words = (entry.get("Exec") or "").split()
    program = os.path.basename(words[0].strip('"')) if words else ""
    return program in X11_DOCKAPP_PROGRAMS or "DockApp" in split_list(entry.get("Categories"))


def render_dockapps(language, action):
    pt = language == "pt"
    wayland = action == "ShellExecute"
    catalog = DOCKAPPS
    if wayland:
        # Os do X11, com o XWayland da sessão (DISPLAY).
        catalog = WAYLAND_DOCKAPPS + (XWAYLAND_DOCKAPPS if os.environ.get("DISPLAY") else ())
    has_battery = any(n.startswith("BAT") for n in _listdir("/sys/class/power_supply"))
    available = [d for d in catalog if dockapp_available(d[1], has_battery)]

    def item(d, indent):
        command, program, label_pt, label_en, _group = d
        label = f"{label_pt if pt else label_en} ({program})"
        return f"{indent}({quote(label)}, {action}, {quote(dockapp_command(command, program, wayland))})"

    items = []
    if len(available) > DOCKAPP_FLAT_MAX:
        for group, title_pt, title_en in DOCKAPP_GROUPS:
            entries = [item(d, "    ") for d in available if d[4] == group]
            if entries:
                items.append("  (\n    " + quote(title_pt if pt else title_en) + ",\n"
                             + ",\n".join(entries) + "\n  )")
    else:
        items = [item(d, "  ") for d in available]
    if not items:
        none = "Nenhum dockapp instalado" if pt else "No dockapps installed"
        items.append(f"  ({quote(none)}, {action}, {quote('true')})")
    if wayland and _x11_only_dockapps():
        # Os outros dockapps X11 instalados ficam de fora aqui; o item explica.
        note = "Sobre os dockapps do X11" if pt else "About X11 dockapps"
        items.append(f"  ({quote(note)}, {action}, {quote('big-wm-appmenu --x11-dockapps-note')})")
    return "(\n  \"Dockapps\",\n" + ",\n".join(items) + "\n)\n"


def _x11_only_dockapps():
    """Dockapps X11 instalados que não estão no menu Wayland."""
    shown = set() if not os.environ.get("DISPLAY") else XWAYLAND_DOCKAPP_PROGRAMS
    return sorted({d[1] for d in DOCKAPPS if d[1] not in shown and shutil.which(d[1])},
                  key=str.casefold)


def x11_dockapps_note(language):
    """Notificação do item "Sobre os dockapps do X11" do menu Wayland."""
    pt = language == "pt"
    names = _x11_only_dockapps()
    if not os.environ.get("DISPLAY"):
        body = (("Sem o XWayland, os dockapps do X11 ficam só na sessão Window Maker (X11): "
                 if pt else "Without XWayland, X11 dockapps stay in the Window Maker (X11) session: ")
                + ", ".join(names) + ".")
    else:
        parts = []
        for name in names:
            if name in _XWAYLAND_EQUIVALENT:
                parts.append(f"{name} → {_XWAYLAND_EQUIVALENT[name]}")
            elif name == "wmpager":
                parts.append("wmpager (" + ("as áreas de trabalho do wlmaker não chegam aos programas do X11"
                                            if pt else "wlmaker's workspaces do not reach X11 programs") + ")")
            else:
                parts.append(name)
        body = (("Aqui estes têm o equivalente do Wayland, ou ficam só no X11: "
                 if pt else "Here these have a Wayland equivalent, or stay on X11: ")
                + "; ".join(parts) + ". "
                + ("Os outros do X11 rodam pelo XWayland." if pt else "The other X11 ones run on XWayland."))
    os.execvp("notify-send", ["notify-send", "-a", "Big WindowMaker", "-i", "dialog-information",
                              "Dockapps", body])


def icon_theme_dirs():
    """Diretórios de temas de ícones do XDG, na ordem de prioridade."""
    data_home = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    data_dirs = (os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":")
    dirs = [os.path.join(data_home, "icons"), os.path.expanduser("~/.icons")]
    dirs += [os.path.join(d, "icons") for d in data_dirs if d]
    return list(dict.fromkeys(dirs))


def read_icon_theme(index, lang_keys):
    """Nome amigável de um index.theme, ou None se não for um tema de
    ícones para mostrar (oculto, só cursores, sem diretórios)."""
    section, values = None, {}
    try:
        with open(index, encoding="utf-8", errors="replace") as f:
            for line in f:
                line = line.strip()
                if line.startswith("["):
                    if section == "Icon Theme":
                        break
                    section = line.strip("[]")
                    continue
                if section == "Icon Theme" and "=" in line:
                    key, _, value = line.partition("=")
                    values.setdefault(key.strip(), value.strip())
    except OSError:
        return None
    if values.get("Hidden", "").lower() == "true" or not values.get("Directories"):
        return None
    for key in lang_keys:
        if values.get(f"Name[{key}]"):
            return values[f"Name[{key}]"]
    return values.get("Name")


def current_icon_theme():
    try:
        out = subprocess.run(["gsettings", "get", "org.gnome.desktop.interface", "icon-theme"],
                             capture_output=True, text=True, timeout=2).stdout.strip().strip("'")
        if out:
            return out
    except (OSError, subprocess.SubprocessError):
        pass
    ini = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
                       "gtk-3.0", "settings.ini")
    try:
        with open(ini, encoding="utf-8") as f:
            for line in f:
                if line.strip().startswith("gtk-icon-theme-name"):
                    return line.split("=", 1)[1].strip()
    except OSError:
        pass
    return ""


def icon_themes(lang_keys, use_cache=True):
    """[(id, nome)] dos temas instalados; cache invalidado pela data dos
    diretórios (instalar ou remover um tema muda a data do diretório)."""
    dirs = icon_theme_dirs()
    stamp_parts = []
    for d in dirs:
        try:
            stamp_parts.append(f"{d}:{os.stat(d).st_mtime_ns}")
        except OSError:
            stamp_parts.append(f"{d}:-")
    stamp = hash_stamp("\x1f".join(stamp_parts + list(lang_keys)))
    cache = os.path.join(os.path.dirname(cache_path()), "icon-themes.tsv")
    if use_cache:
        try:
            with open(cache, encoding="utf-8") as f:
                if f.readline().strip() == stamp:
                    return [tuple(l.rstrip("\n").split("\t", 1)) for l in f if "\t" in l]
        except OSError:
            pass
    themes, seen = [], set()
    for d in dirs:
        for name in sorted(_listdir(d)):
            if name in seen or name in ("default", "hicolor", "locolor"):
                continue
            label = read_icon_theme(os.path.join(d, name, "index.theme"), lang_keys)
            if label:
                seen.add(name)
                themes.append((name, label))
    themes.sort(key=lambda t: t[1].casefold())
    if use_cache:
        try:
            os.makedirs(os.path.dirname(cache), exist_ok=True)
            tmp = f"{cache}.{os.getpid()}"
            with open(tmp, "w", encoding="utf-8") as f:
                f.write(stamp + "\n" + "".join(f"{i}\t{n}\n" for i, n in themes))
            os.replace(tmp, cache)
        except OSError:
            pass
    return themes


def render_icon_themes(language, lang_keys, action, use_cache=True):
    """Menu Aparência > Tema de ícones: todos os temas de ícones do XDG
    instalados (sistema e usuário), o ativo marcado."""
    pt = language == "pt"
    title = "Tema de ícones" if pt else "Icon theme"
    current = current_icon_theme()
    items = []
    for theme_id, label in icon_themes(lang_keys, use_cache):
        mark = "\u2713 " if theme_id == current else "    "
        command = "big-wm-theme icons " + shlex.quote(theme_id)
        items.append(f"  ({quote(mark + label)}, {action}, {quote(command)})")
    if not items:
        none = "Nenhum tema de ícones instalado" if pt else "No icon themes installed"
        items.append(f"  ({quote(none)}, {action}, {quote('true')})")
    return f"(\n  {quote(title)},\n" + ",\n".join(items) + "\n)\n"


WALLPAPER_DIRS = ("/usr/share/backgrounds/big-wm", "~/GNUstep/Library/WindowMaker/Backgrounds")
WALLPAPER_EXTS = (".jpg", ".jpeg", ".png", ".webp")


def render_wallpapers(language, action):
    """Papéis de parede para big-wm-wallpaper (sessão Wayland)."""
    title = "Papéis de parede" if language == "pt" else "Wallpapers"
    items, seen = [], set()
    for d in WALLPAPER_DIRS:
        d = os.path.expanduser(d)
        try:
            names = sorted(os.listdir(d), key=str.casefold)
        except OSError:
            continue
        for name in names:
            path = os.path.realpath(os.path.join(d, name))
            stem, ext = os.path.splitext(name)
            if ext.lower() not in WALLPAPER_EXTS or path in seen or stem == "default":
                continue
            seen.add(path)
            command = "big-wm-wallpaper " + shlex.quote(path)
            items.append(f"  ({quote(stem)}, {action}, {quote(command)})")
    if not items:
        items.append(f"  ({quote('—')}, {action}, {quote('true')})")
    return f"(\n  {quote(title)},\n" + ",\n".join(items) + "\n)\n"


def message_locale():
    for var in ("LC_ALL", "LC_MESSAGES", "LANG"):
        value = os.environ.get(var)
        if value:
            return value
    return "C"


def locale_keys(value):
    """Sufixos de chave traduzida, do mais ao menos específico (spec, seção 5)."""
    lang = value.split(".", 1)[0]
    lang, _, modifier = lang.partition("@")
    language, _, country = lang.partition("_")
    keys = []
    if country and modifier:
        keys.append(f"{language}_{country}@{modifier}")
    if country:
        keys.append(f"{language}_{country}")
    if modifier:
        keys.append(f"{language}@{modifier}")
    keys.append(language)
    return keys


def data_dirs():
    home = os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share")
    dirs = [home]
    dirs += (os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share").split(":")
    # Fora de uma sessão que leu /etc/profile.d/flatpak.sh os diretórios do
    # flatpak não estão no XDG_DATA_DIRS.
    dirs += [os.path.expanduser("~/.local/share/flatpak/exports/share"),
             "/var/lib/flatpak/exports/share"]
    seen, result = set(), []
    for d in dirs:
        d = os.path.join(d, "applications")
        if d not in seen and os.path.isdir(d):
            seen.add(d)
            result.append(d)
    return result


def desktop_files(dirs):
    """{ID: caminho}; o primeiro diretório (o do usuário) vence."""
    found = {}
    for base in dirs:
        for root, _subdirs, files in os.walk(base):
            for name in files:
                if not name.endswith(".desktop"):
                    continue
                path = os.path.join(root, name)
                desktop_id = os.path.relpath(path, base).replace(os.sep, "-")
                found.setdefault(desktop_id, path)
    return found


def read_entry(path):
    parser = ConfigParser(interpolation=None, strict=False, delimiters=("=",))
    parser.optionxform = str
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            parser.read_file(f)
    except (OSError, ConfigError):
        return None
    if not parser.has_section("Desktop Entry"):
        return None
    return parser["Desktop Entry"]


def split_list(value):
    return [v for v in (value or "").split(";") if v]


def is_true(value):
    return (value or "").strip().lower() == "true"


def try_exec_ok(value):
    if not value:
        return True
    value = value.strip()
    if os.path.isabs(value):
        return os.access(value, os.X_OK)
    return shutil.which(value) is not None


def category_of(categories):
    present = set(categories)
    for main, aliases in MAIN_CATEGORIES:
        if present.intersection(aliases):
            return main
    return "Other"


# Ajustes das entradas .desktop só nas sessões Big WindowMaker, por ID:
# arquivos parciais (só [Desktop Entry] e as chaves que mudam) em
# /usr/share/big-wm/desktop-overrides/<ID>.desktop e, do usuário (vencem),
# em ~/.config/big-wm/desktop-overrides/<ID>.desktop. As chaves entram por
# cima das do .desktop original: NoDisplay/Hidden (fora do menu e do Buscar
# aplicativos), OnlyShowIn/NotShowIn (só numa das sessões), Name e
# Name[xx] (o nome), X-BigWM-RootMenu=true (fora de Aplicativos por já
# estar no menu raiz; o Buscar aplicativos continua mostrando). Não ficam
# no XDG_DATA_DIRS: o KDE, o GNOME, o XFCE e o "Abrir com" não os veem, e o
# .desktop original (Exec, ícone, tipos MIME) continua valendo, atualizado
# pelo pacote dele. Para trazer de volta um aplicativo escondido, um
# arquivo do usuário com NoDisplay=false.
def override_dirs():
    config = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    datadir = os.environ.get("BIGWM_DATADIR") or "/usr/share/big-wm"
    return [os.path.join(datadir, "desktop-overrides"),
            os.path.join(config, "big-wm", "desktop-overrides")]


_overrides = None


def desktop_overrides():
    """{ID: {chave: valor}} dos ajustes; os do usuário por último (vencem)."""
    global _overrides
    if _overrides is None:
        _overrides = {}
        for d in override_dirs():
            for name in sorted(_listdir(d)):
                if not name.endswith(".desktop"):
                    continue
                entry = read_entry(os.path.join(d, name))
                if entry is not None:
                    _overrides.setdefault(name, {}).update(dict(entry))
    return _overrides


def apply_overrides(desktop_id, entry):
    for key, value in desktop_overrides().get(desktop_id, {}).items():
        entry[key] = value
        if key == "Name" or key.startswith("Name["):
            # Nome escolhido aqui: fica inteiro (sem tirar a marca da base).
            entry["X-BigWM-KeepName"] = "true"
    return entry


# O sistema se apresenta como Big WindowMaker (baseado no BigLinux): o
# "Sistema e Distribuição" da BigCommunity mostra a outra marca e repete o que
# o fastfetch e o painel Informações já mostram.
HIDDEN_APPS = frozenset({"org.bigcommunity.CommRelease.desktop"})
# Nas ferramentas da base, o nome do produto sai do nome do programa nos
# menus: "BigLinux Narrador de Texto" -> "Narrador de Texto".
_BRAND_PREFIX = re.compile(r"^(?:BigLinux|BigCommunity|Big Community)\s*[-:–]?\s+", re.IGNORECASE)
_BRAND_SUFFIX = re.compile(r"\s+(?:d[aeo]\s+)?(?:BigLinux|BigCommunity|Big Community)$", re.IGNORECASE)


def display_name(name, entry=None):
    """Nome do aplicativo nos menus, sem a marca da base (a menos que o nome
    venha de um ajuste do Big WindowMaker, como "Configurações do BigLinux")."""
    if entry is not None and is_true(entry.get("X-BigWM-KeepName")):
        return name.strip()
    clean = _BRAND_SUFFIX.sub("", _BRAND_PREFIX.sub("", name.strip()))
    return clean or name.strip()


def visible_entries(desktops):
    """(ID sem .desktop, entrada) dos aplicativos que aparecem nesta sessão."""
    for desktop_id, path in desktop_files(data_dirs()).items():
        if desktop_id in HIDDEN_APPS:
            continue
        entry = read_entry(path)
        if entry is None or entry.get("Type", "Application") != "Application":
            continue
        apply_overrides(desktop_id, entry)
        if is_true(entry.get("NoDisplay")) or is_true(entry.get("Hidden")):
            continue
        if not entry.get("Exec") and not is_true(entry.get("DBusActivatable")):
            continue
        only = split_list(entry.get("OnlyShowIn"))
        if only and not desktops.intersection(only):
            continue
        if desktops.intersection(split_list(entry.get("NotShowIn"))):
            continue
        if not try_exec_ok(entry.get("TryExec")):
            continue
        if "wlmaker" in desktops and is_x11_dockapp(entry):
            continue
        yield desktop_id[:-len(".desktop")], entry


def collect(lang_keys, desktops):
    apps = {}
    for app_id, entry in visible_entries(desktops):
        # Os dockapps (do wlmaker e do X11) já estão em Configurações >
        # Dockapps, que os abre com o comando certo de cada sessão; o Buscar
        # aplicativos continua achando os do X11 pelo nome.
        if app_id.startswith("wlmaker.") or is_x11_dockapp(entry):
            continue
        # Itens que já estão no menu raiz (X-BigWM-RootMenu=true, como as
        # Preferências do Dock com Abas em Configurações) não se repetem.
        if is_true(entry.get("X-BigWM-RootMenu")):
            continue
        name = next((entry[f"Name[{k}]"] for k in lang_keys if entry.get(f"Name[{k}]")),
                    entry.get("Name"))
        if not name:
            continue
        category = category_of(split_list(entry.get("Categories")))
        apps.setdefault(category, []).append((display_name(name, entry), app_id))
    return apps


# Ícones de reserva no Window Maker. Um aplicativo que não informa o próprio
# ícone (_NET_WM_ICON ou WM_HINTS) aparece com o cubo genérico do GNUstep; o
# Window Maker usa o atributo Icon de WMWindowAttributes só nesse caso
# (src/icon.c, wIconUpdate), procurando "instância.classe", "instância" e
# "classe". Por isso as chaves vêm do que o .desktop permite prever:
# StartupWMClass, --class= (webapps), o ID e o nome do executável.
GENERIC_COMMANDS = {
    "env", "sh", "bash", "python", "python3", "perl", "java", "flatpak",
    "electron", "gtk-launch", "xdg-open", "big-webapps-exec", "brave",
    "chromium", "google-chrome-stable", "firefox", "sudo", "pkexec",
    "softwarerender", "dbus-send", "gapplication",
}


def window_keys(app_id, entry):
    keys = []
    if entry.get("StartupWMClass"):
        keys.append(entry["StartupWMClass"].strip())
    words = (entry.get("Exec") or "").split()
    for word in words:
        if word.startswith("--class="):
            keys.append(word.split("=", 1)[1])
    keys.append(app_id)
    command = next((w for w in words if "=" not in w), "")
    base = os.path.basename(command.strip('"'))
    if base and base.lower() not in GENERIC_COMMANDS and not base.startswith("%"):
        keys.append(base)
    return [k for k in dict.fromkeys(keys) if k and '"' not in k]


PLIST_WORD = re.compile(r"[^\s{}()=;,\"]+")


def user_attribute_keys(text):
    """Chaves de primeiro nível de WMWindowAttributes (minúsculas)."""
    keys, depth, i, last = set(), 0, 0, None
    while i < len(text):
        c = text[i]
        if c == '"':
            j = i + 1
            while j < len(text) and text[j] != '"':
                j += 2 if text[j] == "\\" else 1
            last, i = text[i + 1:j], j + 1
            continue
        if c in "{(":
            depth += 1
        elif c in "})":
            depth -= 1
        elif c == "=" and depth == 1 and last is not None:
            keys.add(last.lower())
        elif not c.isspace():
            m = PLIST_WORD.match(text, i)
            if m:
                last = m.group(0)
                i = m.end()
                continue
            last = None
        i += 1
    return keys


def install_icons(desktops):
    gnustep = os.environ.get("WMAKER_USER_ROOT") or os.path.expanduser("~/GNUstep")
    attributes = os.path.join(gnustep, "Defaults", "WMWindowAttributes")
    try:
        with open(attributes, encoding="utf-8") as f:
            text = f.read()
    except OSError:
        return
    end = text.rfind("}")
    if not text.lstrip().startswith("{") or end < 0:
        return

    # Nada mudou desde a última vez (aplicativos, tema de ícones, arquivo do
    # usuário): não carrega o GTK à toa a cada login.
    stamp_file = os.path.join(os.path.dirname(cache_path()), "icons.stamp")
    stamp = hash_stamp(fingerprint("icons", desktops) + "\x1f" + gtk_icon_theme()
                       + "\x1f" + hash_stamp(text))
    try:
        with open(stamp_file, encoding="utf-8") as f:
            if f.read().strip() == stamp:
                return
    except OSError:
        pass

    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk

    theme = Gtk.IconTheme.get_default()
    cache = os.path.join(os.path.expanduser(os.environ.get("XDG_CACHE_HOME") or "~/.cache"),
                         "big-wm", "icons")
    os.makedirs(cache, exist_ok=True)

    existing = user_attribute_keys(text)
    wanted, clash = {}, set()
    for app_id, entry in visible_entries(desktops):
        icon = (entry.get("Icon") or "").strip()
        if not icon:
            continue
        for key in window_keys(app_id, entry):
            low = key.lower()
            if low in existing:
                continue
            if low in wanted and wanted[low][1] != icon:
                clash.add(low)
            wanted.setdefault(low, (key, icon))

    added = []
    for low, (key, icon) in sorted(wanted.items()):
        if low in clash:
            continue
        png = os.path.join(cache, hashlib.sha1(icon.encode()).hexdigest()[:16] + ".png")
        if not os.path.exists(png):
            try:
                if os.path.isabs(icon):
                    from gi.repository import GdkPixbuf
                    pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_size(icon, 64, 64)
                else:
                    info = theme.lookup_icon(icon, 64, Gtk.IconLookupFlags.FORCE_SIZE)
                    pixbuf = info.load_icon() if info else None
                if pixbuf is None:
                    continue
                pixbuf.savev(png, "png", [], [])
            except Exception:
                continue
        added.append(f"  {quote(key)} = {{Icon = {quote(png)};}};")

    if added:
        head = text[:end].rstrip()
        if not head.endswith(("{", ";")):
            head += ";"
        text = head + "\n" + "\n".join(added) + "\n}\n"
        tmp = f"{attributes}.{os.getpid()}"
        with open(tmp, "w", encoding="utf-8") as f:
            f.write(text)
        os.replace(tmp, attributes)
        stamp = hash_stamp(fingerprint("icons", desktops) + "\x1f" + gtk_icon_theme()
                           + "\x1f" + hash_stamp(text))
    with open(stamp_file, "w", encoding="utf-8") as f:
        f.write(stamp + "\n")


def gtk_icon_theme():
    path = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
                        "gtk-3.0", "settings.ini")
    try:
        with open(path, encoding="utf-8") as f:
            m = re.search(r"^gtk-icon-theme-name\s*=\s*(.+)$", f.read(), re.M)
        return m.group(1).strip() if m else ""
    except OSError:
        return ""


def quote(text):
    return '"' + text.replace("\\", "\\\\").replace('"', '\\"') + '"'


def launch_id(app_id):
    """O argumento do gtk-launch: o ID, ou o nome do arquivo quando o ID já
    termina em ".desktop" (org.telegram.desktop): o gtk-launch toma esse ID
    por um nome de arquivo e procura "org.telegram.desktop", que não existe
    ("nenhum aplicativo"); o Telegram não abria pelo menu."""
    return app_id + ".desktop" if app_id.endswith(".desktop") else app_id


def render(apps, labels, action="EXEC"):
    key = locale.strxfrm
    lines = ["(", f"  {quote(labels['_title'])},"]
    submenus = []
    for category, entries in apps.items():
        items = []
        seen = set()
        for name, app_id in sorted(entries, key=lambda e: (key(e[0].casefold()), e[1])):
            # Dois .desktop com o mesmo nome (ex.: pacote e flatpak) ficam
            # distinguíveis pelo ID.
            label = name if name not in seen else f"{name} ({app_id})"
            seen.add(name)
            items.append(f"    ({quote(label)}, {action}, {quote('gtk-launch ' + launch_id(app_id))})")
        submenus.append((labels.get(category, category), items))
    # "Outros" sempre por último; o resto em ordem alfabética.
    submenus.sort(key=lambda s: (s[0] == labels["Other"], key(s[0].casefold())))
    if not submenus:
        submenus.append((labels["Other"], [f"    ({quote('—')}, {action}, {quote('true')})"]))
    blocks = []
    for title, items in submenus:
        blocks.append("  (\n    " + quote(title) + ",\n" + ",\n".join(items) + "\n  )")
    lines.append(",\n".join(blocks))
    lines.append(")")
    return "\n".join(lines) + "\n"


def cache_path():
    base = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
    return os.path.join(base, "big-wm", "appmenu.plist")


def fingerprint(lang, desktops):
    """Muda quando um .desktop é instalado, removido ou alterado."""
    parts = [CACHE_VERSION, lang, ":".join(sorted(desktops)), os.environ.get("PATH", "")]
    for d in data_dirs():
        for root, _subdirs, _files in os.walk(d):
            try:
                parts.append(f"{root}:{os.stat(root).st_mtime_ns}")
            except OSError:
                pass
    # Os ajustes são poucos: cada arquivo conta (editado no lugar também).
    for d in override_dirs():
        for name in sorted(_listdir(d)):
            try:
                parts.append(f"{d}/{name}:{os.stat(os.path.join(d, name)).st_mtime_ns}")
            except OSError:
                pass
    return "\x1f".join(parts)


def hash_stamp(stamp):
    return hashlib.sha256(stamp.encode()).hexdigest()


def main():
    args = sys.argv[1:]
    action = "ShellExecute" if "--wlmaker" in args else "EXEC"
    try:
        run(args, action)
    except Exception:
        if action != "ShellExecute":
            raise
        # O wlmaker descarta o menu raiz inteiro se um gerador falhar.
        sys.stdout.write('("Big WindowMaker",\n  ("big-wm-appmenu", ShellExecute, "true")\n)\n')


def run(args, action):
    use_cache = "--no-cache" not in args
    try:
        locale.setlocale(locale.LC_ALL, "")
    except locale.Error:
        pass
    lang = message_locale()
    lang_keys = locale_keys(lang)
    labels = LABELS.get(lang_keys[-1], LABELS["en"])
    if "--dockapps" in args:
        sys.stdout.write(render_dockapps(lang_keys[-1], action))
        return
    if "--x11-dockapps-note" in args:
        x11_dockapps_note(lang_keys[-1])
        return
    if "--wallpapers" in args:
        sys.stdout.write(render_wallpapers(lang_keys[-1], action))
        return
    if "--icon-themes" in args:
        sys.stdout.write(render_icon_themes(lang_keys[-1], lang_keys, action, use_cache))
        return
    desktops = set(split_list(os.environ.get("XDG_CURRENT_DESKTOP", "WindowMaker").replace(":", ";")))
    if "--icons" in args:
        install_icons(desktops)
        return

    stamp = fingerprint(lang + action, desktops) if use_cache else ""
    path = cache_path() if action == "EXEC" else cache_path().replace(".plist", "-wlmaker.plist")
    if use_cache:
        try:
            with open(path, encoding="utf-8") as f:
                head, _, body = f.read().partition("\n")
            if head == "// " + hash_stamp(stamp):
                sys.stdout.write(body)
                return
        except OSError:
            pass

    menu = render(collect(lang_keys, desktops), labels, action)
    sys.stdout.write(menu)
    if use_cache:
        try:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            tmp = f"{path}.{os.getpid()}"
            with open(tmp, "w", encoding="utf-8") as f:
                f.write("// " + hash_stamp(stamp) + "\n" + menu)
            os.replace(tmp, path)
        except OSError:
            pass


if __name__ == "__main__":
    main()
