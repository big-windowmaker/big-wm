# Dock padrão (data/wlmaker/State.plist): borda direita, no alto, com o
# quadrado principal e dois lançadores.
DEFAULT_DOCK = ("RIGHT", "TOP", 2)


def text():
    lang = os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or ""
    return TEXT["pt"] if lang.startswith("pt") else TEXT["en"]


def config_home():
    return os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")


def state_path():
    return os.path.join(config_home(), "wlmaker", "State.plist")


def prefs_path():
    return os.path.join(config_home(), "big-wm", "tray")


def wlmaker_prefs_path():
    """Preferências do dockapp guardadas pelo wlmaker (Configurações... do
    menu do ladrilho, o esquema Dockapps.plist do wlmaker)."""
    return os.path.join(config_home(), "wlmaker", DOCKAPP_NAME + ".plist")


def dockapps_path():
    return os.path.join(config_home(), "wlmaker", "Dockapps.plist")


def plist_names(text, key):
    """Nomes da lista "key = ( ... )" de primeiro nível do Dockapps.plist."""
    m = re.search(r'(^|[\s{;])"?%s"?\s*=\s*\(([^)]*)\)' % re.escape(key), text or "")
    if not m:
        return []
    return [n.strip().strip('"') for n in m.group(2).split(",") if n.strip().strip('"')]


def removed(path=None):
    """Se o usuário tirou a bandeja do Dock (arrastou para fora): o wlmaker a
    põe em "Removed" do Dockapps.plist."""
    return DOCKAPP_NAME in plist_names(read_plist(path or dockapps_path()), "Removed")


def mode_path():
    return os.path.join(config_home(), "big-wm", "theme")


def datadir():
    return os.environ.get("BIGWM_DATADIR") or "/usr/share/big-wm"


def theme_mode(path=None):
    """light ou dark, como o big-wm-theme get (sem o arquivo, claro)."""
    try:
        with open(path or mode_path(), encoding="utf-8") as f:
            return "dark" if f.read().strip() == "dark" else "light"
    except (OSError, UnicodeDecodeError):
        return "light"


def read_plist(path):
    """Texto da property list sem os comentários //, ou None."""
    try:
        with open(path, encoding="utf-8") as f:
            return re.sub(r"(?m)^\s*//[^\n]*|\s//[^\n]*", "", f.read())
    except (OSError, UnicodeDecodeError):
        return None


def plist_block(text, key):
    """Conteúdo do dicionário "key = { ... }" de primeiro nível."""
    m = re.search(r'(^|[\s{;])"?%s"?\s*=\s*\{' % re.escape(key), text)
    if not m:
        return None
    depth, i = 1, m.end()
    while i < len(text) and depth:
        c = text[i]
        if c == '"':
            i += 1
            while i < len(text) and text[i] != '"':
                i += 2 if text[i] == "\\" else 1
        elif c in "{(":
            depth += 1
        elif c in "})":
            depth -= 1
        i += 1
    return text[m.end():i - 1]


def dock_layout(path=None):
    """(borda, âncora, ladrilhos depois do quadrado principal) do Dock do
    wlmaker: os lançadores e os dockapps acoplados ao Dock (DockappTiles,
    que o wlmaker regrava quando um dockapp entra ou sai do Dock)."""
    text = read_plist(path or state_path())
    if text is None:
        return DEFAULT_DOCK
    dock = plist_block(text, "Dock")
    if dock is None:
        return DEFAULT_DOCK
    # Só as chaves do próprio Dock (fora de Output e dos lançadores).
    top_level = re.sub(r"\{[^{}]*\}", "", dock)
    edge = re.search(r"\bEdge\s*=\s*\"?(\w+)", top_level)
    anchor = re.search(r"\bAnchor\s*=\s*\"?(\w+)", top_level)
    launchers = re.search(r"\bLaunchers\s*=\s*\(", dock)
    count = 0
    if launchers:
        depth, i, start = 1, launchers.end(), launchers.end()
        while i < len(dock) and depth:
            depth += {"(": 1, ")": -1}.get(dock[i], 0)
            i += 1
        # As entradas de primeiro nível (uma gaveta tem os próprios
        # lançadores dentro dela).
        level = 0
        for c in dock[start:i - 1]:
            if c in "{(":
                if c == "{" and level == 0:
                    count += 1
                level += 1
            elif c in "})":
                level -= 1
    dockapps = re.search(r"\bDockappTiles\s*=\s*\"?(\d+)", top_level)
    if dockapps:
        count += int(dockapps.group(1))
    edge = (edge.group(1) if edge else DEFAULT_DOCK[0]).upper()
    anchor = (anchor.group(1) if anchor else DEFAULT_DOCK[1]).upper()
    if edge not in ("LEFT", "RIGHT", "TOP", "BOTTOM"):
        edge = DEFAULT_DOCK[0]
    vertical = edge in ("LEFT", "RIGHT")
    if anchor not in (("TOP", "BOTTOM") if vertical else ("LEFT", "RIGHT")):
        anchor = "TOP" if vertical else "RIGHT"
    return edge, anchor, count


def dock_level(path=None):
    """Nível do Dock (Dock position do Window Maker, Lowered e AutoRaiseLower
    no State.plist): "top" (Manter sobre outros, o padrão), "normal" (abaixo
    das janelas) ou "auto" (Auto raise & lower)."""
    text = read_plist(path or state_path())
    dock = plist_block(text, "Dock") if text else None
    if dock is None:
        return "top"
    top_level = re.sub(r"\{[^{}]*\}", "", dock)

    def flag(key):
        m = re.search(r"\b%s\s*=\s*\"?(\w+)" % key, top_level)
        return bool(m) and m.group(1).lower() in ("yes", "true", "1")
    if flag("AutoRaiseLower"):
        return "auto"
    return "normal" if flag("Lowered") else "top"


def theme_path(mode="light"):
    """Tema dos ladrilhos do Dock. Com o ThemeFile do Config.plist (o que o
    wlmdock lê) num dos dois temas do Big WindowMaker, vale o do modo (o
    big-wm-theme troca o ThemeFile, mas o wlmdock só o relê no próximo
    login); com outro tema escolhido pelo usuário, esse tema."""
    wlmaker = os.path.join(config_home(), "wlmaker")
    themes = os.path.join(datadir(), "wlmaker")
    pair = {os.path.join(themes, PALETTE[m]["theme"]) for m in PALETTE}
    config = read_plist(os.path.join(wlmaker, "Config.plist")) or ""
    m = re.search(r'\bThemeFile\s*=\s*"([^"]+)"', config)
    candidates = []
    if m and os.path.expanduser(m.group(1)) not in pair:
        candidates.append(os.path.expanduser(m.group(1)))
    candidates += [os.path.join(themes, PALETTE[mode]["theme"]), os.path.join(wlmaker, "Theme.plist")]
    for path in candidates:
        if os.path.isfile(path):
            return path
    return None


def parse_argb(value):
    """"argb32:aarrggbb" -> (r, g, b, a) em 0-255."""
    m = re.fullmatch(r"\s*\"?argb32:([0-9a-fA-F]{8})\"?\s*", value or "")
    if not m:
        return None
    v = int(m.group(1), 16)
    return (v >> 16) & 0xff, (v >> 8) & 0xff, v & 0xff, v >> 24


def tile_style(path=None, mode="light"):
    """Fundo dos ladrilhos do Dock (Tile do tema do wlmaker) e a margem
    entre eles (Dock.Margin.Width): um ladrilho a cada TILE + margem."""
    text = read_plist(path) if path else None
    tile = plist_block(text, "Tile") if text else None
    fill = plist_block(tile, "Fill") if tile else None
    style = dict(DEFAULT_TILE, **{k: PALETTE[mode][k] for k in ("from", "to")})

    def value(block, key):
        m = re.search(r"\b%s\s*=\s*([^;]+);" % key, block)
        return m.group(1).strip() if m else None
    dock = plist_block(text, "Dock") if text else None
    margin = plist_block(dock, "Margin") if dock else None
    width = value(margin, "Width") if margin else None
    if width and width.isdigit():
        style["margin"] = int(width)
    if fill is None:
        return style
    kind = (value(fill, "Type") or "").strip('"').upper()
    if kind not in ("SOLID", "HGRADIENT", "VGRADIENT", "DGRADIENT", "ADGRADIENT"):
        return style
    style["type"] = kind
    if kind == "SOLID":
        style["color"] = parse_argb(value(fill, "Color")) or style["from"]
    else:
        style["from"] = parse_argb(value(fill, "From")) or style["from"]
        style["to"] = parse_argb(value(fill, "To")) or style["to"]
    bezel = value(re.sub(r"\{[^{}]*\}", "", tile), "BezelWidth")
    if bezel and bezel.isdigit():
        style["bezel"] = int(bezel)
    return style


def read_prefs(path=None):
    prefs = {"small": False, "fgcolor": None}
    try:
        with open(path or prefs_path(), encoding="utf-8") as f:
            for line in f:
                key, sep, val = line.strip().partition("=")
                if not sep or key.startswith("#"):
                    continue
                key, val = key.strip(), val.strip()
                if key == "small":
                    prefs["small"] = val.lower() in ("1", "true", "yes", "sim")
                elif key == "fgcolor" and re.fullmatch(r"#[0-9a-fA-F]{6}", val):
                    prefs["fgcolor"] = val
    except OSError:
        pass
    # Configurações... do menu do wlmaker: "Ícones pequenos" (SmallIcons).
    if path is None:
        text = read_plist(wlmaker_prefs_path())
        m = re.search(r'\bSmallIcons\s*=\s*"?(\w+)', text or "")
        if m:
            prefs["small"] = m.group(1).lower() in ("yes", "true", "1")
    return prefs


def write_prefs(prefs, path=None):
    path = path or prefs_path()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write("# big-wm-tray (Configurações... no menu do ladrilho)\n")
        f.write("small=%s\n" % ("true" if prefs["small"] else "false"))
        if prefs["fgcolor"]:
            f.write("fgcolor=%s\n" % prefs["fgcolor"])
    os.replace(tmp, path)


# --- Paginação e áreas do ladrilho (como no wmsystemtray) -----------------

def grid(small):
    """(tamanho do ícone, ícones por linha, por coluna)."""
    return (ICON_SIZE_SMALL, 3, 3) if small else (ICON_SIZE, 2, 2)


def page_count(n_items, per_page):
    """Páginas para n ícones: sempre ao menos uma ("1/1" sem ícones)."""
    return max(1, (n_items - 1) // per_page + 1) if n_items > 0 else 1


def page_slots(n_items, page, small):
    """Índices dos ícones da página e onde ficam: [(índice, x, y)]."""
    size, per_row, per_col = grid(small)
    per_page = per_row * per_col
    first = page * per_page
    slots = []
    for j, i in enumerate(range(first, min(n_items, first + per_page))):
        slots.append((i, ICONS_ORIGIN[0] + (j % per_row) * size,
                      ICONS_ORIGIN[1] + (j // per_row) * size))
    return slots


def page_label(page, pages):
    """Texto e posição x do número da página (wmsystemtray: 24, ou 19
    a partir da página 10)."""
    return "%d/%d" % (page + 1, pages), (19 if page > 8 else 24)


def hit_test(x, y, n_items, page, small):
    """O que está no ponto (x, y) do ladrilho: ("icon", índice), ("left",),
    ("right",), ("bar",) ou ("frame",)."""
    size = grid(small)[0]
    for i, ix, iy in page_slots(n_items, page, small):
        if ix <= x < ix + size and iy <= y < iy + size:
            return ("icon", i)
    for name, (x0, y0, x1, y1) in (("left", HIT_LEFT), ("right", HIT_RIGHT)):
        if x0 <= x < x1 and y0 <= y < y1:
            return (name,)
    x0, y0, x1, y1 = BAR
    if x0 <= x < x1 and y0 <= y < y1:
        return ("bar",)
    return ("frame",)


def input_rects(n_items, page, small):
    """Região de entrada da bandeja adotada: os ícones da página e as
    setas, (x, y, largura, altura). O resto do ladrilho (a borda, os lugares
    vazios, o número da página) é do wlmaker: arrastar o ladrilho e o menu
    dele, como na borda dos outros dockapps."""
    size = grid(small)[0]
    rects = [(x, y, size, size) for _i, x, y in page_slots(n_items, page, small)]
    for x in (ARROW_LEFT_X, ARROW_RIGHT_X):
        rects.append((x, ARROW_Y, ARROW_W, ARROW_H))
    return rects


def running_names():
    """Nomes dos processos (/proc/*/comm): os dockapps que estão rodando."""
    names = set()
    for pid in os.listdir("/proc"):
        if pid.isdigit():
            try:
                with open("/proc/%s/comm" % pid, encoding="utf-8") as f:
                    names.add(f.read().strip())
            except OSError:
                pass
    return names


def dockapp_slot(dockapps_text, name=DOCKAPP_NAME, running=None):
    """Onde o wlmaker pôs a bandeja, pelo Dockapps.plist: ("Dock", índice)
    entre os dockapps do Dock, ("Clip", índice) ou ("Drawer.N", índice); o
    índice conta os dockapps da lista que estão rodando (running: nomes;
    None, todos). Sem o nome em nenhuma lista, o Dock (Dock.Dockapps do
    State.plist)."""
    for key in ["Dock", "Order"] + sorted(set(re.findall(r'"?(Drawer\.[^\s="]+)"?\s*=', dockapps_text or ""))):
        names = plist_names(dockapps_text, key)
        if name in names:
            before = names[:names.index(name)]
            index = len([n for n in before if running is None or n in running])
            return ("Clip" if key == "Order" else key), index
    return "Dock", 0


def dock_offset(tiles, margin=1):
    """Distância da bandeja ao canto do Dock: o quadrado principal e os
    ladrilhos seguintes, cada um com a margem do Dock depois dele."""
    return (TILE + margin) * (1 + tiles)


def tile_origin(edge, anchor, launchers, width, height, margin=1):
    """Canto do ladrilho na saída (largura × altura) junto do Dock."""
    offset = dock_offset(launchers, margin)
    if edge in ("LEFT", "RIGHT"):
        x = 0 if edge == "LEFT" else width - TILE
        y = offset if anchor == "TOP" else height - offset - TILE
    else:
        y = 0 if edge == "TOP" else height - TILE
        x = offset if anchor == "LEFT" else width - offset - TILE
    return x, y


def balloon_geometry(text_w, n_lines, line_h, anchor, screen):
    """Balão do Window Maker (showText em balloon.c) para o objeto em
    anchor = (x, y, w, h) na tela screen = (largura, altura): devolve
    (largura, altura sem a ponta, à direita?, embaixo?, x, y da janela)."""
    x, y, w, h = anchor
    width = text_w + 16
    height = max(16, n_lines * line_h + 4)
    width = max(width, height)
    right = x + width > screen[0]
    bx = max(0, x - width + w // 2) if right else x + w // 2
    bx = min(bx, screen[0] - width)
    below = y - (height + BALLOON_SPACE) < 0
    by = y + h - 1 if below else y - (height + BALLOON_SPACE)
    return width, height, right, below, bx, by


def balloon_tail(width, height, right, below):
    """Pontos da ponta do balão (pt e ipt de drawBalloon)."""
    y = BALLOON_SPACE if below else 0
    w1 = max(height, 21)
    if below:
        py = [y, y - BALLOON_SPACE, y]
        iy = [v + 1 for v in py]
    else:
        py = [y + height - 1, y + height - 1 + BALLOON_SPACE, y + height - 1]
        iy = [v - 1 for v in py]
    if right:
        px = [width - w1 + 2 * w1 // 16, width - w1 + 11 * w1 // 16, width - w1 + 7 * w1 // 16]
        ix = [1 + width - w1 + 2 * (w1 - 1) // 16, 1 + width - w1 + 11 * (w1 - 1) // 16,
              1 + width - w1 + 7 * (w1 - 1) // 16]
    else:
        px = [w1 - 2 * w1 // 16, w1 - 11 * w1 // 16, w1 - 7 * w1 // 16]
        ix = [-1 + w1 - 2 * (w1 - 1) // 16, -1 + w1 - 11 * (w1 - 1) // 16,
              -1 + w1 - 7 * (w1 - 1) // 16]
    return list(zip(px, py)), list(zip(ix, iy))


def item_label(props):
    """Texto do balão de um item: o ToolTip (título e descrição), senão o
    Title, senão o Id."""
    lines = []
    tip = props.get("ToolTip")
    if tip and len(tip) > 3:
        for part in (tip[2], tip[3]):
            part = re.sub(r"<[^>]*>", "", part or "").strip()
            if part and part not in lines:
                lines.append(part)
    if not lines:
        title = (props.get("Title") or "").strip() or (props.get("Id") or "").strip()
        if title:
            lines.append(title)
    return "\n".join(lines)


def split_service(service, sender):
    """'nome', 'nome/caminho' ou '/caminho' -> (nome no barramento, caminho)."""
    if service.startswith("/"):
        return sender, service
    name, _, path = service.partition("/")
    return name, ("/" + path) if path else "/StatusNotifierItem"


WATCHER_XML = """
