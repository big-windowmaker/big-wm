# Preenchidos por load_gi() ao iniciar a bandeja.
cairo = DbusmenuGtk3 = Gdk = GdkPixbuf = Gio = GLib = Gtk = GtkLayerShell = Pango = PangoCairo = None


def load_gi():
    """Importa o GTK só ao iniciar a bandeja (os testes leem as funções
    acima sem GTK)."""
    # O PyGObject importa o asyncio, e o asyncio, o ssl: libssl e libcrypto
    # carregados à toa (1,7 MiB de PSS medidos na bandeja), sem nenhuma
    # conexão TLS aqui. Sem o módulo, o asyncio segue sem TLS.
    sys.modules.setdefault("ssl", None)
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    gi.require_version("GtkLayerShell", "0.1")
    gi.require_version("DbusmenuGtk3", "0.4")
    gi.require_version("Pango", "1.0")
    gi.require_version("PangoCairo", "1.0")
    import cairo
    from gi.repository import (DbusmenuGtk3, Gdk, GdkPixbuf, Gio, GLib, Gtk,  # noqa: F401
                               GtkLayerShell, Pango, PangoCairo)
    globals().update(DbusmenuGtk3=DbusmenuGtk3, Gdk=Gdk, GdkPixbuf=GdkPixbuf, Gio=Gio,
                     GLib=GLib, Gtk=Gtk, GtkLayerShell=GtkLayerShell, Pango=Pango,
                     PangoCairo=PangoCairo, cairo=cairo)


def hex_rgb(color):
    return tuple(int(color[i:i + 2], 16) / 255 for i in (1, 3, 5))


def arrows_pixbuf():
    rows = len(ARROWS_XPM)
    cols = len(ARROWS_XPM[0])
    data = bytearray()
    for line in ARROWS_XPM:
        for ch in line:
            data += bytes(ARROWS_XPM_COLORS[ch])
    return GdkPixbuf.Pixbuf.new_from_bytes(GLib.Bytes.new(bytes(data)), GdkPixbuf.Colorspace.RGB,
                                           False, 8, cols, rows, cols * 3)


def pixbuf_from_argb(pixmap, size):
    """IconPixmap (ARGB32 em ordem de rede) -> GdkPixbuf RGBA de size×size."""
    width, height, data = pixmap
    data = bytes(data)
    if width <= 0 or height <= 0 or len(data) < width * height * 4:
        return None
    data = data[:width * height * 4]
    rgba = bytearray(len(data))
    rgba[0::4], rgba[1::4], rgba[2::4], rgba[3::4] = data[1::4], data[2::4], data[3::4], data[0::4]
    pixbuf = GdkPixbuf.Pixbuf.new_from_bytes(GLib.Bytes.new(bytes(rgba)), GdkPixbuf.Colorspace.RGB,
                                             True, 8, width, height, width * 4)
    if (width, height) == (size, size):
        return pixbuf
    return pixbuf.scale_simple(size, size, GdkPixbuf.InterpType.BILINEAR)


DESKTOP_ICONS = {}


def desktop_icon(name):
    """Ícone do .desktop cujo ID é name ou começa com "name." (o
    org.manjaro.pamac.manager.desktop para "org.manjaro.pamac")."""
    if name not in DESKTOP_ICONS:
        found = None
        apps = sorted(Gio.AppInfo.get_all(), key=lambda a: a.get_id() or "")
        for app in apps:
            app_id = app.get_id() or ""
            if app_id == name + ".desktop" or app_id.startswith(name + "."):
                icon = app.get_icon()
                if isinstance(icon, Gio.ThemedIcon) and icon.get_names():
                    found = icon.get_names()[0]
                    break
        DESKTOP_ICONS[name] = found
    return DESKTOP_ICONS[name]


def best_pixmap(pixmaps, size):
    """O menor IconPixmap que cobre size, senão o maior."""
    pixmaps = [p for p in pixmaps or [] if p[0] > 0 and p[1] > 0]
    if not pixmaps:
        return None
    big = [p for p in pixmaps if min(p[0], p[1]) >= size]
    return min(big, key=lambda p: p[0] * p[1]) if big else max(pixmaps, key=lambda p: p[0] * p[1])


class Item:
    def __init__(self, tray, key, bus_name, path):
        self.tray, self.key, self.bus_name, self.path = tray, key, bus_name, path
        self.props = {}
        self.loaded = False
        self.pixbuf = None
        self.source = "-"
        self.menu = None
        self.queued = False
        self.subscriptions = [
            tray.bus.signal_subscribe(bus_name, ITEM_IFACE, None, path, None,
                                      Gio.DBusSignalFlags.NONE, self.on_signal),
        ]
        self.refresh()

    @property
    def visible(self):
        return self.loaded and self.props.get("Status", "Active") != "Passive"

    def close(self):
        for sub in self.subscriptions:
            self.tray.bus.signal_unsubscribe(sub)
        if self.menu is not None:
            self.menu.destroy()

    def call(self, method, args, on_error=None):
        def done(bus, result):
            try:
                bus.call_finish(result)
            except GLib.Error:
                if on_error:
                    on_error()
        self.tray.bus.call(self.bus_name, self.path, ITEM_IFACE, method, args,
                           None, Gio.DBusCallFlags.NONE, 2000, None, done)

    def on_signal(self, *_args):
        # NewIcon, NewStatus, NewToolTip... chegam em rajadas: um GetAll só.
        if not self.queued:
            self.queued = True
            GLib.idle_add(self.refresh)

    def refresh(self):
        self.queued = False
        self.tray.bus.call(self.bus_name, self.path, "org.freedesktop.DBus.Properties",
                           "GetAll", GLib.Variant("(s)", (ITEM_IFACE,)),
                           GLib.VariantType("(a{sv})"), Gio.DBusCallFlags.NONE, 2000,
                           None, self.on_props)
        return False

    def on_props(self, bus, result):
        try:
            props = bus.call_finish(result).unpack()[0]
        except GLib.Error:
            return
        if self.tray.items.get(self.key) is not self:
            return  # saiu do barramento enquanto a resposta vinha
        self.props = props
        self.loaded = True
        self.update_icon()
        # O dbusmenu chega de forma assíncrona: criado já aqui, o menu está
        # preenchido no primeiro clique (um menu vazio não abre).
        menu_path = self.props.get("Menu")
        if self.menu is None and menu_path and menu_path != "/":
            self.menu = DbusmenuGtk3.Menu.new(self.bus_name, menu_path)
            self.menu.attach_to_widget(self.tray.area, None)
        self.tray.relayout()

    def update_icon(self):
        size = self.tray.icon_size()
        scale = self.tray.area.get_scale_factor()
        attention = self.props.get("Status") == "NeedsAttention"
        pixbuf, self.source = self.icon_pixbuf(attention, size * scale)
        if pixbuf is None:
            pixbuf, self.source = self.tray.themed_icon("image-missing", size * scale), "missing"
        overlay, _src = self.icon_pixbuf(False, size * scale // 2, overlay=True)
        if pixbuf is not None and overlay is not None:
            pixbuf = pixbuf.copy()
            half = overlay.get_width()
            overlay.composite(pixbuf, pixbuf.get_width() - half, pixbuf.get_height() - half,
                              half, half, pixbuf.get_width() - half, pixbuf.get_height() - half,
                              1, 1, GdkPixbuf.InterpType.BILINEAR, 255)
        self.pixbuf = pixbuf

    def icon_pixbuf(self, attention, size, overlay=False):
        if overlay:
            names, pixmaps = ["OverlayIconName"], ["OverlayIconPixmap"]
        else:
            names = (["AttentionIconName"] if attention else []) + ["IconName"]
            pixmaps = (["AttentionIconPixmap"] if attention else []) + ["IconPixmap"]
        theme_path = self.props.get("IconThemePath")
        theme = Gtk.IconTheme.get_default()
        if theme_path and os.path.isdir(theme_path) and theme_path not in theme.get_search_path():
            theme.append_search_path(theme_path)
        for key in names:
            name = self.props.get(key)
            if not name:
                continue
            if name.startswith("/"):
                try:
                    return GdkPixbuf.Pixbuf.new_from_file_at_size(name, size, size), "file:" + name
                except GLib.Error:
                    continue
            if theme_path and os.path.isdir(theme_path):
                # Ícones soltos no IconThemePath (sem index.theme), como os de
                # alguns AppIndicators em Python.
                for ext in (".png", ".svg", ".xpm"):
                    path = os.path.join(theme_path, name + ext)
                    if os.path.isfile(path):
                        try:
                            return GdkPixbuf.Pixbuf.new_from_file_at_size(path, size, size), "file:" + path
                        except GLib.Error:
                            pass
            pixbuf = self.tray.themed_icon(name, size)
            if pixbuf is not None:
                return pixbuf, "name:" + name
        for key in pixmaps:
            pixmap = best_pixmap(self.props.get(key), size)
            if pixmap is not None:
                pixbuf = pixbuf_from_argb(pixmap, size)
                if pixbuf is not None:
                    return pixbuf, "pixmap:%dx%d" % (pixmap[0], pixmap[1])
        if not overlay:
            # IconName que o tema não tem, mas que é o nome do aplicativo
            # (o pamac-tray começa com "org.manjaro.pamac"; o snixembed no
            # X11 fica sem ícone): o ícone do .desktop dele.
            for name in (self.props.get(names[-1]), self.props.get("Id")):
                icon = desktop_icon(name) if name and not name.startswith("/") else None
                pixbuf = self.tray.themed_icon(icon, size) if icon else None
                if pixbuf is not None:
                    return pixbuf, "desktop:" + icon
        return None, "-"

    def label(self):
        return item_label(self.props)

    def activate(self, button, trigger):
        x, y = self.tray.item_screen_point(self)
        if button == 1 and not self.props.get("ItemIsMenu", False):
            # AppIndicators (Ayatana) não têm Activate: o clique abre o menu,
            # como no Plasma e no Waybar.
            self.call("Activate", GLib.Variant("(ii)", (x, y)),
                      on_error=lambda: self.show_menu(trigger))
        elif button == 2:
            self.call("SecondaryActivate", GLib.Variant("(ii)", (x, y)))
        else:
            self.show_menu(trigger)

    def show_menu(self, trigger):
        if self.menu is None:
            x, y = self.tray.item_screen_point(self)
            self.call("ContextMenu", GLib.Variant("(ii)", (x, y)))
            return
        self.tray.popup(self.menu, self.tray.item_rect(self), trigger)

    def scroll(self, delta, orientation):
        self.call("Scroll", GLib.Variant("(is)", (delta, orientation)))


class Balloon:
    """O balão do Window Maker (balloon.c), num popup da bandeja."""

    def __init__(self, tray):
        self.tray = tray
        self.window = None
        self.text = ""
        self.geometry = None

    def font(self):
        desc = Pango.FontDescription.from_string(BALLOON_FONT)
        desc.set_absolute_size(BALLOON_FONT_PX * Pango.SCALE)
        return desc

    def show(self, label, anchor):
        """Mostra label para a área anchor = (x, y, w, h) do ladrilho."""
        self.hide()
        if not label:
            return
        layout = self.tray.area.create_pango_layout("")
        layout.set_font_description(self.font())
        lines = label.split("\n")
        widths, line_h = [], 0
        for line in lines:
            layout.set_text(line, -1)
            _ink, logical = layout.get_pixel_extents()
            widths.append(logical.width)
            line_h = max(line_h, logical.height)
        tile_x, tile_y, screen = self.tray.tile_screen()
        x, y, w, h = anchor
        width, height, right, below, bx, by = balloon_geometry(
            max(widths), len(lines), line_h, (tile_x + x, tile_y + y, w, h), screen)
        self.text, self.geometry = label, (width, height, right, below, line_h)
        win = Gtk.Window(type=Gtk.WindowType.POPUP)
        win.set_type_hint(Gdk.WindowTypeHint.TOOLTIP)
        win.set_transient_for(self.tray.window)
        win.set_app_paintable(True)
        visual = win.get_screen().get_rgba_visual()
        if visual is not None:
            win.set_visual(visual)
        win.set_size_request(width, height + BALLOON_SPACE)
        win.connect("draw", self.on_draw)
        win.realize()
        # Posição relativa ao ladrilho (o popup do layer-shell não tem
        # coordenadas globais): mesmo canto que o Window Maker calcula.
        rect = Gdk.Rectangle()
        rect.x, rect.y, rect.width, rect.height = bx - tile_x, by - tile_y, 1, 1
        win.get_window().move_to_rect(rect, Gdk.Gravity.NORTH_WEST, Gdk.Gravity.NORTH_WEST,
                                      Gdk.AnchorHints.SLIDE, 0, 0)
        win.show()
        self.window = win

    def hide(self):
        if self.window is not None:
            self.window.destroy()
            self.window = None
            self.text = ""

    def on_draw(self, _win, cr):
        width, height, right, below, line_h = self.geometry
        cr.set_operator(cairo.OPERATOR_CLEAR)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)
        y = BALLOON_SPACE if below else 0
        rad = height * 3 // 10
        pt, ipt = balloon_tail(width, height, right, below)
        cr.set_antialias(cairo.ANTIALIAS_NONE)  # XFillArc/XFillPolygon do Window Maker

        def rounded(x0, y0, w, h, r):
            cr.rectangle(x0, y0 + r // 2, w, h - r)
            cr.rectangle(x0 + r // 2, y0, w - r, h)
            for cx, cy in ((x0 + r / 2, y0 + r / 2), (x0 + w - 1 - r / 2, y0 + r / 2),
                           (x0 + r / 2, y0 + h - 1 - r / 2), (x0 + w - 1 - r / 2, y0 + h - 1 - r / 2)):
                cr.new_sub_path()
                cr.arc(cx + 0.5, cy + 0.5, r / 2, 0, 2 * math.pi)
            cr.fill()

        def polygon(points):
            cr.move_to(points[0][0] + 0.5, points[0][1] + 0.5)
            for px, py in points[1:]:
                cr.line_to(px + 0.5, py + 0.5)
            cr.close_path()
            cr.fill()
        # Contorno (a máscara) em preto, o interior em branco, a ponta por cima.
        cr.set_source_rgb(*BALLOON_FG)
        rounded(0, y, width, height, rad)
        polygon(pt)
        cr.set_source_rgb(*BALLOON_BG)
        rounded(1, y + 1, width - 2, height - 2, rad)
        polygon(ipt)
        cr.set_source_rgb(*BALLOON_FG)
        cr.set_line_width(1)
        for shift in (0, 1):
            dx = (shift, 0, -shift) if right else (-shift, 0, shift)
            cr.move_to(pt[0][0] + dx[0] + 0.5, pt[0][1] + 0.5)
            cr.line_to(pt[1][0] + dx[1] + 0.5, pt[1][1] + 0.5)
            cr.line_to(pt[2][0] + dx[2] + 0.5, pt[2][1] + 0.5)
            cr.stroke()
        cr.set_antialias(cairo.ANTIALIAS_DEFAULT)  # o texto do Xft é suavizado
        layout = PangoCairo.create_layout(cr)
        layout.set_font_description(self.font())
        for n, line in enumerate(self.text.split("\n")):
            layout.set_text(line, -1)
            cr.move_to(8, (BALLOON_SPACE if below else 0) + 2 + n * line_h)
            PangoCairo.show_layout(cr, layout)
        return True


class Tray:
    def __init__(self, bus):
        self.bus = bus
        self.items = {}
        self.text = text()
        self.prefs = read_prefs()
        self.page = 0
        self.down = None           # seta pressionada ("left"/"right")
        self.hover = None          # alvo sob o ponteiro
        self.balloon = Balloon(self)
        self.balloon_timer = 0
        self.balloon_shown = False  # já mostrou um: os próximos são imediatos
        self.scroll_acc = 0.0
        self.open_menu = None
        self.frame_menu = None
        self.settings = None
        self.arrows = arrows_pixbuf()
        self.mode = theme_mode()
        self.tile = tile_style(theme_path(self.mode), self.mode)
        self.window = Gtk.Window()
        self.window.set_name("big-wm-tray")
        GtkLayerShell.init_for_window(self.window)
        GtkLayerShell.set_layer(self.window, GtkLayerShell.Layer.TOP)
        GtkLayerShell.set_namespace(self.window, "wlmaker-dockapp" if ADOPTED else "big-wm-tray")
        # Na coluna (ou linha) do Dock, sem ser empurrado pela reserva de
        # espaço dele nem a de outros painéis (o Dock com abas na base).
        GtkLayerShell.set_exclusive_zone(self.window, -1)
        self.area = Gtk.DrawingArea()
        self.area.set_size_request(TILE, TILE)
        self.area.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK
                             | Gdk.EventMask.SCROLL_MASK | Gdk.EventMask.SMOOTH_SCROLL_MASK
                             | Gdk.EventMask.POINTER_MOTION_MASK | Gdk.EventMask.ENTER_NOTIFY_MASK
                             | Gdk.EventMask.LEAVE_NOTIFY_MASK)
        self.area.connect("draw", self.on_draw)
        self.area.connect("button-press-event", self.on_press)
        self.area.connect("button-release-event", self.on_release)
        self.area.connect("scroll-event", self.on_scroll)
        self.area.connect("motion-notify-event", self.on_motion)
        self.area.connect("enter-notify-event", self.on_enter)
        self.area.connect("leave-notify-event", self.on_leave)
        self.window.add(self.area)
        self.window.set_resizable(False)
        self.edge = None
        self.placed_margin = None
        self.level = None
        self.level_timer = 0
        if not ADOPTED:  # adotada, o wlmaker põe e empilha o ladrilho
            self.place()
            self.apply_level()
        self.monitors = []
        try:  # o diretório do modo (big-wm-theme) já existindo, o aviso é na hora
            os.makedirs(os.path.dirname(mode_path()), exist_ok=True)
        except OSError:
            pass
        for path, handler in ((state_path(), self.on_state_changed),
                              (wlmaker_prefs_path(), self.on_prefs_changed),
                              (mode_path(), self.on_theme_changed),
                              (os.path.join(config_home(), "wlmaker", "Config.plist"), self.on_theme_changed)):
            monitor = Gio.File.new_for_path(path).monitor_file(Gio.FileMonitorFlags.NONE, None)
            monitor.connect("changed", handler)
            self.monitors.append(monitor)
        # O próprio arquivo do tema: o big-wm-wprefs-sync regera o
        # ~/.config/wlmaker/Theme.plist (aparência do WPrefs) a cada troca
        # de modo, depois de o modo ser gravado.
        self.theme_file = None
        self.theme_monitor = None
        self.watch_theme_file()
        Gtk.IconTheme.get_default().connect("changed", lambda _t: self.reload_icons())
        self.area.connect("notify::scale-factor", lambda *_a: self.reload_icons())
        node = Gio.DBusNodeInfo.new_for_xml(TRAY_XML)
        self.bus.register_object_with_closures2(TRAY_PATH, node.interfaces[0], self.on_tray_call, None, None)
        self.own_watcher()
        # Sempre visível, mesmo sem ícones ("1/1"), como o dockapp no X11.
        self.window.show_all()
        self.update_input_shape()

    # --- Preferências e aparência ---------------------------------------
    def fg(self):
        return self.prefs["fgcolor"] or PALETTE[self.mode]["fg"]

    def icon_size(self):
        return grid(self.prefs["small"])[0]

    def per_page(self):
        _size, per_row, per_col = grid(self.prefs["small"])
        return per_row * per_col

    def reload_icons(self):
        for item in self.items.values():
            if item.loaded:
                item.update_icon()
        self.area.queue_draw()

    def themed_icon(self, name, size):
        theme = Gtk.IconTheme.get_default()
        try:
            info = theme.lookup_icon(name, size, Gtk.IconLookupFlags.FORCE_SIZE)
            if info is None:
                return None
            if info.is_symbolic():
                # Símbolos na cor do texto da bandeja, como o snixembed no X11.
                fg = Gdk.RGBA()
                fg.parse(self.fg())
                return info.load_symbolic(fg, None, None, None)[0]
            return info.load_icon()
        except GLib.Error:
            return None

    def watch_theme_file(self):
        path = theme_path(self.mode)
        if path == self.theme_file:
            return
        self.theme_file = path
        if self.theme_monitor is not None:
            self.theme_monitor.cancel()
            self.theme_monitor = None
        if path:
            self.theme_monitor = Gio.File.new_for_path(path).monitor_file(Gio.FileMonitorFlags.NONE, None)
            self.theme_monitor.connect("changed", self.on_theme_changed)

    def on_theme_changed(self, _monitor, _file, _other, event):
        # big-wm-theme grava o modo com mv: chega como CREATED/MOVED_IN.
        if event in (Gio.FileMonitorEvent.CHANGES_DONE_HINT, Gio.FileMonitorEvent.CREATED,
                     Gio.FileMonitorEvent.DELETED, Gio.FileMonitorEvent.MOVED_IN,
                     Gio.FileMonitorEvent.RENAMED):
            mode = theme_mode()
            self.tile = tile_style(theme_path(mode), mode)
            self.watch_theme_file()
            self.replace()  # a margem entre os ladrilhos vem do tema
            if mode != self.mode:
                self.mode = mode
                self.reload_icons()  # símbolos na cor nova
            self.area.queue_draw()

    # --- Posição junto do Dock --------------------------------------------
    def place(self):
        edge, anchor, launchers = dock_layout()
        if (edge, anchor, launchers) == self.edge and self.tile["margin"] == self.placed_margin:
            return False
        self.edge = (edge, anchor, launchers)
        self.placed_margin = self.tile["margin"]
        edges = {"LEFT": GtkLayerShell.Edge.LEFT, "RIGHT": GtkLayerShell.Edge.RIGHT,
                 "TOP": GtkLayerShell.Edge.TOP, "BOTTOM": GtkLayerShell.Edge.BOTTOM}
        for name, value in edges.items():
            GtkLayerShell.set_anchor(self.window, value, name in (edge, anchor))
            GtkLayerShell.set_margin(self.window, value, 0)
        # Depois do quadrado principal, dos lançadores e dos dockapps do Dock.
        GtkLayerShell.set_margin(self.window, edges[anchor], dock_offset(launchers, self.tile["margin"]))
        return True

    def apply_level(self):
        """Mesma camada do Dock: acima das janelas ou abaixo delas (Normal e
        Auto raise & lower, que sobe com o ponteiro sobre a bandeja)."""
        level = dock_level()
        if level == self.level:
            return
        self.level = level
        self.cancel_level_timer()
        self.set_raised(level == "top")

    def set_raised(self, raised):
        layer = GtkLayerShell.Layer.TOP if raised else GtkLayerShell.Layer.BOTTOM
        if GtkLayerShell.get_layer(self.window) != layer:
            GtkLayerShell.set_layer(self.window, layer)
        return False

    def cancel_level_timer(self):
        if self.level_timer:
            GLib.source_remove(self.level_timer)
            self.level_timer = 0

    def autoraise(self, raised):
        if self.level != "auto":
            return
        self.cancel_level_timer()

        def done():
            self.level_timer = 0
            if not raised and self.open_menu is not None and self.open_menu.get_visible():
                return False  # com o menu aberto, fica em cima
            return self.set_raised(raised)
        self.level_timer = GLib.timeout_add(AUTORAISE_DELAY if raised else AUTOLOWER_DELAY, done)

    def on_prefs_changed(self, _monitor, _file, _other, event):
        if event in (Gio.FileMonitorEvent.CHANGES_DONE_HINT, Gio.FileMonitorEvent.CREATED,
                     Gio.FileMonitorEvent.MOVED_IN, Gio.FileMonitorEvent.RENAMED,
                     Gio.FileMonitorEvent.DELETED):
            small = self.prefs["small"]
            self.prefs = read_prefs()
            if small != self.prefs["small"]:
                self.page = 0
                self.reload_icons()
                self.relayout()

    def update_input_shape(self):
        """Adotada: entrada só nos ícones e na barra das setas."""
        gdk_window = self.window.get_window()
        if not ADOPTED or gdk_window is None:
            return
        rects = input_rects(len(self.visible_items()), self.page, self.prefs["small"])
        region = cairo.Region([cairo.RectangleInt(*r) for r in rects])
        gdk_window.input_shape_combine_region(region, 0, 0)

    def on_state_changed(self, _monitor, _file, _other, event):
        if ADOPTED:
            return
        if event in (Gio.FileMonitorEvent.CHANGES_DONE_HINT, Gio.FileMonitorEvent.CREATED,
                     Gio.FileMonitorEvent.MOVED_IN, Gio.FileMonitorEvent.RENAMED):
            self.apply_level()
            self.replace()

    def replace(self):
        if self.place() and self.window.get_visible():
            # O layer-shell só aplica âncoras novas num novo mapeamento.
            self.close_popups()
            self.window.hide()
            self.window.show_all()

    def monitor_geometry(self):
        display = Gdk.Display.get_default()
        gdk_window = self.window.get_window()
        monitor = display.get_monitor_at_window(gdk_window) if gdk_window else None
        if monitor is None:
            monitor = display.get_primary_monitor() or display.get_monitor(0)
        return monitor.get_geometry() if monitor else None

    def dock_place(self):
        """(borda, âncora, ladrilhos antes da bandeja) do dock em que ela
        está. Adotada: pelo Dockapps.plist, no Dock depois dos lançadores e
        dos dockapps (rodando) antes dela, ou no Clip."""
        if not ADOPTED:
            return self.edge or DEFAULT_DOCK
        column, index = dockapp_slot(read_plist(dockapps_path()), running=running_names())
        state = read_plist(state_path()) or ""
        if column == "Clip":
            clip = plist_block(state, "Clip") or ""
            top_level = re.sub(r"\{[^{}]*\}", "", clip)
            edge = re.search(r"\bEdge\s*=\s*\"?(\w+)", top_level)
            anchor = re.search(r"\bAnchor\s*=\s*\"?(\w+)", top_level)
            launchers = len(re.findall(r"\bCommandLine\b", clip))
            return ((edge.group(1) if edge else "LEFT").upper(),
                    (anchor.group(1) if anchor else "TOP").upper(), launchers + index)
        edge, anchor, tiles = dock_layout()
        m = re.search(r"\bDockappTiles\s*=\s*\"?(\d+)", re.sub(r"\{[^{}]*\}", "", plist_block(state, "Dock") or ""))
        launchers = tiles - (int(m.group(1)) if m else 0)
        return edge, anchor, launchers + index

    def tile_screen(self):
        """(x, y) do ladrilho na saída e (largura, altura) da saída."""
        geo = self.monitor_geometry()
        width, height = (geo.width, geo.height) if geo else (TILE, TILE)
        x, y = tile_origin(*self.dock_place(), width, height, self.tile["margin"])
        return x, y, (width, height)

    def item_slot(self, item):
        visible = self.visible_items()
        if item not in visible:
            return None
        for i, x, y in page_slots(len(visible), self.page, self.prefs["small"]):
            if visible[i] is item:
                return x, y
        return None

    def item_rect(self, item):
        size = self.icon_size()
        x, y = self.item_slot(item) or (0, 0)
        return x, y, size, size

    def item_screen_point(self, item):
        tx, ty, _screen = self.tile_screen()
        x, y, size, _s = self.item_rect(item)
        geo = self.monitor_geometry()
        ox, oy = (geo.x, geo.y) if geo else (0, 0)
        return ox + tx + x + size // 2, oy + ty + y + size // 2

    def popup(self, menu, rect, trigger):
        """Abre menu junto da área rect do ladrilho, para dentro da tela."""
        self.cancel_balloon()
        edge = self.dock_place()[0]
        rect_anchor, menu_anchor = {
            "RIGHT": (Gdk.Gravity.NORTH_WEST, Gdk.Gravity.NORTH_EAST),
            "LEFT": (Gdk.Gravity.NORTH_EAST, Gdk.Gravity.NORTH_WEST),
            "TOP": (Gdk.Gravity.SOUTH_WEST, Gdk.Gravity.NORTH_WEST),
            "BOTTOM": (Gdk.Gravity.NORTH_WEST, Gdk.Gravity.SOUTH_WEST),
        }[edge]
        r = Gdk.Rectangle()
        r.x, r.y, r.width, r.height = rect
        self.open_menu = menu
        menu.popup_at_rect(self.area.get_window(), r, rect_anchor, menu_anchor, trigger)

    # --- Desenho (os pixels do wmsystemtray sobre o ladrilho do Dock) ------
    def visible_items(self):
        return [item for item in self.items.values() if item.visible]

    def pages(self):
        return page_count(len(self.visible_items()), self.per_page())

    def set_page(self, page):
        page = min(max(0, page), self.pages() - 1)
        if page != self.page:
            self.page = page
            self.cancel_balloon()
            self.area.queue_draw()
        self.update_input_shape()

    def relayout(self):
        self.set_page(self.page)  # a página pode ter sumido
        self.update_input_shape()
        self.area.queue_draw()

    def draw_tile(self, cr):
        style = self.tile
        size = TILE
        kind = style["type"]
        if kind == "SOLID":
            r, g, b, a = style["color"]
            cr.set_source_rgba(r / 255, g / 255, b / 255, a / 255)
        else:
            if kind == "HGRADIENT":
                coords = (0, 0, size, 0)
            elif kind == "VGRADIENT":
                coords = (0, 0, 0, size)
            elif kind == "DGRADIENT":
                coords = (0, 0, size, size)
            else:  # ADGRADIENT, como em wlmaker_primitives_cairo_fill_at
                d = max(1.0, 2.0 * size * size)
                coords = (0, 0, 2 * size * size * size / d, 2 * size * size * size / d)
            pattern = cairo.LinearGradient(*coords)
            for stop, (r, g, b, a) in ((0, style["from"]), (1, style["to"])):
                pattern.add_color_stop_rgba(stop, r / 255, g / 255, b / 255, a / 255)
            cr.set_source(pattern)
        cr.rectangle(0, 0, size, size)
        cr.fill()
        # Relevo do ladrilho (wlmaker_primitives_draw_bezel_at, levantado).
        bw = style["bezel"]
        if bw > 0:
            cr.set_source_rgba(1, 1, 1, 0.6)
            cr.move_to(0, 0)
            for px, py in ((size, 0), (size - bw, bw), (bw, bw), (bw, size - bw), (0, size)):
                cr.line_to(px, py)
            cr.close_path()
            cr.fill()
            cr.set_source_rgba(0, 0, 0, 0.4)
            cr.move_to(size, size)
            for px, py in ((0, size), (bw, size - bw), (size - bw, size - bw), (size - bw, bw), (size, 0)):
                cr.line_to(px, py)
            cr.close_path()
            cr.fill()

    def draw_arrow(self, cr, which, state):
        """state: 0 apagada, 1 normal, 2 pressionada (linhas do XPM)."""
        sx = 0 if which == "left" else ARROW_W
        dx = ARROW_LEFT_X if which == "left" else ARROW_RIGHT_X
        cr.save()
        Gdk.cairo_set_source_pixbuf(cr, self.arrows, dx - sx, ARROW_Y - state * ARROW_H)
        cr.get_source().set_filter(cairo.FILTER_NEAREST)
        cr.rectangle(dx, ARROW_Y, ARROW_W, ARROW_H)
        cr.fill()
        cr.restore()

    def draw_text(self, cr, label, x):
        cr.set_source_rgb(*hex_rgb(self.fg()))
        top = TEXT_BASELINE - FONT_ASCENT
        for ch in label:
            rows = FONT_5X8.get(ch)
            if rows:
                for gy, row in enumerate(rows.split("|")):
                    for gx, bit in enumerate(row):
                        if bit == "#":
                            cr.rectangle(x + gx, top + gy, 1, 1)
            x += 5
        cr.fill()

    def on_draw(self, _area, cr):
        self.draw_tile(cr)
        visible = self.visible_items()
        size = self.icon_size()
        for i, x, y in page_slots(len(visible), self.page, self.prefs["small"]):
            pixbuf = visible[i].pixbuf
            if pixbuf is None:
                continue
            cr.save()
            cr.translate(x, y)
            if pixbuf.get_width() != size:
                cr.scale(size / pixbuf.get_width(), size / pixbuf.get_height())
            Gdk.cairo_set_source_pixbuf(cr, pixbuf, 0, 0)
            cr.paint()
            cr.restore()
        pages = self.pages()
        self.draw_arrow(cr, "left", 0 if self.page == 0 else 2 if self.down == "left" else 1)
        self.draw_arrow(cr, "right", 0 if self.page + 1 >= pages else 2 if self.down == "right" else 1)
        label, x = page_label(self.page, pages)
        self.draw_text(cr, label, x)
        return True

    # --- Eventos -------------------------------------------------------
    def target(self, x, y):
        visible = self.visible_items()
        hit = hit_test(int(x), int(y), len(visible), self.page, self.prefs["small"])
        if hit[0] == "icon":
            return ("icon", visible[hit[1]])
        return hit

    def on_press(self, _area, event):
        if event.type != Gdk.EventType.BUTTON_PRESS:
            return True  # duplo/triplo clique: o primeiro já foi tratado
        self.cancel_balloon()
        hit = self.target(event.x, event.y)
        if event.button == 1 and hit[0] in ("left", "right"):
            self.down = hit[0]
            self.area.queue_draw()
        elif hit[0] == "icon" and event.button in (1, 2, 3):
            # O popup no Wayland precisa do evento (serial) do clique,
            # inclusive quando o menu só abre depois da resposta do Activate.
            hit[1].activate(event.button, event.copy())
        elif event.button == 3:
            self.show_frame_menu(event.copy())
        return True

    def on_release(self, _area, event):
        if event.button != 1 or self.down is None:
            return True
        hit = self.target(event.x, event.y)
        if hit[0] == self.down:
            self.set_page(self.page + (-1 if self.down == "left" else 1))
        self.down = None
        self.area.queue_draw()
        return True

    def on_scroll(self, _area, event):
        hit = self.target(event.x, event.y)
        if event.direction == Gdk.ScrollDirection.SMOOTH:
            _ok, dx, dy = event.get_scroll_deltas()
            if hit[0] == "icon":
                delta, orientation = (int(-dy * 120), "vertical") if dy else (int(dx * 120), "horizontal")
                if delta:
                    hit[1].scroll(delta, orientation)
                return True
            self.scroll_acc += dy or dx
            step = int(self.scroll_acc)
            if step:
                self.scroll_acc -= step
                self.set_page(self.page + step)
            return True
        if hit[0] == "icon":
            delta, orientation = {
                Gdk.ScrollDirection.UP: (120, "vertical"), Gdk.ScrollDirection.DOWN: (-120, "vertical"),
                Gdk.ScrollDirection.LEFT: (-120, "horizontal"), Gdk.ScrollDirection.RIGHT: (120, "horizontal"),
            }.get(event.direction, (0, "vertical"))
            if delta:
                hit[1].scroll(delta, orientation)
            return True
        # Roda para cima/esquerda volta, para baixo/direita avança (botões
        # 4 a 7 no wmsystemtray), sem dar a volta.
        if event.direction in (Gdk.ScrollDirection.UP, Gdk.ScrollDirection.LEFT):
            self.set_page(self.page - 1)
        elif event.direction in (Gdk.ScrollDirection.DOWN, Gdk.ScrollDirection.RIGHT):
            self.set_page(self.page + 1)
        return True

    def on_enter(self, area, event):
        self.autoraise(True)
        return self.on_motion(area, event)

    def on_motion(self, _area, event):
        hit = self.target(event.x, event.y)
        key = hit[1].key if hit[0] == "icon" else "tile"
        if key == self.hover:
            return False
        self.hover = key
        self.balloon.hide()
        if self.balloon_timer:
            GLib.source_remove(self.balloon_timer)
            self.balloon_timer = 0
        if self.open_menu is not None and self.open_menu.get_visible():
            return False
        if self.balloon_shown:
            self.show_balloon()
        else:
            self.balloon_timer = GLib.timeout_add(BALLOON_DELAY, self.show_balloon)
        return False

    def on_leave(self, _area, event):
        if event.mode == Gdk.CrossingMode.NORMAL:
            self.cancel_balloon()
            self.autoraise(False)
        return False

    def cancel_balloon(self):
        if self.balloon_timer:
            GLib.source_remove(self.balloon_timer)
            self.balloon_timer = 0
        self.balloon.hide()
        self.balloon_shown = False
        self.hover = None

    def show_balloon(self):
        self.balloon_timer = 0
        item = self.items.get(self.hover)
        if item is not None and item.visible and self.item_slot(item) is not None:
            self.balloon.show(item.label(), self.item_rect(item))
        else:
            # O objeto é o ladrilho inteiro, como no Window Maker.
            self.balloon.show(self.text["balloon"], (0, 0, TILE, TILE))
        self.balloon_shown = True
        return False

    def close_popups(self):
        self.cancel_balloon()
        if self.open_menu is not None:
            self.open_menu.popdown()

    # --- Menu do ladrilho (o do Window Maker para dockapps) ---------------
    def show_frame_menu(self, trigger):
        if self.frame_menu is None:
            menu = Gtk.Menu()
            for label, callback in ((self.text["settings"], self.show_settings),
                                    (self.text["kill"], self.confirm_kill)):
                entry = Gtk.MenuItem.new_with_label(label)
                entry.connect("activate", lambda _w, cb=callback: cb())
                menu.append(entry)
            menu.show_all()
            menu.attach_to_widget(self.area, None)
            self.frame_menu = menu
        self.popup(self.frame_menu, (0, 0, TILE, TILE), trigger)

    def show_settings(self):
        if self.settings is not None:
            self.settings.present()
            return
        dialog = Gtk.Dialog(title=self.text["settings_title"])
        dialog.set_icon_name("preferences-desktop")
        dialog.add_button(self.text["close"], Gtk.ResponseType.CLOSE)
        small = Gtk.CheckButton.new_with_label(self.text["small"])
        small.set_active(self.prefs["small"])
        small.connect("toggled", self.on_small_toggled)
        box = dialog.get_content_area()
        box.set_border_width(12)
        box.add(small)
        dialog.connect("response", lambda d, _r: d.destroy())
        dialog.connect("destroy", lambda _d: setattr(self, "settings", None))
        dialog.show_all()
        self.settings = dialog

    def on_small_toggled(self, button):
        self.prefs["small"] = button.get_active()
        try:
            write_prefs(self.prefs)
        except OSError as e:
            print("big-wm-tray: não foi possível gravar %s: %s" % (prefs_path(), e), file=sys.stderr)
        self.page = 0
        self.reload_icons()
        self.relayout()

    def confirm_kill(self):
        dialog = Gtk.MessageDialog(message_type=Gtk.MessageType.QUESTION, text=self.text["kill_title"])
        dialog.format_secondary_text(self.text["kill_text"])
        dialog.add_button(self.text["no"], Gtk.ResponseType.NO)
        dialog.add_button(self.text["yes"], Gtk.ResponseType.YES)
        dialog.set_default_response(Gtk.ResponseType.YES)

        def response(d, r):
            d.destroy()
            if r == Gtk.ResponseType.YES:
                Gtk.main_quit()
        dialog.connect("response", response)
        dialog.show_all()

    # --- Controle (big-wm-tray --state, testes e atalhos) ------------------
    def on_tray_call(self, _bus, _sender, _path, _iface, method, params, invocation):
        if method == "State":
            invocation.return_value(GLib.Variant("(s)", (self.state(),)))
        elif method == "Page":
            self.set_page(self.page + params.unpack()[0])
            invocation.return_value(None)

    def state(self):
        visible = self.visible_items()
        shown = {visible[i].key for i, _x, _y in page_slots(len(visible), self.page, self.prefs["small"])}
        tx, ty, screen = self.tile_screen()
        geo = self.monitor_geometry()
        lines = [
            "page %d/%d" % (self.page + 1, self.pages()),
            "per_page %d" % self.per_page(),
            "theme %s fg %s" % (self.mode, self.fg()),
            "icon_size %d" % self.icon_size(),
            "dock %s %s %d" % self.dock_place(),
            "adopted %s" % ("yes" if ADOPTED else "no"),
            "level %s %s" % (self.level or "top", "top" if GtkLayerShell.get_layer(self.window)
                             == GtkLayerShell.Layer.TOP else "bottom"),
            "theme_file %s" % (self.theme_file or "-"),
            "output %d %d %d %d" % ((geo.x, geo.y, geo.width, geo.height) if geo else (0, 0) + screen),
            "tile %d %d %d %d" % (tx, ty, TILE, TILE),
            "tile_fill %s #%02x%02x%02x" % ((self.tile["type"],) + tuple(
                self.tile["color" if self.tile["type"] == "SOLID" else "from"][:3])),
            "balloon %s" % (self.balloon.text.replace("\n", "\\n") or "-"),
            "menu %s" % ("frame" if self.open_menu is self.frame_menu and self.open_menu is not None
                         and self.open_menu.get_visible() else
                         "item" if self.open_menu is not None and self.open_menu.get_visible() else "-"),
        ]
        for item in self.items.values():
            status = ("shown" if item.key in shown else "other-page") if item.visible else (
                "passive" if item.loaded else "loading")
            lines.append("item %s %s %s %s" % (item.key, item.props.get("Id", "-") or "-", status, item.source))
        return "\n".join(lines) + "\n"

    def on_unix_signal(self, signum):
        # SIGUSR1/SIGUSR2: página anterior/próxima, dando a volta.
        pages = self.pages()
        self.set_page((self.page + (-1 if signum == signal.SIGUSR1 else 1)) % pages)
        return True

    # --- Watcher -------------------------------------------------------
    def own_watcher(self):
        node = Gio.DBusNodeInfo.new_for_xml(WATCHER_XML)
        self.bus.register_object_with_closures2(
            WATCHER_PATH, node.interfaces[0], self.on_watcher_call,
            self.on_watcher_property, None)
        Gio.bus_own_name_on_connection(self.bus, WATCHER_NAME, Gio.BusNameOwnerFlags.NONE,
                                       None, self.on_watcher_lost)
        self.bus.signal_subscribe("org.freedesktop.DBus", "org.freedesktop.DBus",
                                  "NameOwnerChanged", "/org/freedesktop/DBus", None,
                                  Gio.DBusSignalFlags.NONE, self.on_name_owner_changed)

    def on_watcher_lost(self, _bus, _name):
        # Outro watcher (ex.: snixembed) já existe: lê os itens dele.
        self.bus.signal_subscribe(WATCHER_NAME, WATCHER_NAME, None, WATCHER_PATH, None,
                                  Gio.DBusSignalFlags.NONE, self.on_foreign_watcher_signal)
        try:
            reply = self.bus.call_sync(WATCHER_NAME, WATCHER_PATH, "org.freedesktop.DBus.Properties",
                                       "Get", GLib.Variant("(ss)", (WATCHER_NAME, "RegisteredStatusNotifierItems")),
                                       None, Gio.DBusCallFlags.NONE, 2000, None)
            for service in reply.unpack()[0]:
                self.add_item(service, None)
            self.bus.call_sync(WATCHER_NAME, WATCHER_PATH, WATCHER_NAME, "RegisterStatusNotifierHost",
                               GLib.Variant("(s)", (self.bus.get_unique_name(),)),
                               None, Gio.DBusCallFlags.NONE, 2000, None)
        except GLib.Error:
            pass

    def on_foreign_watcher_signal(self, _bus, _sender, _path, _iface, signal_name, params):
        service = params.unpack()[0] if params.n_children() else None
        if signal_name == "StatusNotifierItemRegistered":
            self.add_item(service, None)
        elif signal_name == "StatusNotifierItemUnregistered" and service:
            bus_name, path = split_service(service, None)
            self.remove_item(f"{bus_name}{path}")

    def on_watcher_call(self, _bus, sender, _path, _iface, method, params, invocation):
        if method == "RegisterStatusNotifierItem":
            service = params.unpack()[0]
            key = self.add_item(service, sender)
            if key:
                self.emit("StatusNotifierItemRegistered", GLib.Variant("(s)", (key,)))
        elif method == "RegisterStatusNotifierHost":
            self.emit("StatusNotifierHostRegistered", None)
        invocation.return_value(None)

    def on_watcher_property(self, _bus, _sender, _path, _iface, prop):
        if prop == "RegisteredStatusNotifierItems":
            return GLib.Variant("as", list(self.items))
        if prop == "IsStatusNotifierHostRegistered":
            return GLib.Variant("b", True)
        if prop == "ProtocolVersion":
            return GLib.Variant("i", 0)
        return None

    def emit(self, signal_name, params):
        self.bus.emit_signal(None, WATCHER_PATH, WATCHER_NAME, signal_name, params)

    def on_name_owner_changed(self, _bus, _sender, _path, _iface, _signal, params):
        name, _old, new = params.unpack()
        if new:
            return
        for key in [k for k, item in self.items.items() if item.bus_name == name]:
            self.remove_item(key)
            self.emit("StatusNotifierItemUnregistered", GLib.Variant("(s)", (key,)))

    # --- Itens ----------------------------------------------------------
    def add_item(self, service, sender):
        if not service:
            return None
        bus_name, path = split_service(service, sender)
        if not bus_name:
            return None
        key = f"{bus_name}{path}"
        if key not in self.items:
            self.items[key] = Item(self, key, bus_name, path)
        return key

    def remove_item(self, key):
        item = self.items.pop(key, None)
        if item:
            if self.hover == key:
                self.cancel_balloon()
            item.close()
            self.relayout()


def own_tray_name(bus):
    """Uma bandeja por sessão: False se outra já tem o nome."""
    try:
        reply = bus.call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus",
                              "org.freedesktop.DBus", "RequestName",
                              GLib.Variant("(su)", (TRAY_NAME, 4)),  # DO_NOT_QUEUE
                              GLib.VariantType("(u)"), Gio.DBusCallFlags.NONE, 2000, None)
    except GLib.Error:
        return True
    return reply.unpack()[0] in (1, 4)  # PRIMARY_OWNER, ALREADY_OWNER


def print_state():
    load_gi()
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SESSION)
        reply = bus.call_sync(TRAY_NAME, TRAY_PATH, TRAY_NAME, "State", None,
                              GLib.VariantType("(s)"), Gio.DBusCallFlags.NONE, 3000, None)
    except GLib.Error as e:
        print("big-wm-tray: bandeja não está rodando (%s)" % e.message, file=sys.stderr)
        return 1
    sys.stdout.write(reply.unpack()[0])
    return 0


def main():
    if sys.argv[1:] == ["--state"]:
        return print_state()
    if sys.argv[1:] == ["--autostart"]:
        if ADOPTED and removed():
            print("big-wm-tray: tirada do Dock (Removed do Dockapps.plist); "
                  "abra pelo menu Aparência > Dockapps", file=sys.stderr)
            return 0
    elif sys.argv[1:]:
        print("uso: big-wm-tray [--autostart | --state]", file=sys.stderr)
        return 2
    load_gi()
    if not Gtk.init_check(sys.argv)[0] or not GtkLayerShell.is_supported():
        print("big-wm-tray: precisa de um compositor Wayland com layer-shell", file=sys.stderr)
        return 1
    bus = Gio.bus_get_sync(Gio.BusType.SESSION)
    if not own_tray_name(bus):
        print("big-wm-tray: a bandeja já está rodando nesta sessão", file=sys.stderr)
        return 0
    tray = Tray(bus)
    try:  # PyGObject 3.52+: GLibUnix; antes, GLib.unix_signal_add
        gi_require = __import__("gi").require_version
        gi_require("GLibUnix", "2.0")
        from gi.repository import GLibUnix
        signal_add = GLibUnix.signal_add
    except (ImportError, ValueError):
        signal_add = GLib.unix_signal_add
    for signum in (signal.SIGUSR1, signal.SIGUSR2):
        signal_add(GLib.PRIORITY_DEFAULT, signum, tray.on_unix_signal, signum)
    for signum in (signal.SIGTERM, signal.SIGINT):
        signal_add(GLib.PRIORITY_DEFAULT, signum, Gtk.main_quit)
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
