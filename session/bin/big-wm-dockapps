#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-or-later
#
# Dockapps da sessão Wayland (wlmaker): ladrilhos ao lado do Clip, como os
# dockapps do Dock na sessão X11. Iniciado pelo autostart.
#
#   big-wm-dockapps
#
# A lista vem de ~/.config/big-wm/dockapps (um comando por linha; # comenta)
# ou, sem o arquivo, do padrão: os dockapps do Dock da sessão X11, os
# mesmos programas (o wlmaker põe a janela de ícone de um dockapp X11 num
# ladrilho, pelo XWayland): relógio, volume (wmpulsemixer: saída e
# microfone; sem ele, o wmix), música (wmusic, players MPRIS), CPU,
# memória, rede, organização
# de janelas (wmake-zones-wl), histórico da área de transferência, desligar
# e os olhos (wlmeyes --dockapp, igual ao wmeyes, que no XWayland não veria
# o ponteiro). Sem o XWayland (sem DISPLAY) ou sem o programa do X11, o
# nativo do wlmaker de mesma função. Havendo bateria, a bateria. Os outros
# dockapps ficam em Configurações > Dockapps no menu.
# Os que foram tirados do Dock ou do Clip (lista "Removed" do
# ~/.config/wlmaker/Dockapps.plist) ficam de fora.

list=${XDG_CONFIG_HOME:-$HOME/.config}/big-wm/dockapps

# Programa que um comando roda, como o ladrilho se chama no wlmaker (o
# WM_CLASS de um dockapp X11): os invólucros do Big WindowMaker rodam o
# dockapp do X11 de mesmo papel.
program_of() {
	case $1 in
	big-wm-clock) echo wmclock ;;
	big-wm-mixer) echo wmix ;;
	*) echo "${1##*/}" ;;
	esac
}

# Dockapps do X11 (programas): só com o XWayland. Os do catálogo do menu
# (big-wm-appmenu, XWAYLAND_DOCKAPPS) e os do padrão.
x11_programs=" big-wm-tabbed-dock-dockapp wmclock wmpulsemixer wmix wmcpuload wmmemload wmnet wmcliphist wmshutdown wmcube wmfsm wmglobe wmgtemp
 wmCalClock wmtime wmclockmon wmtz pclock minicontrol wmcpufreq wmmon wmtop wmwifi wmbattery wmapmload
 wmusic wmweather wmsun wmmoonclock wmcalc minidock wmudmount mount.app "
# Os de GTK só desenham a janela de ícone com o backend X11; os aplicativos
# que eles abrem (big-wm-open) voltam ao Wayland (BIG_WM_DOCKAPP_X11).
gtk_programs=" wmcliphist wmshutdown minidock minicontrol wmudmount "
# (o wmpulsemixer já pede o backend X11 sozinho)

# O primeiro disponível de cada grupo "a|b|c".
first_available() {
	local IFS='|' alt
	for alt in $1; do
		local name=${alt%% *}
		local program
		program=$(program_of "$name")
		case $x11_programs in *" $program "*) [ -n "${DISPLAY:-}" ] || continue ;; esac
		if ! command -v "$name" >/dev/null || ! command -v "$program" >/dev/null; then
			continue
		fi
		echo "$alt"
		return
	done
}

# Grupos de mesma função: o do X11 primeiro, depois os nativos. Volume: o
# wmpulsemixer (-w: modo dockapp), senão o wmix, senão o nativo; um só.
# Música: o wmusic sem -w (nele -w seria janela comum), com o player de
# música padrão no clique duplo do visor.
# O controlador do Dock com Abas (X11, pelo XWayland; o menu dele no wlmaker
# vem do Dockapps.d).
groups=(big-wm-tabbed-dock-dockapp "big-wm-clock|wlmcalclock|wlmclock" "wmpulsemixer -w|big-wm-mixer|wlmmixer"
	'wmusic -c "big-wm-open music"'
	"wmcpuload|wlmcpugraph" "wmmemload|wlmmemgraph" "wmnet -w|wlmnetgraph"
	wmake-zones-wl wmcliphist wmshutdown "wlmeyes --dockapp")

# Programas do mesmo grupo que $1 (ele incluso).
same_function() {
	local group alt found IFS='|'
	for group in "${groups[@]}"; do
		found=0
		for alt in $group; do [ "$(program_of "${alt%% *}")" = "$1" ] && found=1; done
		[ "$found" = 1 ] || continue
		for alt in $group; do program_of "${alt%% *}"; done
		return
	done
	echo "$1"
}

if [ -r "$list" ]; then
	mapfile -t apps < <(sed -e 's/#.*//' -e '/^[[:space:]]*$/d' "$list")
else
	apps=()
	for group in "${groups[@]}"; do
		app=$(first_available "$group")
		[ -n "$app" ] && apps+=("$app")
	done
	compgen -G '/sys/class/power_supply/BAT*' >/dev/null && apps+=(wlmbattery)
fi

# Estado do Dock e do Clip guardado pelo wlmaker (~/.config/wlmaker/
# Dockapps.plist): "Removed" são os dockapps que o usuário tirou (arrastados
# para fora, como no Window Maker), que não iniciam mais com a sessão até
# serem abertos de novo pelo menu; "Order" (Clip) e "Dock" são os que estão
# acoplados. Um dockapp do catálogo do menu que ficou acoplado inicia com a
# sessão, como um dockapp acoplado no X11.
mapfile -t state < <(BIG_WM_APPMENU=${BIG_WM_APPMENU:-$(command -v big-wm-appmenu)} python3 -I -c 'import os, re, sys
try:
    t = open(sys.argv[1], encoding="utf-8").read()
except OSError:
    sys.exit(0)
def names(key):
    m = re.search(r"(?:^|[\s{;])%s\s*=\s*\((.*?)\)" % key, t, re.S)
    return [n.strip().strip("\"") for n in (m.group(1).split(",") if m else []) if n.strip()]
catalog = set()
path = os.environ.get("BIG_WM_APPMENU")
if path:
    from importlib.machinery import SourceFileLoader
    from importlib.util import module_from_spec, spec_from_loader
    sys.dont_write_bytecode = True
    try:
        loader = SourceFileLoader("big_wm_appmenu", path)
        menu = module_from_spec(spec_from_loader("big_wm_appmenu", loader))
        loader.exec_module(menu)
        catalog = {d[1]: d[0] for d in menu.WAYLAND_DOCKAPPS}
        if os.environ.get("DISPLAY"):
            catalog.update({d[1]: d[0] for d in menu.XWAYLAND_DOCKAPPS})
    except Exception:
        pass
# A bandeja tem o próprio autostart (adotada pelo wlmaker).
catalog.pop("big-wm-tray", None)
for n in names("Removed"):
    print("R", n)
for n in names("Order") + names("Dock"):
    if n in catalog:
        print("P", n, catalog[n])' "${XDG_CONFIG_HOME:-$HOME/.config}/wlmaker/Dockapps.plist" 2>/dev/null)
removed=$(printf '%s\n' "${state[@]}" | sed -n 's/^R //p')
for line in "${state[@]}"; do
	[ "${line%% *}" = P ] || continue
	rest=${line#P }
	name=${rest%% *}
	command=${rest#* }
	# Já na lista, ele ou um de mesma função (um nativo acoplado antes
	# não roda ao lado do dockapp do X11 que o substituiu).
	known=0
	mapfile -t same < <(same_function "$name")
	for app in "${apps[@]}"; do
		p=$(program_of "${app%% *}")
		[ "$p" = "$name" ] && known=1
		case $x11_programs in *" $p "*)
			for s in "${same[@]}"; do [ "$p" = "$s" ] && known=1; done ;;
		esac
	done
	[ "$known" = 1 ] || apps+=("$command")
done

# Já rodando nesta sessão (mesmo DISPLAY do XWayland, ou mesmo
# WAYLAND_DISPLAY): o autostart rodado de novo (wlmaker reiniciado, a
# sessão restaurada) não abre um segundo ladrilho do mesmo dockapp.
running_here() {
	local pid env want
	case $x11_programs in
	*" $1 "*) want=${DISPLAY:+DISPLAY=$DISPLAY} ;;
	*) want=${WAYLAND_DISPLAY:+WAYLAND_DISPLAY=$WAYLAND_DISPLAY} ;;
	esac
	# Sem a variável não há sessão com que comparar.
	[ -n "$want" ] || return 1
	for pid in $(pgrep -u "$(id -u)" -x -- "${1:0:15}" 2>/dev/null); do
		env=$(tr '\0' '\n' <"/proc/$pid/environ" 2>/dev/null) || continue
		grep -qxF -- "$want" <<<"$env" && return 0
	done
	return 1
}

for app in "${apps[@]}"; do
	name=${app%% *}
	program=$(program_of "$name")
	grep -qxF -- "$program" <<<"$removed" && continue
	command -v "$name" >/dev/null || continue
	if running_here "$program"; then
		logger -t big-wm-dockapps -- "$program já está aberto nesta sessão" 2>/dev/null
		continue
	fi
	case $x11_programs in
	*" $program "*)
		[ -n "${DISPLAY:-}" ] || continue
		# Cada linha é um comando, com argumentos entre aspas (o
		# wmusic -c "big-wm-open music" do catálogo).
		case $gtk_programs in
		*" $program "*)
			(export GDK_BACKEND=x11 BIG_WM_DOCKAPP_X11=1; eval "$app") &
			;;
		*)
			(eval "$app") &
			;;
		esac
		;;
	*)
		(eval "$app") &
		;;
	esac
done
wait
