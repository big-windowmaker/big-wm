#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-or-later
#
# Papel de parede das sessões Big WindowMaker.
#
#   big-wm-wallpaper ARQUIVO      aplica e guarda a escolha
#   big-wm-wallpaper --restore    aplica a escolha guardada (ou o padrão)
#   big-wm-wallpaper --mode MODO  muda o ajuste do papel de parede atual:
#       fill     preenche cada monitor sem deformar (corta as sobras; padrão)
#       fit      inteiro dentro de cada monitor, sem deformar
#       center   no tamanho original, centralizado
#       stretch  estica até o tamanho do monitor (deforma)
#       tile     lado a lado
#       span     uma imagem só por todos os monitores (X11; no Wayland, fill)
#
# Wayland: swaybg (layer-shell) numa unidade transitória do systemd --user,
# independente de quem chamou (menu do wlmaker, terminal, autostart). O novo
# sobe antes de o anterior sair, para a tela não piscar. X11: wmsetbg, que
# também grava a escolha no Window Maker (menu Aparência > Papéis de parede).
#
# No X11 a imagem é sempre reduzida ou ampliada com suavização (wmsetbg -S,
# filtro Catmull-Rom do wrlib). Sem isso o wmsetbg usava o vizinho mais
# próximo e gravava SmoothWorkspaceBack = NO: imagens serrilhadas, e o
# "esticar" de antes deformava imagens de outra proporção (16:9 num
# monitor 21:9). A imagem original nunca é alterada; a escala é feita uma
# vez por aplicação (login, troca de imagem ou de modo), não por quadro.
#
# A escolha guardada (~/.config/big-wm/wallpaper) é o caminho da imagem e,
# numa segunda linha opcional, o modo (fill, fit, center, tile, stretch,
# span); ou "color:#rrggbb" para uma cor sólida. O big-wm-wprefs-sync
# grava ali o fundo escolhido no WPrefs (WorkspaceBack).

set -u
mode=fill
color=

state=${XDG_CONFIG_HOME:-$HOME/.config}/big-wm/wallpaper
default=/usr/share/backgrounds/big-wm/default.jpg
unitfile=${XDG_RUNTIME_DIR:-/tmp}/big-wm-swaybg.unit

file='' saved_file='' saved_mode=''
if [ -r "$state" ]; then
	{
		IFS= read -r saved_file
		IFS= read -r saved_mode
	} <"$state"
fi

valid_mode() {
	case $1 in
	fill | fit | center | tile | stretch | span) return 0 ;;
	esac
	return 1
}

# Guarda imagem e modo; o padrão do sistema (default.jpg) com o modo padrão
# não é guardado, para seguir o padrão quando ele mudar.
save() { # arquivo, modo
	if [ "$1" = "$default" ] && [ "$2" = fill ]; then
		rm -f "$state"
	else
		mkdir -p "${state%/*}" && printf '%s\n%s\n' "$1" "$2" >"$state"
	fi
}

case ${1:-} in
--restore)
	file=$saved_file
	mode=${saved_mode:-fill}
	valid_mode "$mode" || mode=fill
	case ${file:-} in
	color:\#[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) color=${file#color:} ;;
	*) [ -r "${file:-}" ] || file=$default ;;
	esac
	;;
--mode)
	mode=${2:-}
	valid_mode "$mode" || {
		echo "uso: ${0##*/} --mode fill|fit|center|stretch|tile|span" >&2
		exit 2
	}
	case ${saved_file:-} in
	color:*)
		echo "${0##*/}: o fundo atual é uma cor sólida" >&2
		exit 1
		;;
	esac
	file=$saved_file
	[ -r "${file:-}" ] || file=$default
	save "$file" "$mode"
	;;
'' | -h | --help)
	echo "uso: ${0##*/} ARQUIVO | --restore | --mode MODO" >&2
	exit 2
	;;
*)
	file=$(realpath -e -- "$1" 2>/dev/null) || {
		echo "${0##*/}: arquivo não encontrado: $1" >&2
		exit 1
	}
	mode=${saved_mode:-fill}
	valid_mode "$mode" || mode=fill
	# Escolher o padrão (default.jpg) volta a seguir o padrão do sistema: o
	# realpath gravaria a imagem para onde ele aponta hoje, e uma troca do
	# papel de parede padrão não chegaria mais a esta conta.
	if [ "$file" = "$(realpath -e -- "$default" 2>/dev/null)" ] && [ "$(realpath -s -- "$1")" = "$default" ]; then
		file=$default
	fi
	save "$file" "$mode"
	;;
esac

if [ -n "${WAYLAND_DISPLAY:-}" ]; then
	old=$(cat "$unitfile" 2>/dev/null)
	unit=big-wm-swaybg-$$-$EPOCHSECONDS.service
	if [ -n "$color" ]; then
		bg=(swaybg -c "$color")
	else
		# swaybg pinta cada saída separadamente: "span" vira "fill".
		bg=(swaybg -m "${mode/span/fill}" -i "$file")
	fi
	if systemd-run --user --quiet --collect --unit="$unit" \
		--setenv=WAYLAND_DISPLAY="$WAYLAND_DISPLAY" "${bg[@]}" 2>/dev/null; then
		echo "$unit" >"$unitfile"
		sleep 0.5
		new=$(systemctl --user show "$unit" -p MainPID --value 2>/dev/null)
	else
		# Sem systemd --user (contêiner de testes, sessão iniciada à mão).
		setsid "${bg[@]}" >/dev/null 2>&1 </dev/null &
		new=$!
		sleep 0.5
	fi
	[ -n "$old" ] && systemctl --user stop "$old" 2>/dev/null
	# swaybg de versões anteriores ou iniciado à mão: só fica o novo.
	for pid in $(pgrep -u "$EUID" -x swaybg); do
		[ "$pid" = "$new" ] || kill "$pid" 2>/dev/null
	done
elif [ -n "$color" ]; then
	# Cor sólida: no X11 o fundo já é o WorkspaceBack do Window Maker.
	exit 0
else
	case $mode in
	fill) how=(-f) ;;
	fit) how=(-a) ;;
	center) how=(-e) ;;
	tile) how=(-t) ;;
	stretch) how=(-s) ;;
	span) how=(-X -f) ;;
	esac
	# -u também grava no Window Maker (WorkspaceBack, SmoothWorkspaceBack),
	# que reaplica o mesmo fundo ao reiniciar.
	exec wmsetbg -u -S "${how[@]}" "$file"
fi
