#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-or-later
#
# Papel de parede das sessões Big WindowMaker.
#
#   big-wm-wallpaper ARQUIVO    aplica e guarda a escolha
#   big-wm-wallpaper --restore  aplica a escolha guardada (ou o padrão)
#
# Wayland: swaybg (layer-shell) numa unidade transitória do systemd --user,
# independente de quem chamou (menu do wlmaker, terminal, autostart). O novo
# sobe antes de o anterior sair, para a tela não piscar. X11: wmsetbg, que
# também grava a escolha no Window Maker (menu Aparência > Papéis de parede).
#
# A escolha guardada (~/.config/big-wm/wallpaper) é o caminho da imagem e,
# numa segunda linha opcional, o modo do swaybg (fill, fit, center, tile,
# stretch); ou "color:#rrggbb" para uma cor sólida. O big-wm-wprefs-sync
# grava ali o fundo escolhido no WPrefs (WorkspaceBack).

set -u
mode=fill
color=

state=${XDG_CONFIG_HOME:-$HOME/.config}/big-wm/wallpaper
default=/usr/share/backgrounds/big-wm/default.jpg
unitfile=${XDG_RUNTIME_DIR:-/tmp}/big-wm-swaybg.unit

case ${1:-} in
--restore)
	{
		IFS= read -r file
		IFS= read -r mode
	} <"$state" 2>/dev/null
	case ${mode:-} in
	fill | fit | center | tile | stretch) ;;
	*) mode=fill ;;
	esac
	case ${file:-} in
	color:\#[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) color=${file#color:} ;;
	*) [ -r "${file:-}" ] || file=$default ;;
	esac
	;;
'' | -h | --help)
	echo "uso: ${0##*/} ARQUIVO | --restore" >&2
	exit 2
	;;
*)
	file=$(realpath -e -- "$1" 2>/dev/null) || {
		echo "${0##*/}: arquivo não encontrado: $1" >&2
		exit 1
	}
	# Escolher o padrão (default.jpg) volta a seguir o padrão do sistema: o
	# realpath gravaria a imagem para onde ele aponta hoje, e uma troca do
	# papel de parede padrão não chegaria mais a esta conta.
	if [ "$file" = "$(realpath -e -- "$default" 2>/dev/null)" ] && [ "$(realpath -s -- "$1")" = "$default" ]; then
		rm -f "$state"
	else
		mkdir -p "${state%/*}" && printf '%s\n' "$file" >"$state"
	fi
	;;
esac

if [ -n "${WAYLAND_DISPLAY:-}" ]; then
	old=$(cat "$unitfile" 2>/dev/null)
	unit=big-wm-swaybg-$$-$EPOCHSECONDS.service
	if [ -n "$color" ]; then
		bg=(swaybg -c "$color")
	else
		bg=(swaybg -m "$mode" -i "$file")
	fi
	if systemd-run --user --quiet --collect --unit="$unit" \
		--setenv=WAYLAND_DISPLAY="$WAYLAND_DISPLAY" "${bg[@]}" 2>/dev/null; then
		echo "$unit" >"$unitfile"
		sleep 0.5
		new=$(systemctl --user show "$unit" -p MainPID --value 2>/dev/null)
	else
		# Sem systemd --user (contêiner de testes, sessão iniciada à mão).
		setsid "${bg[@]}" >/dev/null 2>&1 </dev/null &
		new=$!
		sleep 0.5
	fi
	[ -n "$old" ] && systemctl --user stop "$old" 2>/dev/null
	# swaybg de versões anteriores ou iniciado à mão: só fica o novo.
	for pid in $(pgrep -u "$EUID" -x swaybg); do
		[ "$pid" = "$new" ] || kill "$pid" 2>/dev/null
	done
elif [ -n "$color" ]; then
	# Cor sólida: no X11 o fundo já é o WorkspaceBack do Window Maker.
	exit 0
else
	exec wmsetbg -u -s "$file"
fi
