#!/usr/bin/python3 -Is
# SPDX-License-Identifier: GPL-2.0-or-later
#
# Spectacle na sessão Wayland do Big WindowMaker.
#
# No Wayland o Spectacle (KDE) só tira a captura pelo KWin: a interface
# D-Bus org.kde.KWin.ScreenShot2. Este serviço a oferece fora do Plasma,
# com o grim (protocolo de captura do wlmaker) e o slurp: tela inteira, uma
# tela, uma área, a janela ativa e a escolha interativa (janela ou tela). A
# seleção de região do Spectacle funciona sobre a tela inteira, como no
# Plasma.
#
#   big-wm-kwin-screenshot          serviço (autostart da sessão Wayland)
#   big-wm-kwin-screenshot --check  sai com 0 se este ambiente o aceita
#
# Só roda numa sessão wlmaker e só quando nenhum KWin de verdade tem os
# nomes: no Plasma, o KWin os tem e este sai sem fazer nada.

import os
import re
import subprocess
import sys
import threading

# O Spectacle procura o dono de org.kde.KWin.ScreenShot2 (o KWin registra
# esse nome à parte) e fala com org.kde.KWin (o /Effects).
SERVICES = ("org.kde.KWin.ScreenShot2", "org.kde.KWin")
SCREENSHOT_PATH = "/org/kde/KWin/ScreenShot2"
EFFECTS_PATH = "/Effects"
VERSION = 4  # CaptureWorkspace (Plasma 6)
FORMAT_RGB32 = 4  # QImage::Format_RGB32: 0xffRRGGBB, B G R A na memória

INTROSPECTION = """
<node>
  <interface name="org.kde.KWin.ScreenShot2">
    <property name="Version" type="u" access="read"/>
    <method name="CaptureWindow">
      <arg name="handle" type="s" direction="in"/>
      <arg name="options" type="a{sv}" direction="in"/>
      <arg name="pipe" type="h" direction="in"/>
      <arg name="results" type="a{sv}" direction="out"/>
    </method>
    <method name="CaptureActiveWindow">
      <arg name="options" type="a{sv}" direction="in"/>
      <arg name="pipe" type="h" direction="in"/>
      <arg name="results" type="a{sv}" direction="out"/>
    </method>
    <method name="CaptureArea">
      <arg name="x" type="i" direction="in"/>
      <arg name="y" type="i" direction="in"/>
      <arg name="width" type="u" direction="in"/>
      <arg name="height" type="u" direction="in"/>
      <arg name="options" type="a{sv}" direction="in"/>
      <arg name="pipe" type="h" direction="in"/>
      <arg name="results" type="a{sv}" direction="out"/>
    </method>
    <method name="CaptureScreen">
      <arg name="name" type="s" direction="in"/>
      <arg name="options" type="a{sv}" direction="in"/>
      <arg name="pipe" type="h" direction="in"/>
      <arg name="results" type="a{sv}" direction="out"/>
    </method>
    <method name="CaptureActiveScreen">
      <arg name="options" type="a{sv}" direction="in"/>
      <arg name="pipe" type="h" direction="in"/>
      <arg name="results" type="a{sv}" direction="out"/>
    </method>
    <method name="CaptureWorkspace">
      <arg name="options" type="a{sv}" direction="in"/>
      <arg name="pipe" type="h" direction="in"/>
      <arg name="results" type="a{sv}" direction="out"/>
    </method>
    <method name="CaptureInteractive">
      <arg name="kind" type="u" direction="in"/>
      <arg name="options" type="a{sv}" direction="in"/>
      <arg name="pipe" type="h" direction="in"/>
      <arg name="results" type="a{sv}" direction="out"/>
    </method>
  </interface>
  <interface name="org.kde.kwin.Effects">
    <method name="isEffectLoaded">
      <arg name="name" type="s" direction="in"/>
      <arg name="loaded" type="b" direction="out"/>
    </method>
    <property name="loadedEffects" type="as" access="read"/>
  </interface>
</node>
"""


def wlmaker_session():
    return "wlmaker" in os.environ.get("XDG_CURRENT_DESKTOP", "").split(":") and \
        bool(os.environ.get("WAYLAND_DISPLAY"))


def grim(args, cursor=False):
    """PPM do grim -> (largura, altura, bytes BGRA). None se falhar."""
    cmd = ["grim", "-t", "ppm"] + (["-c"] if cursor else []) + args + ["-"]
    try:
        out = subprocess.run(cmd, capture_output=True, timeout=20, check=True).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    # P6\n<w> <h>\n<max>\n<dados>: o cabeçalho pela expressão e o corpo
    # pela posição (um byte do corpo pode valer um espaço em branco).
    m = re.match(rb"P6\s+(\d+)\s+(\d+)\s+255\s", out)
    if m is None:
        return None
    w, h, rgb = int(m.group(1)), int(m.group(2)), out[m.end():]
    n = w * h
    if len(rgb) < 3 * n:
        return None
    bgra = bytearray(4 * n)
    bgra[0::4] = rgb[2:3 * n:3]
    bgra[1::4] = rgb[1:3 * n:3]
    bgra[2::4] = rgb[0:3 * n:3]
    bgra[3::4] = b"\xff" * n
    return w, h, bytes(bgra)


def zones(*args):
    try:
        return subprocess.run(["wmake-zones", *args], capture_output=True, text=True,
                              timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


GEOMETRY = re.compile(r"^(\d+)x(\d+)([+-]\d+)([+-]\d+)$")


def rect_of(geometry):
    """'LxA+X+Y' (também com X ou Y negativos: '1519x985+5231-2') -> (x, y, l, a)."""
    m = GEOMETRY.match(geometry.strip())
    if m is None:
        return None
    w, h, x, y = (int(v) for v in m.groups())
    return x, y, w, h


def box_of(geometry):
    """'LxA+X+Y' -> 'X,Y LxA' (grim -g / slurp), ou None."""
    r = rect_of(geometry)
    return None if r is None else f"{r[0]},{r[1]} {r[2]}x{r[3]}"


def outputs():
    """[(nome, x, y, l, a)] das saídas, pelo compositor (wmake-zones status)."""
    out = []
    for line in zones("status").splitlines():
        if line.startswith("monitor="):
            name, _, rest = line[len("monitor="):].partition(" ")
            r = rect_of(rest.split(" ")[0])
            if r is not None:
                out.append((name,) + r)
    return out


def output_scale(name):
    """A escala da saída (status do wmake-zones), 1.0 se não se sabe."""
    for line in zones("status").splitlines():
        if line.startswith(f"monitor={name} "):
            m = re.search(r"\bscale=([0-9.]+)", line)
            if m:
                return float(m.group(1)) or 1.0
    return 1.0


def output_at(x, y, outs=None):
    for name, ox, oy, w, h in outs if outs is not None else outputs():
        if ox <= x < ox + w and oy <= y < oy + h:
            return name
    return None


def pointer_output():
    """A saída sob o ponteiro, no momento do pedido (o "monitor atual" do
    KWin). O wlmaker com o comando "pointer" do wmake-zones a informa; um
    anterior não: vale a saída da janela ativa, depois a primeira."""
    out = zones("pointer").split()
    if len(out) >= 3 and not out[0].startswith("error="):
        return out[2]
    outs = outputs()
    act = zones("active").splitlines()
    if act and not act[0].startswith("error="):
        r = rect_of(act[0].split("\t")[0])
        if r is not None:
            name = output_at(r[0] + r[2] // 2, r[1] + r[3] // 2, outs)
            if name:
                return name
    return outs[0][0] if outs else None


def active_window_box():
    out = zones("active").splitlines()
    if out and not out[0].startswith("error="):
        return box_of(out[0].split("\t")[0])
    return None


# O Spectacle espera a CaptureInteractive por 60 s: o slurp termina antes,
# para não ficar segurando o teclado e o ponteiro depois que ele desistiu.
SLURP_TIMEOUT = 50
_slurp_lock = threading.Lock()
_slurp_proc = [None]


def window_boxes():
    """Caixas das janelas para a escolha (a ativa primeiro: o slurp fica com
    a primeira que contém o ponteiro), só as que aparecem numa saída."""
    outs = outputs()
    act = zones("active").splitlines()
    active = act[0].split("\t")[0] if act and not act[0].startswith("error=") else None
    boxes = []
    for line in zones("windows", "-l").splitlines():
        f = line.split("\t")
        if len(f) < 4:
            continue
        r = rect_of(f[3])
        if r is None or r[2] <= 0 or r[3] <= 0:
            continue
        if outs and not any(output_at(x, y, outs) for x, y in
                            ((r[0] + r[2] // 2, r[1] + r[3] // 2), (r[0], r[1]),
                             (r[0] + r[2] - 1, r[1] + r[3] - 1))):
            continue                    # minimizada ou fora das telas
        box = f"{r[0]},{r[1]} {r[2]}x{r[3]}"
        if f[3] == active:
            boxes.insert(0, box)
        else:
            boxes.append(box)
    return boxes


def slurp(kind):
    """Escolha interativa: 0 = janela (as caixas das janelas), 1 = tela.
    Esc cancela; um pedido novo encerra o anterior; nunca passa do prazo."""
    if kind == 1:
        cmd, data = ["slurp", "-o", "-f", "%x,%y %wx%h"], None
    else:
        cmd, data = ["slurp", "-r", "-f", "%x,%y %wx%h"], "\n".join(window_boxes()) + "\n"
    with _slurp_lock:
        old = _slurp_proc[0]
        if old is not None and old.poll() is None:
            old.terminate()
        try:
            proc = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                    stderr=subprocess.DEVNULL, text=True)
        except OSError:
            return None
        _slurp_proc[0] = proc
    try:
        out, _ = proc.communicate(data, timeout=SLURP_TIMEOUT)
    except subprocess.TimeoutExpired:
        proc.kill()
        proc.communicate()
        return None
    finally:
        with _slurp_lock:
            if _slurp_proc[0] is proc:
                _slurp_proc[0] = None
    return out.strip() if proc.returncode == 0 and out.strip() else None


def main():
    if "--check" in sys.argv[1:]:
        return 0 if wlmaker_session() else 1
    if not wlmaker_session():
        return 0

    import warnings
    # register_object com funções Python (não closures): marcado obsoleto,
    # mas é a forma que o PyGObject oferece.
    warnings.filterwarnings("ignore", category=DeprecationWarning)
    import gi
    gi.require_version("Gio", "2.0")
    from gi.repository import Gio, GLib

    node = Gio.DBusNodeInfo.new_for_xml(INTROSPECTION)
    loop = GLib.MainLoop()

    def options_of(params, index):
        opts = params.get_child_value(index).unpack() if params.n_children() > index else {}
        return opts if isinstance(opts, dict) else {}

    def error(invocation, name, text):
        invocation.return_dbus_error("org.kde.KWin.ScreenShot2.Error." + name, text)

    def send(invocation, image, pipe_index, screen=None):
        try:
            reply(invocation, image, pipe_index, screen)
        except Exception as exc:  # sempre responde: o Spectacle espera
            error(invocation, "InternalError", str(exc))

    def reply(invocation, image, pipe_index, screen=None):
        fds = invocation.get_message().get_unix_fd_list()
        if image is None:
            invocation.return_dbus_error("org.kde.KWin.ScreenShot2.Error.InternalError",
                                         "grim falhou")
            return
        if fds is None:
            invocation.return_dbus_error("org.kde.KWin.ScreenShot2.Error.InvalidArguments",
                                         "sem o descritor do pipe")
            return
        # Os descritores passam a ser só nossos (steal_fds): o do pipe é
        # fechado ao fim da escrita, e quem lê recebe o fim do arquivo na
        # hora (com fds.get(), o original ficava preso na mensagem).
        owned = fds.steal_fds()
        fd = owned[pipe_index] if 0 <= pipe_index < len(owned) else -1
        for other in owned:
            if other != fd:
                os.close(other)
        if fd < 0:
            invocation.return_dbus_error("org.kde.KWin.ScreenShot2.Error.InvalidArguments",
                                         "descritor do pipe inválido")
            return
        w, h, data = image
        meta = {
            "type": GLib.Variant("s", "raw"),
            "width": GLib.Variant("u", w),
            "height": GLib.Variant("u", h),
            "stride": GLib.Variant("u", 4 * w),
            "format": GLib.Variant("u", FORMAT_RGB32),
            "scale": GLib.Variant("d", output_scale(screen) if screen else 1.0),
        }
        if screen:
            # Sem a saída, o Spectacle põe cada tela em (0, 0) ao juntar
            # "Todas as telas" (uma cobria as outras) e a região de cada
            # monitor mostrava a imagem de outro.
            meta["screen"] = GLib.Variant("s", screen)
        results = GLib.Variant("a{sv}", meta)
        invocation.return_value(GLib.Variant.new_tuple(results))

        def write():
            try:
                with os.fdopen(fd, "wb") as f:
                    f.write(data)
            except OSError:
                pass
        threading.Thread(target=write, daemon=True).start()

    def capture(invocation, method, params):
        """Captura numa thread (o slurp espera o usuário) e responde."""
        def work():
            try:
                run()
            except Exception as exc:  # sempre responde: o Spectacle espera
                msg = str(exc)
                GLib.idle_add(lambda: error(invocation, "InternalError", msg) or False)

        def run():
            image = None
            screen = None
            if method == "CaptureArea":
                x, y, w, h = (params.get_child_value(i).unpack() for i in range(4))
                opts, pipe = options_of(params, 4), params.get_child_value(5).unpack()
                image = grim(["-g", f"{x},{y} {w}x{h}"], opts.get("include-cursor", False))
            elif method == "CaptureScreen":
                name = params.get_child_value(0).unpack()
                opts, pipe = options_of(params, 1), params.get_child_value(2).unpack()
                image = grim(["-o", name] if name else [], opts.get("include-cursor", False))
                screen = name or None
            elif method in ("CaptureActiveWindow", "CaptureWindow"):
                i = 0 if method == "CaptureActiveWindow" else 1
                opts, pipe = options_of(params, i), params.get_child_value(i + 1).unpack()
                box = active_window_box()
                image = grim(["-g", box] if box else [], opts.get("include-cursor", False))
            elif method == "CaptureInteractive":
                kind = params.get_child_value(0).unpack()
                opts, pipe = options_of(params, 1), params.get_child_value(2).unpack()
                box = slurp(kind)
                if box is None:
                    GLib.idle_add(lambda: invocation.return_dbus_error(
                        "org.kde.KWin.ScreenShot2.Error.Cancelled", "cancelado") and False)
                    return
                image = grim(["-g", box], opts.get("include-cursor", False))
                if kind == 1:
                    x, _, rest = box.partition(",")
                    y = rest.split(" ")[0]
                    screen = output_at(int(x), int(y))
            elif method == "CaptureActiveScreen":
                # O monitor atual: o do ponteiro (não a área de trabalho toda).
                opts, pipe = options_of(params, 0), params.get_child_value(1).unpack()
                screen = pointer_output()
                image = grim(["-o", screen] if screen else [], opts.get("include-cursor", False))
            else:  # CaptureWorkspace: todas as telas
                opts, pipe = options_of(params, 0), params.get_child_value(1).unpack()
                image = grim([], opts.get("include-cursor", False))
            GLib.idle_add(lambda: send(invocation, image, pipe, screen) or False)
        threading.Thread(target=work, daemon=True).start()

    def on_call(conn, sender, path, iface, method, params, invocation):
        if iface == "org.kde.kwin.Effects":
            if method == "isEffectLoaded":
                name = params.get_child_value(0).unpack()
                invocation.return_value(GLib.Variant("(b)", (name == "screenshot",)))
            else:
                invocation.return_dbus_error("org.freedesktop.DBus.Error.UnknownMethod", method)
            return
        capture(invocation, method, params)

    def on_get_property(conn, sender, path, iface, prop):
        if prop == "Version":
            return GLib.Variant("u", VERSION)
        if prop == "loadedEffects":
            return GLib.Variant("as", ["screenshot"])
        return None

    registered = []

    def on_bus(conn, name):
        if registered:
            return
        registered.append(conn.register_object(
            SCREENSHOT_PATH, node.interfaces[0], on_call, on_get_property, None))
        registered.append(conn.register_object(
            EFFECTS_PATH, node.interfaces[1], on_call, on_get_property, None))

    def on_lost(conn, name):
        # Outro serviço (o KWin de verdade) tem o nome: nada a fazer aqui.
        loop.quit()

    for service in SERVICES:
        Gio.bus_own_name(Gio.BusType.SESSION, service, Gio.BusNameOwnerFlags.DO_NOT_QUEUE,
                         on_bus, None, on_lost)
    try:
        loop.run()
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
