#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-or-later
#
# Sessão X11 do Big WindowMaker.
#
# Prepara o ambiente, aplica a configuração padrão no primeiro login,
# integra a sessão ao systemd --user (XDG autostart, portais, notificações)
# e executa o Window Maker. O binário /usr/bin/wmaker nunca é alterado.

export XDG_CURRENT_DESKTOP=WindowMaker
export XDG_SESSION_DESKTOP=WindowMaker
export DESKTOP_SESSION=big-wm

# shellcheck source=session/lib/big-wm-env.sh
. /usr/lib/big-wm/big-wm-env.sh

big-wm-firstrun x11

# Janelas GTK com a barra de título do Window Maker (ver big-wm-env.sh).
big_wm_nocsd

# O Xorg só aplica o layout configurado no systemd-localed; quando ele não
# existe (o console tem layout próprio), aplica o equivalente ao do console.
# shellcheck source=session/lib/big-wm-keyboard.sh
. /usr/lib/big-wm/big-wm-keyboard.sh
big_wm_keyboard
setxkbmap -layout "$XKB_LAYOUT" -model "$XKB_MODEL" ${XKB_VARIANT:+-variant "$XKB_VARIANT"} \
	${XKB_OPTIONS:+-option "$XKB_OPTIONS"} 2>/dev/null

big-wm-session-ctl start

# Ícones de reserva para aplicativos que não informam o próprio (sem isso o
# Window Maker mostra o cubo genérico). Só trabalha quando algo mudou.
nice -n 10 big-wm-appmenu --icons >/dev/null 2>&1 &

wmaker "$@"
status=$?

big-wm-session-ctl stop
exit "$status"
