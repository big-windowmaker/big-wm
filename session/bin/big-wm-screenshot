#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-or-later
#
# Captura de tela das duas sessões (menu Captura de tela e teclas Print do
# wlmaker). Grava em Imagens/Capturas de tela, a mesma pasta das teclas Print
# do Window Maker, e avisa com uma notificação que abre a pasta.
#
#   big-wm-screenshot full     tela inteira
#   big-wm-screenshot window   uma janela (X11: clique nela)
#   big-wm-screenshot area     área selecionada com o mouse
#
# Com o Spectacle instalado, as teclas abrem a janela dele com a captura
# (para salvar, copiar, anotar): Print a tela inteira, Alt+Print a janela
# ativa, Shift+Print uma área. No Wayland (wlmaker, sem o KWin) o
# Spectacle tira a captura pelo big-wm-kwin-screenshot (a interface
# org.kde.KWin.ScreenShot2 com o grim): tela, janela ativa e área; sem esse
# serviço, janela e área ficam com o grim + slurp.
#
# Sem o Spectacle, ou com tool=builtin em ~/.config/big-wm/screenshot.conf
# (ou BIG_WM_SCREENSHOT_TOOL=builtin), grava direto em Imagens/Capturas de
# tela e avisa: X11 com scrot, Wayland com grim + slurp. O wlmaker ainda
# não informa a posição das janelas nem oferece captura por janela
# (ext-foreign-toplevel-image-capture-source), então no Wayland "janela" é
# uma área: arraste em volta da janela.

set -u

mode=${1:-}
case $mode in
full | window | area) ;;
*)
	echo "uso: ${0##*/} full|window|area" >&2
	exit 2
	;;
esac

wayland=false
if [ "${XDG_SESSION_TYPE:-}" = wayland ] || { [ -n "${WAYLAND_DISPLAY:-}" ] && [ -z "${DISPLAY:-}" ]; }; then
	wayland=true
fi

# Ferramenta: spectacle (padrão, se instalado) ou builtin.
tool=${BIG_WM_SCREENSHOT_TOOL:-}
if [ -z "$tool" ]; then
	tool=$(sed -n 's/^[[:space:]]*tool[[:space:]]*=[[:space:]]*\([a-z]*\).*/\1/p' \
		"${XDG_CONFIG_HOME:-$HOME/.config}/big-wm/screenshot.conf" 2>/dev/null | tail -n1)
fi
# No Wayland, o serviço de captura que o Spectacle procura (o do KWin, ou o
# big-wm-kwin-screenshot da sessão Big WindowMaker) está no ar?
kwin_screenshot=false
if $wayland && command -v gdbus >/dev/null &&
	gdbus call --session --dest org.freedesktop.DBus --object-path /org/freedesktop/DBus \
		--method org.freedesktop.DBus.NameHasOwner org.kde.KWin.ScreenShot2 2>/dev/null | grep -q true; then
	kwin_screenshot=true
fi
if [ "${tool:-spectacle}" = spectacle ] && command -v spectacle >/dev/null; then
	if $kwin_screenshot; then
		case $mode in
		full) exec spectacle --fullscreen ;;
		window) exec spectacle --activewindow ;;
		area) exec spectacle --region ;;
		esac
	fi
	case $mode in
	full) exec spectacle --fullscreen ;;
	window)
		if ! $wayland; then
			# Sem janela ativa (clique na área de trabalho) o Spectacle 6.7
			# fecha com falha de segmentação: escolhe a área.
			if command -v xdotool >/dev/null && ! xdotool getactivewindow >/dev/null 2>&1; then
				exec spectacle --region
			fi
			exec spectacle --activewindow
		fi
		;;
	area) $wayland || exec spectacle --region ;;
	esac
fi

# Textos: catálogo "big-wm" (po/ na raiz do big-wm), msgids em inglês, pelo
# gettext(1) (só nas mensagens, fora de laços). BIGWM_LOCALEDIR: catálogos
# compilados fora de /usr/share/locale (testes).
_t() {
	if command -v gettext >/dev/null; then
		TEXTDOMAIN=big-wm TEXTDOMAINDIR=${BIGWM_LOCALEDIR:-/usr/share/locale} gettext "$1"
	else
		printf '%s' "$1"
	fi
}

title=$(_t "Screenshot")
# Nome da pasta: o mesmo do big-wm-firstrun (um caminho, não um texto da
# interface; não vem do catálogo). i18n-lint: ignorar
case ${LANG%%_*} in
pt) name="Capturas de tela" ;;
es) name="Capturas de pantalla" ;;
*) name=Screenshots ;;
esac

# Pasta das teclas Print do Window Maker (link para Imagens/Capturas de tela,
# criado por big-wm-firstrun); sem ela, Imagens/Capturas de tela.
dir=${WMAKER_USER_ROOT:-$HOME/GNUstep}/Library/WindowMaker/Screenshots
if [ ! -d "$dir" ]; then
	pictures=$(xdg-user-dir PICTURES 2>/dev/null)
	[ -n "$pictures" ] && [ "$pictures" != "$HOME" ] || pictures=$HOME/Pictures
	dir=$pictures/$name
	mkdir -p "$dir" || dir=$HOME
fi
# Mesmo formato de nome das capturas do Window Maker.
file="$dir/screenshot_$(date +%Y-%m-%d_at_%H:%M:%S).png"

hint() {
	notify-send -a "$title" -i applets-screenshooter -t 3000 "$title" "$1" 2>/dev/null
}

if $wayland; then
	# O slurp lê retângulos da entrada padrão quando ela não é um terminal:
	# iniciado pelo menu do wlmaker (entrada herdada, que nunca termina) ele
	# esperava para sempre e a seleção da área nunca aparecia.
	case $mode in
	full) grim "$file" ;;
	window | area)
		[ "$mode" = window ] && hint "$(_t "Drag around the window to capture (Esc cancels).")"
		geometry=$(slurp -d </dev/null) || exit 1
		grim -g "$geometry" "$file"
		;;
	esac
else
	# Uma fração de segundo para o menu do Window Maker sair da imagem.
	sleep 0.3
	case $mode in
	full) scrot --overwrite "$file" ;;
	window)
		hint "$(_t "Click the window to capture (Esc cancels).")"
		# Clique: a janela, com a moldura do Window Maker (arrastar captura
		# uma área).
		scrot --select --border --overwrite "$file"
		;;
	area) scrot --select --overwrite "$file" ;;
	esac
fi
status=$?
if [ "$status" -ne 0 ] || [ ! -s "$file" ]; then
	# Esc na seleção também termina com erro: sem arquivo, nada a avisar.
	[ "$mode" = full ] && notify-send -a "$title" -i dialog-error "$title" "$(_t "Could not take the screenshot.")" 2>/dev/null
	exit 1
fi

# Notificação com a miniatura; "Abrir a pasta" abre o gerenciador de
# arquivos. Em segundo plano: notify-send --action espera a notificação
# fechar.
open=$(_t "Open folder")
(
	action=$(notify-send -a "$title" -i "$file" --action=open="$open" \
		"$title" "${file##*/}" 2>/dev/null)
	[ "$action" = open ] && exec xdg-open "$dir"
) >/dev/null 2>&1 &
exit 0
