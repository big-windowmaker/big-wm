#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-or-later
#
# Captura de tela na sessão Wayland (grim + slurp).
# Na sessão X11 o próprio Window Maker faz as capturas (ScreenCaptureKey).
#
#   big-wm-screenshot full   tela inteira
#   big-wm-screenshot area   área selecionada com o mouse

# Mesma pasta da tecla Print na sessão X11 (criada por big-wm-firstrun).
dir=${WMAKER_USER_ROOT:-$HOME/GNUstep}/Library/WindowMaker/Screenshots
[ -d "$dir" ] || dir=$(xdg-user-dir PICTURES 2>/dev/null)
[ -d "$dir" ] || dir=$HOME
file="$dir/screenshot_$(date +%Y-%m-%d_at_%H:%M:%S).png"

case "$1" in
full) grim "$file" ;;
area)
	geometry=$(slurp) || exit 1
	grim -g "$geometry" "$file"
	;;
*)
	echo "uso: ${0##*/} full|area" >&2
	exit 2
	;;
esac || exit 1

notify-send -i "$file" "Captura de tela" "$file" 2>/dev/null
exit 0
