#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-or-later
#
# Aplica a configuração padrão do Big WindowMaker na conta do usuário.
#
#   big-wm-firstrun x11       ~/GNUstep (Window Maker)
#   big-wm-firstrun wayland   ~/.config/wlmaker (wlmaker)
#   big-wm-firstrun --reset x11|wayland
#                             renomeia a configuração atual para *.bak-<data>
#                             e aplica os padrões de novo
#
# Só copia arquivos que ainda não existem: nada do usuário é sobrescrito.
# Funciona para contas novas e para contas que já existiam antes da
# instalação, por isso o Big WindowMaker não instala nada em /etc/skel.

set -u

datadir=/usr/share/big-wm
wmicons=/usr/share/WindowMaker/Icons
kvantumdir=/usr/share/Kvantum
ashyterm=/usr/bin/ashyterm
config_home=${XDG_CONFIG_HOME:-$HOME/.config}
gnustep=${WMAKER_USER_ROOT:-$HOME/GNUstep}

reset=0
if [ "${1:-}" = --reset ]; then
	reset=1
	shift
fi

log() {
	logger -t big-wm-firstrun -- "$*" 2>/dev/null
}

# Escolhe a variante traduzida de um arquivo: nome.pt_BR, nome.pt, nome.
localized() {
	local base=$1 lang=${LANG%%.*}
	for candidate in "$base.$lang" "$base.${lang%%_*}" "$base"; do
		if [ -e "$candidate" ]; then
			echo "$candidate"
			return
		fi
	done
}

# Copia src para dst somente se dst não existir.
install_default() {
	local src=$1 dst=$2 mode=${3:-644}
	[ -e "$dst" ] && return
	install -Dm"$mode" "$src" "$dst"
}

backup() {
	local path=$1
	[ -e "$path" ] || return 0
	mv "$path" "$path.bak-$(date +%Y%m%d-%H%M%S)"
	log "configuração anterior salva: $path.bak-*"
}

# A tecla Print do Window Maker grava em ~/GNUstep/Library/WindowMaker/Screenshots
# (caminho fixo no código). Esse diretório vira um link para Imagens/Capturas
# de tela, que também é usado pela captura da sessão Wayland.
setup_screenshots() {
	local link=$gnustep/Library/WindowMaker/Screenshots pictures name
	[ -e "$link" ] || [ -L "$link" ] && return
	pictures=$(xdg-user-dir PICTURES 2>/dev/null)
	[ -n "$pictures" ] && [ "$pictures" != "$HOME" ] || pictures=$HOME/Pictures
	case "${LANG%%_*}" in
	pt) name="Capturas de tela" ;;
	es) name="Capturas de pantalla" ;;
	*) name=Screenshots ;;
	esac
	mkdir -p "$pictures/$name" "${link%/*}" && ln -s "$pictures/$name" "$link"
}

# Aplicativos Qt com o QTStep (aparência OpenStep), nas duas sessões: o
# big-wm-env.sh liga o Kvantum e o Kvantum só lê o tema da configuração do
# usuário (não há padrão do sistema). Quem já escolheu um tema fica com ele.
# fastfetch com o logo do Big WindowMaker em ASCII e os textos nas cores do
# logo. O wrapper /usr/local/bin/fastfetch da BigCommunity usa
# ~/.config/fastfetch/{ascii-art,config.jsonc} quando existem (e traduz os
# rótulos). Só para quem ainda não personalizou o fastfetch.
setup_fastfetch() {
	local dir=$config_home/fastfetch src=$datadir/fastfetch
	[ -e "$dir/ascii-art" ] || [ -e "$dir/config.jsonc" ] && return 0
	[ -r "$src/ascii-art" ] && [ -r "$src/config.jsonc" ] || return 0
	install -Dm644 "$src/ascii-art" "$dir/ascii-art" &&
		install -Dm644 "$src/config.jsonc" "$dir/config.jsonc" &&
		log "fastfetch: logo do Big WindowMaker"
}

setup_kvantum() {
	local conf=$config_home/Kvantum/kvantum.kvconfig
	[ -e "$conf" ] && return 0
	[ -d "$kvantumdir/QTStepOpenStep" ] || return 0
	mkdir -p "${conf%/*}" && printf '[General]\ntheme=QTStepOpenStep\n' >"$conf"
	log "Kvantum: tema QTStepOpenStep"
}

# AshyTerm (terminal padrão) translúcido, com o papel de parede aparecendo
# por trás do texto: transparência 22 dá cerca de 87% de opacidade no fundo
# escuro dos esquemas de cores (o padrão do AshyTerm, 16, dá 92% e quase não
# se nota). Só quando o AshyTerm ainda não tem configuração: quem já abriu o
# AshyTerm, nesta ou em outra sessão, fica com o que escolheu. O AshyTerm
# completa o arquivo com os outros padrões na primeira execução.
setup_ashyterm() {
	local conf=$config_home/ashyterm/settings.json
	[ -e "$conf" ] && return 0
	[ -e "$ashyterm" ] || return 0
	mkdir -p "${conf%/*}" && chmod 700 "${conf%/*}" && printf '{"transparency": 22}\n' >"$conf"
	log "AshyTerm: transparência 22"
}

# Menus criados por versões anteriores: troca só as linhas que mudaram (o
# caminho antigo do WPrefs, o wmmenugen que deixava "Aplicativos" vazio
# quando faltava o diretório do flatpak e o bloqueio que dependia do
# xss-lock). O resto do menu do usuário fica como está.
migrate_menu() {
	local menu=$1
	[ -w "$menu" ] || return 0
	grep -q -e 'GNUstep/Applications/WPrefs\.app' -e 'wmmenugen -parser:xdg' \
		-e 'EXEC, "loginctl lock-session"' "$menu" || return 0
	sed -i \
		-e 's#"/usr/lib/GNUstep/Applications/WPrefs\.app/WPrefs"#WPrefs#' \
		-e 's#"|| wmmenugen -parser:xdg [^"]*"#"|| big-wm-appmenu"#' \
		-e 's#EXEC, "loginctl lock-session"#EXEC, "big-wm-lock"#' \
		"$menu"
	log "menu atualizado: $menu"
}

# Menu raiz X11 de versões anteriores, sem alteração do usuário (sha256 dos
# modelos pt_BR e inglês, também depois do migrate_menu): dá lugar ao menu
# novo, com Captura de tela (tela, janela, área), Executar no rofi e Forçar
# o fechamento (Ctrl+Alt+Esc). Um menu editado fica como está.
migrate_menu_default() {
	local menu=$1
	[ -f "$menu" ] || return 0
	case $(sha256sum "$menu" | cut -d' ' -f1) in
	62401952421ca86510aece78cf6fe1cabbeb9f1c0f1abc5befa300153f7a8b3d | \
		f4ad57c9d4a26573b79fe16a825816b37fc2c911bea98b432488c0fd2f41caa8 | \
		ac334e032603bcb864939b4126e10cf1d693db89a7132cd66f3e1c8ad74f70aa | \
		40c815f4db304892b0c7f7042a49baf0b40b9f935f8b0783474886c0fca44b48)
		mv "$menu" "$menu.bak-$(date +%Y%m%d-%H%M%S)"
		log "menu X11 antigo substituído: $menu"
		;;
	esac
}

# Menu editado pelo usuário: só ganha o atalho Ctrl+Alt+Esc (Forçar o
# fechamento, com a caveira do xkill), logo depois do Bloquear tela. No
# Window Maker os atalhos de comandos vêm do menu raiz.
migrate_kill_shortcut() {
	local menu=$1 label="Force quit"
	[ -w "$menu" ] && grep -q 'EXEC, "big-wm-lock"),$' "$menu" || return 0
	grep -q -e 'big-wm-kill' -e '"Control+Mod1+Escape"' "$menu" && return 0
	grep -q '"Bloquear tela"' "$menu" && label="Forçar o fechamento"
	sed -i "0,/EXEC, \"big-wm-lock\"),\$/s//&\\n    (\"$label\", SHORTCUT, \"Control+Mod1+Escape\", EXEC, \"big-wm-kill\"),/" "$menu"
	log "menu: atalho Ctrl+Alt+Esc (Forçar o fechamento) em $menu"
}

# Canto ativo de bloqueio das versões anteriores (loginctl lock-session só
# funciona com o xss-lock, que a sessão live não inicia).
migrate_hot_corner() {
	local prefs=$1
	[ -w "$prefs" ] && grep -q '"loginctl lock-session"' "$prefs" || return 0
	sed -i '/HotCornerActions/s#"loginctl lock-session"#"big-wm-lock"#' "$prefs"
	log "canto ativo de bloqueio atualizado: $prefs"
}

# O navegador padrão passou do Brave para o Firefox. Contas criadas antes
# têm o Brave no Clip; troca só quando o Brave não está mais instalado (o
# lançador abre o navegador padrão; o nome serve para o ícone e para marcar
# o aplicativo aberto).
browser_moved() {
	[ ! -e /usr/share/applications/brave-browser.desktop ] &&
		[ -e /usr/share/applications/firefox.desktop ]
}

migrate_browser_x11() {
	local defaults=$1
	browser_moved || return 0
	[ -w "$defaults/WMState" ] && grep -q '"brave-browser.Brave-browser"' "$defaults/WMState" || return 0
	sed -i 's/"brave-browser\.Brave-browser"/Navigator.firefox/' "$defaults/WMState"
	command -v wdwrite >/dev/null && clip_icon Navigator.firefox big-wm-netscape.png
	log "Clip: Brave trocado pelo Firefox"
}

migrate_browser_wayland() {
	local state=$1
	browser_moved || return 0
	[ -w "$state" ] && grep -q 'AppID = "\?brave-browser"\?;' "$state" || return 0
	sed -i 's/AppID = "\?brave-browser"\?;/AppID = "firefox";/' "$state"
	log "Clip (Wayland): Brave trocado pelo Firefox"
}

# Firefox com o tema Netscape 4 (retrothemes-firefox): o userChrome.css tem
# de estar no perfil. Vale para os perfis existentes que ainda não têm
# chrome/ (nada do usuário é sobrescrito); sem perfil nenhum, o Firefox é
# aberto uma vez sem janela para criar o perfil padrão, como na primeira
# execução. Junto com o tema vão preferências (que o usuário pode mudar
# depois em about:config): ler o userChrome.css, usar a barra de título do
# gerenciador de janelas em vez das abas no lugar dela e não perguntar se
# é o navegador padrão (o .desktop chama "firefox", que no BigLinux é o
# wrapper /usr/local/bin/firefox, e o Firefox não se reconhece nele mesmo
# sendo o padrão). O prefs.js só é tocado com o Firefox fechado; aberto,
# fica para o próximo login.
#
# Uma cópia do tema feita por aqui e não alterada pelo usuário é atualizada
# quando o pacote muda (o .big-wm-theme no chrome/ guarda o hash do que foi
# copiado; a cópia sem esse arquivo do retrothemes-firefox 0.r68-1 é
# reconhecida pelo hash dela). Um chrome/ do usuário nunca é tocado.
firefox_theme=${BIGWM_FIREFOX_THEME:-/usr/share/retrothemes-firefox/Netscape4/chrome}
firefox_theme_old=32eb43b99f950b3a4e1161f887dd0cd0c1034020a73bb7950fe934d6c35c47ea

theme_sum() {
	(cd "$1" && find . -type f ! -name .big-wm-theme -print0 | LC_ALL=C sort -z |
		xargs -0 -r sha256sum) | sha256sum | cut -d' ' -f1
}

# Tema copiado por aqui, sem alteração do usuário, e diferente do atual.
firefox_theme_outdated() {
	local chrome=$1 sum recorded=
	sum=$(theme_sum "$chrome")
	[ -r "$chrome/.big-wm-theme" ] && recorded=$(cat "$chrome/.big-wm-theme")
	[ "$sum" = "${recorded:-$firefox_theme_old}" ] && [ "$sum" != "$(theme_sum "$firefox_theme")" ]
}

firefox_profiles() {
	local root ini line
	for root in "$config_home/mozilla/firefox" "$HOME/.mozilla/firefox"; do
		ini=$root/profiles.ini
		[ -r "$ini" ] || continue
		while IFS= read -r line; do
			case $line in
			Path=/*) echo "${line#Path=}" ;;
			Path=*) echo "$root/${line#Path=}" ;;
			esac
		done <"$ini"
	done
}

setup_firefox() {
	[ -d "$firefox_theme" ] && [ -x /usr/bin/firefox ] || return 0
	local profiles profile
	profiles=$(firefox_profiles)
	if [ -z "$profiles" ] && ! pgrep -u "$(id -u)" -x firefox >/dev/null; then
		# Sem janela e sem falar com outra instância; termina assim que o
		# perfil está pronto (compatibility.ini é gravado na partida).
		/usr/bin/firefox --headless --no-remote about:blank >/dev/null 2>&1 &
		local pid=$!
		for _ in $(seq 60); do
			profiles=$(firefox_profiles)
			[ -n "$profiles" ] && compgen -G "$(head -1 <<<"$profiles")/compatibility.ini" >/dev/null && break
			sleep 0.5
		done
		kill "$pid" 2>/dev/null
		wait "$pid" 2>/dev/null
		profiles=$(firefox_profiles)
	fi
	pgrep -u "$(id -u)" -x firefox >/dev/null && return 0
	while IFS= read -r profile; do
		[ -d "$profile" ] || continue
		if [ -e "$profile/chrome" ]; then
			if firefox_theme_outdated "$profile/chrome"; then
				rm -rf "$profile/chrome.big-wm-new" &&
					cp -r "$firefox_theme" "$profile/chrome.big-wm-new" &&
					theme_sum "$profile/chrome.big-wm-new" >"$profile/chrome.big-wm-new/.big-wm-theme" &&
					rm -rf "$profile/chrome" && mv "$profile/chrome.big-wm-new" "$profile/chrome" &&
					log "Firefox: tema Netscape 4 atualizado em $profile"
			fi
			continue
		fi
		cp -r "$firefox_theme" "$profile/chrome" || continue
		theme_sum "$profile/chrome" >"$profile/chrome/.big-wm-theme"
		local pref
		for pref in 'toolkit.legacyUserProfileCustomizations.stylesheets", true' \
			'browser.tabs.inTitlebar", 0' \
			'browser.shell.checkDefaultBrowser", false'; do
			grep -qF "user_pref(\"${pref%%\"*}\"" "$profile/prefs.js" 2>/dev/null ||
				echo "user_pref(\"$pref);" >>"$profile/prefs.js"
		done
		log "Firefox: tema Netscape 4 em $profile"
	done <<<"$profiles"
}

# Ícone fixo de um atalho do Clip (classe, ícone dos ícones do Window Maker).
clip_icon() {
	[ -r "$wmicons/$2" ] || return 0
	WMAKER_USER_ROOT=$gnustep wdwrite WMWindowAttributes "$1" "{Icon = \"$2\"; AlwaysUserIcon = YES;}"
}

# Ícones do tema Window Maker em SVG (big-wm-themes) no lugar dos que as
# versões anteriores gravaram: o PNG do pacote do Firefox e do Thunar (que o
# big-wm-firstrun escrevia nos atributos) e o cubo do Window Maker. Só troca
# o atributo que ainda é exatamente o que foi gravado aqui; um ícone
# escolhido pelo usuário (outro arquivo, outras chaves) fica como está.
migrate_icons_x11() {
	local attrs=$1
	[ -w "$attrs" ] || return 0
	grep -q -e '/usr/share/icons/hicolor/64x64/apps/firefox\.png' \
		-e '/usr/share/icons/hicolor/128x128/apps/org\.xfce\.thunar\.png' \
		-e 'defaultAppIcon\.tiff' "$attrs" || return 0
	local entry='\([{;][[:space:]]*"\?'
	sed -z -i \
		-e "s#${entry}Navigator\\.firefox\"\\? = {\\)[[:space:]]*Icon = \"/usr/share/icons/hicolor/64x64/apps/firefox\\.png\";[[:space:]]*}#\\1\\n    Icon = \"big-wm-netscape.png\";\\n    AlwaysUserIcon = YES;\\n  }#" \
		-e "s#${entry}thunar\\.Thunar\"\\? = {\\)[[:space:]]*Icon = \"/usr/share/icons/hicolor/128x128/apps/org\\.xfce\\.thunar\\.png\";[[:space:]]*}#\\1\\n    Icon = \"big-wm-folder.png\";\\n    AlwaysUserIcon = YES;\\n  }#" \
		-e "s#${entry}\\*\"\\? = {[[:space:]]*Icon = \\)\"\\?defaultAppIcon\\.tiff\"\\?;\\([[:space:]]*}\\)#\\1\"big-wm-defaultapp.png\";\\2#" \
		"$attrs"
	log "ícones do tema Window Maker nos atributos: $attrs"
}

setup_x11() {
	[ "$reset" = 1 ] && backup "$gnustep"

	local src=$datadir/GNUstep
	local defaults=$gnustep/Defaults
	local library=$gnustep/Library/WindowMaker

	for f in WindowMaker WMGLOBAL WMState WMWindowAttributes; do
		install_default "$src/Defaults/$f" "$defaults/$f"
	done
	# Os ícones dos atalhos do Clip (Netscape e pasta) já vêm no
	# WMWindowAttributes padrão: são PNG do big-wm-themes, sempre instalados.
	migrate_icons_x11 "$defaults/WMWindowAttributes"
	migrate_menu_default "$defaults/WMRootMenu"
	install_default "$(localized "$src/Defaults/WMRootMenu")" "$defaults/WMRootMenu"
	migrate_browser_x11 "$defaults"
	migrate_menu "$defaults/WMRootMenu"
	migrate_kill_shortcut "$defaults/WMRootMenu"
	migrate_hot_corner "$defaults/WindowMaker"
	# Sem autostart/exitscript padrão: os serviços da sessão vêm do XDG
	# autostart (systemd --user) e, sem esses arquivos, o Window Maker nem
	# chama system() na partida (o que gerava um erro intermitente).
	mkdir -p "$library/Themes" "$library/Styles" "$library/IconSets" \
		"$library/Backgrounds" "$library/CachedPixmaps" "$gnustep/Library/Icons"

	# picom só lê um arquivo por vez; o padrão do sistema pertence ao pacote picom.
	install_default "$datadir/picom.conf" "$config_home/picom/picom.conf"
}

# State.plist de versões anteriores, sem alteração do usuário: dá lugar ao
# novo (Clip no canto superior esquerdo com navegador e arquivos abaixo
# dele, como no X11; AppID nos lançadores, que o wlmdock usa para indicar
# app aberto).
migrate_wayland_state() {
	local state=$1
	[ -f "$state" ] || return 0
	case $(sha256sum "$state" | cut -d' ' -f1) in
	ac11d36d9486b493bb4739c40d89cb341deb2fdbbfa9fdec633e310e7e0f59da | \
		0c8d9ef38f69f47a52be2fa69faa4ba82ac9716ae1ad8d5f246437ee6ca39069) ;;
	*) return 0 ;;
	esac
	mv "$state" "$state.bak-$(date +%Y%m%d-%H%M%S)"
	log "estado do wlmaker antigo substituído: $state"
}

# Menu Wayland de versões anteriores, sem alteração do usuário (sha256 do
# modelo pt_BR e do inglês): dá lugar ao menu novo, com aplicativos por
# categoria, Aparência e Configurações. Um menu editado fica como está.
migrate_wayland_menu() {
	local menu=$1 sum
	[ -f "$menu" ] || return 0
	sum=$(sha256sum "$menu" | cut -d' ' -f1)
	case $sum in
	bd102072be1d2640e10b939310ec289f1704bd4de50846d3e6308db234496843 | \
		8715e560d3ac24ec7d2524be7ec474577504ec637a3239d53332bb6c16399cf8 | \
		ffe109654063310c634e01a5687f5978b166c139395dade57aa64609195545a9 | \
		4be6ad80c151f2432226c108b01f7c5d67f9b62944ab9f3b91e50538f1bb8ad6)
		mv "$menu" "$menu.bak-$(date +%Y%m%d-%H%M%S)"
		log "menu Wayland antigo substituído: $menu"
		;;
	esac
}

# Ícones dos lançadores das versões anteriores (globo, pasta amarela e o
# terminal do wlmaker) trocados pelos do tema Window Maker em SVG. Os dois
# primeiros nomes são só do Big WindowMaker; o terminal-56x56.png do wlmaker
# só muda no lançador do terminal padrão (big-wm-open terminal). O ícone do
# Clip não precisa de migração: sem Clip.Icon, o wlmaker do Big WindowMaker
# já usa o big-wm-clip-56x56.png.
migrate_wayland_icons() {
	local state=$1
	[ -w "$state" ] || return 0
	grep -q -e 'big-wm-browser-56x56\.png' -e 'big-wm-files-56x56\.png' \
		-e '"\?terminal-56x56\.png"\?;' "$state" || return 0
	local open='"\?/usr/bin/big-wm-open terminal"\?;'
	sed -z -i \
		-e 's#Icon = "\?big-wm-browser-56x56\.png"\?;#Icon = "big-wm-netscape-56x56.png";#g' \
		-e 's#Icon = "\?big-wm-files-56x56\.png"\?;#Icon = "big-wm-folder-56x56.png";#g' \
		-e "s#\\(CommandLine = ${open}[^{}]*Icon = \\)\"\\?terminal-56x56\\.png\"\\?;#\\1\"big-wm-terminal-56x56.png\";#g" \
		-e "s#\\(Icon = \\)\"\\?terminal-56x56\\.png\"\\?;\\([^{}]*CommandLine = ${open}\\)#\\1\"big-wm-terminal-56x56.png\";\\2#g" \
		"$state"
	log "ícones dos lançadores do wlmaker atualizados: $state"
}

# Config.plist de versões anteriores: troca só as linhas que mudaram (rofi
# sem o tema, swaylock sem a imagem do Big WindowMaker, swaybg fixo no
# papel de parede padrão).
migrate_wayland_config() {
	local config=$1
	[ -w "$config" ] || return 0
	grep -q -e '"rofi -show drun"' -e '/usr/bin/swaylock -f -c 202a2e' \
		-e '/usr/bin/swaybg -m fill -i /usr/share/backgrounds/big-wm/default.jpg' \
		-e '"xdg-terminal-exec"' "$config" || return 0
	# shellcheck disable=SC2016 # $HOME é texto do plist, não do shell
	sed -i \
		-e 's#(ShellExecute, "rofi -show drun")#(ShellExecute, "big-wm-open apps")#' \
		-e 's#(ShellExecute, "xdg-terminal-exec")#(ShellExecute, "big-wm-open terminal")#' \
		-e 's#(ShellExecute, "xdg-open \\"$HOME\\"")#(ShellExecute, "big-wm-open files")#' \
		-e 's#Command = "/usr/bin/swaylock -f -c 202a2e";#Command = "/usr/bin/big-wm-lock";#' \
		-e 's#"/usr/bin/swaybg -m fill -i /usr/share/backgrounds/big-wm/default.jpg"#"/usr/bin/big-wm-wallpaper --restore"#' \
		"$config"
	log "configuração do wlmaker atualizada: $config"
}

# Atalhos novos do wlmaker (captura de janela e Forçar o fechamento) num
# Config.plist que ainda não os tem: entram logo depois de "KeyBindings = {";
# uma tecla que o usuário já usa para outra coisa fica como está.
migrate_wayland_keys() {
	local config=$1 key line lines=()
	[ -w "$config" ] && grep -q '^[[:space:]]*KeyBindings = {' "$config" || return 0
	for line in '"Alt+Print" = (ShellExecute, "big-wm-screenshot window");' \
		'"Ctrl+Alt+Escape" = (ShellExecute, "big-wm-kill");'; do
		key=${line%% =*}
		grep -qF "$key =" "$config" || lines+=("$line")
	done
	[ ${#lines[@]} -gt 0 ] || return 0
	for line in "${lines[@]}"; do
		sed -i "0,/^\([[:space:]]*\)KeyBindings = {\$/s##&\\n\\1    $line#" "$config"
	done
	log "atalhos novos do wlmaker em $config: ${lines[*]}"
}

setup_wayland() {
	local dst=$config_home/wlmaker
	[ "$reset" = 1 ] && backup "$dst"

	migrate_wayland_state "$dst/State.plist"
	install_default "$datadir/wlmaker/State.plist" "$dst/State.plist"
	migrate_wayland_menu "$dst/RootMenu.plist"
	install_default "$(localized "$datadir/wlmaker/RootMenu.plist")" "$dst/RootMenu.plist"
	migrate_wayland_config "$dst/Config.plist"
	migrate_wayland_keys "$dst/Config.plist"
	migrate_browser_wayland "$dst/State.plist"
	migrate_wayland_icons "$dst/State.plist"

	# O layout de teclado vem do sistema (localectl ou console), como na sessão X11.
	if [ ! -e "$dst/Config.plist" ]; then
		# shellcheck source=session/lib/big-wm-keyboard.sh
		. "${BIGWM_LIBDIR:-/usr/lib/big-wm}/big-wm-keyboard.sh"
		big_wm_keyboard
		mkdir -p "$dst"
		sed -e "s|@XKB_LAYOUT@|$XKB_LAYOUT|" \
			-e "s|@XKB_VARIANT@|$XKB_VARIANT|" \
			-e "s|@XKB_MODEL@|$XKB_MODEL|" \
			-e "s|@XKB_OPTIONS@|$XKB_OPTIONS|" \
			"$datadir/wlmaker/Config.plist.in" >"$dst/Config.plist"
	fi
}

case "${1:-}" in
x11) setup_x11; setup_screenshots; setup_kvantum; setup_fastfetch; setup_ashyterm; setup_firefox & ;;
wayland) setup_wayland; setup_screenshots; setup_kvantum; setup_fastfetch; setup_ashyterm; setup_firefox & ;;
*)
	echo "uso: ${0##*/} [--reset] x11|wayland" >&2
	exit 2
	;;
esac
