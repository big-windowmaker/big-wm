# Ícones dos lançadores das versões anteriores (globo, pasta amarela e o
# terminal do wlmaker) trocados pelos do tema Window Maker em SVG. Os dois
# primeiros nomes são só do Big WindowMaker; o terminal-56x56.png do wlmaker
# só muda no lançador do terminal padrão (big-wm-open terminal). O ícone do
# Clip não precisa de migração: sem Clip.Icon, o wlmaker do Big WindowMaker
# já usa o big-wm-clip-56x56.png.
migrate_wayland_icons() {
	local state=$1
	[ -w "$state" ] || return 0
	grep -q -e 'big-wm-browser-56x56\.png' -e 'big-wm-files-56x56\.png' \
		-e '"\?terminal-56x56\.png"\?;' "$state" || return 0
	local open='"\?/usr/bin/big-wm-open terminal"\?;'
	sed -z -i \
		-e 's#Icon = "\?big-wm-browser-56x56\.png"\?;#Icon = "big-wm-netscape-56x56.png";#g' \
		-e 's#Icon = "\?big-wm-files-56x56\.png"\?;#Icon = "big-wm-folder-56x56.png";#g' \
		-e "s#\\(CommandLine = ${open}[^{}]*Icon = \\)\"\\?terminal-56x56\\.png\"\\?;#\\1\"big-wm-terminal-56x56.png\";#g" \
		-e "s#\\(Icon = \\)\"\\?terminal-56x56\\.png\"\\?;\\([^{}]*CommandLine = ${open}\\)#\\1\"big-wm-terminal-56x56.png\";\\2#g" \
		"$state"
	log "ícones dos lançadores do wlmaker atualizados: $state"
}

# Config.plist de versões anteriores: troca só as linhas que mudaram (rofi
# sem o tema, swaylock sem a imagem do Big WindowMaker, swaybg fixo no
# papel de parede padrão).
migrate_wayland_config() {
	local config=$1
	[ -w "$config" ] || return 0
	grep -q -e '"rofi -show drun"' -e '/usr/bin/swaylock -f -c 202a2e' \
		-e '/usr/bin/swaybg -m fill -i /usr/share/backgrounds/big-wm/default.jpg' \
		-e '"xdg-terminal-exec"' "$config" || return 0
	# shellcheck disable=SC2016 # $HOME é texto do plist, não do shell
	sed -i \
		-e 's#(ShellExecute, "rofi -show drun")#(ShellExecute, "big-wm-open apps")#' \
		-e 's#(ShellExecute, "xdg-terminal-exec")#(ShellExecute, "big-wm-open terminal")#' \
		-e 's#(ShellExecute, "xdg-open \\"$HOME\\"")#(ShellExecute, "big-wm-open files")#' \
		-e 's#Command = "/usr/bin/swaylock -f -c 202a2e";#Command = "/usr/bin/big-wm-lock";#' \
		-e 's#"/usr/bin/swaybg -m fill -i /usr/share/backgrounds/big-wm/default.jpg"#"/usr/bin/big-wm-wallpaper --restore"#' \
		"$config"
	log "configuração do wlmaker atualizada: $config"
}

# O wlmaker instalado conhece a ampliação da tela (ZoomIn, ZoomOut, ZoomReset
# e os atalhos de rolagem)? Um wlmaker anterior não inicia com um atalho que
# não conhece: os da ampliação só entram no Config.plist quando ele os tem.
wlmaker_has_zoom() {
	local bin
	bin=$(command -v wlmaker) || return 1
	grep -qa ZoomReset "$bin"
}

# O wlmaker instalado tem a caveira de forçar o fechamento (ação
# ForceCloseSelect) e localiza o ponteiro ao sacudir (LocatePointer)?
wlmaker_has_force_close() {
	local bin
	bin=$(command -v wlmaker) || return 1
	grep -qa ForceCloseSelect "$bin"
}

# Ctrl+Alt+Esc: com o wlmaker que conhece ForceCloseSelect, a caveira do
# próprio compositor (clique na janela); antes dele, a lista do big-wm-kill.
wlmaker_force_close_key() {
	if wlmaker_has_force_close; then
		echo '"Ctrl+Alt+Escape" = ForceCloseSelect;'
	else
		echo '"Ctrl+Alt+Escape" = (ShellExecute, "big-wm-kill");'
	fi
}

# Config.plist anterior à caveira e ao ponteiro ampliado do wlmaker: o
# Ctrl+Alt+Esc padrão passa para a caveira (um atalho mudado pelo usuário
# fica), e entram os blocos LocatePointer (o mesmo arquivo de configuração
# da sessão X11) e ForceClose (o tema de cursor da caveira). Só com um
# wlmaker que os conhece.
migrate_wayland_pointer_tools() {
	local config=$1
	[ -w "$config" ] && wlmaker_has_force_close || return 0
	if grep -q '^[[:space:]]*"Ctrl+Alt+Escape" = (ShellExecute, "big-wm-kill");$' "$config"; then
		sed -i 's#^\([[:space:]]*\)"Ctrl+Alt+Escape" = (ShellExecute, "big-wm-kill");$#\1"Ctrl+Alt+Escape" = ForceCloseSelect;#' "$config"
		log "Ctrl+Alt+Esc do wlmaker: a caveira (ForceCloseSelect): $config"
	fi
	grep -q '^    Autostart = ($' "$config" || return 0
	if ! grep -q '^    LocatePointer = {$' "$config"; then
		sed -i '0,/^    Autostart = ($/s//    \/\/ Sacudir o mouse aumenta o ponteiro: o mesmo arquivo da sessão X11\n    \/\/ (menu Configurações > Localizar o ponteiro ao sacudir).\n    LocatePointer = {\n        SettingsFile = "~\/.config\/big-wm\/locate-pointer.conf";\n    };\n\n&/' "$config"
		log "localizar o ponteiro no wlmaker: $config"
	fi
	if ! grep -q '^    ForceClose = {$' "$config"; then
		sed -i '0,/^    Autostart = ($/s//    \/\/ Forçar o fechamento (Ctrl+Alt+Esc): o ponteiro vira a caveira vermelha.\n    ForceClose = {\n        CursorTheme = "big-wm-skull";\n        Cursor = "pirate";\n    };\n\n&/' "$config"
		log "caveira de forçar o fechamento no wlmaker: $config"
	fi
}

# Atalhos novos do wlmaker (captura de janela, Forçar o fechamento, ampliação
# da tela com Ctrl+Alt+rolagem) num Config.plist que ainda não os tem:
# entram logo depois de "KeyBindings = {";
# uma tecla que o usuário já usa para outra coisa fica como está.
migrate_wayland_keys() {
	local config=$1 key line lines=()
	[ -w "$config" ] && grep -q '^[[:space:]]*KeyBindings = {' "$config" || return 0
	for line in '"Alt+Print" = (ShellExecute, "big-wm-screenshot window");' \
		"$(wlmaker_force_close_key)" \
		'"Logo+V" = (ShellExecute, "big-wm-open clipboard");' \
		'"Logo+R" = (ShellExecute, "big-wm-open run");' \
		'"Alt+space" = (ShellExecute, "big-wm-open apps");' \
		'"Ctrl+Shift+Escape" = (ShellExecute, "big-wm-open taskmanager");' \
		'"Logo+Shift+Z" = (Zones, "autotile toggle");' \
		'"Logo+Ctrl+Z" = (Zones, "layout next");' \
		'"Logo+Alt+Z" = (Zones, "editor");' \
		'"Logo+Ctrl+Left" = (Zones, "move left");' \
		'"Logo+Ctrl+Right" = (Zones, "move right");' \
		'"Logo+Ctrl+Up" = (Zones, "move up");' \
		'"Logo+Ctrl+Down" = (Zones, "move down");' \
		'"Logo+Ctrl+0" = (Zones, "restore");' \
		'"Logo+Ctrl+F" = (Zones, "float");' \
		'"Logo+Ctrl+Return" = (Zones, "promote");' \
		'"Logo+Ctrl+equal" = (Zones, "grow");' \
		'"Logo+Ctrl+minus" = (Zones, "shrink");' \
		'"Logo+Z" = (Zones, "picker");' \
		'"Logo+Alt+Left" = (Zones, "focus left");' \
		'"Logo+Alt+Right" = (Zones, "focus right");' \
		'"Logo+Alt+Up" = (Zones, "focus up");' \
		'"Logo+Alt+Down" = (Zones, "focus down");' \
		'"Logo+Shift+Left" = (Zones, "swap left");' \
		'"Logo+Shift+Right" = (Zones, "swap right");' \
		'"Logo+Shift+Up" = (Zones, "swap up");' \
		'"Logo+Shift+Down" = (Zones, "swap down");' \
		'"Logo+Ctrl+BackSpace" = (Zones, "undo");' \
		'"Logo+Ctrl+Shift+BackSpace" = (Zones, "redo");' \
		'"Ctrl+Alt+WheelUp" = ZoomIn;' \
		'"Ctrl+Alt+WheelDown" = ZoomOut;' \
		'"Ctrl+Alt+0" = ZoomReset;'; do
		key=${line%% =*}
		case $line in *'= Zoom'*) wlmaker_has_zoom || continue ;; esac
		grep -qF "$key =" "$config" || lines+=("$line")
	done
	[ ${#lines[@]} -gt 0 ] || return 0
	for line in "${lines[@]}"; do
		sed -i "0,/^\([[:space:]]*\)KeyBindings = {\$/s##&\\n\\1    $line#" "$config"
	done
	log "atalhos novos do wlmaker em $config: ${lines[*]}"
}

# A bandeja como dockapp do Dock (o wlmaker a adota: Dock.Dockapps diz que
# ela começa no Dock, depois dos lançadores) e o ícone das gavetas novas
# (Add a drawer), num State.plist que ainda não os tem.
migrate_wayland_dock_keys() {
	local state=$1
	[ -w "$state" ] && grep -q '^  Dock = {$' "$state" || return 0
	if ! grep -q '"big-wm-tray"' "$state" && ! sed -n '/^  Dock = {$/,/^  };$/p' "$state" | grep -q '^    Dockapps = '; then
		sed -i '0,/^  Dock = {$/s//&\n    Dockapps = ("big-wm-tray");/' "$state"
		log "bandeja no Dock do wlmaker: $state"
	fi
	# O ladrilho do wmake-zones (0.3) entra uma vez na lista; quem o tirar
	# do Dock não o vê voltar (a marca em ~/.config/big-wm).
	local mark=$config_home/big-wm/wmake-zones-dock-wayland
	if [ ! -e "$mark" ] && command -v wmake-zones-wl >/dev/null; then
		if ! grep -q '"wmake-zones-wl"' "$state" &&
			grep -q '^    Dockapps = (.*"big-wm-tray".*);$' "$state"; then
			sed -i 's/^\(    Dockapps = (.*\)\();\)$/\1, "wmake-zones-wl"\2/' "$state"
			log "ladrilho do wmake-zones no Dock do wlmaker: $state"
		fi
		mkdir -p "${mark%/*}" && : >"$mark"
	fi
	# Os dockapps do Dock do X11, pelo XWayland (novembro de 2026): a lista
	# padrão anterior dá lugar à nova, uma vez; uma lista mudada fica.
	mark=$config_home/big-wm/dock-dockapps-x11-wayland
	if [ ! -e "$mark" ]; then
		if grep -qE '^    Dockapps = \("big-wm-tray"(, "wmake-zones-wl")?\);$' "$state"; then
			sed -i -E 's/^    Dockapps = \("big-wm-tray"(, "wmake-zones-wl")?\);$/    Dockapps = (wmclock, "big-wm-tray", wmix, wmcpuload, wmmemload, wmnet, "wmake-zones-wl", wmcliphist, wmshutdown, wlmeyes);/' "$state"
			log "dockapps do Dock do X11 no Dock do wlmaker: $state"
		fi
		mkdir -p "${mark%/*}" && : >"$mark"
	fi
	# Painel de informações (duplo clique no ladrilho principal do Dock).
	if ! grep -q 'InfoCommand' "$state"; then
		sed -i '0,/^  Dock = {$/s//&\n    InfoCommand = "\/usr\/bin\/big-wm-about";/' "$state"
		log "painel de informações no Dock do wlmaker: $state"
	fi
	if ! grep -q 'DrawerIcon' "$state"; then
		sed -i '0,/^  Dock = {$/s//&\n    DrawerIcon = "big-wm-drawer-56x56.png";/' "$state"
		log "ícone das gavetas do Dock: $state"
	fi
}

# Moldura do Window Maker em todas as janelas (novembro de 2026), também
# nos programas que desenham a própria (AshyTerm, Telegram, Chrome, Steam):
# ServerDecoration = Yes no "*" do WindowAttributes de um Config.plist
# anterior. Uma vez só (a marca): quem tirar não vê voltar.
migrate_wayland_frames() {
	local config=$1 mark=$config_home/big-wm/migrations/wayland-server-decoration-all
	[ -w "$config" ] && [ ! -e "$mark" ] || return 0
	if grep -q '^[[:space:]]*"\*" = .*ServerDecoration' "$config"; then
		:
	elif grep -q '^[[:space:]]*"\*" = {' "$config"; then
		sed -i '0,/^\([[:space:]]*"\*" = {\)/s//\1 ServerDecoration = Yes;/' "$config" || return 0
	elif grep -q '^    WindowAttributes = {$' "$config"; then
		sed -i '0,/^    WindowAttributes = {$/s//&\n        "*" = { ServerDecoration = Yes; };/' "$config" || return 0
	elif [ "$(tail -n1 "$config")" = "}" ]; then
		sed -i '$ s#^}$#    WindowAttributes = {\n        "*" = { ServerDecoration = Yes; };\n    };\n}#' "$config" || return 0
	else
		return 0
	fi
	log "moldura do Window Maker em todas as janelas: $config"
	mkdir -p "${mark%/*}" && : >"$mark"
}

# "Configurações..." dos lançadores do Dock e do Clip (wlmaker com os menus
# do Window Maker): o comando entra num Config.plist que ainda não o tem,
# logo depois do ThemeFile.
migrate_wayland_dock_settings() {
	local config=$1
	[ -w "$config" ] && grep -q '^[[:space:]]*ThemeFile = ' "$config" || return 0
	grep -q 'DockSettingsCommand' "$config" && return 0
	sed -i '0,/^\([[:space:]]*\)ThemeFile = .*$/s##&\n\1DockSettingsCommand = "/usr/bin/big-wm-dock-settings";#' "$config"
	log "Configurações... dos lançadores em $config"
}

# O WPrefs (menu Configurações > Window Maker) também abre na sessão
# Wayland, pelo XWayland, e lê ~/GNUstep/Defaults: quem nunca entrou na
# sessão X11 começa com os padrões do Big WindowMaker, não os do Window
# Maker. Nada do usuário é sobrescrito.
setup_wprefs_defaults() {
	local src=$datadir/GNUstep/Defaults defaults=$gnustep/Defaults f
	for f in WindowMaker WMGLOBAL WMState WMWindowAttributes; do
		install_default "$src/$f" "$defaults/$f"
	done
	install_default "$(localized "$src/WMRootMenu")" "$defaults/WMRootMenu"
	# Sem este diretório o WPrefs não grava a velocidade do mouse
	# (autostart com "xset m").
	mkdir -p "$gnustep/Library/WindowMaker"
}

setup_wayland() {
	local dst=$config_home/wlmaker
	[ "$reset" = 1 ] && backup "$dst"
	setup_wprefs_defaults

	migrate_wayland_state "$dst/State.plist"
	install_default "$datadir/wlmaker/State.plist" "$dst/State.plist"
	migrate_wayland_menu "$dst/RootMenu.plist"
	migrate_lock_settings_menu "$dst/RootMenu.plist" ShellExecute
	install_default "$(localized "$datadir/wlmaker/RootMenu.plist")" "$dst/RootMenu.plist"
	migrate_tabbed_dock_menu "$dst/RootMenu.plist" ShellExecute wayland
	migrate_display_menu "$dst/RootMenu.plist"
	migrate_wayland_config "$dst/Config.plist"
	migrate_wayland_keys "$dst/Config.plist"
	migrate_wayland_pointer_tools "$dst/Config.plist"
	migrate_wayland_dock_settings "$dst/Config.plist"
	migrate_wayland_frames "$dst/Config.plist"
	migrate_browser_wayland "$dst/State.plist"
	migrate_wayland_icons "$dst/State.plist"
	migrate_wayland_dock_keys "$dst/State.plist"

	# O layout de teclado vem do sistema (localectl ou console), como na sessão X11.
	if [ ! -e "$dst/Config.plist" ]; then
		# shellcheck source=session/lib/big-wm-keyboard.sh
		. "${BIGWM_LIBDIR:-/usr/lib/big-wm}/big-wm-keyboard.sh"
		big_wm_keyboard
		mkdir -p "$dst"
		sed -e "s|@XKB_LAYOUT@|$XKB_LAYOUT|" \
			-e "s|@XKB_VARIANT@|$XKB_VARIANT|" \
			-e "s|@XKB_MODEL@|$XKB_MODEL|" \
			-e "s|@XKB_OPTIONS@|$XKB_OPTIONS|" \
			"$datadir/wlmaker/Config.plist.in" >"$dst/Config.plist"
		wlmaker_has_zoom || sed -i '/= Zoom\(In\|Out\|Reset\);/d' "$dst/Config.plist"
		wlmaker_has_force_close ||
			sed -i 's#"Ctrl+Alt+Escape" = ForceCloseSelect;#"Ctrl+Alt+Escape" = (ShellExecute, "big-wm-kill");#' "$dst/Config.plist"
	fi
}

case "${1:-}" in
x11) setup_x11; setup_screenshots; setup_kvantum; setup_theme; setup_fastfetch; setup_ashyterm; setup_terminal_helper; setup_wmcliphist; setup_vscode_titlebar; setup_chromium_frame; setup_webapps; setup_firefox & ;;
wayland) setup_wayland; setup_screenshots; setup_kvantum; setup_theme; setup_fastfetch; setup_ashyterm; setup_terminal_helper; setup_wmcliphist; setup_vscode_titlebar; setup_chromium_frame; setup_webapps; setup_firefox & ;;
*)
	echo "uso: ${0##*/} [--reset] x11|wayland" >&2
	exit 2
	;;
esac
