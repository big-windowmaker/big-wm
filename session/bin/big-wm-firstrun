#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-or-later
#
# Aplica a configuração padrão do Big WindowMaker na conta do usuário.
#
#   big-wm-firstrun x11       ~/GNUstep (Window Maker)
#   big-wm-firstrun wayland   ~/.config/wlmaker (wlmaker)
#   big-wm-firstrun --reset x11|wayland
#                             renomeia a configuração atual para *.bak-<data>
#                             e aplica os padrões de novo
#
# Só copia arquivos que ainda não existem: nada do usuário é sobrescrito.
# Funciona para contas novas e para contas que já existiam antes da
# instalação, por isso o Big WindowMaker não instala nada em /etc/skel.

set -u

datadir=/usr/share/big-wm
config_home=${XDG_CONFIG_HOME:-$HOME/.config}
gnustep=${WMAKER_USER_ROOT:-$HOME/GNUstep}

reset=0
if [ "${1:-}" = --reset ]; then
	reset=1
	shift
fi

log() {
	logger -t big-wm-firstrun -- "$*" 2>/dev/null
}

# Escolhe a variante traduzida de um arquivo: nome.pt_BR, nome.pt, nome.
localized() {
	local base=$1 lang=${LANG%%.*}
	for candidate in "$base.$lang" "$base.${lang%%_*}" "$base"; do
		if [ -e "$candidate" ]; then
			echo "$candidate"
			return
		fi
	done
}

# Copia src para dst somente se dst não existir.
install_default() {
	local src=$1 dst=$2 mode=${3:-644}
	[ -e "$dst" ] && return
	install -Dm"$mode" "$src" "$dst"
}

backup() {
	local path=$1
	[ -e "$path" ] || return 0
	mv "$path" "$path.bak-$(date +%Y%m%d-%H%M%S)"
	log "configuração anterior salva: $path.bak-*"
}

# A tecla Print do Window Maker grava em ~/GNUstep/Library/WindowMaker/Screenshots
# (caminho fixo no código). Esse diretório vira um link para Imagens/Capturas
# de tela, que também é usado pela captura da sessão Wayland.
setup_screenshots() {
	local link=$gnustep/Library/WindowMaker/Screenshots pictures name
	[ -e "$link" ] || [ -L "$link" ] && return
	pictures=$(xdg-user-dir PICTURES 2>/dev/null)
	[ -n "$pictures" ] && [ "$pictures" != "$HOME" ] || pictures=$HOME/Pictures
	case "${LANG%%_*}" in
	pt) name="Capturas de tela" ;;
	es) name="Capturas de pantalla" ;;
	*) name=Screenshots ;;
	esac
	mkdir -p "$pictures/$name" "${link%/*}" && ln -s "$pictures/$name" "$link"
}

# Menus criados por versões anteriores: troca só as linhas que mudaram (o
# caminho antigo do WPrefs, o wmmenugen que deixava "Aplicativos" vazio
# quando faltava o diretório do flatpak e o bloqueio que dependia do
# xss-lock). O resto do menu do usuário fica como está.
migrate_menu() {
	local menu=$1
	[ -w "$menu" ] || return 0
	grep -q -e 'GNUstep/Applications/WPrefs\.app' -e 'wmmenugen -parser:xdg' \
		-e 'EXEC, "loginctl lock-session"' "$menu" || return 0
	sed -i \
		-e 's#"/usr/lib/GNUstep/Applications/WPrefs\.app/WPrefs"#WPrefs#' \
		-e 's#"|| wmmenugen -parser:xdg [^"]*"#"|| big-wm-appmenu"#' \
		-e 's#EXEC, "loginctl lock-session"#EXEC, "big-wm-lock"#' \
		"$menu"
	log "menu atualizado: $menu"
}

# Canto ativo de bloqueio das versões anteriores (loginctl lock-session só
# funciona com o xss-lock, que a sessão live não inicia).
migrate_hot_corner() {
	local prefs=$1
	[ -w "$prefs" ] && grep -q '"loginctl lock-session"' "$prefs" || return 0
	sed -i '/HotCornerActions/s#"loginctl lock-session"#"big-wm-lock"#' "$prefs"
	log "canto ativo de bloqueio atualizado: $prefs"
}

clip_icon() { # classe, arquivo
	[ -r "$2" ] || return 0
	WMAKER_USER_ROOT=$gnustep wdwrite WMWindowAttributes "$1" "{Icon = \"$2\";}"
}

setup_x11() {
	[ "$reset" = 1 ] && backup "$gnustep"

	local src=$datadir/GNUstep
	local defaults=$gnustep/Defaults
	local library=$gnustep/Library/WindowMaker

	local new_attributes=0
	[ -e "$defaults/WMWindowAttributes" ] || new_attributes=1
	for f in WindowMaker WMGLOBAL WMState WMWindowAttributes; do
		install_default "$src/Defaults/$f" "$defaults/$f"
	done
	# Ícones dos atalhos do Clip: o Window Maker não acha ícones de tema por
	# nome, e avisa sobre arquivos que não existem; por isso só entram os
	# aplicativos instalados, com o PNG que o próprio pacote instala.
	if [ "$new_attributes" = 1 ] && command -v wdwrite >/dev/null; then
		clip_icon "brave-browser.Brave-browser" /usr/share/icons/hicolor/64x64/apps/brave-desktop.png
		clip_icon thunar.Thunar /usr/share/icons/hicolor/128x128/apps/org.xfce.thunar.png
	fi
	install_default "$(localized "$src/Defaults/WMRootMenu")" "$defaults/WMRootMenu"
	migrate_menu "$defaults/WMRootMenu"
	migrate_hot_corner "$defaults/WindowMaker"
	# Sem autostart/exitscript padrão: os serviços da sessão vêm do XDG
	# autostart (systemd --user) e, sem esses arquivos, o Window Maker nem
	# chama system() na partida (o que gerava um erro intermitente).
	mkdir -p "$library/Themes" "$library/Styles" "$library/IconSets" \
		"$library/Backgrounds" "$library/CachedPixmaps" "$gnustep/Library/Icons"

	# picom só lê um arquivo por vez; o padrão do sistema pertence ao pacote picom.
	install_default "$datadir/picom.conf" "$config_home/picom/picom.conf"
}

# State.plist de versões anteriores, sem alteração do usuário: dá lugar ao
# novo (Clip no canto superior esquerdo, como no X11, e AppID nos
# lançadores, que o wlmdock do wlmaker 0.9 usa para indicar app aberto).
migrate_wayland_state() {
	local state=$1
	[ -f "$state" ] || return 0
	[ "$(sha256sum "$state" | cut -d' ' -f1)" = \
		ac11d36d9486b493bb4739c40d89cb341deb2fdbbfa9fdec633e310e7e0f59da ] || return 0
	mv "$state" "$state.bak-$(date +%Y%m%d-%H%M%S)"
	log "estado do wlmaker antigo substituído: $state"
}

# Menu Wayland de versões anteriores, sem alteração do usuário (sha256 do
# modelo pt_BR e do inglês): dá lugar ao menu novo, com aplicativos por
# categoria, Aparência e Configurações. Um menu editado fica como está.
migrate_wayland_menu() {
	local menu=$1 sum
	[ -f "$menu" ] || return 0
	sum=$(sha256sum "$menu" | cut -d' ' -f1)
	case $sum in
	bd102072be1d2640e10b939310ec289f1704bd4de50846d3e6308db234496843 | \
		8715e560d3ac24ec7d2524be7ec474577504ec637a3239d53332bb6c16399cf8)
		mv "$menu" "$menu.bak-$(date +%Y%m%d-%H%M%S)"
		log "menu Wayland antigo substituído: $menu"
		;;
	esac
}

# Config.plist de versões anteriores: troca só as linhas que mudaram (rofi
# sem o tema, swaylock sem a imagem do Big WindowMaker, swaybg fixo no
# papel de parede padrão).
migrate_wayland_config() {
	local config=$1
	[ -w "$config" ] || return 0
	grep -q -e '"rofi -show drun"' -e '/usr/bin/swaylock -f -c 202a2e' \
		-e '/usr/bin/swaybg -m fill -i /usr/share/backgrounds/big-wm/default.jpg' \
		-e '"xdg-terminal-exec"' "$config" || return 0
	# shellcheck disable=SC2016 # $HOME é texto do plist, não do shell
	sed -i \
		-e 's#(ShellExecute, "rofi -show drun")#(ShellExecute, "big-wm-open apps")#' \
		-e 's#(ShellExecute, "xdg-terminal-exec")#(ShellExecute, "big-wm-open terminal")#' \
		-e 's#(ShellExecute, "xdg-open \\"$HOME\\"")#(ShellExecute, "big-wm-open files")#' \
		-e 's#Command = "/usr/bin/swaylock -f -c 202a2e";#Command = "/usr/bin/big-wm-lock";#' \
		-e 's#"/usr/bin/swaybg -m fill -i /usr/share/backgrounds/big-wm/default.jpg"#"/usr/bin/big-wm-wallpaper --restore"#' \
		"$config"
	log "configuração do wlmaker atualizada: $config"
}

setup_wayland() {
	local dst=$config_home/wlmaker
	[ "$reset" = 1 ] && backup "$dst"

	migrate_wayland_state "$dst/State.plist"
	install_default "$datadir/wlmaker/State.plist" "$dst/State.plist"
	migrate_wayland_menu "$dst/RootMenu.plist"
	install_default "$(localized "$datadir/wlmaker/RootMenu.plist")" "$dst/RootMenu.plist"
	migrate_wayland_config "$dst/Config.plist"

	# O layout de teclado vem do sistema (localectl ou console), como na sessão X11.
	if [ ! -e "$dst/Config.plist" ]; then
		# shellcheck source=session/lib/big-wm-keyboard.sh
		. "${BIGWM_LIBDIR:-/usr/lib/big-wm}/big-wm-keyboard.sh"
		big_wm_keyboard
		mkdir -p "$dst"
		sed -e "s|@XKB_LAYOUT@|$XKB_LAYOUT|" \
			-e "s|@XKB_VARIANT@|$XKB_VARIANT|" \
			-e "s|@XKB_MODEL@|$XKB_MODEL|" \
			-e "s|@XKB_OPTIONS@|$XKB_OPTIONS|" \
			"$datadir/wlmaker/Config.plist.in" >"$dst/Config.plist"
	fi
}

case "${1:-}" in
x11) setup_x11; setup_screenshots ;;
wayland) setup_wayland; setup_screenshots ;;
*)
	echo "uso: ${0##*/} [--reset] x11|wayland" >&2
	exit 2
	;;
esac
