#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-or-later
#
# Aplica a configuração padrão do Big WindowMaker na conta do usuário.
#
#   big-wm-firstrun x11       ~/GNUstep (Window Maker)
#   big-wm-firstrun wayland   ~/.config/wlmaker (wlmaker)
#   big-wm-firstrun --reset x11|wayland
#                             renomeia a configuração atual para *.bak-<data>
#                             e aplica os padrões de novo
#
# Só copia arquivos que ainda não existem: nada do usuário é sobrescrito.
# Funciona para contas novas e para contas que já existiam antes da
# instalação, por isso o Big WindowMaker não instala nada em /etc/skel.

set -u

datadir=/usr/share/big-wm
wmicons=/usr/share/WindowMaker/Icons
kvantumdir=/usr/share/Kvantum
ashyterm=/usr/bin/ashyterm
ashyterm_frame='/usr/lib/python3*/site-packages/ashyterm/utils/wm_frame.py'
config_home=${XDG_CONFIG_HOME:-$HOME/.config}
data_home=${XDG_DATA_HOME:-$HOME/.local/share}
gnustep=${WMAKER_USER_ROOT:-$HOME/GNUstep}

reset=0
if [ "${1:-}" = --reset ]; then
	reset=1
	shift
fi

log() {
	logger -t big-wm-firstrun -- "$*" 2>/dev/null
}

# Escolhe a variante traduzida de um arquivo: nome.pt_BR, nome.pt, nome.
localized() {
	local base=$1 lang=${LANG%%.*}
	for candidate in "$base.$lang" "$base.${lang%%_*}" "$base"; do
		if [ -e "$candidate" ]; then
			echo "$candidate"
			return
		fi
	done
}

# Copia src para dst somente se dst não existir.
install_default() {
	local src=$1 dst=$2 mode=${3:-644}
	[ -e "$dst" ] && return
	install -Dm"$mode" "$src" "$dst"
}

backup() {
	local path=$1
	[ -e "$path" ] || return 0
	mv "$path" "$path.bak-$(date +%Y%m%d-%H%M%S)"
	log "configuração anterior salva: $path.bak-*"
}

# A tecla Print do Window Maker grava em ~/GNUstep/Library/WindowMaker/Screenshots
# (caminho fixo no código). Esse diretório vira um link para Imagens/Capturas
# de tela, que também é usado pela captura da sessão Wayland.
setup_screenshots() {
	local link=$gnustep/Library/WindowMaker/Screenshots pictures name
	[ -e "$link" ] || [ -L "$link" ] && return
	pictures=$(xdg-user-dir PICTURES 2>/dev/null)
	[ -n "$pictures" ] && [ "$pictures" != "$HOME" ] || pictures=$HOME/Pictures
	case "${LANG%%_*}" in
	pt) name="Capturas de tela" ;;
	es) name="Capturas de pantalla" ;;
	*) name=Screenshots ;;
	esac
	mkdir -p "$pictures/$name" "${link%/*}" && ln -s "$pictures/$name" "$link"
}

# fastfetch com o logo do Big WindowMaker em ASCII e os textos nas cores do
# logo. O wrapper /usr/local/bin/fastfetch da BigCommunity usa
# ~/.config/fastfetch/{ascii-art,config.jsonc} quando existem (e traduz os
# rótulos). Só para quem ainda não personalizou o fastfetch.
setup_fastfetch() {
	local dir=$config_home/fastfetch src=$datadir/fastfetch
	[ -e "$dir/ascii-art" ] || [ -e "$dir/config.jsonc" ] && return 0
	[ -r "$src/ascii-art" ] && [ -r "$src/config.jsonc" ] || return 0
	install -Dm644 "$src/ascii-art" "$dir/ascii-art" &&
		install -Dm644 "$src/config.jsonc" "$dir/config.jsonc" &&
		log "fastfetch: logo do Big WindowMaker"
}

# Aplicativos Qt com o QTStep (aparência OpenStep), nas duas sessões: o
# big-wm-env.sh liga o Kvantum e o Kvantum só lê o tema da configuração do
# usuário (não há padrão do sistema). Quem já escolheu um tema fica com ele;
# o BigAdwaitaRoundGtk*, gravado sozinho pelo assistente do BigLinux e pela
# sincronização do tema do GNOME com o Qt, e um arquivo sem tema não contam
# como escolha. No modo escuro (big-wm-theme dark, ~/.config/big-wm/theme),
# o QTStepOpenStepDark.
setup_kvantum() {
	local conf=$config_home/Kvantum/kvantum.kvconfig theme=QTStepOpenStep
	if [ -e "$conf" ]; then
		case $(sed -n 's/^[[:space:]]*theme=//p' "$conf" | head -n1) in
		'' | BigAdwaitaRoundGtk*) ;;
		*) return 0 ;;
		esac
	fi
	[ "$(cat "$config_home/big-wm/theme" 2>/dev/null)" = dark ] &&
		[ -d "$kvantumdir/QTStepOpenStepDark" ] && theme=QTStepOpenStepDark
	[ -d "$kvantumdir/$theme" ] || return 0
	mkdir -p "${conf%/*}" && printf '[General]\ntheme=%s\n' "$theme" >"$conf"
	log "Kvantum: tema $theme"
}

# Modo claro ou escuro escolhido (big-wm-theme), também antes do primeiro
# login (assistente da live): os padrões acabaram de ser instalados no modo
# claro e passam ao escuro aqui. Um estilo do Window Maker ou um tema do
# Kvantum escolhido pelo usuário fica como está.
setup_theme() {
	command -v big-wm-theme >/dev/null || return 0
	big-wm-theme apply
}

# AshyTerm (terminal padrão) translúcido, com o papel de parede aparecendo
# por trás do texto: transparência 22 dá cerca de 87% de opacidade no fundo
# escuro dos esquemas de cores (o padrão do AshyTerm, 16, dá 92% e quase não
# se nota). Só quando o AshyTerm ainda não tem configuração: quem já abriu o
# AshyTerm, nesta ou em outra sessão, fica com o que escolheu. O AshyTerm
# completa o arquivo com os outros padrões na primeira execução.
setup_ashyterm() {
	local conf=$config_home/ashyterm/settings.json
	[ -e "$conf" ] && return 0
	[ -e "$ashyterm" ] || return 0
	mkdir -p "${conf%/*}" && chmod 700 "${conf%/*}" && printf '{"transparency": 22}\n' >"$conf"
	log "AshyTerm: transparência 22"
}

# Menus criados por versões anteriores: troca só as linhas que mudaram (o
# caminho antigo do WPrefs, o wmmenugen que deixava "Aplicativos" vazio
# quando faltava o diretório do flatpak e o bloqueio que dependia do
# xss-lock). O resto do menu do usuário fica como está.
migrate_menu() {
	local menu=$1
	[ -w "$menu" ] || return 0
	grep -q -e 'GNUstep/Applications/WPrefs\.app' -e 'wmmenugen -parser:xdg' \
		-e 'EXEC, "loginctl lock-session"' "$menu" || return 0
	sed -i \
		-e 's#"/usr/lib/GNUstep/Applications/WPrefs\.app/WPrefs"#WPrefs#' \
		-e 's#"|| wmmenugen -parser:xdg [^"]*"#"|| big-wm-appmenu"#' \
		-e 's#EXEC, "loginctl lock-session"#EXEC, "big-wm-lock"#' \
		"$menu"
	log "menu atualizado: $menu"
}

# Menu raiz X11 de versões anteriores, sem alteração do usuário (sha256 dos
# modelos pt_BR e inglês, também depois do migrate_menu): dá lugar ao menu
# novo, com Captura de tela (tela, janela, área), Executar no rofi, Forçar
# o fechamento (Ctrl+Alt+Esc) e Tema claro/escuro em Aparência. Um menu
# editado fica como está.
migrate_menu_default() {
	local menu=$1
	[ -f "$menu" ] || return 0
	case $(sha256sum "$menu" | cut -d' ' -f1) in
	62401952421ca86510aece78cf6fe1cabbeb9f1c0f1abc5befa300153f7a8b3d | \
		f4ad57c9d4a26573b79fe16a825816b37fc2c911bea98b432488c0fd2f41caa8 | \
		ac334e032603bcb864939b4126e10cf1d693db89a7132cd66f3e1c8ad74f70aa | \
		40c815f4db304892b0c7f7042a49baf0b40b9f935f8b0783474886c0fca44b48 | \
		4e9bc7dc0851433d6e03d40e2aad3eac6958b86c6ba4ea47c56d7f79739337a6 | \
		74526b19d533d7b3d3f648cc3a4d7d27b39e3e71196cd676144c9bc5e35044f5)
		mv "$menu" "$menu.bak-$(date +%Y%m%d-%H%M%S)"
		log "menu X11 antigo substituído: $menu"
		;;
	esac
}

# Menu editado pelo usuário: só ganha o atalho Ctrl+Alt+Esc (Forçar o
# fechamento, com a caveira do xkill), logo depois do Bloquear tela. No
# Window Maker os atalhos de comandos vêm do menu raiz.
migrate_kill_shortcut() {
	local menu=$1 label="Force quit"
	[ -w "$menu" ] && grep -q 'EXEC, "big-wm-lock"),$' "$menu" || return 0
	grep -q -e 'big-wm-kill' -e '"Control+Mod1+Escape"' "$menu" && return 0
	grep -q '"Bloquear tela"' "$menu" && label="Forçar o fechamento"
	sed -i "0,/EXEC, \"big-wm-lock\"),\$/s//&\\n    (\"$label\", SHORTCUT, \"Control+Mod1+Escape\", EXEC, \"big-wm-kill\"),/" "$menu"
	log "menu: atalho Ctrl+Alt+Esc (Forçar o fechamento) em $menu"
}

# Menu editado pelo usuário (ou o padrão anterior): ganha Super+V, o
# histórico da área de transferência (wmcliphist), logo depois de
# "Executar...". Fica como está se Super+V já faz outra coisa no menu ou nos
# atalhos do Window Maker.
migrate_clipboard_shortcut() {
	local menu=$1 prefs=$2 label="Clipboard history"
	[ -w "$menu" ] && grep -q 'EXEC, "big-wm-open run"),$' "$menu" || return 0
	grep -qi -e 'big-wm-open clipboard' -e '"Mod4+v"' "$menu" && return 0
	grep -qi '"Mod4+v"' "$prefs" 2>/dev/null && return 0
	grep -q '"Executar\.\.\."' "$menu" && label="Área de transferência"
	sed -i "0,/EXEC, \"big-wm-open run\"),\$/s//&\\n  (\"$label\", SHORTCUT, \"Mod4+v\", EXEC, \"big-wm-open clipboard\"),/" "$menu"
	log "menu: atalho Super+V (histórico da área de transferência) em $menu"
}

# Atalhos de novembro de 2026 num menu já existente (padrão ou editado).
# Cada um só entra quando a tecla está livre no menu e nos atalhos do
# Window Maker; uma linha editada pelo usuário fica como está.
#   Super+R         Executar...
#   Alt+Espaço      Buscar aplicativos (antes Super+Espaço)
#   Ctrl+Shift+Esc  Gerenciador de tarefas (depois de Forçar o fechamento)
#   Print, Alt+Print, Shift+Print: Captura de tela pelo big-wm-screenshot
#                   (Spectacle, quando instalado), no lugar das teclas
#                   internas do Window Maker, que gravavam direto.
key_free() {
	local key=$1 menu=$2 prefs=$3
	! grep -qiF "\"$key\"" "$menu" && ! grep -qiF "\"$key\"" "$prefs" 2>/dev/null
}

migrate_shortcuts_2026_11() {
	local menu=$1 prefs=$2 label
	[ -w "$menu" ] || return 0
	if grep -q '^  ("\(Executar\.\.\.\|Run\.\.\.\)", EXEC, "big-wm-open run"),$' "$menu" &&
		key_free Mod4+r "$menu" "$prefs"; then
		sed -i 's/^  ("\(Executar\.\.\.\|Run\.\.\.\)", EXEC, "big-wm-open run"),$/  ("\1", SHORTCUT, "Mod4+r", EXEC, "big-wm-open run"),/' "$menu"
		log "menu: atalho Super+R (Executar...) em $menu"
	fi
	if grep -q 'SHORTCUT, "Mod4+space", EXEC, "big-wm-open apps")' "$menu" &&
		key_free Mod1+space "$menu" "$prefs"; then
		sed -i 's/SHORTCUT, "Mod4+space", EXEC, "big-wm-open apps")/SHORTCUT, "Mod1+space", EXEC, "big-wm-open apps")/' "$menu"
		log "menu: Buscar aplicativos em Alt+Espaço em $menu"
	fi
	if grep -q 'SHORTCUT, "Control+Mod1+Escape", EXEC, "big-wm-kill"),$' "$menu" &&
		! grep -q 'big-wm-open taskmanager' "$menu" && key_free Control+Shift+Escape "$menu" "$prefs"; then
		label="Task manager"
		grep -q '"Forçar o fechamento"' "$menu" && label="Gerenciador de tarefas"
		sed -i "0,/SHORTCUT, \"Control+Mod1+Escape\", EXEC, \"big-wm-kill\"),\$/s//&\\n    (\"$label\", SHORTCUT, \"Control+Shift+Escape\", EXEC, \"big-wm-open taskmanager\"),/" "$menu"
		log "menu: Gerenciador de tarefas (Ctrl+Shift+Esc) em $menu"
	fi
	# As três teclas Print mudam juntas, só com os valores padrão antigos
	# nas preferências e as três entradas da Captura de tela sem atalho.
	if [ -w "$prefs" ] && grep -qx '  ScreenCaptureKey = Print;' "$prefs" &&
		grep -qx '  WindowCaptureKey = "Mod1+Print";' "$prefs" &&
		grep -qx '  PartialCaptureKey = "Shift+Print";' "$prefs" &&
		[ "$(grep -c '^    ([^,]*, EXEC, "big-wm-screenshot \(full\|window\|area\)")' "$menu")" = 3 ] &&
		! grep -qi 'SHORTCUT, "\?[A-Za-z0-9+]*Print"\?,' "$menu"; then
		sed -i -e 's/^  \(Screen\|Window\|Partial\)CaptureKey = .*;$/  \1CaptureKey = None;/' "$prefs"
		sed -i -e 's/^\(    ([^,]*\), EXEC, "big-wm-screenshot full")/\1, SHORTCUT, Print, EXEC, "big-wm-screenshot full")/' \
			-e 's/^\(    ([^,]*\), EXEC, "big-wm-screenshot window")/\1, SHORTCUT, "Mod1+Print", EXEC, "big-wm-screenshot window")/' \
			-e 's/^\(    ([^,]*\), EXEC, "big-wm-screenshot area")/\1, SHORTCUT, "Shift+Print", EXEC, "big-wm-screenshot area")/' "$menu"
		log "Print, Alt+Print e Shift+Print pelo big-wm-screenshot em $menu e $prefs"
	fi
}

# Ícones padronizados (windowmaker 10): com EnforceIconMargin = YES a imagem
# de cada ícone cabe em 3/4 do ladrilho, reduzida sem serrilhado e com a
# sombra do clip.tiff. As contas criadas antes tinham o NO do padrão
# anterior: passa a YES uma vez só (o marcador em ~/.config/big-wm guarda
# isso); quem voltar a NO no WPrefs fica com NO.
migrate_icon_margin() {
	local prefs=$1 mark=$config_home/big-wm/migracao-margem-dos-icones
	[ -e "$mark" ] && return 0
	mkdir -p "${mark%/*}" || return 0
	if [ -w "$prefs" ] && grep -qx '  EnforceIconMargin = NO;' "$prefs"; then
		sed -i 's/^  EnforceIconMargin = NO;$/  EnforceIconMargin = YES;/' "$prefs" &&
			log "ícones com margem e sombra (EnforceIconMargin = YES): $prefs"
	fi
	: >"$mark"
}

# Papéis de parede do menu X11: passam pelo big-wm-wallpaper (escala suave,
# sem deformar, guardada para o Wayland) em vez do "wmsetbg -u -s", que
# esticava a imagem com o vizinho mais próximo e gravava
# SmoothWorkspaceBack = NO. Ganha também o submenu de ajuste (preencher,
# ajustar, tamanho original, esticar, lado a lado, estender).
migrate_wallpaper_menu() {
	local menu=$1 block
	[ -w "$menu" ] && grep -q 'WITH wmsetbg -u -s"),$' "$menu" || return 0
	sed -i 's#WITH wmsetbg -u -s"),$#WITH big-wm-wallpaper"),#' "$menu"
	if ! grep -q 'big-wm-wallpaper --mode' "$menu"; then
		if grep -q '"Papéis de parede"' "$menu"; then
			block='    (\n      "Ajuste do papel de parede",\n      (Preencher, EXEC, "big-wm-wallpaper --mode fill"),\n      (Ajustar, EXEC, "big-wm-wallpaper --mode fit"),\n      ("Tamanho original", EXEC, "big-wm-wallpaper --mode center"),\n      (Esticar, EXEC, "big-wm-wallpaper --mode stretch"),\n      ("Lado a lado", EXEC, "big-wm-wallpaper --mode tile"),\n      ("Estender pelos monitores", EXEC, "big-wm-wallpaper --mode span")\n    ),'
		else
			block='    (\n      "Wallpaper fit",\n      (Fill, EXEC, "big-wm-wallpaper --mode fill"),\n      (Fit, EXEC, "big-wm-wallpaper --mode fit"),\n      ("Original size", EXEC, "big-wm-wallpaper --mode center"),\n      (Stretch, EXEC, "big-wm-wallpaper --mode stretch"),\n      (Tile, EXEC, "big-wm-wallpaper --mode tile"),\n      ("Span all monitors", EXEC, "big-wm-wallpaper --mode span")\n    ),'
		fi
		sed -i "0,/WITH big-wm-wallpaper\"),\$/s//&\\n$block/" "$menu"
	fi
	log "menu: papéis de parede pelo big-wm-wallpaper em $menu"
}

# Fundo com escala suave: SmoothWorkspaceBack = NO, que o "wmsetbg -u -s"
# do menu gravava a cada troca de papel de parede, passa a YES uma vez
# (quem voltar a NO no WPrefs fica com NO). O fundo padrão esticado
# (spixmap) passa a preencher sem deformar (fpixmap).
migrate_smooth_background() {
	local prefs=$1 mark=$config_home/big-wm/migrations/smooth-background
	[ -e "$mark" ] || [ ! -w "$prefs" ] && return 0
	if grep -q '^[[:space:]]*SmoothWorkspaceBack = NO;' "$prefs"; then
		sed -i 's/^\([[:space:]]*SmoothWorkspaceBack = \)NO;/\1YES;/' "$prefs" &&
			log "fundo com escala suave: $prefs"
	fi
	sed -i 's#^\([[:space:]]*WorkspaceBack = (\)spixmap\(, "/usr/share/backgrounds/big-wm/default\.jpg", "\#505075");\)#\1fpixmap\2#' "$prefs"
	mkdir -p "${mark%/*}" && : >"$mark"
}

# "Restaurar posição do Dock" (Área de trabalho), logo depois de "Organizar
# ícones": traz o Dock de volta quando ele some atrás das janelas ou num
# monitor desligado (também pelo comando big-wm-dock-reset).
migrate_reset_dock() {
	local menu=$1 label="Restore Dock position"
	[ -w "$menu" ] && grep -q ', ARRANGE_ICONS),$' "$menu" || return 0
	grep -q 'RESET_DOCK' "$menu" && return 0
	grep -q '"Organizar ícones"' "$menu" && label="Restaurar posição do Dock"
	sed -i "0,/, ARRANGE_ICONS),\$/s//&\\n    (\"$label\", RESET_DOCK),/" "$menu"
	log "menu: Restaurar posição do Dock em $menu"
}

# Histórico da área de transferência (wmcliphist): a CLIPBOARD (Ctrl+C e
# Ctrl+V; a PRIMARY padrão do wmcliphist fazia o item escolhido no
# histórico não colar com Ctrl+V), o último item mantido quando o
# aplicativo que copiou fecha e o histórico só na memória. Só quando o
# ~/.wmcliphistrc não existe ou está vazio (o wmcliphist cria um vazio), e
# o "persist" só com um wmcliphist que o entende (um anterior pararia ao
# ler a diretiva).
setup_wmcliphist() {
	local rc=$HOME/.wmcliphistrc bin
	bin=$(command -v wmcliphist) || return 0
	[ -s "$rc" ] && return 0
	{
		echo "# Big WindowMaker: histórico da área de transferência (Super+V)"
		echo "clipboard CLIPBOARD"
		echo "auto_take_up yes"
		echo "keep 30"
		grep -aq 'persist' "$bin" && echo "persist no"
	} >"$rc"
	log "wmcliphist: CLIPBOARD, sem gravar o histórico em disco"
}

# Conjuntos de ícones: em vez dos IconSets do Window Maker (só havia o
# Default), os temas de ícones do XDG instalados, gerados ao abrir o menu
# (big-wm-appmenu --icon-themes) e aplicados com big-wm-theme icons.
migrate_icon_sets_menu() {
	local menu=$1
	[ -w "$menu" ] && grep -q 'IconSets WITH seticons"),$' "$menu" || return 0
	sed -i 's#OPEN_MENU, "-noext /usr/share/WindowMaker/IconSets ~/GNUstep/Library/WindowMaker/IconSets WITH seticons"),$#OPEN_PLMENU, "|| big-wm-appmenu --icon-themes"),#' "$menu"
	log "menu: temas de ícones do XDG em $menu"
}

# Configurações > "Localizar o ponteiro ao sacudir" (big-wm-locate-pointer
# --toggle), logo abaixo da Lupa, em menus de versões anteriores.
migrate_locate_pointer_menu() {
	local menu=$1 label="Shake to find the pointer"
	[ -w "$menu" ] && grep -q '^    (\(Lupa\|"Magnifier"\), EXEC, wmagnify)$' "$menu" || return 0
	grep -q 'big-wm-locate-pointer' "$menu" && return 0
	grep -q '^    (Lupa, EXEC, wmagnify)$' "$menu" && label="Localizar o ponteiro ao sacudir"
	sed -i "s/^    (\\(Lupa\\|\"Magnifier\"\\), EXEC, wmagnify)\$/&,\\n    (\"$label\", EXEC, \"big-wm-locate-pointer --toggle\")/" "$menu"
	log "menu: Localizar o ponteiro ao sacudir em $menu"
}

# Terminal do Thunar ("Abrir terminal aqui") e do exo-open: sem o
# xfce4-settings (xfce4-mime-helper), o exo só lê o TerminalEmulator do
# ~/.config/xfce4/helpers.rc e, sem ele, procura o xfce4-terminal, que o Big
# WindowMaker não tem ("Could not find fallback TerminalEmulator
# application"). O big-wm-terminal abre o terminal preferido do usuário
# (AshyTerm por padrão) na pasta; um terminal já escolhido fica.
setup_terminal_helper() {
	local rc=$config_home/xfce4/helpers.rc
	command -v big-wm-terminal >/dev/null || return 0
	grep -q '^TerminalEmulator=' "$rc" 2>/dev/null && return 0
	mkdir -p "${rc%/*}" && echo "TerminalEmulator=big-wm-terminal" >>"$rc" &&
		log "Thunar: terminal preferido pelo big-wm-terminal ($rc)"
}

# Canto ativo de bloqueio das versões anteriores (loginctl lock-session só
# funciona com o xss-lock, que a sessão live não inicia).
migrate_hot_corner() {
	local prefs=$1
	[ -w "$prefs" ] && grep -q '"loginctl lock-session"' "$prefs" || return 0
	sed -i '/HotCornerActions/s#"loginctl lock-session"#"big-wm-lock"#' "$prefs"
	log "canto ativo de bloqueio atualizado: $prefs"
}

# O navegador padrão passou do Brave para o Firefox. Contas criadas antes
# têm o Brave no Clip; troca só quando o Brave não está mais instalado (o
# lançador abre o navegador padrão; o nome serve para o ícone e para marcar
# o aplicativo aberto).
browser_moved() {
	[ ! -e /usr/share/applications/brave-browser.desktop ] &&
		[ -e /usr/share/applications/firefox.desktop ]
}

migrate_browser_x11() {
	local defaults=$1
	browser_moved || return 0
	[ -w "$defaults/WMState" ] && grep -q '"brave-browser.Brave-browser"' "$defaults/WMState" || return 0
	sed -i 's/"brave-browser\.Brave-browser"/Navigator.firefox/' "$defaults/WMState"
	command -v wdwrite >/dev/null && clip_icon Navigator.firefox big-wm-netscape.png
	log "Clip: Brave trocado pelo Firefox"
}

# A bandeja do Dock passou a sair pelo big-wm-systemtray (número da página
# legível no modo escuro). Só a entrada padrão, sem opções do usuário.
migrate_systemtray_x11() {
	local state=$1/WMState
	[ -w "$state" ] && grep -q '^[[:space:]]*Command = "\?wmsystemtray"\?;' "$state" || return 0
	sed -i 's/^\([[:space:]]*Command = \)"\?wmsystemtray"\?;/\1"big-wm-systemtray";/' "$state"
	log "Dock: bandeja pelo big-wm-systemtray"
}

migrate_browser_wayland() {
	local state=$1
	browser_moved || return 0
	[ -w "$state" ] && grep -q 'AppID = "\?brave-browser"\?;' "$state" || return 0
	sed -i 's/AppID = "\?brave-browser"\?;/AppID = "firefox";/' "$state"
	log "Clip (Wayland): Brave trocado pelo Firefox"
}

# Firefox com o tema Netscape 4 (retrothemes-firefox): o userChrome.css tem
# de estar no perfil. Vale para os perfis existentes que ainda não têm
# chrome/ (nada do usuário é sobrescrito); sem perfil nenhum, o Firefox é
# aberto uma vez sem janela para criar o perfil padrão, como na primeira
# execução. Junto com o tema vão preferências (que o usuário pode mudar
# depois em about:config): ler o userChrome.css, usar a barra de título do
# gerenciador de janelas em vez das abas no lugar dela e não perguntar se
# é o navegador padrão (o .desktop chama "firefox", que no BigLinux é o
# wrapper /usr/local/bin/firefox, e o Firefox não se reconhece nele mesmo
# sendo o padrão). O prefs.js só é tocado com o Firefox fechado; aberto,
# fica para o próximo login.
#
# O tema fica em chrome/netscape4/ e o userChrome.css (e o userContent.css)
# só o importa enquanto o tema do Firefox é o padrão ("Sistema",
# extensions.activeThemeID = default-theme@mozilla.org). Outro tema escolhido
# em about:addons vale na hora, sem o Netscape por cima; voltar ao tema
# padrão traz o Netscape de volta.
#
# Uma cópia do tema feita por aqui e não alterada pelo usuário é atualizada
# quando o pacote muda (o .big-wm-theme no chrome/ guarda o hash do que foi
# copiado; a cópia sem esse arquivo do retrothemes-firefox 0.r68-1 é
# reconhecida pelo hash dela; as cópias antigas, sem a condição, passam para
# a nova). Um chrome/ do usuário nunca é tocado, e um chrome/ apagado pelo
# usuário não volta (o .big-wm-firefox no perfil diz que o tema já foi
# posto ali uma vez).
firefox_theme=${BIGWM_FIREFOX_THEME:-/usr/share/retrothemes-firefox/Netscape4/chrome}
firefox_theme_old=32eb43b99f950b3a4e1161f887dd0cd0c1034020a73bb7950fe934d6c35c47ea
firefox_default_theme=default-theme@mozilla.org

theme_sum() {
	(cd "$1" && find . -type f ! -name .big-wm-theme -print0 | LC_ALL=C sort -z |
		xargs -0 -r sha256sum) | sha256sum | cut -d' ' -f1
}

# Monta em $1 (que não existe) o chrome/ do Big WindowMaker.
firefox_compose() {
	local dest=$1 sheet
	mkdir -p "$dest" && cp -r "$firefox_theme" "$dest/netscape4" || return 1
	for sheet in userChrome.css userContent.css; do
		[ -e "$dest/netscape4/$sheet" ] || continue
		cat >"$dest/$sheet" <<-EOF
			/* Big WindowMaker: tema Netscape 4 (retrothemes-firefox) só com o tema
			 * padrão do Firefox; outro tema escolhido em about:addons vale sozinho. */
			@import url("netscape4/$sheet") (-moz-pref("extensions.activeThemeID", "$firefox_default_theme"));
		EOF
	done
}

# Hash do chrome/ atual (montado uma vez numa pasta temporária).
firefox_theme_sum_new=
firefox_current_sum() {
	if [ -z "$firefox_theme_sum_new" ]; then
		local tmp
		tmp=$(mktemp -d) || return 1
		firefox_compose "$tmp/chrome" && firefox_theme_sum_new=$(theme_sum "$tmp/chrome")
		rm -r -- "${tmp:?}"
	fi
	echo "$firefox_theme_sum_new"
}

# Tema copiado por aqui, sem alteração do usuário, e diferente do atual.
firefox_theme_outdated() {
	local chrome=$1 sum recorded=
	sum=$(theme_sum "$chrome")
	[ -r "$chrome/.big-wm-theme" ] && recorded=$(cat "$chrome/.big-wm-theme")
	[ "$sum" = "${recorded:-$firefox_theme_old}" ] && [ "$sum" != "$(firefox_current_sum)" ]
}

# Tema copiado por aqui e não alterado (atual ou não).
firefox_theme_ours() {
	local chrome=$1 sum recorded=
	sum=$(theme_sum "$chrome")
	[ -r "$chrome/.big-wm-theme" ] && recorded=$(cat "$chrome/.big-wm-theme")
	[ "$sum" = "${recorded:-$firefox_theme_old}" ]
}

firefox_profiles() {
	local root ini line
	for root in "$config_home/mozilla/firefox" "$HOME/.mozilla/firefox"; do
		ini=$root/profiles.ini
		[ -r "$ini" ] || continue
		while IFS= read -r line; do
			case $line in
			Path=/*) echo "${line#Path=}" ;;
			Path=*) echo "$root/${line#Path=}" ;;
			esac
		done <"$ini"
	done
}

setup_firefox() {
	[ -d "$firefox_theme" ] && [ -x /usr/bin/firefox ] || return 0
	local profiles profile
	profiles=$(firefox_profiles)
	if [ -z "$profiles" ] && ! pgrep -u "$(id -u)" -x firefox >/dev/null; then
		# Sem janela e sem falar com outra instância; termina assim que o
		# perfil está pronto (compatibility.ini é gravado na partida).
		/usr/bin/firefox --headless --no-remote about:blank >/dev/null 2>&1 &
		local pid=$!
		for _ in $(seq 60); do
			profiles=$(firefox_profiles)
			[ -n "$profiles" ] && compgen -G "$(head -1 <<<"$profiles")/compatibility.ini" >/dev/null && break
			sleep 0.5
		done
		kill "$pid" 2>/dev/null
		wait "$pid" 2>/dev/null
		profiles=$(firefox_profiles)
	fi
	pgrep -u "$(id -u)" -x firefox >/dev/null && return 0
	while IFS= read -r profile; do
		[ -d "$profile" ] || continue
		if [ -e "$profile/chrome" ]; then
			# Cópia nossa de antes do .big-wm-firefox: o tema já foi posto aqui.
			[ -e "$profile/.big-wm-firefox" ] || ! firefox_theme_ours "$profile/chrome" ||
				: >"$profile/.big-wm-firefox"
			if firefox_theme_outdated "$profile/chrome"; then
				rm -rf "$profile/chrome.big-wm-new" &&
					firefox_compose "$profile/chrome.big-wm-new" &&
					theme_sum "$profile/chrome.big-wm-new" >"$profile/chrome.big-wm-new/.big-wm-theme" &&
					rm -rf "$profile/chrome" && mv "$profile/chrome.big-wm-new" "$profile/chrome" &&
					log "Firefox: tema Netscape 4 atualizado em $profile"
			fi
			continue
		fi
		# chrome/ apagado pelo usuário: fica sem o tema.
		[ -e "$profile/.big-wm-firefox" ] && continue
		firefox_compose "$profile/chrome" || continue
		theme_sum "$profile/chrome" >"$profile/chrome/.big-wm-theme"
		: >"$profile/.big-wm-firefox"
		local pref
		for pref in 'toolkit.legacyUserProfileCustomizations.stylesheets", true' \
			'browser.tabs.inTitlebar", 0' \
			'browser.shell.checkDefaultBrowser", false'; do
			grep -qF "user_pref(\"${pref%%\"*}\"" "$profile/prefs.js" 2>/dev/null ||
				echo "user_pref(\"$pref);" >>"$profile/prefs.js"
		done
		log "Firefox: tema Netscape 4 em $profile"
	done <<<"$profiles"
}

# WebApps do BigLinux com o Firefox. O biglinux-webapps põe no /etc/skel
# WebApps prontos (WhatsApp, Discord, Drive...) que chamam o Brave, e o Big
# WindowMaker não traz o Brave: numa conta nova eles não abriam. Sem o Brave
# e com o Firefox, cada um desses arquivos ainda igual ao do /etc/skel vira
# o mesmo WebApp no Firefox, no formato que o próprio WebApps grava
# (firefox-<site>-Browser.desktop, perfil "Browser"); o webapps.json, se
# existir, acompanha. Um WebApp criado ou editado pelo usuário fica como
# está, e o navegador de novos WebApps segue o navegador padrão (Firefox).
webapps_skel=${BIGWM_WEBAPPS_SKEL:-/etc/skel/.local/share/applications}
# Os caminhos que o WebApps procura (browsers.toml) e o Flatpak; não o
# PATH: o auto-tweaks-browser põe um /usr/local/bin/brave mesmo sem o Brave.
brave_installed() {
	local p
	for p in /usr/bin/brave /usr/bin/brave-browser /usr/bin/brave-browser-stable \
		/usr/lib/brave-browser/brave /opt/brave-bin/brave; do
		[ -x "$p" ] && return 0
	done
	[ -d /var/lib/flatpak/app/com.brave.Browser ] || [ -d "$data_home/flatpak/app/com.brave.Browser" ]
}

setup_webapps() {
	local apps=$data_home/applications f base slug new
	[ -x "${BIGWM_FIREFOX_BIN:-/usr/bin/firefox}" ] || return 0
	brave_installed && return 0
	local moved=()
	for f in "$apps"/brave-*-Default.desktop; do
		[ -f "$f" ] || continue
		base=${f##*/}
		cmp -s "$f" "$webapps_skel/$base" || continue
		slug=${base#brave-}
		slug=${slug%-Default.desktop}
		new=firefox-$slug-Browser
		[ -e "$apps/$new.desktop" ] && continue
		sed -e "s#filename=\"$base\" brave --class=\"[^\"]*\" --profile-directory=[^ ]*#filename=\"$new.desktop\" firefox --class=\"$new\" --profile-directory=\"Browser\"#" \
			-e "s#^StartupWMClass=.*#StartupWMClass=$new#" "$f" >"$apps/$new.desktop.tmp" &&
			grep -q "firefox --class=\"$new\"" "$apps/$new.desktop.tmp" &&
			mv "$apps/$new.desktop.tmp" "$apps/$new.desktop" && rm -f "$f" &&
			moved+=("$base=$new.desktop")
		rm -f "$apps/$new.desktop.tmp"
	done
	[ ${#moved[@]} -gt 0 ] || return 0
	local json=$data_home/biglinux-webapps/webapps.json
	if [ -w "$json" ]; then
		python3 -I - "$json" "${moved[@]}" <<-'PY' || log "WebApps: webapps.json não foi atualizado"
			import json, os, sys
			path, pairs = sys.argv[1], dict(p.split("=", 1) for p in sys.argv[2:])
			with open(path) as f:
			    data = json.load(f)
			items = data if isinstance(data, list) else data.get("webapps", [])
			for it in items:
			    if isinstance(it, dict) and it.get("app_file") in pairs and it.get("browser") == "brave":
			        it["app_file"] = pairs[it["app_file"]]
			        it["browser"] = "firefox"
			        it["app_profile"] = "Browser"
			tmp = path + ".tmp"
			with open(tmp, "w") as f:
			    json.dump(data, f, ensure_ascii=False, indent=2)
			os.replace(tmp, path)
		PY
	fi
	log "WebApps no Firefox: ${moved[*]}"
}

# Ícone fixo de um atalho do Clip (classe, ícone dos ícones do Window Maker).
clip_icon() {
	[ -r "$wmicons/$2" ] || return 0
	WMAKER_USER_ROOT=$gnustep wdwrite WMWindowAttributes "$1" "{Icon = \"$2\"; AlwaysUserIcon = YES;}"
}

# Ícones do tema Window Maker em SVG (big-wm-themes) no lugar dos que as
# versões anteriores gravaram: o PNG do pacote do Firefox e do Thunar (que o
# big-wm-firstrun escrevia nos atributos) e o cubo do Window Maker. Só troca
# o atributo que ainda é exatamente o que foi gravado aqui; um ícone
# escolhido pelo usuário (outro arquivo, outras chaves) fica como está.
migrate_icons_x11() {
	local attrs=$1
	[ -w "$attrs" ] || return 0
	grep -q -e '/usr/share/icons/hicolor/64x64/apps/firefox\.png' \
		-e '/usr/share/icons/hicolor/128x128/apps/org\.xfce\.thunar\.png' \
		-e 'defaultAppIcon\.tiff' "$attrs" || return 0
	local entry='\([{;][[:space:]]*"\?'
	sed -z -i \
		-e "s#${entry}Navigator\\.firefox\"\\? = {\\)[[:space:]]*Icon = \"/usr/share/icons/hicolor/64x64/apps/firefox\\.png\";[[:space:]]*}#\\1\\n    Icon = \"big-wm-netscape.png\";\\n    AlwaysUserIcon = YES;\\n  }#" \
		-e "s#${entry}thunar\\.Thunar\"\\? = {\\)[[:space:]]*Icon = \"/usr/share/icons/hicolor/128x128/apps/org\\.xfce\\.thunar\\.png\";[[:space:]]*}#\\1\\n    Icon = \"big-wm-folder.png\";\\n    AlwaysUserIcon = YES;\\n  }#" \
		-e "s#${entry}\\*\"\\? = {[[:space:]]*Icon = \\)\"\\?defaultAppIcon\\.tiff\"\\?;\\([[:space:]]*}\\)#\\1\"big-wm-defaultapp.png\";\\2#" \
		"$attrs"
	log "ícones do tema Window Maker nos atributos: $attrs"
}

# O Firefox agrupa as janelas sob um líder "firefox.Firefox" (a janela do
# navegador é "Navigator.firefox"): é por ele que o Window Maker escolhe o
# ícone do aplicativo e reconhece o lançador do Clip. O ícone escolhido para
# "Navigator.firefox" (o Netscape do Big WindowMaker, ou outro do usuário)
# passa a valer também para "firefox.Firefox", e o lançador do Clip
# "Navigator.firefox" vira "firefox.Firefox": sem isso o Firefox aberto
# aparecia com o próprio ícone, num segundo ícone no rodapé.
migrate_firefox_x11() {
	local defaults=$1 icon
	local attrs=$defaults/WMWindowAttributes state=$defaults/WMState
	if [ -w "$attrs" ] && ! grep -q '^[[:space:]]*"\?firefox\.Firefox"\? = ' "$attrs"; then
		icon=$(sed -n '/^[[:space:]]*"\?Navigator\.firefox"\? = {/,/}/{s/^[[:space:]]*Icon = "\?\([^";]*\)"\?;.*/\1/p}' "$attrs" | head -n1)
		if [ -n "$icon" ] && sed -n '/^[[:space:]]*"\?Navigator\.firefox"\? = {/,/}/p' "$attrs" | grep -q 'AlwaysUserIcon = YES'; then
			# Acrescentado no fim, como texto: o wdwrite regravaria (e
			# reordenaria) o arquivo inteiro do usuário.
			if [ "$(tail -n1 "$attrs")" = "}" ]; then
				local esc=${icon//\\/\\\\}
				esc=${esc//#/\\#}
				esc=${esc//&/\\&}
				sed -i '$ s#^}$#  firefox.Firefox = {\n    Icon = "'"$esc"'";\n    AlwaysUserIcon = YES;\n  };\n}#' "$attrs"
			else
				WMAKER_USER_ROOT=$gnustep wdwrite WMWindowAttributes firefox.Firefox "{Icon = \"$icon\"; AlwaysUserIcon = YES;}"
			fi && log "Firefox: ícone $icon também no líder firefox.Firefox"
		fi
	fi
	if [ -w "$state" ] && grep -q '^[[:space:]]*Name = "\?Navigator\.firefox"\?;' "$state"; then
		sed -i 's/^\([[:space:]]*Name = \)"\?Navigator\.firefox"\?;/\1firefox.Firefox;/' "$state" &&
			log "Clip: lançador do Firefox reconhece o navegador aberto (firefox.Firefox)"
	fi
}

# AshyTerm com a barra de título do Window Maker. É GTK4/libadwaita: o
# headerbar (abas, busca, menu) é a decoração da janela, e o Window Maker
# respeita o pedido de "sem moldura". Com IgnoreDecorationChanges ele
# desenha a barra dele por cima; o AshyTerm que lê _NET_FRAME_EXTENTS
# (utils/wm_frame.py) esconde então os botões de janela do headerbar, que
# ficariam duplicados, e mantém o resto. Só com essa versão do AshyTerm, e
# uma vez só: se o usuário apagar o atributo, ele não volta.
migrate_ashyterm_x11() {
	local attrs=$1 done=$config_home/big-wm/ashyterm-wm-titlebar
	[ -w "$attrs" ] && [ ! -e "$done" ] || return 0
	compgen -G "$ashyterm_frame" >/dev/null || return 0
	mkdir -p "${done%/*}" && : >"$done"
	grep -q '^[[:space:]]*"\?org\.communitybig\.ashyterm"\? = ' "$attrs" && return 0
	if [ "$(tail -n1 "$attrs")" = "}" ]; then
		sed -i '$ s#^}$#  "org.communitybig.ashyterm" = {\n    IgnoreDecorationChanges = YES;\n  };\n}#' "$attrs"
	else
		WMAKER_USER_ROOT=$gnustep wdwrite WMWindowAttributes org.communitybig.ashyterm "{IgnoreDecorationChanges = YES;}"
	fi && log "AshyTerm: barra de título do Window Maker"
}

# Salvar sessão: o Dock com abas (iniciado pela sessão), o Buscar
# aplicativos/Executar e a Lupa não entram na sessão salva; antes, a
# sessão salva iniciava um segundo Dock com abas. Acrescentado uma vez,
# no fim do arquivo do usuário (o wdwrite reordenaria o arquivo todo).
migrate_session_attrs_x11() {
	local attrs=$1 done=$config_home/big-wm/session-attrs
	[ -w "$attrs" ] && [ ! -e "$done" ] || return 0
	mkdir -p "${done%/*}" && : >"$done"
	[ "$(tail -n1 "$attrs")" = "}" ] || return 0
	local add='' c
	for c in big-wm-tabbed-dock.Big-wm-tabbed-dock big-wm-launcher.BigWMLauncher magnify.Magnify; do
		grep -q "^[[:space:]]*\"\?${c//./\\.}\"\? = " "$attrs" && continue
		add="$add  \"$c\" = {\n    DontSaveSession = YES;\n  };\n"
	done
	[ -n "$add" ] || return 0
	sed -i "\$ s#^}\$#$add}#" "$attrs" && log "Salvar sessão: componentes da sessão fora da sessão salva"
}

setup_x11() {
	[ "$reset" = 1 ] && backup "$gnustep"

	local src=$datadir/GNUstep
	local defaults=$gnustep/Defaults
	local library=$gnustep/Library/WindowMaker

	for f in WindowMaker WMGLOBAL WMState WMWindowAttributes; do
		install_default "$src/Defaults/$f" "$defaults/$f"
	done
	# Os ícones dos atalhos do Clip (Netscape e pasta) já vêm no
	# WMWindowAttributes padrão: são PNG do big-wm-themes, sempre instalados.
	migrate_icons_x11 "$defaults/WMWindowAttributes"
	migrate_menu_default "$defaults/WMRootMenu"
	install_default "$(localized "$src/Defaults/WMRootMenu")" "$defaults/WMRootMenu"
	migrate_browser_x11 "$defaults"
	migrate_systemtray_x11 "$defaults"
	migrate_menu "$defaults/WMRootMenu"
	migrate_kill_shortcut "$defaults/WMRootMenu"
	migrate_clipboard_shortcut "$defaults/WMRootMenu" "$defaults/WindowMaker"
	migrate_wallpaper_menu "$defaults/WMRootMenu"
	migrate_reset_dock "$defaults/WMRootMenu"
	migrate_icon_sets_menu "$defaults/WMRootMenu"
	migrate_locate_pointer_menu "$defaults/WMRootMenu"
	migrate_shortcuts_2026_11 "$defaults/WMRootMenu" "$defaults/WindowMaker"
	migrate_icon_margin "$defaults/WindowMaker"
	migrate_smooth_background "$defaults/WindowMaker"
	migrate_firefox_x11 "$defaults"
	migrate_ashyterm_x11 "$defaults/WMWindowAttributes"
	migrate_session_attrs_x11 "$defaults/WMWindowAttributes"
	migrate_hot_corner "$defaults/WindowMaker"
	# Sem autostart/exitscript padrão: os serviços da sessão vêm do XDG
	# autostart (systemd --user) e, sem esses arquivos, o Window Maker nem
	# chama system() na partida (o que gerava um erro intermitente).
	# Pixmaps: o primeiro lugar do PixmapPath e do IconPath, para imagens do
	# próprio usuário. Fica vazia de propósito (o wmaker.inst do Window Maker
	# também a cria vazia): as texturas e os ícones dos temas vêm de
	# /usr/share/WindowMaker/{Pixmaps,Icons,Backgrounds}, de
	# /usr/share/backgrounds/big-wm e de dentro dos pacotes .themed.
	mkdir -p "$library/Themes" "$library/Styles" "$library/IconSets" \
		"$library/Backgrounds" "$library/CachedPixmaps" "$library/Pixmaps" "$gnustep/Library/Icons"

	# picom só lê um arquivo por vez; o padrão do sistema pertence ao pacote picom.
	install_default "$datadir/picom.conf" "$config_home/picom/picom.conf"
}

# State.plist de versões anteriores, sem alteração do usuário: dá lugar ao
# novo (Clip no canto superior esquerdo com navegador e arquivos abaixo
# dele, como no X11; AppID nos lançadores, que o wlmdock usa para indicar
# app aberto).
migrate_wayland_state() {
	local state=$1
	[ -f "$state" ] || return 0
	case $(sha256sum "$state" | cut -d' ' -f1) in
	ac11d36d9486b493bb4739c40d89cb341deb2fdbbfa9fdec633e310e7e0f59da | \
		0c8d9ef38f69f47a52be2fa69faa4ba82ac9716ae1ad8d5f246437ee6ca39069) ;;
	*) return 0 ;;
	esac
	mv "$state" "$state.bak-$(date +%Y%m%d-%H%M%S)"
	log "estado do wlmaker antigo substituído: $state"
}

# Menu Wayland de versões anteriores, sem alteração do usuário (sha256 do
# modelo pt_BR e do inglês): dá lugar ao menu novo, com aplicativos por
# categoria, Aparência (Tema claro/escuro, Temas e Estilos) e Configurações
# (com o WPrefs). Um menu editado fica como está.
migrate_wayland_menu() {
	local menu=$1 sum
	[ -f "$menu" ] || return 0
	sum=$(sha256sum "$menu" | cut -d' ' -f1)
	case $sum in
	bd102072be1d2640e10b939310ec289f1704bd4de50846d3e6308db234496843 | \
		8715e560d3ac24ec7d2524be7ec474577504ec637a3239d53332bb6c16399cf8 | \
		ffe109654063310c634e01a5687f5978b166c139395dade57aa64609195545a9 | \
		4be6ad80c151f2432226c108b01f7c5d67f9b62944ab9f3b91e50538f1bb8ad6 | \
		d01886af7e322f4ffa75e3be118aa38066f7459ee36fc6de6c1dbea43f62430c | \
		bf59e398965306e4c3267f001e3bfdf291411aa3d4f0de3b78c8264dc2d56885 | \
		4d447fb9d31bf3108305fcd8d2549593e86e3a177f29fbaf093fb990a425205b | \
		c4620c5e5af1731651fc6190fe8c60e1a34a64f50e43717e0a8a72261cc40dd7 | \
		7782e0f6d529f36f1e648686f0fc017bd2984a5c8521dda47a51192d7881f191 | \
		ff5ce47c9773d35225cb200480ed8d6f7e3f4e2428a553dbe0328016a0ffd75e)
		mv "$menu" "$menu.bak-$(date +%Y%m%d-%H%M%S)"
		log "menu Wayland antigo substituído: $menu"
		;;
	esac
}

# Ícones dos lançadores das versões anteriores (globo, pasta amarela e o
# terminal do wlmaker) trocados pelos do tema Window Maker em SVG. Os dois
# primeiros nomes são só do Big WindowMaker; o terminal-56x56.png do wlmaker
# só muda no lançador do terminal padrão (big-wm-open terminal). O ícone do
# Clip não precisa de migração: sem Clip.Icon, o wlmaker do Big WindowMaker
# já usa o big-wm-clip-56x56.png.
migrate_wayland_icons() {
	local state=$1
	[ -w "$state" ] || return 0
	grep -q -e 'big-wm-browser-56x56\.png' -e 'big-wm-files-56x56\.png' \
		-e '"\?terminal-56x56\.png"\?;' "$state" || return 0
	local open='"\?/usr/bin/big-wm-open terminal"\?;'
	sed -z -i \
		-e 's#Icon = "\?big-wm-browser-56x56\.png"\?;#Icon = "big-wm-netscape-56x56.png";#g' \
		-e 's#Icon = "\?big-wm-files-56x56\.png"\?;#Icon = "big-wm-folder-56x56.png";#g' \
		-e "s#\\(CommandLine = ${open}[^{}]*Icon = \\)\"\\?terminal-56x56\\.png\"\\?;#\\1\"big-wm-terminal-56x56.png\";#g" \
		-e "s#\\(Icon = \\)\"\\?terminal-56x56\\.png\"\\?;\\([^{}]*CommandLine = ${open}\\)#\\1\"big-wm-terminal-56x56.png\";\\2#g" \
		"$state"
	log "ícones dos lançadores do wlmaker atualizados: $state"
}

# Config.plist de versões anteriores: troca só as linhas que mudaram (rofi
# sem o tema, swaylock sem a imagem do Big WindowMaker, swaybg fixo no
# papel de parede padrão).
migrate_wayland_config() {
	local config=$1
	[ -w "$config" ] || return 0
	grep -q -e '"rofi -show drun"' -e '/usr/bin/swaylock -f -c 202a2e' \
		-e '/usr/bin/swaybg -m fill -i /usr/share/backgrounds/big-wm/default.jpg' \
		-e '"xdg-terminal-exec"' "$config" || return 0
	# shellcheck disable=SC2016 # $HOME é texto do plist, não do shell
	sed -i \
		-e 's#(ShellExecute, "rofi -show drun")#(ShellExecute, "big-wm-open apps")#' \
		-e 's#(ShellExecute, "xdg-terminal-exec")#(ShellExecute, "big-wm-open terminal")#' \
		-e 's#(ShellExecute, "xdg-open \\"$HOME\\"")#(ShellExecute, "big-wm-open files")#' \
		-e 's#Command = "/usr/bin/swaylock -f -c 202a2e";#Command = "/usr/bin/big-wm-lock";#' \
		-e 's#"/usr/bin/swaybg -m fill -i /usr/share/backgrounds/big-wm/default.jpg"#"/usr/bin/big-wm-wallpaper --restore"#' \
		"$config"
	log "configuração do wlmaker atualizada: $config"
}

# Atalhos novos do wlmaker (captura de janela e Forçar o fechamento) num
# Config.plist que ainda não os tem: entram logo depois de "KeyBindings = {";
# uma tecla que o usuário já usa para outra coisa fica como está.
migrate_wayland_keys() {
	local config=$1 key line lines=()
	[ -w "$config" ] && grep -q '^[[:space:]]*KeyBindings = {' "$config" || return 0
	for line in '"Alt+Print" = (ShellExecute, "big-wm-screenshot window");' \
		'"Ctrl+Alt+Escape" = (ShellExecute, "big-wm-kill");' \
		'"Logo+V" = (ShellExecute, "big-wm-open clipboard");' \
		'"Logo+R" = (ShellExecute, "big-wm-open run");' \
		'"Alt+space" = (ShellExecute, "big-wm-open apps");' \
		'"Ctrl+Shift+Escape" = (ShellExecute, "big-wm-open taskmanager");'; do
		key=${line%% =*}
		grep -qF "$key =" "$config" || lines+=("$line")
	done
	[ ${#lines[@]} -gt 0 ] || return 0
	for line in "${lines[@]}"; do
		sed -i "0,/^\([[:space:]]*\)KeyBindings = {\$/s##&\\n\\1    $line#" "$config"
	done
	log "atalhos novos do wlmaker em $config: ${lines[*]}"
}

# A bandeja como dockapp do Dock (o wlmaker a adota: Dock.Dockapps diz que
# ela começa no Dock, depois dos lançadores) e o ícone das gavetas novas
# (Add a drawer), num State.plist que ainda não os tem.
migrate_wayland_dock_keys() {
	local state=$1
	[ -w "$state" ] && grep -q '^  Dock = {$' "$state" || return 0
	if ! grep -q '"big-wm-tray"' "$state"; then
		sed -i '0,/^  Dock = {$/s//&\n    Dockapps = ("big-wm-tray");/' "$state"
		log "bandeja no Dock do wlmaker: $state"
	fi
	if ! grep -q 'DrawerIcon' "$state"; then
		sed -i '0,/^  Dock = {$/s//&\n    DrawerIcon = "big-wm-drawer-56x56.png";/' "$state"
		log "ícone das gavetas do Dock: $state"
	fi
}

# "Configurações..." dos lançadores do Dock e do Clip (wlmaker com os menus
# do Window Maker): o comando entra num Config.plist que ainda não o tem,
# logo depois do ThemeFile.
migrate_wayland_dock_settings() {
	local config=$1
	[ -w "$config" ] && grep -q '^[[:space:]]*ThemeFile = ' "$config" || return 0
	grep -q 'DockSettingsCommand' "$config" && return 0
	sed -i '0,/^\([[:space:]]*\)ThemeFile = .*$/s##&\n\1DockSettingsCommand = "/usr/bin/big-wm-dock-settings";#' "$config"
	log "Configurações... dos lançadores em $config"
}

# O WPrefs (menu Configurações > Window Maker) também abre na sessão
# Wayland, pelo XWayland, e lê ~/GNUstep/Defaults: quem nunca entrou na
# sessão X11 começa com os padrões do Big WindowMaker, não os do Window
# Maker. Nada do usuário é sobrescrito.
setup_wprefs_defaults() {
	local src=$datadir/GNUstep/Defaults defaults=$gnustep/Defaults f
	for f in WindowMaker WMGLOBAL WMState WMWindowAttributes; do
		install_default "$src/$f" "$defaults/$f"
	done
	install_default "$(localized "$src/WMRootMenu")" "$defaults/WMRootMenu"
	# Sem este diretório o WPrefs não grava a velocidade do mouse
	# (autostart com "xset m").
	mkdir -p "$gnustep/Library/WindowMaker"
}

setup_wayland() {
	local dst=$config_home/wlmaker
	[ "$reset" = 1 ] && backup "$dst"
	setup_wprefs_defaults

	migrate_wayland_state "$dst/State.plist"
	install_default "$datadir/wlmaker/State.plist" "$dst/State.plist"
	migrate_wayland_menu "$dst/RootMenu.plist"
	install_default "$(localized "$datadir/wlmaker/RootMenu.plist")" "$dst/RootMenu.plist"
	migrate_wayland_config "$dst/Config.plist"
	migrate_wayland_keys "$dst/Config.plist"
	migrate_wayland_dock_settings "$dst/Config.plist"
	migrate_browser_wayland "$dst/State.plist"
	migrate_wayland_icons "$dst/State.plist"
	migrate_wayland_dock_keys "$dst/State.plist"

	# O layout de teclado vem do sistema (localectl ou console), como na sessão X11.
	if [ ! -e "$dst/Config.plist" ]; then
		# shellcheck source=session/lib/big-wm-keyboard.sh
		. "${BIGWM_LIBDIR:-/usr/lib/big-wm}/big-wm-keyboard.sh"
		big_wm_keyboard
		mkdir -p "$dst"
		sed -e "s|@XKB_LAYOUT@|$XKB_LAYOUT|" \
			-e "s|@XKB_VARIANT@|$XKB_VARIANT|" \
			-e "s|@XKB_MODEL@|$XKB_MODEL|" \
			-e "s|@XKB_OPTIONS@|$XKB_OPTIONS|" \
			"$datadir/wlmaker/Config.plist.in" >"$dst/Config.plist"
	fi
}

case "${1:-}" in
x11) setup_x11; setup_screenshots; setup_kvantum; setup_theme; setup_fastfetch; setup_ashyterm; setup_terminal_helper; setup_wmcliphist; setup_webapps; setup_firefox & ;;
wayland) setup_wayland; setup_screenshots; setup_kvantum; setup_theme; setup_fastfetch; setup_ashyterm; setup_terminal_helper; setup_wmcliphist; setup_webapps; setup_firefox & ;;
*)
	echo "uso: ${0##*/} [--reset] x11|wayland" >&2
	exit 2
	;;
esac
