#!/usr/bin/python3 -I
# SPDX-License-Identifier: GPL-2.0-or-later
#
# HP Device Manager e HP Scan (HPLIP) nas sessões Big WindowMaker:
#
#   big-wm-hp toolbox     hp-toolbox (HP Device Manager)
#   big-wm-hp scan        hp-uiscan (HP Scan)
#
# As interfaces do HPLIP são PyQt5, que no pacote hplip é dependência
# opcional (python-pyqt5). Sem ele o hp-toolbox e o hp-uiscan escrevem
# "error: No module named 'PyQt5'" no terminal e saem com código 0: pelo
# menu ou pelo Dock, clicar não fazia nada. Aqui a falta vira uma janela que
# diz o que instalar; com o PyQt5 presente, o programa do HPLIP abre como
# sempre (sem impressora, ele mesmo explica: "No Installed HP Devices Found",
# "No device connected").
#
# As entradas org.bigwindowmaker.HPDeviceManager e org.bigwindowmaker.HPScan
# (OnlyShowIn=WindowMaker;wlmaker) chamam este programa; as hplip.desktop e
# hp-uiscan.desktop do pacote ficam ocultas nessas sessões.
"""Abre o HP Device Manager ou o HP Scan, ou explica o que falta."""

import os
import shutil
import subprocess
import sys

PT = (os.environ.get("LANGUAGE") or os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES")
      or os.environ.get("LANG") or "").startswith("pt")

TOOLS = {"toolbox": ("hp-toolbox", "HP Device Manager"),
         "scan": ("hp-uiscan", "HP Scan")}


def tr(pt, en):
    return pt if PT else en


def pyqt5_present():
    """O HPLIP roda com "#!/usr/bin/env python", com o site-packages do
    usuário e o PYTHONPATH: a pergunta vai para esse mesmo python (este
    script, com -I, não enxergaria um PyQt5 instalado só para o usuário)."""
    try:
        return subprocess.run(["python", "-c", "import PyQt5.QtWidgets"], stdin=subprocess.DEVNULL,
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                              timeout=20, check=False).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def explain(name, title, text):
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import GLib, Gtk
    GLib.set_prgname("big-wm-hp")
    dialog = Gtk.MessageDialog(message_type=Gtk.MessageType.WARNING, buttons=Gtk.ButtonsType.CLOSE,
                               text=title)
    dialog.set_title(name)
    dialog.set_icon_name("printer")
    dialog.format_secondary_markup(text)
    dialog.run()


def main(argv):
    which = argv[1] if len(argv) > 1 else ""
    if which not in TOOLS:
        print("uso: big-wm-hp toolbox|scan", file=sys.stderr)
        return 2
    program, name = TOOLS[which]
    path = shutil.which(program)
    if path is None:
        explain(name, tr("%s não está instalado" % name, "%s is not installed" % name),
                tr("Instale o pacote <b>hplip</b> para usar impressoras e scanners HP.",
                   "Install the <b>hplip</b> package to use HP printers and scanners."))
        return 1
    if not pyqt5_present():
        explain(name, tr("%s precisa do PyQt5" % name, "%s needs PyQt5" % name),
                tr("A janela do HPLIP é feita com o Qt 5 e o pacote <b>python-pyqt5</b> "
                   "não está instalado.\n\nInstale-o pelo gerenciador de pacotes (Pamac) "
                   "ou no terminal:\n<tt>sudo pacman -S python-pyqt5</tt>\n\n"
                   "A impressão continua funcionando sem ele; para configurar uma "
                   "impressora há também Configurações de impressão.",
                   "The HPLIP window is built with Qt 5 and the <b>python-pyqt5</b> package "
                   "is not installed.\n\nInstall it with the package manager (Pamac) or in "
                   "a terminal:\n<tt>sudo pacman -S python-pyqt5</tt>\n\n"
                   "Printing keeps working without it; to set up a printer there is also "
                   "Print Settings."))
        return 1
    os.execv(path, [path] + argv[2:])
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
