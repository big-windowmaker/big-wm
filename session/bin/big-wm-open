#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-or-later
#
# Abre o aplicativo padrão do usuário para uma função, respeitando as
# escolhas feitas em xdg-settings/xdg-mime. Usado pelo Dock, pelo Clip
# e pelos menus das duas sessões.
#
#   big-wm-open browser | files | terminal | apps | run

case "$1" in
browser)
	desktop=$(xdg-settings get default-web-browser 2>/dev/null)
	if [ -n "$desktop" ]; then
		exec gtk-launch "${desktop%.desktop}"
	fi
	exec xdg-open about:blank
	;;
files)
	# Pastas abrem no aplicativo padrão de inode/directory, mas o Catfish (que
	# se registra para pastas) é busca, não gerenciador de arquivos: aí, ou
	# sem padrão, vai o Thunar.
	case $(xdg-mime query default inode/directory 2>/dev/null) in
	"" | *[Cc]atfish*)
		command -v thunar >/dev/null && exec thunar "$HOME"
		;;
	esac
	exec xdg-open "$HOME"
	;;
terminal) exec xdg-terminal-exec ;;
apps | run)
	mode=drun
	[ "$1" = run ] && mode=run
	# Tema do Big WindowMaker, a menos que o usuário tenha configurado o rofi.
	config=${XDG_CONFIG_HOME:-$HOME/.config}/rofi/config.rasi
	if [ -e "$config" ]; then
		exec rofi -show "$mode"
	fi
	case ${LANG%%_*}:$mode in
	pt:drun) title="Buscar aplicativos" hint="Digite o nome do aplicativo..." ;;
	pt:run) title="Executar" hint="Digite o comando..." ;;
	es:drun) title="Buscar aplicaciones" hint="Escriba el nombre de la aplicación..." ;;
	es:run) title="Ejecutar" hint="Escriba el comando..." ;;
	*:run) title="Run" hint="Type the command..." ;;
	*) title="Search applications" hint="Type the application name..." ;;
	esac
	exec rofi -show "$mode" -show-icons -drun-display-format '{name}' \
		-theme "${BIGWM_DATADIR:-/usr/share/big-wm}/rofi/big-wm.rasi" \
		-theme-str "textbox-title { content: \"$title\"; }" \
		-theme-str "entry { placeholder: \"$hint\"; }"
	;;
*)
	echo "uso: ${0##*/} browser|files|terminal|apps|run" >&2
	exit 2
	;;
esac
