#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-or-later
#
# Abre o aplicativo padrão do usuário para uma função, respeitando as
# escolhas feitas em xdg-settings/xdg-mime. Usado pelo Dock, pelo Clip
# e pelos menus das duas sessões.
#
#   big-wm-open browser | files | terminal | apps | run | music | clipboard |
#               taskmanager

# Modo claro/escuro escolhido depois do login (big-wm-theme): o aplicativo
# aberto daqui já sai com o tema GTK do modo atual.
# shellcheck source=session/lib/big-wm-theme.sh
. "${BIGWM_LIBDIR:-/usr/lib/big-wm}/big-wm-theme.sh" 2>/dev/null && big_wm_theme_refresh_env

# "yes" quando o .desktop (ID) é de um gerenciador de arquivos
# (Categories=...;FileManager;...), procurado nos diretórios do XDG.
file_manager_category() {
	local id=$1 dir file
	for dir in "${XDG_DATA_HOME:-$HOME/.local/share}" $(tr ':' ' ' <<<"${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"); do
		file=$dir/applications/$id
		[ -r "$file" ] || continue
		grep -qE '^Categories=(.*;)?FileManager(;|$)' "$file" && echo yes
		return
	done
}

# Aberto por um dockapp de GTK no XWayland (minidock, wmcliphist...), que
# precisa do backend X11 do GTK: o aplicativo aberto não o herda e sai no
# backend da sessão (Wayland nativo na sessão Wayland).
if [ -n "${BIG_WM_DOCKAPP_X11:-}" ]; then
	unset GDK_BACKEND BIG_WM_DOCKAPP_X11
fi
# O gtk-launch recebe o nome do arquivo (.desktop): sem a extensão, um ID
# que termina em ".desktop" (org.telegram.desktop) não seria achado.
case "${1:-}" in
browser)
	desktop=$(xdg-settings get default-web-browser 2>/dev/null)
	if [ -n "$desktop" ]; then
		exec gtk-launch "$desktop"
	fi
	exec xdg-open about:blank
	;;
files)
	# Pastas abrem no aplicativo padrão de inode/directory (Thunar no Big
	# WindowMaker, /etc/xdg/<sessão>-mimeapps.list; o usuário pode trocar).
	# Só vale se for mesmo um gerenciador de arquivos: o Kate e o VSCodium
	# (editores) e o Catfish (busca) também se registram para pastas e já
	# viraram o "padrão" por engano; aí, ou sem padrão, vai o Thunar.
	desktop=$(xdg-mime query default inode/directory 2>/dev/null)
	if [ -n "$desktop" ] && [ "$(file_manager_category "$desktop")" = yes ]; then
		exec gtk-launch "$desktop" "$HOME"
	fi
	command -v thunar >/dev/null && exec thunar "$HOME"
	exec xdg-open "$HOME"
	;;
terminal)
	# Terminal escolhido pelo usuário (xdg-terminals.list), AshyTerm por
	# padrão, com reservas e aviso quando não há nenhum: big-wm-terminal,
	# o mesmo do "Abrir terminal aqui" do Thunar.
	exec big-wm-terminal
	;;
clipboard)
	# Super+V: a janela do histórico (busca, favoritos), a mesma nas duas
	# sessões; aberta, vem para a frente.
	exec big-wm-clipboard
	;;
apps | run)
	# Visual do Window Maker, botão de fechar e Lista/Grade/Categorias
	# (big-wm-launcher), a menos que o usuário tenha configurado o rofi.
	config=${XDG_CONFIG_HOME:-$HOME/.config}/rofi/config.rasi
	if [ -e "$config" ]; then
		mode=drun
		[ "$1" = run ] && mode=run
		exec rofi -show "$mode"
	fi
	exec big-wm-launcher "$1"
	;;
taskmanager)
	# Ctrl+Shift+Esc. Uma janela já aberta só volta para a frente (o
	# xfce4-taskmanager é de instância única). Sem gerenciador gráfico, o
	# htop (ou o top) no terminal.
	for app in xfce4-taskmanager lxtask gnome-system-monitor plasma-systemmonitor; do
		command -v "$app" >/dev/null && exec "$app"
	done
	if command -v htop >/dev/null; then
		exec big-wm-terminal -e htop
	fi
	exec big-wm-terminal -e top
	;;
music)
	# Player de música padrão (wmusic -c): o aplicativo de audio/mpeg.
	desktop=$(xdg-mime query default audio/mpeg 2>/dev/null)
	[ -n "$desktop" ] && exec gtk-launch "$desktop"
	for app in br.com.biglinux.AudioPlayer org.gnome.Rhythmbox3 audacious vlc; do
		gtk-launch "$app" 2>/dev/null && exit 0
	done
	exit 1
	;;
*)
	echo "uso: ${0##*/} browser|files|terminal|apps|run|music|clipboard|taskmanager" >&2
	exit 2
	;;
esac
