#!/usr/bin/python3 -I
# SPDX-License-Identifier: GPL-2.0-or-later
#
# "Buscar aplicativos" e "Executar" do Big WindowMaker: uma janela GTK 3
# comum, com a barra de título do Window Maker (arrasta, minimiza, fecha
# como as outras) e o tema GTK da sessão (OneStepBack, claro ou escuro).
#
#   big-wm-launcher apps      Buscar aplicativos
#   big-wm-launcher run       Executar
#   big-wm-launcher --print apps|run|categories|CATEGORIA
#                             só imprime os dados (testes)
#
# Buscar aplicativos: categorias à esquerda (Todos e as do menu
# Aplicativos), a lista à direita com ícone, nome, descrição e a categoria
# em texto menor. A busca vale em qualquer categoria e procura no nome, no
# nome genérico, na descrição, nas palavras-chave e na categoria; as
# palavras podem vir em qualquer ordem e sem acento, e os resultados mais
# relevantes vêm primeiro (depois os mais usados). A roda do mouse só rola
# a lista; setas, Page Up/Down, Home/End escolhem; Enter ou um clique
# abrem; Esc fecha. Sem popovers: nada fica preso na tela.
#
# Executar: o comando é dividido como no shell (aspas e barras), mas
# executado diretamente, sem shell: nada de variáveis, curingas ou
# redirecionamentos interpretados sem querer. "Interpretar como comando do
# shell" passa a linha inteira para o sh -c, de propósito. "Abrir no
# terminal" usa o big-wm-terminal. Completa nomes de comandos do PATH (Tab
# ou a lista que aparece ao digitar), lembra os comandos usados (opcional) e
# mostra o erro na própria janela quando o comando não existe.
#
# Os aplicativos e as categorias vêm do big-wm-appmenu (os mesmos do menu
# Aplicativos, com as mesmas regras de NoDisplay, OnlyShowIn, TryExec e
# tradução), lidos a cada abertura (cerca de 0,15 s): um aplicativo
# instalado ou removido aparece na hora, sem processo residente. Abrem com
# gtk-launch. Os mais usados vêm primeiro.
#
# Preferências: ~/.config/big-wm/launcher (category=, run-history=yes|no,
# run-shell=, run-terminal=). Uso: ~/.cache/big-wm/launcher-history.

import os
import shlex
import shutil
import subprocess
import sys
import unicodedata
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader

# O big-wm-appmenu é um script, não um módulo: carregado do mesmo diretório,
# sem gravar __pycache__ ao lado dele.
sys.dont_write_bytecode = True
HERE = os.path.dirname(os.path.realpath(__file__))
_loader = SourceFileLoader(
    "big_wm_appmenu", os.environ.get("BIGWM_APPMENU") or os.path.join(HERE, "big-wm-appmenu"))
appmenu = module_from_spec(spec_from_loader("big_wm_appmenu", _loader))
_loader.exec_module(appmenu)

