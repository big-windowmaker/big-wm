#!/usr/bin/python3 -Is
# SPDX-License-Identifier: GPL-2.0-or-later
#
# Ampliação da tela por comando (menus Aparência > Aumentar Escala e
# Diminuir Escala), a mesma do Ctrl+Alt+rolagem:
#
#   big-wm-zoom in       amplia um passo (como um entalhe da roda)
#   big-wm-zoom out      reduz um passo
#   big-wm-zoom reset    volta ao normal (Ctrl+Alt+0)
#
# Sessão X11: quem amplia é o plugin do picom (pacote big-wm-zoom). Ele é
# dono da seleção _BIG_WM_ZOOM_S<tela>; o comando vai como ClientMessage
# _BIG_WM_ZOOM_COMMAND para a janela dona (1 amplia, 2 reduz, 3 normal).
# Sem dono (picom parado, sem o plugin, picom de outra versão), avisa por
# notificação e sai com 1.
#
# Sessão Wayland: o menu do wlmaker chama as ações ZoomIn/ZoomOut/ZoomReset
# direto (o big-wm-wprefs-sync converte este comando nelas); aqui só avisa.
#
# Só usa a libX11 (ctypes): nenhuma dependência nova.

import ctypes
import ctypes.util
import os
import shutil
import subprocess
import sys

COMMANDS = {"in": 1, "out": 2, "reset": 3}
CLIENT_MESSAGE = 33


class XClientMessageEvent(ctypes.Structure):
    _fields_ = [("type", ctypes.c_int), ("serial", ctypes.c_ulong), ("send_event", ctypes.c_int),
                ("display", ctypes.c_void_p), ("window", ctypes.c_ulong),
                ("message_type", ctypes.c_ulong), ("format", ctypes.c_int),
                ("data", ctypes.c_long * 5)]


class XEvent(ctypes.Union):
    _fields_ = [("xclient", XClientMessageEvent), ("pad", ctypes.c_long * 24)]


def pt():
    lang = os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or ""
    return lang.startswith("pt")


def warn(text_pt, text_en):
    text = text_pt if pt() else text_en
    print("big-wm-zoom: " + text, file=sys.stderr)
    if shutil.which("notify-send"):
        title = "Ampliação da tela" if pt() else "Screen zoom"
        subprocess.run(["notify-send", "-a", "Big WindowMaker", "-i", "big-wm-magnify", title, text],
                       check=False)


def send(code):
    """Manda o comando ao plugin; False se ninguém o atende."""
    name = ctypes.util.find_library("X11")
    if not name:
        return False
    x = ctypes.CDLL(name)
    x.XOpenDisplay.restype = ctypes.c_void_p
    x.XOpenDisplay.argtypes = [ctypes.c_char_p]
    x.XInternAtom.restype = ctypes.c_ulong
    x.XInternAtom.argtypes = [ctypes.c_void_p, ctypes.c_char_p, ctypes.c_int]
    x.XGetSelectionOwner.restype = ctypes.c_ulong
    x.XGetSelectionOwner.argtypes = [ctypes.c_void_p, ctypes.c_ulong]
    x.XDefaultScreen.argtypes = [ctypes.c_void_p]
    x.XSendEvent.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_int, ctypes.c_long,
                             ctypes.POINTER(XEvent)]
    x.XFlush.argtypes = [ctypes.c_void_p]
    x.XCloseDisplay.argtypes = [ctypes.c_void_p]
    dpy = x.XOpenDisplay(None)
    if not dpy:
        return False
    try:
        screen = x.XDefaultScreen(dpy)
        owner = x.XGetSelectionOwner(dpy, x.XInternAtom(dpy, b"_BIG_WM_ZOOM_S%d" % screen, 0))
        if not owner:
            return False
        ev = XEvent()
        ev.xclient.type = CLIENT_MESSAGE
        ev.xclient.window = owner
        ev.xclient.message_type = x.XInternAtom(dpy, b"_BIG_WM_ZOOM_COMMAND", 0)
        ev.xclient.format = 32
        ev.xclient.data[0] = code
        x.XSendEvent(dpy, owner, 0, 0, ctypes.byref(ev))
        x.XFlush(dpy)
        return True
    finally:
        x.XCloseDisplay(dpy)


def main(argv):
    if len(argv) != 2 or argv[1] not in COMMANDS:
        print("uso: big-wm-zoom in|out|reset", file=sys.stderr)
        return 2
    if os.environ.get("WAYLAND_DISPLAY") and "wlmaker" in os.environ.get("XDG_CURRENT_DESKTOP", ""):
        warn("no Wayland use Ctrl+Alt+rolagem ou o menu Aparência (ações do wlmaker).",
             "on Wayland use Ctrl+Alt+wheel or the Appearance menu (wlmaker actions).")
        return 1
    if not os.environ.get("DISPLAY") or not send(COMMANDS[argv[1]]):
        warn("a ampliação da tela não está ativa (precisa do picom com o big-wm-zoom).",
             "screen zoom is not running (it needs picom with big-wm-zoom).")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
