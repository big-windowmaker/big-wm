#!/usr/bin/python3 -Is
# SPDX-License-Identifier: GPL-2.0-or-later
#
# Dockapps acoplados no Dock ou no Clip do Window Maker iniciam com a sessão.
#
# O Window Maker do Big WindowMaker já acopla um dockapp com "Iniciar quando
# o Window Maker iniciar" ligado (patch 0016 do pacote windowmaker). Isto
# cobre o que foi acoplado antes, quando ele acoplava com AutoLaunch = No:
# parado, um dockapp é só um ladrilho vazio no Dock. Na primeira vez que um
# dockapp aparece acoplado, o AutoLaunch dele é ligado e o nome vai para uma
# lista; se o usuário desligar depois, a escolha fica.
#
# Dockapp é a entrada de classe "DockApp" (libdockapp) ou a de um programa do
# catálogo do menu Aparência > Dockapps (big-wm-appmenu): wmfsm, wmglobe,
# wmcliphist, wmeyes e os outros têm classes próprias.
#
# Roda antes do wmaker (startbigwm), que regrava o WMState ao sair.
#
#   big-wm-dockapps-autolaunch [WMState] [lista]

import os
import re
import shlex
import shutil
import sys
import tempfile
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader

gnustep = os.environ.get("WMAKER_USER_ROOT") or os.path.expanduser("~/GNUstep")
config_home = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
state = sys.argv[1] if len(sys.argv) > 1 else os.path.join(gnustep, "Defaults", "WMState")
seen_file = (sys.argv[2] if len(sys.argv) > 2
             else os.path.join(config_home, "big-wm", "dockapps-autolaunch"))

# Entrada de aplicativo do Dock/Clip: dicionário sem chaves aninhadas.
ENTRY = re.compile(r"\{[^{}]*\}")
NAME = re.compile(r'\bName\s*=\s*("(?:[^"\\]|\\.)*"|[^;\s]+)\s*;')
COMMAND = re.compile(r'(?<![A-Za-z])Command\s*=\s*("(?:[^"\\]|\\.)*"|[^;\s]+)\s*;')
AUTOLAUNCH = re.compile(r"\bAutoLaunch\s*=\s*No\s*;", re.I)


def unquote(value):
    if value.startswith('"') and value.endswith('"'):
        return re.sub(r"\\(.)", r"\1", value[1:-1])
    return value


def dockapp_programs():
    """Programas dos dockapps X11 do catálogo do menu (sem ele, vazio)."""
    path = os.environ.get("BIG_WM_APPMENU") or shutil.which("big-wm-appmenu")
    if not path:
        return frozenset()
    try:
        loader = SourceFileLoader("big_wm_appmenu", path)
        menu = module_from_spec(spec_from_loader("big_wm_appmenu", loader))
        loader.exec_module(menu)
        commands = {shlex.split(d[0])[0] for d in menu.DOCKAPPS}
        return frozenset(menu.X11_DOCKAPP_PROGRAMS) | commands
    except (OSError, SyntaxError, AttributeError, ValueError, IndexError):
        return frozenset()


def is_dockapp(name, command, programs):
    if name.endswith(".DockApp"):
        return True
    try:
        words = shlex.split(command)
    except ValueError:
        words = command.split()
    return bool(words) and os.path.basename(words[0]) in programs


def main():
    try:
        with open(state, encoding="utf-8") as f:
            text = f.read()
    except OSError:
        return 0
    try:
        with open(seen_file, encoding="utf-8") as f:
            seen = {line.strip() for line in f if line.strip()}
    except OSError:
        seen = set()

    new_seen = set()
    changed = []
    programs = dockapp_programs()

    def fix(match):
        entry = match.group(0)
        name = NAME.search(entry)
        if not name:
            return entry
        app = unquote(name.group(1))
        command = COMMAND.search(entry)
        if not is_dockapp(app, unquote(command.group(1)) if command else "", programs):
            return entry
        if app in seen or app in new_seen:
            return entry
        new_seen.add(app)
        if AUTOLAUNCH.search(entry):
            changed.append(app)
            return AUTOLAUNCH.sub("AutoLaunch = Yes;", entry)
        return entry

    text = ENTRY.sub(fix, text)
    if changed:
        directory = os.path.dirname(state)
        fd, tmp = tempfile.mkstemp(dir=directory, prefix=".WMState.")
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        os.chmod(tmp, os.stat(state).st_mode & 0o777)
        os.replace(tmp, state)
    if new_seen:
        os.makedirs(os.path.dirname(seen_file), exist_ok=True)
        with open(seen_file, "a", encoding="utf-8") as f:
            for app in sorted(new_seen):
                f.write(app + "\n")
    for app in changed:
        print(f"{app}: AutoLaunch ligado", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
