# Maintainer: Big WindowMaker <https://github.com/big-windowmaker>
#
# Pacotes do desktop Big WindowMaker. Segue o padrão de versão dos pacotes da
# BigCommunity (data do build). Para compilar a cópia local do repositório:
#   BIGWM_SOURCE="git+file://$PWD/.." makepkg

pkgbase=big-wm
pkgname=('big-wm-session' 'big-wm-wayland' 'big-wm-themes' 'big-wm-tabbed-dock' 'big-wm-locate-pointer'
	'big-wm-lockscreen' 'big-wm-name'
	'grub-theme-big-wm' 'plymouth-theme-big-wm')
# printf embutido do bash, não o date: o namcap lê o PKGBUILD sem PATH e
# recusava o arquivo ("date: command not found").
pkgver=$(printf '%(%y.%m.%d)T' -1)
pkgrel=$(printf '%(%H%M)T' -1)
# O dock com abas é binário (x86_64); os demais pacotes são arch=any.
arch=('x86_64')
url="https://github.com/big-windowmaker/big-wm"
license=('GPL-2.0-or-later')
# grub (grub-mkfont), freetype2 e gsfonts geram as fontes .pf2 do tema do GRUB.
makedepends=('git' 'python' 'desktop-file-utils' 'librsvg'
	'meson' 'gtk3' 'gtk-layer-shell' 'wayland' 'wayland-protocols' 'libx11' 'gettext'
	'libxi' 'libxfixes' 'libxext' 'libxcursor' 'libxrandr' 'cairo' 'gdk-pixbuf2'
	'grub' 'freetype2' 'gsfonts')
# tests/run.sh pula o shellcheck quando ele falta; no build do pacote ele roda.
# xdg-utils: os testes da escolha do gerenciador de arquivos usam o xdg-mime.
checkdepends=('shellcheck' 'xdg-utils')
source=("big-wm::${BIGWM_SOURCE:-git+$url.git}")
sha256sums=('SKIP')

build() {
	arch-meson big-wm/tabbed-dock build-tabbed-dock
	meson compile -C build-tabbed-dock
	make -C big-wm locate-pointer
	make -C big-wm lockscreen
}

check() {
	meson test -C build-tabbed-dock --print-errorlogs
	cd big-wm
	session/locate-pointer/big-wm-locate-pointer --selftest
	tests/run.sh
}

package_big-wm-session() {
	pkgdesc="Big WindowMaker: sessão X11 do Window Maker integrada ao BigLinux"
	arch=('any')
	# Aplicativos padrão das sessões (pastas no Thunar): o administrador pode
	# editar, e o pacman não sobrescreve a edição.
	backup=('etc/xdg/windowmaker-mimeapps.list' 'etc/xdg/wlmaker-mimeapps.list'
	        'etc/xdg/windowmaker-xdg-terminals.list' 'etc/xdg/wlmaker-xdg-terminals.list')
	depends=(
		'big-wm-themes'
		'big-wm-locate-pointer' # sacudir o mouse para achar o ponteiro (menu Configurações)
		# 0.3.1: mosaico confiável em vários monitores, dockapp com o modo
		'wmake-zones>=0.3.1-2'
		# 12: dockapp acoplado inicia com a sessão; dicas do Motif mudadas
		# com a janela aberta (Telegram, Qt)
		'windowmaker>=0.96.0.r130.g558e67f-12'
		'bash' 'dbus' 'systemd' 'gtk3' 'xdg-utils' 'xdg-user-dirs' 'xorg-setxkbmap'
		'xdg-desktop-portal-gtk' 'xdg-terminal-exec' 'libnotify'
		'xsettingsd' # tema GTK claro/escuro ao vivo (XSETTINGS) na sessão X11
		'xterm' # terminal de reserva: o big-wm-open terminal nunca fica sem um
		'alsa-lib' # wmix (biglinux-stable) usa libasound sem declarar a dependência
		'alsa-utils' # amixer: big-wm-mixer espera o mixer ter controles
		'dunst' 'polkit-gnome' 'snixembed' 'xss-lock'
		# Tela de bloqueio OPENSTEP: xsecurelock (grabs, monitores, PAM pelo
		# authproto_pam) com os módulos do big-wm-lockscreen; i3lock de
		# reserva.
		'big-wm-lockscreen' 'xsecurelock' 'i3lock'
		# Captura de tela (menu Captura de tela) e Ctrl+Alt+Esc (caveira do xkill)
		'scrot' 'xorg-xkill'
		# Histórico da área de transferência (big-wm-clipboard): o xsel
		# mantém o item escolhido depois que a janela fecha (X11)
		'xsel'
		# big-wm-appmenu e as preferências da tela de bloqueio (Python, GTK 3)
		'python' 'python-gobject' 'python-cairo'
		# big-wm-x11-repaint chama a libX11 pelo ctypes
		'libx11'
		# Janelas GTK 3/4 e libadwaita com a decoração do Window Maker
		'gtk-nocsd'
		# Aplicativos Qt com a aparência OpenStep (Kvantum + QTStep). O modo
		# escuro (big-wm-theme dark) usa o QTStepOpenStepDark do mesmo pacote,
		# a partir do qtstep-kvantum 0.r23.36dc0d3-2.
		'kvantum' 'qtstep-kvantum'
		# Aplicativos GTK com a aparência NeXTSTEP e o tema Netscape 4 do
		# Firefox; o OneStepBack-Dark do modo escuro vem no mesmo pacote, a
		# partir do onestepback-gtk-theme 0.997-4. Sem as variações escuras o
		# big-wm-theme dark troca só o que existe (Window Maker, wlmaker,
		# dock, menus, notificações).
		'onestepback-gtk-theme' 'retrothemes-firefox'
		# big-wm-theme (modo claro/escuro): gsettings (glib2) para o
		# color-scheme dos aplicativos libadwaita e do portal
		'glib2'
		# wmsystemtray 20260412-8: publica a cor dos ícones simbólicos
		# (_NET_SYSTEM_TRAY_COLORS), escuros no claro e claros no escuro.
		'wmclock' 'wmsystemtray>=20260412-8' 'wmix' 'wmcpuload' 'wmmemload' 'wmnet'
		# Fontes bitmap do X usadas pelos dockapps; o xorg-mkfontscale gera o
		# fonts.dir, sem o qual o servidor X não as encontra.
		'xorg-fonts-misc' 'xorg-mkfontscale'
	)
	optdepends=(
		'rofi: Buscar aplicativos e Executar pelo rofi, quando houver ~/.config/rofi/config.rasi'
		'spectacle: Print, Alt+Print e Shift+Print abrem o Spectacle (sem ele, o scrot grava direto)'
		'xfce4-taskmanager: Gerenciador de tarefas (Ctrl+Shift+Esc; sem ele, o htop no terminal)'
		'picom: sombras e transições suaves (compositor X11)'
		'arandr: configuração de monitores'
		'pavucontrol: controle de volume'
		'big-system-config: Configurações do BigLinux'
		'pamac-gtk: instalação de programas'
		'thunar: gerenciador de arquivos do Clip'
		'kvantum-qt5: QTStep também nos aplicativos Qt 5'
		'firefox: navegador padrão (tema Netscape 4)'
		'big-wm-tabbed-dock: dock horizontal com abas (estilo OPENSTEP 4.0 beta)'
		'indicator-sound-switcher: trocar a saída e a entrada de som pela bandeja'
		'playerctl: dockapp wmusic e teclas de mídia'
		'ashyterm: terminal padrão (Ctrl+Alt+T, Abrir terminal aqui no Thunar)'
		'network-manager-applet: rede na bandeja'
		'blueman: Bluetooth na bandeja (só sobe quando há adaptador)'
		'fastfetch: logo do Big WindowMaker no terminal'
		'wdm: tela de login no visual NeXT, com as duas sessões'
		'lightdm-slick-greeter: emblemas das sessões na tela de login'
		# Catálogo do menu Aparência > Dockapps (big-wm-appmenu): cada dockapp
		# aparece lá quando instalado. Pacotes do big-dockapps.
		'wmcalclock: dockapp calendário e relógio'
		'wmtime: dockapp relógio com data'
		'wmclockmon: dockapp relógio com alarmes'
		'wmtz: dockapp relógio mundial'
		'pclock: dockapp relógio analógico'
		'minicontrol: dockapp relógio, WPrefs e desligar'
		'wmcube: dockapp cubo 3D da CPU'
		'wmcpufreq: dockapp frequência da CPU'
		'wmmon: dockapp CPU, disco e memória'
		'wmtop: dockapp processos mais ativos'
		'wmfsm: dockapp uso dos discos'
		'wmgtemp: dockapp temperatura'
		'wmwifi: dockapp sinal do Wi-Fi'
		'wmbattery: dockapp bateria'
		'wmapmload: dockapp bateria (visor LCD)'
		'wmusic: dockapp controle de música'
		'wmweather: dockapp clima'
		'wmsun: dockapp nascer e pôr do sol'
		'wmmoonclock: dockapp fase da lua'
		'wmglobe: dockapp globo terrestre'
		'wmcliphist: histórico da área de transferência no Dock e no Super+V'
		'wmcalc: dockapp calculadora'
		'wmpager: dockapp áreas de trabalho'
		'minidock: dockapp lançador de 4 botões'
		'wmudmount: dockapp discos e pendrives'
		'mountapp: dockapp montar partições do fstab'
		'wmshutdown: dockapp desligar e reiniciar'
	)

	cd big-wm
	make DESTDIR="$pkgdir" install-session
	install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}

package_big-wm-wayland() {
	pkgdesc="Big WindowMaker: sessão Wayland experimental com o compositor wlmaker"
	arch=('any')
	depends=(
		'big-wm-session'
		# 16: a ação Zones dos atalhos e do menu (wmake-zones); um wlmaker
		# mais antigo não abre com o Config.plist desta sessão.
		# 18: o mosaico acompanha a área útil e as saídas; algorithm next/prev
		# (setas do dockapp wmake-zones-wl)
		'wlmaker>=1:0.8.r80.g7481afe-19' 'xorg-xwayland' 'swaybg'
		# Tela de bloqueio OPENSTEP (ext-session-lock); swaylock de reserva.
		'gtklock' 'swaylock'
		'xdg-desktop-portal-wlr' 'grim' 'slurp'
		# big-wm-tray: bandeja SNI em layer-shell, com os menus via dbusmenu
		'python' 'python-gobject' 'python-cairo' 'gtk3' 'gtk-layer-shell' 'libdbusmenu-gtk3'
		# big-wm-wprefs-sync lê os atalhos do WPrefs com a libxkbcommon (ctypes)
		'libxkbcommon'
		# Monitores (menu Configurações) e bloqueio pelo logind (big-wm-lock --watch)
		'wdisplays' 'swayidle'
		# Histórico da área de transferência: wl-paste --watch (data-control
		# do wlmaker) grava o que é copiado; wl-copy devolve o item escolhido
		'wl-clipboard'
	)
	optdepends=(
		'wireplumber: teclas de volume (wpctl)'
		'playerctl: teclas de mídia'
		'brightnessctl: teclas de brilho'
		'xdotool: Forçar o fechamento (Ctrl+Alt+Esc) de janelas do XWayland'
		'xorg-xprop: Forçar o fechamento (Ctrl+Alt+Esc) de janelas do XWayland'
	)

	cd big-wm
	make DESTDIR="$pkgdir" install-wayland
}

package_big-wm-themes() {
	pkgdesc="Big WindowMaker: temas, estilos, ícones e papéis de parede"
	arch=('any')
	# Ícones do logo em /usr/share/icons/hicolor (diretórios do tema hicolor).
	depends=('hicolor-icon-theme')
	optdepends=('windowmaker: aplicar os temas pelo menu Aparência')

	cd big-wm
	make DESTDIR="$pkgdir" install-themes
	install -Dm644 CREDITS.md "$pkgdir/usr/share/doc/$pkgname/CREDITS.md"
}

package_big-wm-tabbed-dock() {
	pkgdesc="Big WindowMaker: dock horizontal com abas (X11 e Wayland), inspirado no OPENSTEP 4.0 beta"
	depends=('glibc' 'gtk3' 'glib2' 'gdk-pixbuf2' 'cairo' 'pango' 'librsvg' 'libx11' 'wayland' 'gtk-layer-shell')
	optdepends=(
		'big-wm-session: sessão Window Maker (X11)'
		'big-wm-wayland: sessão wlmaker (Wayland)'
		'windowmaker: escolher entre o Dock clássico e o dock com abas (wdwrite)'
	)

	meson install -C build-tabbed-dock --destdir "$pkgdir" --no-rebuild
	cd big-wm
	for f in docs/tabbed-dock/*.md; do
		install -Dm644 "$f" "$pkgdir/usr/share/doc/$pkgname/${f##*/}"
	done
}

package_big-wm-locate-pointer() {
	pkgdesc="Big WindowMaker: sacudir o mouse aumenta o ponteiro por um instante, para achá-lo (X11)"
	depends=('glibc' 'libx11' 'libxi' 'libxfixes' 'libxext' 'libxcursor' 'libxrandr')
	optdepends=('libnotify: aviso ao ligar e desligar pelo menu')

	cd big-wm
	make DESTDIR="$pkgdir" install-locate-pointer
}

package_big-wm-lockscreen() {
	pkgdesc="Big WindowMaker: tela de bloqueio OPENSTEP (fundo desfocado, módulos do xsecurelock e teclado na tela do gtklock)"
	# O módulo do teclado na tela (gtklock-keyboard.c) é GPL-3.0-or-later,
	# como o gtklock, de quem usa a estrutura Window.
	license=('GPL-2.0-or-later' 'GPL-3.0-or-later')
	depends=('glibc' 'libx11' 'libxi' 'libxrandr' 'cairo' 'gdk-pixbuf2' 'fontconfig' 'hicolor-icon-theme' 'gtk3')
	optdepends=('xsecurelock: a tela de bloqueio na sessão X11'
		'gtklock: a tela de bloqueio na sessão Wayland')

	cd big-wm
	make DESTDIR="$pkgdir" install-lockscreen
}

package_grub-theme-big-wm() {
	pkgdesc="Big WindowMaker: tema do GRUB no estilo da tela de boot do Window Maker e resolução pelo monitor"
	arch=('any')
	# As fontes .pf2 são geradas das fontes URW do gsfonts.
	license=('GPL-2.0-or-later' 'AGPL-3.0-only WITH PS-or-PDF-font-exception-20170817')
	# grub-resolucao: bash, coreutils, util-linux (flock), findutils
	depends=('grub' 'bash' 'coreutils' 'util-linux' 'findutils')
	install=grub-theme-big-wm.install

	cd big-wm
	make DESTDIR="$pkgdir" install-grub-theme
	install -Dm644 themes/boot/grub/FONTES-URW.txt "$pkgdir/usr/share/licenses/$pkgname/FONTES-URW.txt"
	install -Dm644 themes/boot/README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}

package_big-wm-name() {
	pkgdesc="Big WindowMaker: nome do sistema (os-release, lsb-release e /etc/issue), baseado no BigLinux"
	arch=('any')
	depends=('bash' 'sed' 'grep')
	# Faz o mesmo papel do bigcommunity-name, com o nome do Big WindowMaker.
	provides=('bigcommunity-name')
	conflicts=('bigcommunity-name')
	replaces=('bigcommunity-name')

	cd big-wm
	make DESTDIR="$pkgdir" install-name
}

package_plymouth-theme-big-wm() {
	pkgdesc="Big WindowMaker: tema do Plymouth no estilo do Window Maker"
	arch=('any')
	# gsfonts: fonte dos textos (Font= do big-wm.plymouth), copiada para o
	# initramfs; bash: hooks do pacman que mantêm o tema escolhido.
	depends=('plymouth' 'gsfonts' 'bash')
	install=plymouth-theme-big-wm.install

	cd big-wm
	make DESTDIR="$pkgdir" install-plymouth-theme
	install -Dm644 themes/boot/README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
