# Maintainer: Big WindowMaker <https://github.com/big-windowmaker>
#
# Pacotes do desktop Big WindowMaker. Segue o padrão de versão dos pacotes da
# BigCommunity (data do build). Para compilar a cópia local do repositório:
#   BIGWM_SOURCE="git+file://$PWD/.." makepkg

pkgbase=big-wm
pkgname=('big-wm-session' 'big-wm-wayland' 'big-wm-themes' 'grub-theme-big-wm' 'plymouth-theme-big-wm')
pkgver=$(date +%y.%m.%d)
pkgrel=$(date +%H%M)
arch=('any')
url="https://github.com/big-windowmaker/big-wm"
license=('GPL-2.0-or-later')
# grub (grub-mkfont), freetype2 e gsfonts geram as fontes .pf2 do tema do GRUB.
makedepends=('git' 'python' 'desktop-file-utils' 'librsvg' 'grub' 'freetype2' 'gsfonts')
source=("big-wm::${BIGWM_SOURCE:-git+$url.git}")
sha256sums=('SKIP')

check() {
	cd big-wm
	tests/run.sh
}

package_big-wm-session() {
	pkgdesc="Big WindowMaker: sessão X11 do Window Maker integrada ao BigLinux"
	depends=(
		'big-wm-themes'
		'windowmaker>0.96.0'
		'bash' 'dbus' 'systemd' 'gtk3' 'xdg-utils' 'xdg-user-dirs' 'xorg-setxkbmap'
		'xdg-desktop-portal-gtk' 'xdg-terminal-exec' 'rofi' 'libnotify'
		'alsa-lib' # wmix (biglinux-stable) usa libasound sem declarar a dependência
		'dunst' 'polkit-gnome' 'snixembed' 'xss-lock' 'i3lock'
		# big-wm-appmenu (Python) e a imagem da tela de bloqueio (big-wm-lock)
		'python' 'python-gobject' 'python-cairo'
		# Janelas GTK 3/4 e libadwaita com a decoração do Window Maker
		'gtk-nocsd'
		# Aplicativos Qt com a aparência OpenStep (Kvantum + QTStep)
		'kvantum' 'qtstep-kvantum'
		# Aplicativos GTK com a aparência NeXTSTEP e o tema Netscape 4 do Firefox
		'onestepback-gtk-theme' 'retrothemes-firefox'
		'wmclock' 'wmsystemtray' 'wmix' 'wmcpuload' 'wmmemload' 'wmnet'
		# Fontes bitmap do X usadas pelos dockapps; o xorg-mkfontscale gera o
		# fonts.dir, sem o qual o servidor X não as encontra.
		'xorg-fonts-misc' 'xorg-mkfontscale'
	)
	optdepends=(
		'picom: sombras e transições suaves (compositor X11)'
		'arandr: configuração de monitores'
		'pavucontrol: controle de volume'
		'big-system-config: Configurações do BigLinux'
		'pamac-gtk: instalação de programas'
		'thunar: gerenciador de arquivos do Clip'
		'kvantum-qt5: QTStep também nos aplicativos Qt 5'
		'firefox: navegador padrão (tema Netscape 4)'
	)

	cd big-wm
	make DESTDIR="$pkgdir" install-session
	install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}

package_big-wm-wayland() {
	pkgdesc="Big WindowMaker: sessão Wayland experimental com o compositor wlmaker"
	depends=(
		'big-wm-session'
		'wlmaker' 'xorg-xwayland' 'swaybg' 'swaylock'
		'xdg-desktop-portal-wlr' 'grim' 'slurp'
		# big-wm-tray: bandeja SNI em layer-shell, com os menus via dbusmenu
		'python-gobject' 'gtk-layer-shell' 'libdbusmenu-gtk3'
		# Monitores (menu Configurações) e bloqueio pelo logind (big-wm-lock --watch)
		'wdisplays' 'swayidle'
	)
	optdepends=(
		'wireplumber: teclas de volume (wpctl)'
		'playerctl: teclas de mídia'
		'brightnessctl: teclas de brilho'
	)

	cd big-wm
	make DESTDIR="$pkgdir" install-wayland
}

package_big-wm-themes() {
	pkgdesc="Big WindowMaker: temas, estilos, ícones e papéis de parede"
	optdepends=('windowmaker: aplicar os temas pelo menu Aparência')

	cd big-wm
	make DESTDIR="$pkgdir" install-themes
	install -Dm644 CREDITS.md "$pkgdir/usr/share/doc/$pkgname/CREDITS.md"
}

package_grub-theme-big-wm() {
	pkgdesc="Big WindowMaker: tema do GRUB no estilo da tela de boot do Window Maker"
	# As fontes .pf2 são geradas das fontes URW do gsfonts.
	license=('GPL-2.0-or-later' 'AGPL-3.0-only WITH PS-or-PDF-font-exception-20170817')
	install=grub-theme-big-wm.install

	cd big-wm
	make DESTDIR="$pkgdir" install-grub-theme
	install -Dm644 themes/boot/grub/FONTES-URW.txt "$pkgdir/usr/share/licenses/$pkgname/FONTES-URW.txt"
	install -Dm644 themes/boot/README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}

package_plymouth-theme-big-wm() {
	pkgdesc="Big WindowMaker: tema do Plymouth no estilo do Window Maker"
	# gsfonts: fonte dos textos (Font= do big-wm.plymouth), copiada para o
	# initramfs; bash: hooks do pacman que mantêm o tema escolhido.
	depends=('plymouth' 'gsfonts' 'bash')
	install=plymouth-theme-big-wm.install

	cd big-wm
	make DESTDIR="$pkgdir" install-plymouth-theme
	install -Dm644 themes/boot/README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
