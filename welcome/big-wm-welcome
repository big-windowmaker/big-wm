# SPDX-License-Identifier: GPL-2.0-or-later
#
# Big WindowMaker Welcome: the tutorial of the first login, "Introducing Big
# WindowMaker", in the look of the 1990s.
#
#   big-wm-welcome              opens it (or raises the open one)
#   big-wm-welcome --autostart  at login: only the first time, then only if
#                               "Show at login" is checked; never in the live
#                               image (the installer is in front there)
#   big-wm-welcome --version

import gettext
import locale
import os
import sys

DATADIR = os.environ.get("BIGWM_WELCOME_DATADIR", "/usr/share/big-wm/welcome")
LOCALEDIR = os.environ.get("BIGWM_WELCOME_LOCALEDIR", "/usr/share/locale")
sys.path.insert(0, DATADIR)


def main(argv):
    try:
        locale.setlocale(locale.LC_ALL, "")
    except locale.Error:
        pass
    gettext.bindtextdomain("big-wm-welcome", LOCALEDIR)
    gettext.textdomain("big-wm-welcome")
    from bigwmwelcome import system
    if "--version" in argv:
        from bigwmwelcome.ui import VERSION
        print(VERSION)
        return 0
    if "--autostart" in argv:
        if not system.should_autostart(system.Preferences(), system.is_live_session()):
            return 0
    from gi.repository import GLib
    # The app ID / WM_CLASS of the desktop entry: the Dock, the appicons and
    # Alt+Tab find its icon.
    GLib.set_prgname(system.APP_ID)
    from bigwmwelcome import ui
    return ui.run([argv[0]])


if __name__ == "__main__":
    sys.exit(main(sys.argv))
